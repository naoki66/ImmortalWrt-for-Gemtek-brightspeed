* -text
*.patch text eol=lf whitespace=-indent-with-non-tab,-space-before-tab,-tab-in-indent,-trailing-space
*.sh text eol=lf
*.dts text eol=lf
*.dts[io] text eol=lf
*.mk text eol=lf
*.conf text eol=lf
*.init text eol=lf
*.uc text eol=lf
*.json text eol=lf
package/base-files/files/bin/config_generate text eol=lf

# lucky package: enforce LF for init/config/scripts
package/lucky/** text eol=lf

# luci JS must stay LF: the LuCI JS minifier turns a CRLF after a backslash
# line continuation into two LFs, breaking multi-line string literals
package/luci-app-netmode/** text eol=lf
package/luci-app-mesh-conf/** text eol=lf
package/luci-app-airoha/** text eol=lf
