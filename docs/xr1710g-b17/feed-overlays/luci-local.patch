+/* netifd enslaves a wireless VAP into the bridge as soon as a wifi-iface is
+ * attached to an interface laid on top of it, so every AP interface shows up
+ * in the live port list. Those are not switch ports and cannot carry the
+ * tagged egress this view edits, so drop them. Decide by device type rather
+ * than by name so every naming scheme is covered (wlan0, phy0-ap0,
+ * phy0.0-ap0, ...). */
+function isWirelessBridgeMember(name) {
+	try {
+		return network.instantiateDevice(name).getType() === 'wifi';
+	}
+	catch (e) {
+		return false;
+	}
+}
