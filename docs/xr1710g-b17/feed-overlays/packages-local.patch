diff --git a/net/dawn/patches/100-add-6ghz-band.patch b/net/dawn/patches/100-add-6ghz-band.patch
new file mode 100644
index 0000000000000000000000000000000000000000..fbf44878b31da72f8707c8496bcb38b31f2a3ce9
--- /dev/null
+++ b/net/dawn/patches/100-add-6ghz-band.patch
@@ -0,0 +1,102 @@
+diff --git a/src/include/datastorage.h b/src/include/datastorage.h
+index a20d7ad..cd689de 100644
+--- a/src/include/datastorage.h
++++ b/src/include/datastorage.h
+@@ -45,9 +45,12 @@ int get_band(int freq);
+ 
+ // Band definitions
+ // Keep them sorted by frequency, in ascending order
++// The order matters: get_band() walks this list and the frequency table below
++// in lockstep, so a band has to sit above the ones below its upper frequency.
+ enum dawn_bands {
+     DAWN_BAND_80211G,
+     DAWN_BAND_80211A,
++    DAWN_BAND_80211A_6G,
+     __DAWN_BAND_MAX
+ };
+ 
+diff --git a/src/storage/datastorage.c b/src/storage/datastorage.c
+index 0184b50..5f9af84 100644
+--- a/src/storage/datastorage.c
++++ b/src/storage/datastorage.c
+@@ -25,14 +25,18 @@ static int compare_station_count(ap* ap_entry_own, ap* ap_entry_to_compare, stru
+ // config section name
+ const char *band_config_name[__DAWN_BAND_MAX] = {
+     "802_11g",
+-    "802_11a"
++    "802_11a",
++    "802_11a_6g"
+ };
+ 
+ // starting frequency
+ // TODO: make this configurable
+ const int max_band_freq[__DAWN_BAND_MAX] = {
+     2500,
+-    5925 // This may cause trouble because there's overlap between bands in different countries
++    5925, // This may cause trouble because there's overlap between bands in different countries
++    7150  // 6 GHz stops at channel 233 = 7115 MHz; without this the band falls
++          // through to get_band()'s "beyond the last known band" branch and a
++          // 6 GHz radio silently reuses the 802_11a metrics.
+ };
+ 
+ // FIXME: Using ratio of 4 to exercise skip handling in small network.  Set to 32, 64 or 128 for real use on larger network.
+diff --git a/src/utils/dawn_uci.c b/src/utils/dawn_uci.c
+index d130602..4a45310 100644
+--- a/src/utils/dawn_uci.c
++++ b/src/utils/dawn_uci.c
+@@ -281,38 +281,38 @@ struct probe_metric_s uci_get_dawn_metric() {
+                             WLAN_RRM_CAPS_BEACON_REPORT_ACTIVE,
+                             WLAN_RRM_CAPS_BEACON_REPORT_TABLE },
+         // CONFIG-B: ap_weight|Per AP weighting|[0] (Deprecated)
+-        .ap_weight = { 0, 0 },
++        .ap_weight = { 0, 0, 0 },
+         // CONFIG-B: ht_support|Score increment if HT is supported|[5]
+-        .ht_support = { 5, 5 },
++        .ht_support = { 5, 5, 5 },
+         // CONFIG-B: vht_support|Score increment if VHT is supported|[5]
+-        .vht_support = { 5, 5 },
++        .vht_support = { 5, 5, 5 },
+         // CONFIG-B: no_ht_support|Score incrment if HT is not supported|[0] (Deprecated)
+-        .no_ht_support = { 0, 0 },
++        .no_ht_support = { 0, 0, 0 },
+         // CONFIG-B: no_vht_support|Score incrment if VHT is not supported|[0] (Deprecated)
+-        .no_vht_support = { 0, 0 },
++        .no_vht_support = { 0, 0, 0 },
+         // CONFIG-B: rssi|Score addition when signal exceeds threshold|[15] See note 2.
+-        .rssi = { 15, 15 },
++        .rssi = { 15, 15, 15 },
+         // CONFIG-B: rssi_val|Threshold for an good RSSI|[-60] See note 2.
+-        .rssi_val = { -60, -60 },
++        .rssi_val = { -60, -60, -60 },
+         // CONFIG-B: initial_score|Base score for AP based on operating band|[2.4GHz = 80; 5Ghz = 100]
+-        .initial_score = { 80, 100 },
++        .initial_score = { 80, 100, 100 },
+         // CONFIG-B: chan_util|Score increment if channel utilization is below chan_util_val|[0]
+-        .chan_util = { 0, 0 },
++        .chan_util = { 0, 0, 0 },
+         // CONFIG-B: max_chan_util_val|Lower threshold for bad channel utilization|[170]
+-        .max_chan_util_val = { 170, 170 },
++        .max_chan_util_val = { 170, 170, 170 },
+         // CONFIG-B: chan_util_val|Upper threshold for good channel utilization|[140]
+-        .chan_util_val = { 140, 140 },
++        .chan_util_val = { 140, 140, 140 },
+         // CONFIG-B: max_chan_util|Score increment if channel utilization is above max_chan_util_val|[-15]
+-        .max_chan_util = { -15, -15 },
++        .max_chan_util = { -15, -15, -15 },
+         // CONFIG-B: low_rssi|Score addition when signal is below threshold|[-15] See note 2.
+-        .low_rssi = { -15, -15 },
++        .low_rssi = { -15, -15, -15 },
+         // CONFIG-B: low_rssi_val|Threshold for bad RSSI|[-80] See note 2.
+-        .low_rssi_val = { -80, -80 },
++        .low_rssi_val = { -80, -80, -80 },
+         // CONFIG-B: rssi_center|Midpoint for weighted RSSI evaluation|[-70] See note 2.
+-        .rssi_center = { -70, -70 },
++        .rssi_center = { -70, -70, -70 },
+         // CONFIG-B: rssi_weight|Per dB increment for weighted RSSI evaluation|[0] See note 2.
+-        .rssi_weight = { 0, 0 },
+-        .neighbors = {NULL, NULL},
++        .rssi_weight = { 0, 0, 0 },
++        .neighbors = {NULL, NULL, NULL},
+     };
+     struct uci_section *global_s, *band_s[__DAWN_BAND_MAX];
+     struct uci_option *global_neighbors = NULL, *neighbors;
