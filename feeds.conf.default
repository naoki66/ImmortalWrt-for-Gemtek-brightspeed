src-git packages https://github.com/immortalwrt/packages.git
# Temporary: luci-theme-argon v3.1.0 from jerrykuku, because immortalwrt/luci
# still ships 3.0.0. Listed before luci so scripts/feeds keeps the first feed
# providing a source package. --directory is required for a repo whose Makefile
# sits at its root, otherwise the scan yields an empty package path. Pin the
# commit rather than the tag: a tag checkout leaves HEAD detached and
# `feeds update` then fails on `git pull --ff-only`.
# Drop this line and move patches/feeds/argon/ back under luci when
# immortalwrt/luci picks up 3.1.0.
src-git --directory=luci-theme-argon argon https://github.com/jerrykuku/luci-theme-argon.git^96734f4f52e98ac70f564ca4b92644b849e189ba
src-git luci https://github.com/immortalwrt/luci.git
src-git routing https://github.com/openwrt/routing.git
src-git telephony https://github.com/openwrt/telephony.git
#src-git video https://github.com/openwrt/video.git
src-git app_airoha https://github.com/naoki66/luci-app-airoha.git
src-git pon_drivers https://github.com/naoki66/openwrt-pon-drivers.git
src-git onu_config https://github.com/naoki66/OpenWrt_ONU_CONFIG.git
#src-git targets https://github.com/openwrt/targets.git
#src-git oldpackages http://git.openwrt.org/packages.git
#src-link custom /usr/src/openwrt/custom-feed
src-git easytier https://github.com/EasyTier/luci-app-easytier.git;main
src-git helloworld https://github.com/fw876/helloworld.git;dev
src-git --directory=luci-app-pushbot pushbot https://github.com/naoki66/luci-app-pushbot.git
