# Runtime distfeeds lists only feeds that publish
# packages/<arch>/<feed>/packages.adb on the ImmortalWrt/OpenWrt snapshot
# tree: packages, luci, routing, telephony, and video (see DISTFEEDS_FEEDS
# in include/feeds.mk). Every other src-git line below is a build-time
# source. Its packages are still installed into the image, but the feed name
# is omitted from /etc/apk/repositories.d/distfeeds.list so `apk update`
# does not request a missing packages.adb.
src-git packages https://github.com/immortalwrt/packages.git
# luci-theme-argon from jerrykuku, tracking the default branch so
# `./scripts/feeds update -a` always pulls the latest theme instead of being
# stuck on immortalwrt/luci's older copy. Listed before luci so scripts/feeds
# keeps the first feed providing a source package. --directory is required for
# a repo whose Makefile sits at its root, otherwise the scan yields an empty
# package path. The patches under patches/feeds/argon/ must be rebased whenever
# upstream rewrites the files they touch.
src-git --directory=luci-theme-argon argon https://github.com/jerrykuku/luci-theme-argon.git
src-git luci https://github.com/immortalwrt/luci.git
src-git routing https://github.com/openwrt/routing.git
src-git telephony https://github.com/openwrt/telephony.git
#src-git video https://github.com/openwrt/video.git
src-git app_airoha https://github.com/naoki66/luci-app-airoha.git
src-git pon_drivers https://github.com/naoki66/openwrt-pon-drivers.git
src-git onu_config https://github.com/naoki66/OpenWrt_ONU_CONFIG.git
#src-git targets https://github.com/openwrt/targets.git
#src-git oldpackages http://git.openwrt.org/packages.git
#src-link custom /usr/src/openwrt/custom-feed
src-git easytier https://github.com/EasyTier/luci-app-easytier.git;main
src-git helloworld https://github.com/fw876/helloworld.git;dev
src-git --directory=luci-app-pushbot pushbot https://github.com/naoki66/luci-app-pushbot.git
src-git --root=deploy/openwrt ac_agent https://github.com/naoki66/OpenWrt_AC-Controller.git
