#!/bin/sh

. /etc/openwrt_release

uci -q get system.@imm_init[0] > "/dev/null" || uci -q add system imm_init > "/dev/null"

if ! uci -q get system.@imm_init[0].lang > "/dev/null"; then
	uci -q batch <<-EOF
		set luci.main.lang="auto"
		commit luci

		set system.@imm_init[0].lang="1"
		commit system
	EOF
fi

# dnsmasq only accepts a single log-facility directive. The init script
# already emits one from UCI, so appending another to dnsmasq.conf makes
# dnsmasq abort with "illegal repeated keyword" and never come up.
# Drop any leftover line from older images and drive it through UCI only.
sed -i "/log-facility/d" "/etc/dnsmasq.conf"

if uci -q get dhcp.@dnsmasq[0] > "/dev/null"; then
	uci -q batch <<-EOF
		set dhcp.@dnsmasq[0].logfacility="/dev/null"
		set dhcp.@dnsmasq[0].logqueries="0"
		commit dhcp
	EOF
fi

ln -sf "/sbin/ip" "/usr/bin/ip"

case "$DISTRIB_TARGET" in
"bcm4908"/*|\
"bcm53xx"/*|\
"ramips/mt7621"|\
"x86"/*)
	if ! uci -q get system.@imm_init[0].packet_steering > "/dev/null"; then
	uci -q batch <<-EOF
		set network.globals="globals"
		set network.@globals[0].packet_steering="1"
		commit network

		set system.@imm_init[0].packet_steering="1"
		commit system
	EOF
	fi
	;;
esac

exit 0
