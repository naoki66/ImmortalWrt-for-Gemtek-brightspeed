 	{ }
 };
 MODULE_DEVICE_TABLE(of, en75xx_pcm_of_match);
@@ -1451,5 +1464,5 @@ static struct platform_driver en75xx_pcm_driver = {
 };
 module_platform_driver(en75xx_pcm_driver);
 
-MODULE_DESCRIPTION("EcoNet/Airoha EN751221/EN7528/EN7523 PCM/TDM driver");
+MODULE_DESCRIPTION("EcoNet/Airoha EN751221/EN7528/EN7523/EN7581 PCM/TDM driver");
 MODULE_LICENSE("GPL");
