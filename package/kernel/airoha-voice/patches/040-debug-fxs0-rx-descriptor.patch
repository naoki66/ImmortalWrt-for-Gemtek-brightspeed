+static void en75xx_pcm_debug_rx(struct en75xx_pcm_dev *pcm,
+				unsigned int index, u8 *frame)
+{
+	struct en75xx_pcm_desc_v2 *desc;
+	unsigned int channel, byte;
+	u32 nonzero[EN75XX_PCM_MAX_CHANNELS] = {};
+	u32 unchanged[EN75XX_PCM_MAX_CHANNELS] = {};
+	dma_addr_t frame_dma;
+
+	if (!debug_rx_once)
+		return;
+	debug_rx_once = false;
+
+	for (channel = 0; channel < EN75XX_PCM_MAX_CHANNELS; channel++) {
+		u8 *data = frame + channel * EN75XX_PCM_FRAME_BYTES;
+
+		for (byte = 0; byte < EN75XX_PCM_FRAME_BYTES; byte++)
+			nonzero[channel] += data[byte] != 0;
+		for (byte = 0; byte < EN75XX_PCM_FRAME_BYTES; byte++)
+			unchanged[channel] += debug_rx_fill &&
+					      data[byte] == debug_rx_fill;
+	}
+
+	frame_dma = pcm->rx_buf_dma + index * EN75XX_PCM_FRAME_STRIDE;
+	if (pcm->soc->pcm_v2) {
+		desc = en75xx_pcm_desc(pcm, pcm->rx_ring, index);
+		pr_info("[DEBUG-FXS0-RX] index=%u status=%#08x ch_valid=%#08x buf=%#08x frame_dma=%pad active=%#02x dma_mask=%#02x\n",
+			index, READ_ONCE(desc->status), READ_ONCE(desc->ch_valid),
+			READ_ONCE(desc->buf_addr), &frame_dma, pcm->active_mask,
+			pcm->dma_channel_mask);
+	} else {
+		pr_info("[DEBUG-FXS0-RX] index=%u status=%#08x frame_dma=%pad active=%#02x dma_mask=%#02x\n",
+			index, en75xx_pcm_desc_status(pcm, pcm->rx_ring, index),
+			&frame_dma, pcm->active_mask, pcm->dma_channel_mask);
+	}
+	pr_info("[DEBUG-FXS0-RX] regs iface=%#08x ring=%#08x dma=%#08x chan=%#08x isr=%#08x imr=%#08x\n",
+		pcm_read(pcm, EN75XX_PCM_IFACE_CTRL),
+		pcm_read(pcm, EN75XX_PCM_RING_CFG),
+		pcm_read(pcm, EN75XX_PCM_DMA_CTRL),
+		pcm->soc->pcm_v2 ? pcm_read(pcm, EN75XX_PCM_CHAN_ENABLE) : 0,
+		pcm_read(pcm, EN75XX_PCM_ISR), pcm_read(pcm, EN75XX_PCM_IMR));
+	pr_info("[DEBUG-FXS0-RX] nonzero-bytes ch0..7=%u,%u,%u,%u,%u,%u,%u,%u\n",
+		nonzero[0], nonzero[1], nonzero[2], nonzero[3],
+		nonzero[4], nonzero[5], nonzero[6], nonzero[7]);
+	pr_info("[DEBUG-FXS0-RX] fill=%#02x unchanged-bytes ch0..7=%u,%u,%u,%u,%u,%u,%u,%u\n",
+		debug_rx_fill, unchanged[0], unchanged[1], unchanged[2],
+		unchanged[3], unchanged[4], unchanged[5], unchanged[6],
+		unchanged[7]);
+	print_hex_dump(KERN_INFO, "[DEBUG-FXS0-RX] frame ", DUMP_PREFIX_OFFSET,
+		       16, 1, frame, 64, false);
+}
+
