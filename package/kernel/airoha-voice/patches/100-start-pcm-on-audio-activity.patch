+static int en75xx_voice_pcm_start_locked(struct en75xx_voice_line *line)
+{
+	int ret;
+
+	if (line->pcm_started)
+		return 0;
+
+	ret = line->pcm->line_ops->start(line->pcm, line->pcm_channel);
+	if (!ret)
+		line->pcm_started = true;
+	return ret;
+}
+
+static int en75xx_voice_pcm_start(struct en75xx_voice_line *line)
+{
+	int ret;
+
+	mutex_lock(&line->lock);
+	ret = en75xx_voice_pcm_start_locked(line);
+	mutex_unlock(&line->lock);
+	return ret;
+}
+
+static void en75xx_voice_pcm_stop_locked(struct en75xx_voice_line *line)
+{
+	if (!line->pcm_started)
+		return;
+	line->pcm->line_ops->stop(line->pcm, line->pcm_channel);
+	line->pcm_started = false;
+}
