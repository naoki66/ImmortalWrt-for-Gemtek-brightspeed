From: Yanghan Ye <yyh94306@gmail.com>
Date: Tue, 14 Jul 2026 13:10:00 +1100
Subject: [PATCH] wifi: mac80211: export link STA capability limits

Drivers that pass operating-mode information to firmware need both the
station's capability limits and its current, possibly OMI-restricted,
operating values.  The latter are public in ieee80211_link_sta while the
former remain private to mac80211.

Export the capability bandwidth and NSS helpers used by MediaTek's
operating-mode handling so mt7996 can construct STA_REC_RA without
confusing capability limits with the current operating mode.

Assisted-by: Codex:gpt-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 include/net/mac80211.h | 15 +++++++++++++++
 net/mac80211/vht.c     | 31 +++++++++++++++++++++++++++++++
 2 files changed, 46 insertions(+)

--- a/include/net/mac80211.h
+++ b/include/net/mac80211.h
@@ -7807,4 +7807,21 @@ void ieee80211_finalize_rx_omi_bw(struct ieee80211_link_sta *link_sta);
 
+/**
+ * ieee80211_link_sta_cap_bw - get a link STA's bandwidth capability
+ * @link_sta: public link STA information
+ *
+ * Return: the capability bandwidth before operating-mode restrictions
+ */
+enum ieee80211_sta_rx_bandwidth
+ieee80211_link_sta_cap_bw(struct ieee80211_link_sta *link_sta);
+
+/**
+ * ieee80211_link_sta_cap_nss - get a link STA's spatial-stream capability
+ * @link_sta: public link STA information
+ *
+ * Return: the capability NSS before operating-mode restrictions
+ */
+u8 ieee80211_link_sta_cap_nss(struct ieee80211_link_sta *link_sta);
+
 /* for older drivers - let's not document these ... */
 int ieee80211_emulate_add_chanctx(struct ieee80211_hw *hw,
 				  struct ieee80211_chanctx_conf *ctx);
--- a/net/mac80211/vht.c
+++ b/net/mac80211/vht.c
@@ -445,6 +445,37 @@ _ieee80211_sta_cap_rx_bw(struct link_sta_info *link_sta,
 		   link_sta->rx_omi_bw_rx);
 }
 
+enum ieee80211_sta_rx_bandwidth
+ieee80211_link_sta_cap_bw(struct ieee80211_link_sta *pub)
+{
+	struct sta_info *sta = container_of(pub->sta, struct sta_info, sta);
+	struct link_sta_info *link_sta;
+	enum ieee80211_sta_rx_bandwidth bw;
+
+	rcu_read_lock();
+	link_sta = rcu_dereference(sta->link[pub->link_id]);
+	bw = ieee80211_sta_cap_rx_bw(link_sta);
+	rcu_read_unlock();
+
+	return bw;
+}
+EXPORT_SYMBOL(ieee80211_link_sta_cap_bw);
+
+u8 ieee80211_link_sta_cap_nss(struct ieee80211_link_sta *pub)
+{
+	struct sta_info *sta = container_of(pub->sta, struct sta_info, sta);
+	struct link_sta_info *link_sta;
+	u8 nss;
+
+	rcu_read_lock();
+	link_sta = rcu_dereference(sta->link[pub->link_id]);
+	nss = link_sta->capa_nss;
+	rcu_read_unlock();
+
+	return nss;
+}
+EXPORT_SYMBOL(ieee80211_link_sta_cap_nss);
+
 enum nl80211_chan_width
 ieee80211_sta_cap_chan_bw(struct link_sta_info *link_sta)
 {
