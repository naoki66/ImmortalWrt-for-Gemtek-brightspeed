Subject: [PATCH] mt76: add load-time NPU WLAN opt-out for diagnosis
Upstream-Status: Inappropriate [local controlled comparison switch]

--- a/npu.c
+++ b/npu.c
@@ -10,6 +10,10 @@
 #include "mt76.h"
 #include "dma.h"
 #include "mt76_connac.h"
+
+static bool npu_enable = true;
+module_param(npu_enable, bool, 0444);
+MODULE_PARM_DESC(npu_enable, "Enable Airoha NPU WLAN offload (load-time only)");
 
 #define MT76_NPU_RX_BUF_SIZE	(1800 + \
 				 SKB_DATA_ALIGN(sizeof(struct skb_shared_info)))
@@ -475,6 +479,11 @@
 	struct airoha_npu *npu;
 	int err = 0;
 
+	if (!npu_enable) {
+		dev_info(dev->dev, "Airoha NPU WLAN offload disabled by module parameter\n");
+		return 0;
+	}
+
 	mutex_lock(&dev->mutex);
 
 	npu = airoha_npu_get(dev->dev);
