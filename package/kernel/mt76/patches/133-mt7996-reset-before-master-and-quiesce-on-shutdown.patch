diff --git a/package/kernel/mt76/patches/133-mt7996-reset-before-master-and-quiesce-on-shutdown.patch b/package/kernel/mt76/patches/133-mt7996-reset-before-master-and-quiesce-on-shutdown.patch
new file mode 100644
index 00000000000..1b3e789d9d5
--- /dev/null
+++ b/package/kernel/mt76/patches/133-mt7996-reset-before-master-and-quiesce-on-shutdown.patch
@@ -0,0 +1,78 @@
+From: XR1710G local firmware work
+Subject: [PATCH] mt7996: reset before bus mastering and quiesce on shutdown
+Origin: https://github.com/iscle/openwrt/pull/2 (patch 992), adapted
+
+Reset the shared radio before enabling bus mastering. On shutdown clear
+bus mastering on both interfaces without MMIO access: a runtime firmware
+or PCIe fault may have made the register window inaccessible. The radio
+reset is left to the next probe, after both interfaces have stopped DMA.
+
+Experimental candidate; runtime validation pending.
+
+--- a/mt7996/pci.c
++++ b/mt7996/pci.c
+@@ -119,7 +119,8 @@
+ 	if (ret)
+ 		return ret;
+ 
+-	pci_set_master(pdev);
++	/* Stop stale DMA before resetting a chip left running by a warm boot. */
++	pci_clear_master(pdev);
+ 
+ 	ret = dma_set_mask(&pdev->dev, DMA_BIT_MASK(36));
+ 	if (ret)
+@@ -145,6 +146,11 @@
+ 	mt7996_wfsys_reset(dev);
+ 	hif2 = mt7996_pci_init_hif2(pdev);
+ 	dev->hif2 = hif2;
++
++	/* Both interfaces may DMA only after the shared radio reset. */
++	pci_set_master(pdev);
++	if (hif2)
++		pci_set_master(to_pci_dev(hif2->dev));
+ 
+ 	mt76_npu_init(mdev, pci_resource_start(pdev, 0),
+ 		      pci_domain_nr(pdev->bus) ? 3 : 2);
+@@ -247,11 +253,34 @@
+ 	mt7996_unregister_device(dev);
+ }
+ 
++/* Config-space writes stop stale DMA without touching an offline MMIO BAR.
++ * The shared radio is reset in probe before either interface becomes master.
++ */
++static void mt7996_hif_shutdown(struct pci_dev *pdev)
++{
++	pci_clear_master(pdev);
++}
++
++static void mt7996_pci_shutdown(struct pci_dev *pdev)
++{
++	struct mt76_dev *mdev = pci_get_drvdata(pdev);
++	struct mt7996_dev *dev;
++
++	pci_clear_master(pdev);
++	if (!mdev)
++		return;
++
++	dev = container_of(mdev, struct mt7996_dev, mt76);
++	if (dev->hif2)
++		pci_clear_master(to_pci_dev(dev->hif2->dev));
++}
++
+ struct pci_driver mt7996_hif_driver = {
+ 	.name		= KBUILD_MODNAME "_hif",
+ 	.id_table	= mt7996_hif_device_table,
+ 	.probe		= mt7996_pci_probe,
+ 	.remove		= mt7996_hif_remove,
++	.shutdown	= mt7996_hif_shutdown,
+ };
+ 
+ struct pci_driver mt7996_pci_driver = {
+@@ -259,6 +288,7 @@
+ 	.id_table	= mt7996_pci_device_table,
+ 	.probe		= mt7996_pci_probe,
+ 	.remove		= mt7996_pci_remove,
++	.shutdown	= mt7996_pci_shutdown,
+ };
+ 
+ MODULE_DEVICE_TABLE(pci, mt7996_pci_device_table);
