 int mt7996_mcu_get_temperature(struct mt7996_phy *phy)
 {
-#define TEMPERATURE_QUERY 0
-#define GET_TEMPERATURE 0
+	struct mt7996_thermal_adc_result result;
+	int ret;
+
+	/* Stock CurrentTemperature uses action 0's temperature field, not
+	 * the ADC code and not the action 1 LVTS records.
+	 */
+	ret = mt7996_mcu_get_thermal_adc(phy, 0, &result);
+	if (ret)
+		return ret;
+	/* hwmon has one input per hardware band. Do not invent a die mapping
+	 * if firmware returns more than the single record verified on XR1710G.
+	 */
+	if (result.count != 1)
+		return -EPROTO;
+	if (!result.record[0].temperature && !result.record[0].adc)
+		return -ENODATA;
+	/* Bound the later degrees-to-millidegrees multiplication. */
+	if (result.record[0].temperature > INT_MAX / 1000)
+		return -ERANGE;
+
+	return result.record[0].temperature;
+}
+
+static int
+mt7996_mcu_parse_thermal_adc(const u8 *data, size_t size,
+			   struct mt7996_thermal_adc_result *result)
+{
+	u16 len;
+	unsigned int count, i;
+
+	memset(result, 0, sizeof(*result));
+	if (size < 8)
+		return -EPROTO;
+	if (get_unaligned_le16(data + 4) != 5)
+		return -EOPNOTSUPP;
+
+	len = get_unaligned_le16(data + 6);
+	if (len < 4 || len > size - 4 || (len - 4) % 12)
+		return -EPROTO;
+	count = (len - 4) / 12;
+	if (!count)
+		return -ENODATA;
+	if (count > MT7996_THERMAL_ADC_MAX_RECORDS)
+		return -EOVERFLOW;
+
+	for (i = 0; i < count; i++) {
+		const u8 *entry = data + 8 + i * 12;
+
+		result->record[i].info = get_unaligned_le32(entry);
+		result->record[i].temperature = get_unaligned_le32(entry + 4);
+		result->record[i].adc = get_unaligned_le32(entry + 8);
+	}
+	result->count = count;
+
+	return 0;
+}
