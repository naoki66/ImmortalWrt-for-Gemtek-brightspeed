+static ssize_t
+mt7996_thermal_adc_query_write(struct file *file, const char __user *user_buf,
+			       size_t count, loff_t *ppos)
+{
+	struct mt7996_dev *dev = file->private_data;
+	struct mt7996_thermal_adc_debug *diag = &dev->thermal_adc_debug;
+	struct mt7996_phy *phy;
+	unsigned int band, action;
+	char buf[32], *arg, *value;
+	int ret;
+
+	if (!count || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, user_buf, count))
+		return -EFAULT;
+	if (memchr(buf, '\0', count))
+		return -EINVAL;
+	buf[count] = '\0';
+	arg = strim(buf);
+	value = strpbrk(arg, " \t");
+	if (!value)
+		return -EINVAL;
+	*value++ = '\0';
+	value = skip_spaces(value);
+	if (kstrtouint(arg, 10, &band) || kstrtouint(value, 10, &action) ||
+	    band >= __MT_MAX_BAND || action > 1)
+		return -EINVAL;
+	if (!mutex_trylock(&dev->mt76.mutex))
+		return -EBUSY;
+
+	phy = __mt7996_phy(dev, band);
+	if (!phy) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (!test_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state) ||
+	    test_bit(MT76_MCU_RESET, &dev->mphy.state) ||
+	    test_bit(MT76_RESTART, &dev->mphy.state) ||
+	    test_bit(MT76_RESET, &phy->mt76->state) ||
+	    dev->recovery.hw_full_reset || dev->recovery.restart) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (diag->queried && time_before(jiffies, diag->next_query)) {
+		ret = -EAGAIN;
+		goto out;
+	}
+
+	memset(diag, 0, sizeof(*diag));
+	diag->band = band;
+	diag->action = action;
+	diag->queried = true;
+	ret = mt7996_mcu_get_thermal_adc(phy, action, &diag->result);
+	diag->status = ret;
+	diag->queried_at = jiffies;
+	diag->next_query = jiffies + (ret ? 30 * HZ : 5 * HZ);
+	if (ret)
+		dev_warn_ratelimited(dev->mt76.dev,
+			"Vendor thermal ADC query band %u action %u failed: %d, firmware status %u\n",
+			band, action, ret, diag->result.fw_status);
+out:
+	mutex_unlock(&dev->mt76.mutex);
+
+	if (ret)
+		return ret;
+	return count;
+}
+
+static const struct file_operations mt7996_thermal_adc_query_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = mt7996_thermal_adc_query_write,
+};
