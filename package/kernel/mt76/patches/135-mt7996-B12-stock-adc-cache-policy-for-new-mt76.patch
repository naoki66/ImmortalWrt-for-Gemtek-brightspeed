+static bool mt7996_thermal_query_blocked(struct mt7996_phy *phy)
+{
+	struct mt7996_dev *dev = phy->dev;
+
+	return !test_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state) ||
+	       test_bit(MT76_MCU_RESET, &dev->mphy.state) ||
+	       test_bit(MT76_RESTART, &dev->mphy.state) ||
+	       test_bit(MT76_RESET, &phy->mt76->state) ||
+	       dev->recovery.hw_full_reset ||
+	       dev->recovery.restart;
+}
+
+void mt7996_thermal_cache_reset(struct mt7996_dev *dev)
+{
+	struct mt7996_phy *phy;
+	unsigned long flags;
+
+	/* Thermal locks are initialized before hw_init_done is published. */
+	if (!dev->recovery.hw_init_done)
+		return;
+
+	mt7996_for_each_phy(dev, phy) {
+		spin_lock_irqsave(&phy->thermal_lock, flags);
+		phy->thermal_cache.valid = false;
+		phy->thermal_cache.generation++;
+		phy->thermal_cache.invalidations++;
+		spin_unlock_irqrestore(&phy->thermal_lock, flags);
+	}
+}
+
+static bool mt7996_thermal_cached(struct mt7996_phy *phy, int *temperature)
+{
+	struct mt7996_thermal_cache *cache = &phy->thermal_cache;
+
+	if (mt7996_thermal_query_blocked(phy)) {
+		if (cache->valid) {
+			cache->valid = false;
+			cache->generation++;
+			cache->invalidations++;
+		}
+		cache->busy_state++;
+		cache->last_read = MT7996_THERMAL_READ_STATE_BUSY;
+		*temperature = -EBUSY;
+		return true;
+	}
+	if (!cache->valid || !time_before(jiffies, cache->expiry))
+		return false;
+
+	*temperature = cache->result;
+	if (*temperature < 0) {
+		cache->backoff_hits++;
+		cache->last_read = MT7996_THERMAL_READ_BACKOFF;
+	} else {
+		cache->cache_hits++;
+		cache->last_read = MT7996_THERMAL_READ_CACHE;
+	}
+	return true;
+}
+
+static int mt7996_thermal_get_temperature(struct mt7996_phy *phy)
+{
+	struct mt7996_thermal_cache *cache = &phy->thermal_cache;
+	struct mt7996_dev *dev = phy->dev;
+	unsigned long flags;
+	u32 generation;
+	int temperature;
+	bool done;
+
+	spin_lock_irqsave(&phy->thermal_lock, flags);
+	cache->reads++;
+	done = mt7996_thermal_cached(phy, &temperature);
+	spin_unlock_irqrestore(&phy->thermal_lock, flags);
+	if (done)
+		return temperature;
+
+	if (!mutex_trylock(&dev->mt76.mutex)) {
+		/* A concurrent reader may have filled the cache since our first check. */
+		spin_lock_irqsave(&phy->thermal_lock, flags);
+		if (!mt7996_thermal_cached(phy, &temperature)) {
+			cache->busy_lock++;
+			cache->last_read = MT7996_THERMAL_READ_LOCK_BUSY;
+			temperature = -EBUSY;
+		}
+		spin_unlock_irqrestore(&phy->thermal_lock, flags);
+		return temperature;
+	}
+
+	spin_lock_irqsave(&phy->thermal_lock, flags);
+	done = mt7996_thermal_cached(phy, &temperature);
+	generation = cache->generation;
+	if (!done)
+		cache->queries++;
+	spin_unlock_irqrestore(&phy->thermal_lock, flags);
+	if (done)
+		goto out;
+
+	temperature = mt7996_mcu_get_temperature(phy);
+	spin_lock_irqsave(&phy->thermal_lock, flags);
+	if (generation != cache->generation || mt7996_thermal_query_blocked(phy)) {
+		/* Never publish an in-flight response across a recovery boundary. */
+		cache->valid = false;
+		cache->query_discarded++;
+		cache->busy_state++;
+		cache->last_read = MT7996_THERMAL_READ_STATE_BUSY;
+		temperature = -EBUSY;
+	} else {
+		cache->result = temperature;
+		cache->updated = jiffies;
+		cache->expiry = jiffies + (temperature < 0 ? 30 * HZ : 5 * HZ);
+		cache->valid = true;
+		cache->last_read = MT7996_THERMAL_READ_QUERY;
+		if (temperature < 0)
+			cache->query_errors++;
+		else
+			cache->query_success++;
+	}
+	spin_unlock_irqrestore(&phy->thermal_lock, flags);
+out:
+	mutex_unlock(&dev->mt76.mutex);
+	return temperature;
+}
