+static int mt7996_thermal_hwmon_status_show(struct seq_file *s, void *data)
+{
+	static const char * const reasons[] = {
+		"none", "cache", "error_backoff", "query", "lock_busy", "state_busy",
+	};
+	struct mt7996_dev *dev = s->private;
+	struct mt7996_phy *phy;
+
+	seq_puts(s, "source=vendor_adc_action0 success_ttl_ms=5000 error_backoff_ms=30000\n");
+	mt7996_for_each_phy(dev, phy) {
+		struct mt7996_thermal_cache cache;
+		unsigned long flags, now;
+		const char *state;
+		bool fresh;
+
+		spin_lock_irqsave(&phy->thermal_lock, flags);
+		cache = phy->thermal_cache;
+		now = jiffies;
+		spin_unlock_irqrestore(&phy->thermal_lock, flags);
+		fresh = cache.valid && time_before(now, cache.expiry);
+		state = !cache.valid ? "empty" : !fresh ? "expired" :
+			cache.result < 0 ? "error_backoff" : "valid";
+		seq_printf(s, "band=%u cache_state=%s cache_age_ms=%u cache_remaining_ms=%u last_result=%d generation=%u last_read=%s\n",
+			   phy->mt76->band_idx, state,
+			   cache.valid ? jiffies_to_msecs(now - cache.updated) : 0,
+			   fresh ? jiffies_to_msecs(cache.expiry - now) : 0,
+			   cache.result, cache.generation,
+			   cache.last_read < ARRAY_SIZE(reasons) ? reasons[cache.last_read] : "unknown");
+		seq_printf(s, "reads=%llu cache_hits=%llu backoff_hits=%llu busy_lock=%llu busy_state=%llu queries=%llu query_success=%llu query_errors=%llu query_discarded=%llu invalidations=%llu\n",
+			   cache.reads, cache.cache_hits, cache.backoff_hits,
+			   cache.busy_lock, cache.busy_state, cache.queries,
+			   cache.query_success, cache.query_errors,
+			   cache.query_discarded, cache.invalidations);
+	}
+	return 0;
+}
