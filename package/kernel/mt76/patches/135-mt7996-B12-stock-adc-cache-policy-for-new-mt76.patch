+static int mt7996_thermal_adc_show(struct seq_file *s, void *data)
+{
+	struct mt7996_dev *dev = s->private;
+	struct mt7996_thermal_adc_debug diag;
+	unsigned int i;
+
+	if (!mutex_trylock(&dev->mt76.mutex))
+		return -EBUSY;
+	diag = dev->thermal_adc_debug;
+	mutex_unlock(&dev->mt76.mutex);
+
+	if (!diag.queried) {
+		seq_puts(s, "not queried; explicit band/action write required\n");
+		return 0;
+	}
+	seq_printf(s, "band=%u action=%u status=%d firmware_status=%u sampled_jiffies=%lu\n",
+		   diag.band, diag.action, diag.status, diag.result.fw_status,
+		   diag.queried_at);
+	if (diag.status)
+		return 0;
+	seq_printf(s, "records=%u; raw fields, scaling and sensor IDs unverified\n",
+		   diag.result.count);
+	for (i = 0; i < diag.result.count; i++)
+		seq_printf(s, "record[%u] info=0x%08x temperature_raw=0x%08x adc_raw=0x%08x\n",
+			   i, diag.result.record[i].info,
+			   diag.result.record[i].temperature,
+			   diag.result.record[i].adc);
+
+	return 0;
+}
