+/* Per-VIF emergency rollback to the unmodified hostapd EDCA baseline. */
+static ssize_t mt7996_stock_policy_read(struct file *file,
+				       char __user *user_buf,
+				       size_t count, loff_t *ppos)
+{
+	struct ieee80211_vif *vif = file->private_data;
+	struct mt7996_vif *mvif = (struct mt7996_vif *)vif->drv_priv;
+	struct mt7996_phy *phy;
+	char buf[1536];
+	u64 events[3];
+	int i, len = 0;
+
+	phy = mt7996_vif_link_phy(&mvif->deflink);
+	if (!phy)
+		return -ENODEV;
+	wiphy_lock(mt76_hw(phy->dev)->wiphy);
+	mutex_lock(&phy->dev->mt76.mutex);
+	for (i = 0; i < IEEE80211_MLD_MAX_NUM_LINKS; i++) {
+		struct mt7996_stock_edca *s = &mvif->link_info[i].stock;
+
+		if (!link_conf_dereference_protected(vif, i))
+			continue;
+		len += scnprintf(buf + len, sizeof(buf) - len,
+			"link=%d enabled=%u active=%u txop=%u ul=%u "
+			"avg_tx_len=%u avg_rx_len=%u updates=%llu failures=%llu error=%d\n",
+			i, s->enabled, s->active, s->txop, s->ul,
+			s->average_tx_len, s->average_rx_len,
+			s->updates, s->failures, s->error);
+	}
+	spin_lock_bh(&phy->dev->stock_stats_lock);
+	memcpy(events, phy->dev->stock_events, sizeof(events));
+	spin_unlock_bh(&phy->dev->stock_stats_lock);
+	len += scnprintf(buf + len, sizeof(buf) - len,
+			"events_bytes=%llu events_msdu=%llu events_mpdu=%llu\n",
+			events[0], events[1], events[2]);
+	len += scnprintf(buf + len, sizeof(buf) - len,
+			"polls=%llu missing_samples=%llu\n",
+			phy->dev->stock_polls, phy->dev->stock_missing);
+	mutex_unlock(&phy->dev->mt76.mutex);
+	wiphy_unlock(mt76_hw(phy->dev)->wiphy);
+	return simple_read_from_buffer(user_buf, count, ppos, buf, len);
+}
+
+static ssize_t mt7996_stock_policy_write(struct file *file,
+					const char __user *user_buf,
+					size_t count, loff_t *ppos)
+{
+	struct ieee80211_vif *vif = file->private_data;
+	struct mt7996_vif *mvif = (struct mt7996_vif *)vif->drv_priv;
+	struct mt7996_phy *phy;
+	struct mt7996_dev *dev;
+	bool enable;
+	int i, ret;
+
+	ret = kstrtobool_from_user(user_buf, count, &enable);
+	if (ret)
+		return ret;
+	phy = mt7996_vif_link_phy(&mvif->deflink);
+	if (!phy)
+		return -ENODEV;
+	wiphy_lock(mt76_hw(phy->dev)->wiphy);
+	dev = phy->dev;
+	mutex_lock(&dev->mt76.mutex);
+	if (!dev->stock_policy) {
+		ret = -EOPNOTSUPP;
+		goto unlock;
+	}
+	if (test_bit(MT76_MCU_RESET, &dev->mphy.state) ||
+	    test_bit(MT76_RESET, &dev->mphy.state)) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	for (i = 0; i < IEEE80211_MLD_MAX_NUM_LINKS; i++) {
+		struct mt7996_stock_edca *s = &mvif->link_info[i].stock;
+
+		s->enabled = enable;
+		/* The worker applies and retries the transition under both locks. */
+		s->error = -EINPROGRESS;
+	}
+	wiphy_delayed_work_queue(mt76_hw(phy->dev)->wiphy, &dev->stock_work, 0);
+	ret = count;
+unlock:
+	mutex_unlock(&dev->mt76.mutex);
+	wiphy_unlock(mt76_hw(phy->dev)->wiphy);
+	return ret;
+}
+
+static const struct file_operations mt7996_stock_policy_fops = {
+	.open = simple_open,
+	.read = mt7996_stock_policy_read,
+	.write = mt7996_stock_policy_write,
+	.llseek = default_llseek,
+};
