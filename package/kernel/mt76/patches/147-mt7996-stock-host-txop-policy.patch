+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/* Independent implementation of the retail host TXOP state machine.
+ * See scripts/xr1710g-b27-stock-txop/README.md for sources and limits.
+ */
+#include <linux/of.h>
+#include "mt7996.h"
+#include "mcu.h"
+#include "stock_policy.h"
+
+#define STOCK_BYTES BIT(0)
+#define STOCK_MSDU BIT(1)
+#define STOCK_MPDU BIT(2)
+
+struct mt7996_stock_band {
+	struct ieee80211_vif *ap, *sta, *main;
+	u8 ap_link, sta_link, main_link;
+	bool mlo, main_valid;
+	u64 ap_tx, ap_rx, sta_rx, main_bytes, main_tx;
+	u32 ap_packets, sta_packets, main_mpdu;
+};
+
+struct mt7996_stock_scene {
+	struct mt7996_dev *dev;
+	struct mt7996_stock_band band[MT7996_MAX_RADIOS];
+};
+
+void mt7996_stock_event(struct mt7996_dev *dev, struct mt76_wcid *wcid,
+			u16 tag, u64 tx, u64 rx)
+{
+	struct mt7996_sta_link *link;
+	struct mt7996_stock_stats *s;
+
+	if (!dev->stock_policy || !wcid->sta ||
+	    test_bit(MT76_MCU_RESET, &dev->mphy.state))
+		return;
+	link = container_of(wcid, struct mt7996_sta_link, wcid);
+	s = &link->stock_stats;
+	spin_lock_bh(&dev->stock_stats_lock);
+	if (s->epoch != READ_ONCE(dev->stock_epoch)) {
+		memset(s, 0, sizeof(*s));
+		s->epoch = READ_ONCE(dev->stock_epoch);
+	}
+	if (!s->started)
+		s->started = jiffies;
+	switch (tag) {
+	case UNI_ALL_STA_TXRX_ADM_STAT:
+		s->tx_bytes += tx;
+		s->rx_bytes += rx;
+		s->seen |= STOCK_BYTES;
+		dev->stock_events[0]++;
+		break;
+	case UNI_ALL_STA_TXRX_MSDU_COUNT:
+		s->tx_msdu += tx;
+		s->rx_msdu += rx;
+		s->seen |= STOCK_MSDU;
+		dev->stock_events[1]++;
+		break;
+	case UNI_ALL_STA_TX_STAT:
+		s->tx_mpdu += tx;
+		s->seen |= STOCK_MPDU;
+		dev->stock_events[2]++;
+		break;
+	}
+	spin_unlock_bh(&dev->stock_stats_lock);
+}
+
+/* Atomic iterator only collects statistics; never sends an MCU request. */
+static void mt7996_stock_collect(void *data, struct ieee80211_sta *sta)
+{
+	struct mt7996_stock_scene *scene = data;
+	struct mt7996_dev *dev = scene->dev;
+	struct mt7996_sta *msta = (struct mt7996_sta *)sta->drv_priv;
+	struct ieee80211_vif *vif;
+	int i;
+
+	vif = container_of((void *)msta->vif, struct ieee80211_vif, drv_priv);
+	if (vif->type != NL80211_IFTYPE_AP &&
+	    vif->type != NL80211_IFTYPE_STATION)
+		return;
+
+	for (i = 0; i < IEEE80211_MLD_MAX_NUM_LINKS; i++) {
+		struct mt7996_sta_link *sl = rcu_dereference(msta->link[i]);
+		struct mt7996_stock_average *a;
+		struct mt7996_stock_stats s;
+		struct mt7996_vif_link *vl;
+		struct mt7996_stock_band *b;
+		struct mt7996_phy *phy;
+		bool ready;
+		unsigned long elapsed;
+		u32 milliseconds;
+
+		if (!sl || !sl->connected)
+			continue;
+		vl = mt7996_vif_link(dev, vif, i);
+		if (!vl)
+			continue;
+		phy = mt7996_vif_link_phy(vl);
+		if (!phy || phy->mt76->band_idx >= MT7996_MAX_RADIOS)
+			continue;
+		b = &scene->band[phy->mt76->band_idx];
+		b->mlo |= sta->mlo;
+		if (vif->type == NL80211_IFTYPE_AP && !b->ap) {
+			b->ap = vif;
+			b->ap_link = i;
+		} else if (vif->type == NL80211_IFTYPE_STATION && !b->sta) {
+			b->sta = vif;
+			b->sta_link = i;
+		}
+
+		spin_lock_bh(&dev->stock_stats_lock);
+		s = sl->stock_stats;
+		ready = s.epoch == READ_ONCE(dev->stock_epoch) &&
+			(s.seen & (STOCK_BYTES | STOCK_MSDU)) ==
+			(STOCK_BYTES | STOCK_MSDU);
+		if (ready || (s.started &&
+		    time_after(jiffies, s.started + 3 * HZ)))
+			memset(&sl->stock_stats, 0, sizeof(sl->stock_stats));
+		spin_unlock_bh(&dev->stock_stats_lock);
+		if (!ready) {
+			dev->stock_missing++;
+			memset(&sl->stock_avg, 0, sizeof(sl->stock_avg));
+			continue;
+		}
+
+		if (sl->stock_avg_epoch != READ_ONCE(dev->stock_epoch)) {
+			memset(&sl->stock_avg, 0, sizeof(sl->stock_avg));
+			sl->stock_sampled = 0;
+			sl->stock_avg_epoch = READ_ONCE(dev->stock_epoch);
+		}
+		elapsed = sl->stock_sampled ? jiffies - sl->stock_sampled : HZ;
+		sl->stock_sampled = jiffies;
+		if (elapsed > 3 * HZ || elapsed < HZ / 2) {
+			dev->stock_missing++;
+			memset(&sl->stock_avg, 0, sizeof(sl->stock_avg));
+			continue;
+		}
+		milliseconds = max_t(u32, jiffies_to_msecs(elapsed), 1);
+		s.tx_bytes = div_u64(s.tx_bytes * 1000, milliseconds);
+		s.rx_bytes = div_u64(s.rx_bytes * 1000, milliseconds);
+		s.tx_msdu = div_u64((u64)s.tx_msdu * 1000, milliseconds);
+		s.rx_msdu = div_u64((u64)s.rx_msdu * 1000, milliseconds);
+		s.tx_mpdu = div_u64((u64)s.tx_mpdu * 1000, milliseconds);
+		a = &sl->stock_avg;
+		a->tx_bytes = mt7996_stock_ewma(a->tx_bytes, s.tx_bytes);
+		a->rx_bytes = mt7996_stock_ewma(a->rx_bytes, s.rx_bytes);
+		a->tx_msdu = mt7996_stock_ewma(a->tx_msdu, s.tx_msdu);
+		a->rx_msdu = mt7996_stock_ewma(a->rx_msdu, s.rx_msdu);
+		a->tx_mpdu = mt7996_stock_ewma(a->tx_mpdu, s.tx_mpdu);
+		if (a->tx_bytes + a->rx_bytes > b->main_bytes || !b->main) {
+			b->main = vif;
+			b->main_link = i;
+			b->main_bytes = a->tx_bytes + a->rx_bytes;
+			b->main_tx = a->tx_bytes;
+			b->main_mpdu = a->tx_mpdu;
+			b->main_valid = s.seen & STOCK_MPDU;
+		}
+		if (vif->type == NL80211_IFTYPE_AP) {
+			if (!mt7996_stock_high_rate(a->tx_bytes, a->rx_bytes))
+				continue;
+			b->ap_tx += s.tx_bytes;
+			b->ap_rx += s.rx_bytes;
+			b->ap_packets += s.rx_msdu;
+		} else {
+			b->sta_rx += s.rx_bytes;
+			b->sta_packets += s.rx_msdu;
+			if (!mt7996_stock_high_rate(a->tx_bytes, a->rx_bytes)) {
+				b->sta_rx = 0;
+				b->sta_packets = 0;
+			}
+		}
+	}
+}
+
+static void mt7996_stock_apply(void *data, u8 *mac, struct ieee80211_vif *vif)
+{
+	struct mt7996_stock_scene *scene = data;
+	struct mt7996_dev *dev = scene->dev;
+	struct mt7996_vif *mvif = (struct mt7996_vif *)vif->drv_priv;
+	int i;
+
+	if (vif->type != NL80211_IFTYPE_AP &&
+	    vif->type != NL80211_IFTYPE_STATION)
+		return;
+	for (i = 0; i < IEEE80211_MLD_MAX_NUM_LINKS; i++) {
+		struct ieee80211_bss_conf *conf;
+		struct mt7996_vif_link *vl;
+		struct mt7996_stock_band *b;
+		struct mt7996_phy *phy;
+		struct mt7996_stock_edca *s = &mvif->link_info[i].stock;
+		struct mt7996_stock_edca old = *s;
+		struct mt7996_stock_vote votes = {};
+		bool mu;
+		int err;
+
+		conf = link_conf_dereference_protected(vif, i);
+		if (!conf)
+			continue;
+		vl = mt7996_vif_link(dev, vif, i);
+		if (!vl)
+			continue;
+		phy = mt7996_vif_link_phy(vl);
+		if (!phy || phy->mt76->band_idx >= MT7996_MAX_RADIOS)
+			continue;
+		if (vif->type == NL80211_IFTYPE_AP && !conf->enable_beacon)
+			continue;
+		b = &scene->band[phy->mt76->band_idx];
+		mu = mvif->link_info[i].queue_params[0].mu_edca_param_rec.mu_edca_timer;
+		mt7996_stock_vote_set(&votes, MT7996_STOCK_DEFAULT,
+				      MT7996_STOCK_BURST, true);
+		s->epoch = READ_ONCE(dev->stock_epoch);
+		s->ul = false;
+		if (b->mlo) {
+			if (b->main == vif && b->main_link == i && b->main_valid) {
+				mt7996_stock_vote_set(&votes, MT7996_STOCK_DEFAULT,
+					mt7996_stock_mlo_txop(b->main_tx, b->main_mpdu, mu),
+					true);
+				s->average_tx_len = b->main_mpdu ?
+					min_t(u64, b->main_tx / b->main_mpdu, U16_MAX) : 0;
+			}
+		} else if (b->ap == vif && b->ap_link == i) {
+			s->ul = mt7996_stock_ap_ul(b->ap_tx, b->ap_rx,
+						 b->ap_packets, mu);
+			s->average_rx_len = b->ap_packets ?
+				b->ap_rx / b->ap_packets : 0;
+		} else if (b->sta == vif && b->sta_link == i) {
+			s->ul = mt7996_stock_sta_ul(b->sta_rx, b->sta_packets);
+			s->average_rx_len = b->sta_packets ?
+				b->sta_rx / b->sta_packets : 0;
+		}
+		mt7996_stock_vote_set(&votes, MT7996_STOCK_UL, 0, s->ul);
+		s->active = s->enabled;
+		s->txop = mt7996_stock_winner(&votes);
+		if (s->active == old.active && s->txop == old.txop &&
+		    s->epoch == old.epoch && !old.error)
+			continue;
+		err = mt7996_mcu_set_tx(dev, vif, conf);
+		if (err) {
+			*s = old;
+			s->error = err;
+			s->failures++;
+			dev_warn_ratelimited(dev->mt76.dev,
+				"stock TXOP update failed (link %d): %d\n", i, err);
+		} else {
+			s->error = 0;
+			s->updates++;
+		}
+	}
+}
+
+static void mt7996_stock_work(struct wiphy *wiphy, struct wiphy_work *work)
+{
+	struct mt7996_dev *dev = container_of(work, struct mt7996_dev,
+					    stock_work.work);
+	struct mt7996_stock_scene scene = { .dev = dev };
+	struct mt7996_phy *phy;
+	bool running = false;
+
+	mt7996_for_each_phy(dev, phy)
+		running |= test_bit(MT76_STATE_RUNNING, &phy->mt76->state);
+
+	mutex_lock(&dev->mt76.mutex);
+	if (!dev->stock_interfaces)
+		goto out;
+	if (!test_bit(MT76_MCU_RESET, &dev->mphy.state) &&
+	    !test_bit(MT76_RESET, &dev->mphy.state) &&
+	    running) {
+		ieee80211_iterate_stations_atomic(mt76_hw(dev),
+						 mt7996_stock_collect, &scene);
+		ieee80211_iterate_active_interfaces_mtx(mt76_hw(dev), 0,
+						       mt7996_stock_apply, &scene);
+		/* Read-clear station statistics once per device, not per radio. */
+		mt7996_mcu_get_all_sta_info(&dev->phy, UNI_ALL_STA_TXRX_ADM_STAT);
+		mt7996_mcu_get_all_sta_info(&dev->phy, UNI_ALL_STA_TXRX_MSDU_COUNT);
+		mt7996_mcu_get_all_sta_info(&dev->phy, UNI_ALL_STA_TX_STAT);
+		dev->stock_polls++;
+	}
+	wiphy_delayed_work_queue(wiphy, &dev->stock_work, HZ);
+out:
+	mutex_unlock(&dev->mt76.mutex);
+}
+
+void mt7996_stock_init(struct mt7996_dev *dev)
+{
+	dev->stock_policy = of_machine_is_compatible("gemtek,xr1710g") ||
+		of_machine_is_compatible("gemtek,xr1710g-ubi");
+	spin_lock_init(&dev->stock_stats_lock);
+	wiphy_delayed_work_init(&dev->stock_work, mt7996_stock_work);
+}
+
+void mt7996_stock_add(struct mt7996_dev *dev, struct ieee80211_vif *vif)
+{
+	struct mt7996_vif *mvif = (struct mt7996_vif *)vif->drv_priv;
+	bool supported = vif->type == NL80211_IFTYPE_AP ||
+			 vif->type == NL80211_IFTYPE_STATION;
+	int i;
+
+	if (!dev->stock_policy)
+		return;
+	for (i = 0; i < IEEE80211_MLD_MAX_NUM_LINKS; i++) {
+		struct mt7996_stock_edca *s = &mvif->link_info[i].stock;
+
+		memset(s, 0, sizeof(*s));
+		s->enabled = supported;
+		s->active = supported;
+		s->txop = MT7996_STOCK_BURST;
+	}
+	if (!dev->stock_interfaces++)
+		wiphy_delayed_work_queue(mt76_hw(dev)->wiphy, &dev->stock_work, HZ);
+}
+
+void mt7996_stock_remove(struct mt7996_dev *dev)
+{
+	if (dev->stock_policy && dev->stock_interfaces && !--dev->stock_interfaces)
+		wiphy_delayed_work_cancel(mt76_hw(dev)->wiphy, &dev->stock_work);
+}
--- /dev/null
+++ b/mt7996/stock_policy.h
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+#ifndef __MT7996_STOCK_POLICY_H
+#define __MT7996_STOCK_POLICY_H
+
+/* Reconstructed host TXOP rules from XR1710G retail 5.1.1.12.
+ * TXOP units are 32 us; this is a device capability, not APTxop=0.
+ */
+#define MT7996_STOCK_BURST 187
+#define MT7996_STOCK_DEFAULT 0
+#define MT7996_STOCK_UL 1
+#define MT7996_STOCK_PRIORITIES 2
+
+struct mt7996_stock_vote {
+	u16 level[MT7996_STOCK_PRIORITIES];
+	u8 valid;
+};
+
+static inline void
+mt7996_stock_vote_set(struct mt7996_stock_vote *v, unsigned int priority,
+		     u16 level, bool enable)
+{
+	if (enable) {
+		v->valid |= 1U << priority;
+		v->level[priority] = level;
+	} else {
+		v->valid &= ~(1U << priority);
+	}
+}
+
+static inline u16 mt7996_stock_winner(const struct mt7996_stock_vote *v)
+{
+	int i;
+
+	for (i = MT7996_STOCK_PRIORITIES - 1; i >= 0; i--)
+		if (v->valid & (1U << i))
+			return v->level[i];
+	return 0;
+}
+
+static inline u64 mt7996_stock_ewma(u64 old, u64 sample)
+{
+	return old ? (old >> 1) + (sample >> 1) + (old & sample & 1) : sample;
+}
+
+static inline u16 mt7996_stock_mlo_txop(u64 bytes, u32 mpdu, bool mu)
+{
+	u64 len = mpdu ? bytes / mpdu : 0;
+
+	return len <= 700 && !mu ? 0 : MT7996_STOCK_BURST;
+}
+
+static inline bool mt7996_stock_ap_ul(u64 tx, u64 rx, u32 packets, bool mu)
+{
+	if (packets)
+		return rx / packets > 1000 && !mu;
+	return rx > tx * 10;
+}
+
+static inline bool mt7996_stock_sta_ul(u64 rx, u32 packets)
+{
+	return packets && rx / packets > 1000;
+}
+
+static inline bool mt7996_stock_high_rate(u64 avg_tx, u64 avg_rx)
+{
+	return ((avg_tx + avg_rx) >> 17) >= 500;
+}
+
+#endif
