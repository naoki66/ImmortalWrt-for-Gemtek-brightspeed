+/* rate is in 100 kbit/s units, as returned by cfg80211_calculate_bitrate. */
+static inline bool mt7996_stock_near_far_fast(u32 packets, u32 rate)
+{
+	return packets > 10 && rate >= 5200;
+}
+
+static inline bool mt7996_stock_near_far_slow(u32 packets, u32 rate)
+{
+	return packets > 10 && rate && rate <= 540;
+}
