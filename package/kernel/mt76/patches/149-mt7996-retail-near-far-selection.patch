+/* A second pass uses the completed WCID selection and per-link averages. */
+static void mt7996_stock_near_far(void *data, struct ieee80211_sta *sta)
+{
+	struct mt7996_stock_scene *scene = data;
+	struct mt7996_dev *dev = scene->dev;
+	struct mt7996_sta *msta = (struct mt7996_sta *)sta->drv_priv;
+	struct ieee80211_vif *vif;
+	int i;
+
+	vif = container_of((void *)msta->vif, struct ieee80211_vif, drv_priv);
+	if (vif->type != NL80211_IFTYPE_AP)
+		return;
+	for (i = 0; i < IEEE80211_MLD_MAX_NUM_LINKS; i++) {
+		struct mt7996_sta_link *sl = rcu_dereference(msta->link[i]);
+		struct mt7996_vif_link *vl = mt7996_vif_link(dev, vif, i);
+		struct mt7996_stock_band *b;
+		struct mt7996_phy *phy;
+		u32 rate;
+
+		if (!sl || !sl->connected || !vl)
+			continue;
+		phy = mt7996_vif_link_phy(vl);
+		if (!phy || phy->mt76->band_idx >= MT7996_MAX_RADIOS ||
+		    !phy->mt76->chandef.chan ||
+		    phy->mt76->chandef.chan->band != NL80211_BAND_5GHZ)
+			continue;
+		b = &scene->band[phy->mt76->band_idx];
+		if (b->selected != vif || b->current_link != i)
+			continue;
+		rate = cfg80211_calculate_bitrate(&sl->wcid.rate);
+		b->near_fast |= mt7996_stock_near_far_fast(sl->stock_avg.tx_msdu, rate);
+		b->near_slow |= mt7996_stock_near_far_slow(sl->stock_avg.tx_msdu, rate);
+	}
+}
