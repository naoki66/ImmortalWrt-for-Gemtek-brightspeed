--- a/mt7996/stock_policy.h
+++ b/mt7996/stock_policy.h
@@ -36,6 +36,17 @@
 		if (v->valid & (1U << i))
 			return v->level[i];
 	return 0;
+}
+
+/* Use paired firmware TX_STAT counters, never TX-free retry accounting.
+ * Reject an empty or inconsistent interval instead of manufacturing PER=0.
+ */
+static inline bool mt7996_stock_per(u64 attempts, u64 failed, u8 *per)
+{
+	if (!attempts || failed > attempts || attempts > U64_MAX / 100)
+		return false;
+	*per = div64_u64(failed * 100, attempts);
+	return true;
 }
 
