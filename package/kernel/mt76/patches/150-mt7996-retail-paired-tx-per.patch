-					le32_to_cpu(res->tx_stat[i].attempts), 0);
+					le32_to_cpu(res->tx_stat[i].attempts),
+					le32_to_cpu(res->tx_stat[i].failed));
 			break;
 		case UNI_ALL_STA_TXRX_ADM_STAT:
 			wlan_idx = le16_to_cpu(res->adm_stat[i].wlan_idx);
