@@ -47,6 +50,37 @@
 		return false;
 	*per = div64_u64(failed * 100, attempts);
 	return true;
+}
+
+/* Retail uses the previous interval's RX packet length and staged integer
+ * divisions. Keep TX/RX qualification separate; DL wins the main-flow tie.
+ */
+static inline u8 mt7996_stock_traffic(u64 tx, u64 rx, u32 last_rx_len)
+{
+	u64 tenth = (tx + rx) / 10;
+	u8 traffic = 0;
+
+	if (tx > tenth * 7)
+		traffic |= MT7996_STOCK_DL;
+	if (rx > tenth * (last_rx_len < 256 ? 5 : 7))
+		traffic |= MT7996_STOCK_UPLINK;
+	return traffic;
+}
+
+static inline bool mt7996_stock_mcli_qualified(u32 packets, u64 bytes,
+					       bool high_band)
+{
+	return packets > 10 || bytes > (high_band ? 12800 : 2560);
+}
+
+static inline bool mt7996_stock_mcli_txop(u16 clients, u8 main_mode, bool old)
+{
+	if (clients < 16 || main_mode == MT7996_STOCK_DL)
+		return false;
+	if (main_mode == MT7996_STOCK_UPLINK)
+		return true;
+	/* Retail retains its vote for an unclassified main flow. */
+	return old;
 }
 
 static inline u64 mt7996_stock_ewma(u64 old, u64 sample)
