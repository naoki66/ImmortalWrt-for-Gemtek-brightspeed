+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/* Independent reconstruction of the XR1710G retail TID0 BA index rule. */
+#include "mt7996.h"
+#include "stock_policy.h"
+
+void mt7996_stock_ba_update(struct mt7996_dev *dev, struct mt7996_sta *msta,
+			    struct mt7996_sta_link *sl, bool enabled, bool sample)
+{
+	struct mt7996_stock_ba *s = &sl->stock_ba;
+	u32 epoch = READ_ONCE(dev->stock_epoch);
+	u32 generation = msta->stock_ba_generation;
+	u32 addr, value, readback;
+	u8 hw_index, next, cap;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	if (!dev->stock_policy || !is_mt7996(&dev->mt76) ||
+	    test_bit(MT76_MCU_RESET, &dev->mphy.state) ||
+	    test_bit(MT76_RESET, &dev->mphy.state))
+		return;
+	if (s->epoch != epoch || s->generation != generation) {
+		memset(s, 0, sizeof(*s));
+		s->epoch = epoch;
+		s->generation = generation;
+	}
+	/* BA stop and WCID destruction invalidate saved hardware state. */
+	if (!sl->connected || !(msta->ba_tx_mask & BIT(0)) ||
+	    !msta->ba_tx[0].buf_size) {
+		s->valid = false;
+		s->changed = false;
+		return;
+	}
+	if (enabled && (!sample || !sl->stock_avg.tx_per_valid))
+		return;
+	if (!enabled && !s->valid)
+		return;
+
+	spin_lock_bh(&dev->wtbl_lock);
+	addr = mt7996_mac_wtbl_lmac_addr(dev, sl->wcid.idx, 7);
+	value = mt76_rr(dev, addr);
+	hw_index = value & GENMASK(3, 0);
+	/* 15 is not a valid BA size index; never turn a sentinel into a write. */
+	if (value == U32_MAX || hw_index == 15) {
+		dev->stock_ba_skips++;
+		goto out;
+	}
+	if (!s->valid) {
+		/* Use FW's initial per-link index as an authoritative upper bound.
+		 * This avoids inventing an index-to-window LUT or exceeding ADDBA.
+		 */
+		cap = msta->ba_tx[0].buf_size <= 64 ? 7 : 14;
+		if (hw_index > cap) {
+			dev->stock_ba_skips++;
+			goto out;
+		}
+		s->baseline = hw_index;
+		s->index = hw_index;
+		s->cap = min(hw_index, cap);
+		s->valid = true;
+	}
+	next = enabled ? mt7996_stock_ba_next(hw_index, s->cap,
+					    sl->stock_avg.tx_per) : s->baseline;
+	if (next != hw_index) {
+		/* Preserve every other TID's nibble in the shared DW7. */
+		mt76_wr(dev, addr, (value & ~GENMASK(3, 0)) | next);
+		readback = mt76_rr(dev, addr);
+		if (readback == U32_MAX || (readback & GENMASK(3, 0)) != next) {
+			dev->stock_ba_errors++;
+			goto out;
+		}
+		dev->stock_ba_updates++;
+	}
+	s->index = next;
+	s->changed = next != s->baseline;
+	if (!enabled)
+		s->valid = false;
+out:
+	spin_unlock_bh(&dev->wtbl_lock);
+}
