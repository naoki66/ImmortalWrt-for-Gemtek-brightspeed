 }
 
+/* Retail changes an index, not an ADDBA window count. The caller caps this
+ * by the firmware's initial negotiated index before invoking this rule.
+ */
+static inline u8 mt7996_stock_ba_next(u8 index, u8 cap, u8 per)
+{
+	index = index > cap ? cap : index;
+	if (per > 35) {
+		if (index > 7)
+			index >>= 1;
+		else if (index > 3)
+			index--;
+	} else if (per < 15 && index < cap) {
+		index++;
+	}
+	return index;
+}
+
 static inline u64 mt7996_stock_ewma(u64 old, u64 sample)
 {
 	return old ? (old >> 1) + (sample >> 1) + (old & sample & 1) : sample;
