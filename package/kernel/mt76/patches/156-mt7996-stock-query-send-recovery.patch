+/* Check host send results without pretending they identify async replies.
+ * After a failed read-clear query, discard its first successful query as a
+ * new counter baseline; only the following success is policy-eligible.
+ * This repairs known send failures, not arbitrary late firmware replies.
+ */
+static void mt7996_stock_query(struct mt7996_dev *dev)
+{
+	static const u16 tags[] = {
+		UNI_ALL_STA_TXRX_ADM_STAT,
+		UNI_ALL_STA_TXRX_MSDU_COUNT,
+		UNI_ALL_STA_TX_STAT,
+	};
+	u8 valid = 0;
+	int i, err;
+
+	for (i = 0; i < ARRAY_SIZE(tags); i++) {
+		err = mt7996_mcu_get_all_sta_info(&dev->phy, tags[i]);
+		dev->stock_query_attempts[i]++;
+		dev->stock_query_error[i] = err;
+		if (err) {
+			dev->stock_query_failures[i]++;
+			dev->stock_query_dirty |= BIT(i);
+		} else if (dev->stock_query_dirty & BIT(i)) {
+			dev->stock_query_dirty &= ~BIT(i);
+			dev->stock_query_rebases[i]++;
+		} else {
+			valid |= BIT(i);
+		}
+	}
+	dev->stock_query_valid = valid;
+	dev->stock_query_started = true;
+	dev->stock_polls++;
 }
 
