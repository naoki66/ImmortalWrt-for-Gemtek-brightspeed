From: Yanghan Ye <yyh94306@gmail.com>
Date: Tue, 14 Jul 2026 12:30:00 +1100
Subject: [PATCH] wifi: mt76: mt7996: pass operating mode to rate control

The STA_REC_RA TLV contains operating-mode fields, but mt7996 leaves them
zeroed when adding a station.  A zero op_vht_rx_nss describes one receive
spatial stream to firmware and can leave a negotiated 2x2 EHT320 station
using NSS1 rates under load.

Populate the capability bandwidth separately from the current operating
bandwidth and receive NSS.  Set the force flag only when the current mode is
more restrictive than the negotiated capabilities.  Later NSS or bandwidth
changes already cause mt7996_mcu_add_rate_ctrl() to rebuild this TLV.

Assisted-by: Codex:gpt-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 mt7996/mcu.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/mt7996/mcu.c b/mt7996/mcu.c
index 25c3d23538a1..a84bf7f42bc9 100644
--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -2475,9 +2475,11 @@ mt7996_mcu_sta_rate_ctrl_tlv(struct sk_buff *skb, struct mt7996_dev *dev,
 			     struct mt7996_vif_link *link)
 {
 #define INIT_RCPI 180
+	enum ieee80211_sta_rx_bandwidth cap_bw = ieee80211_link_sta_cap_bw(link_sta);
 	struct mt76_phy *mphy = mt76_vif_link_phy(&link->mt76);
 	struct cfg80211_bitrate_mask *mask = &link->bitrate_mask;
 	u32 cap = link_sta->sta->wme ? STA_CAP_WMM : 0;
+	u8 cap_nss = ieee80211_link_sta_cap_nss(link_sta);
 	struct cfg80211_chan_def *chandef;
 	struct sta_rec_ra_uni *ra;
 	enum nl80211_band band;
@@ -2500,11 +2502,17 @@ mt7996_mcu_sta_rate_ctrl_tlv(struct sk_buff *skb, struct mt7996_dev *dev,
 	ra->auto_rate = true;
 	ra->phy_mode = mt76_connac_get_phy_mode(mphy, vif, band, link_sta);
 	ra->channel = chandef->chan->hw_value;
-	ra->bw = (link_sta->bandwidth == IEEE80211_STA_RX_BW_320) ?
-		 CMD_CBW_320MHZ : link_sta->bandwidth;
-	ra->phy.bw = ra->bw;
+	ra->bw = mt76_connac_chan_bw(chandef);
+	ra->phy.bw = cap_bw == IEEE80211_STA_RX_BW_320 ?
+		     CMD_CBW_320MHZ : cap_bw;
 	ra->mmps_mode = mt7996_mcu_get_mmps_mode(link_sta->smps_mode);
 
+	ra->op_mode = cap_bw != link_sta->bandwidth ||
+		      cap_nss != link_sta->rx_nss;
+	ra->op_vht_chan_width = link_sta->bandwidth;
+	ra->op_vht_rx_nss = link_sta->rx_nss ? link_sta->rx_nss - 1 : 0;
+	ra->op_vht_rx_nss_type = 0;
+
 	if (supp_rate) {
 		supp_rate &= mask->control[band].legacy;
 		ra->rate_len = hweight32(supp_rate);
-- 
