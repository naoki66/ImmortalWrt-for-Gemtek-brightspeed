msgid "Factory Partition"
msgstr "设备序列号"

msgid "Factory Data"
msgstr "原厂数据"

msgid "Current device values"
msgstr "当前设备值"

msgid "WAN MAC"
msgstr "WAN MAC"

msgid "LAN MAC"
msgstr "LAN MAC"

msgid "U-Boot ethaddr"
msgstr "U-Boot ethaddr"

msgid "OUI"
msgstr "OUI"

msgid "Wi-Fi 2.4G BSSID"
msgstr "Wi-Fi 2.4G BSSID"

msgid "Wi-Fi 5G BSSID"
msgstr "Wi-Fi 5G BSSID"

msgid "Wi-Fi 6G BSSID"
msgstr "Wi-Fi 6G BSSID"

msgid "derived from WAN"
msgstr "由 WAN 派生"

msgid "derived from ethaddr"
msgstr "由 ethaddr 派生"

msgid "Save Factory Block"
msgstr "保存原厂数据块"

msgid "Reload"
msgstr "重新读取"

msgid "Writable"
msgstr "可写"

msgid "Yes"
msgstr "是"

msgid "No (read-only)"
msgstr "否（只读）"

msgid "Serial Number"
msgstr "序列号"

msgid "Same LAN should not have multiple devices with the same MAC."
msgstr "同一局域网内不应该有相同 MAC 的多台设备。"

msgid "Only WAN MAC, LAN MAC, U-Boot ethaddr and Serial Number are edited here. LAN defaults to WAN+1 and U-Boot ethaddr defaults to WAN (both editable). OUI derives from the U-Boot ethaddr."
msgstr "这里编辑 WAN MAC、LAN MAC、U-Boot ethaddr 和序列号。LAN 默认为 WAN+1、U-Boot ethaddr 默认为 WAN（均可手动修改），OUI 由 U-Boot ethaddr 自动派生。"

msgid "Compatibility note:"
msgstr "适配提示："

msgid "Writing requires the latest U-Boot and firmware."
msgstr "写入功能需要刷入新版 U-Boot 和新版固件。"

msgid "U-Boot download:"
msgstr "U-Boot 下载地址："

msgid "Firmware download:"
msgstr "新版固件下载地址："

msgid "After upgrading U-Boot and firmware, this page can modify the serial number and factory data correctly."
msgstr "刷入新版 U-Boot 和新版固件后，本页面才能正确修改序列号和原厂数据。"

msgid "Requires latest U-Boot and Firmware"
msgstr "需要刷入新版 U-Boot 和固件"

msgid "Write ready"
msgstr "可写"

msgid "All write targets are ready. You can save changes directly."
msgstr "所有写入目标均已就绪，可直接保存修改。"

msgid "Vendor partition is read-only."
msgstr "vendor 分区当前为只读。"

msgid "Vendor partition is read-only. Upgrade U-Boot and firmware before writing."
msgstr "vendor 分区当前为只读。请先升级 U-Boot 和固件后再写入。"

msgid "Write factory data + reboot"
msgstr "写入原厂数据并重启"

msgid "Write successful"
msgstr "写入成功"

msgid "(unchanged)"
msgstr "（未修改）"

msgid "Write & Reboot"
msgstr "写入并重启"

msgid "Factory data written successfully. The device will reboot automatically in a few seconds to apply the new configuration."
msgstr "原厂数据写入成功。设备将在几秒后自动重启以应用新配置。"

msgid "OK"
msgstr "确定"

msgid "Cancel"
msgstr "取消"

msgid "Could not read the factory partition: %s"
msgstr "无法读取原厂分区：%s"

msgid "One or more MAC fields are invalid (expected AA:BB:CC:DD:EE:FF)."
msgstr "一个或多个 MAC 格式无效（应为 AA:BB:CC:DD:EE:FF）。"

msgid "Failed to write factory block"
msgstr "写入原厂数据块失败"

msgid "Write failed"
msgstr "写入失败"

msgid "Reload failed: %s"
msgstr "重新读取失败：%s"

msgid "Reload failed"
msgstr "重新读取失败"

msgid "Reload render failed"
msgstr "重新渲染失败"
