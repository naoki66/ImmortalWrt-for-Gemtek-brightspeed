#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "U-Boot Recovery"
msgstr "U-Boot 恢复"

#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "Reboots the device into the U-Boot HTTP recovery environment using a one-shot trigger. The normal boot command is left unchanged."
msgstr "通过一次性触发器重启进入 U-Boot HTTP 恢复环境，正常启动命令保持不变。"

#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "The device is configured to boot into the U-Boot HTTP recovery environment. Re-flash the firmware from the U-Boot interface."
msgstr "设备已配置为进入 U-Boot HTTP 恢复环境，请通过 U-Boot 界面重新刷写固件。"

#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "U-Boot environment"
msgstr "U-Boot 环境"

#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "Available"
msgstr "可用"

#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "Unavailable"
msgstr "不可用"

#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "Reboot to U-Boot"
msgstr "重启进入 U-Boot"

#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "The device will reboot into the U-Boot HTTP recovery environment now. Continue?"
msgstr "设备即将重启进入 U-Boot HTTP 恢复环境，是否继续？"

#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "The U-Boot recovery reboot failed"
msgstr "重启进入 U-Boot 恢复模式失败"

#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "Rebooting…"
msgstr "正在重启…"

#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "Waiting for device..."
msgstr "正在等待设备…"

#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "Device unreachable! Still waiting for device..."
msgstr "设备无响应！仍在等待设备…"

#: htdocs/luci-static/resources/view/airoha_recovery/recovery.js
msgid "Cancel"
msgstr "取消"
