#!/bin/sh

# Airoha XR1710G U-Boot recovery RPC backend for LuCI.
# Arms the native one-shot recovery trigger without changing bootcmd.  U-Boot
# clears and saves the trigger before starting the HTTP recovery server.
#
# The chainloader U-Boot (http-uboot) stores its environment in the redundant
# UBI volumes "ubootenv" / "ubootenv2" (see the device tree
# target/linux/airoha/dts/an7581-xr1710g-ubi.dts).
#
# This backend deliberately does NOT use the shared /etc/fw_env.config:
# that file is also claimed by luci-app-airoha-factory, which installs a
# /dev/mtd0 entry, while uboot-envtools appends the two /dev/ubiX_Y entries.
# fw_env only honours the first two entries of a config file (get_config():
# "while (i < 2 && getline(...))"), so the resulting MTD + UBI mix makes
# fw_env_open() abort with "Incompatible flash types!" and every
# fw_printenv / fw_setenv call fail with "Error: environment not initialized".
# We therefore locate the UBI volumes at runtime and generate a private
# fw_env.config that is passed explicitly with -c on every invocation.

. /lib/functions.sh

RECOVERY_TRIGGER="recovery_trigger"

# Private runtime state (all under /tmp: writable, no sysupgrade leftovers).
ENV_CONF_DIR="/tmp/luci-airoha-recovery"
ENV_CONF="${ENV_CONF_DIR}/fw_env.config"
ENV_LOG="/tmp/airoha-recovery.log"
ENV_LOG_MAX=16384

# Layout of the XR1710G chainloader environment.  Keep in sync with
# package/boot/uboot-tools/uboot-envtools/files/airoha_an7581: the chainloader
# uses CONFIG_ENV_SIZE=0x4000 while a whole UBI LEB (0x1f000) is one sector.
ENV_OFFSET="0x0"
ENV_SIZE="0x4000"
ENV_SECSIZE="0x1f000"
ENV_NUMSEC="1"

# Reason code of the last failure, consumed by get_status().
ENV_REASON=""
# stderr of the last failed fw_setenv call.
ENV_ERROR=""

log_msg()
{
	local ts sz

	ts="$(date '+%H:%M:%S' 2>/dev/null)"
	[ -n "$ts" ] || ts="--:--:--"
	printf '%s %s\n' "$ts" "$*" >> "$ENV_LOG" 2>/dev/null

	# Keep the log from growing without bound across repeated RPC calls.
	sz="$(wc -c < "$ENV_LOG" 2>/dev/null)"
	sz="${sz##* }"
	case "$sz" in
		''|*[!0-9]*) sz=0 ;;
	esac
	if [ "$sz" -gt "$ENV_LOG_MAX" ]; then
		: > "$ENV_LOG" 2>/dev/null
		printf '%s %s\n' "$ts" "log truncated" >> "$ENV_LOG" 2>/dev/null
	fi
}

# Make a string safe to embed in a JSON string literal.
json_escape()
{
	printf '%s' "$1" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# Short, single-line hint taken from the tail of the log.
last_error_hint()
{
	local hint

	hint="$(tail -n 3 "$ENV_LOG" 2>/dev/null | tr '\n' ' ')"
	[ -n "$hint" ] || hint="no detail, see $ENV_LOG"
	json_escape "$hint"
}

is_known_board()
{
	[ "$(board_name 2>/dev/null)" = "gemtek,xr1710g-ubi" ]
}

# Print the character device node of a named UBI volume.
# $1 = volume name, e.g. "ubootenv".  Returns 1 when not found.
ubi_volume_dev()
{
	local volname="$1" dir base current devid major minor

	# A non-matching glob stays literal in ash; the -d test filters it out.
	for dir in /sys/class/ubi/ubi[0-9]*_[0-9]*; do
		[ -d "$dir" ] || continue
		[ -r "$dir/name" ] || continue
		read -r current < "$dir/name" 2>/dev/null || continue
		[ "$current" = "$volname" ] || continue

		base="${dir##*/}"

		# devtmpfs usually creates the node, but do it ourselves as a
		# fallback (same trick as ubi_mknod() in /lib/upgrade/nand.sh).
		if [ ! -c "/dev/$base" ] && [ -r "$dir/dev" ]; then
			read -r devid < "$dir/dev" 2>/dev/null && {
				major="${devid%%:*}"
				minor="${devid##*:}"
				if [ -n "$major" ] && [ -n "$minor" ]; then
					mknod "/dev/$base" c "$major" "$minor" 2>/dev/null
				fi
			}
		fi

		[ -c "/dev/$base" ] || return 1
		printf '/dev/%s\n' "$base"
		return 0
	done

	return 1
}

# Generate the private fw_env.config for the redundant UBI environment.
# Always regenerated: UBI minor numbers can change after a re-attach.
# Returns 0 on success; sets ENV_REASON on failure.
ensure_env_conf()
{
	local dev1 dev2 tmp

	dev1="$(ubi_volume_dev ubootenv)" || dev1=""
	dev2="$(ubi_volume_dev ubootenv2)" || dev2=""
	[ -n "$dev1" ] || dev1="$dev2"
	[ -n "$dev2" ] || dev2="$dev1"

	if [ -z "$dev1" ]; then
		ENV_REASON="ubootenv-volume-not-found"
		log_msg "ensure_env_conf: no UBI volume named ubootenv/ubootenv2"
		return 1
	fi

	if ! mkdir -p "$ENV_CONF_DIR" 2>/dev/null; then
		ENV_REASON="env-conf-dir-unwritable"
		log_msg "ensure_env_conf: cannot create $ENV_CONF_DIR"
		return 1
	fi

	tmp="${ENV_CONF}.tmp"
	{
		printf '# generated by luci-app-airoha-recovery, do not edit\n'
		printf '%s %s %s %s %s\n' \
			"$dev1" "$ENV_OFFSET" "$ENV_SIZE" "$ENV_SECSIZE" "$ENV_NUMSEC"
		# Only emit the second copy when there really are two volumes;
		# a duplicated device would confuse the redundant flag scheme.
		if [ "$dev1" != "$dev2" ]; then
			printf '%s %s %s %s %s\n' \
				"$dev2" "$ENV_OFFSET" "$ENV_SIZE" "$ENV_SECSIZE" "$ENV_NUMSEC"
		fi
	} > "$tmp" 2>/dev/null
	if [ $? != 0 ] || ! mv "$tmp" "$ENV_CONF" 2>/dev/null; then
		rm -f "$tmp"
		ENV_REASON="env-conf-write-failed"
		log_msg "ensure_env_conf: cannot write $ENV_CONF"
		return 1
	fi

	ENV_REASON=""
	log_msg "ensure_env_conf: $ENV_CONF -> $(tr '\n' ' ' < "$ENV_CONF")"
	return 0
}

# Read a variable.  Prints the value and returns 0 when it is defined and
# non-empty.  Anything else (undefined, empty, unreadable env) returns 1.
env_read()
{
	local var="$1" value rc

	value="$(/usr/sbin/fw_printenv -c "$ENV_CONF" -n "$var" 2>>"$ENV_LOG")"
	rc=$?
	# rc 1 == "variable not defined"; anything larger is a real failure.
	[ "$rc" -le 1 ] || log_msg "env_read $var: fw_printenv rc=$rc"
	[ "$rc" = 0 ] || return 1
	[ -n "$value" ] || return 1
	printf '%s\n' "$value"
}

# Returns 0 when the stored environment has a valid CRC.  A bad CRC means
# fw_env falls back to its compiled-in defaults, so every read result is
# meaningless and the environment must be populated from scratch.
env_crc_ok()
{
	local out

	out="$(/usr/sbin/fw_printenv -c "$ENV_CONF" 2>&1 >/dev/null)"
	case "$out" in
		*Bad\ CRC*|*environment\ not\ initialized*) return 1 ;;
	esac
	return 0
}

# Write a variable and verify it actually landed.
#   returns 0 = written and verified
#   returns 1 = fw_setenv failed outright
#   returns 2 = fw_setenv returned success but the read-back does not match
#               (fw_env_set() ignores fw_env_write() errors, so this happens)
# Sets ENV_ERROR to the captured stderr on failure.
env_write()
{
	local var="$1" value="$2" err rc stored

	err="$(/usr/sbin/fw_setenv -c "$ENV_CONF" "$var" "$value" 2>&1)"
	rc=$?
	if [ -n "$err" ]; then
		log_msg "fw_setenv $var (rc=$rc): $(printf '%s' "$err" | tr '\n' ' ')"
	fi

	if [ "$rc" != 0 ]; then
		ENV_ERROR="$err"
		return 1
	fi

	stored="$(/usr/sbin/fw_printenv -c "$ENV_CONF" -n "$var" 2>>"$ENV_LOG")"
	if [ "$stored" != "$value" ]; then
		ENV_ERROR="$var not written (read back '$stored', expected '$value')"
		log_msg "env_write $var: $ENV_ERROR"
		return 2
	fi

	ENV_ERROR=""
	return 0
}

boot_env_defaults()
{
	cat <<-'EOF'
		loadaddr 0x81800000
		bootconf config-1
		bootargs console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait rdinit=/sbin/init
		boot_ubi ubi part ubi && run boot_production
		boot_production run ubi_read_production && bootm ${loadaddr}#${bootconf}
		bootcmd run boot_ubi || http_recovery
		ubi_read_production ubi read ${loadaddr} fit
		recovery_addr 0x81800000
		recovery_mtd fit
		recovery_ubi_part ubi
		recovery_dev_uboot spi-nand0
		uboot_ofs 0x600000
		recovery_size_uboot 0x100000
	EOF
}

# Make sure the boot-critical variables exist so a normal boot still works
# after the one-shot recovery trigger has been consumed by U-Boot.
#
# Single deterministic path: walk the default table, write only what is
# missing, plus a targeted repair for the two values known to survive an
# erased environment as useless compile-time defaults.  A valid environment
# is never wholesale overwritten, so a customised bootcmd/bootargs is kept.
ensure_boot_env()
{
	local dflt line var value current rc=0 missing=0 repaired=0 crc_ok=1

	dflt="$(mktemp 2>/dev/null)" || {
		ENV_ERROR="cannot create temporary file"
		return 1
	}
	boot_env_defaults > "$dflt" 2>/dev/null

	env_crc_ok || {
		crc_ok=0
		log_msg "ensure_boot_env: environment CRC invalid, populating defaults"
	}

	while IFS= read -r line; do
		[ -n "$line" ] || continue
		var="${line%% *}"
		[ "$var" != "$line" ] || continue
		value="${line#* }"

		if [ "$crc_ok" = 1 ]; then
			current="$(env_read "$var")"
			if [ -n "$current" ]; then
				case "$var:$current" in
					loadaddr:0x0|bootcmd:run\ distro_bootcmd)
						log_msg "ensure_boot_env: repairing $var='$current'"
						;;
					*)
						continue
						;;
				esac
				repaired=$((repaired + 1))
			else
				missing=$((missing + 1))
			fi
		fi

		log_msg "ensure_boot_env: setting $var=$value"
		env_write "$var" "$value"
		case $? in
			0)
				;;
			2)
				log_msg "ensure_boot_env: $var not verified, continuing"
				;;
			*)
				rc=1
				break
				;;
		esac
	done < "$dflt"

	rm -f "$dflt"

	if [ "$rc" != 0 ]; then
		return 1
	fi

	log_msg "ensure_boot_env: ok (missing=$missing repaired=$repaired)"
	return 0
}

get_status()
{
	local supported=0 reason="unsupported-board" recovery_active=0
	local conf="" bootcmd="" env_state="unavailable"

	if ! is_known_board; then
		reason="unsupported-board"
	elif [ ! -x /usr/sbin/fw_setenv ] || [ ! -x /usr/sbin/fw_printenv ]; then
		reason="uboot-envtools-missing"
	elif ! ensure_env_conf; then
		reason="$ENV_REASON"
		log_msg "get_status: $reason"
	elif ! /usr/sbin/fw_printenv -c "$ENV_CONF" >/dev/null 2>>"$ENV_LOG"; then
		# A real probe: config file present but the env is unusable.
		reason="uboot-env-unreadable"
		env_state="unreadable"
		log_msg "get_status: fw_printenv failed on $ENV_CONF"
	else
		supported=1
		reason=""
		conf="$ENV_CONF"
		env_state="ok"

		if env_read "$RECOVERY_TRIGGER" >/dev/null 2>&1; then
			recovery_active=1
		fi

		# Recognize state left by older package releases as active too.
		bootcmd="$(env_read bootcmd)"
		case "$bootcmd" in
			*airoha_recovery_once*|http_recovery|run\ http_recovery)
				recovery_active=1
				;;
		esac
	fi

	printf '{"supported":%d,"reason":"%s","recovery_active":%d,"env_conf":"%s","env_state":"%s"}\n' \
		"$supported" "$(json_escape "$reason")" "$recovery_active" \
		"$(json_escape "$conf")" "$env_state"
}

reboot_to_uboot()
{
	local bootcmd

	if ! is_known_board; then
		printf '{"success":false,"error":"Unsupported board"}\n'
		return 0
	fi

	if [ ! -x /usr/sbin/fw_setenv ] || [ ! -x /usr/sbin/fw_printenv ]; then
		printf '{"success":false,"error":"uboot-envtools is not installed"}\n'
		return 0
	fi

	if ! ensure_env_conf; then
		printf '{"success":false,"error":"Cannot locate the U-Boot environment (%s)"}\n' \
			"$(json_escape "$ENV_REASON")"
		return 0
	fi

	if ! /usr/sbin/fw_printenv -c "$ENV_CONF" >/dev/null 2>>"$ENV_LOG"; then
		printf '{"success":false,"error":"Cannot read the U-Boot environment: %s"}\n' \
			"$(last_error_hint)"
		return 0
	fi

	if env_read "$RECOVERY_TRIGGER" >/dev/null 2>&1; then
		printf '{"success":false,"error":"Device is already configured to boot into U-Boot recovery"}\n'
		return 0
	fi

	bootcmd="$(env_read bootcmd)"
	case "$bootcmd" in
		*airoha_recovery_once*|http_recovery|run\ http_recovery)
			printf '{"success":false,"error":"Device is already configured to boot into U-Boot recovery"}\n'
			return 0
			;;
	esac

	if ! ensure_boot_env; then
		printf '{"success":false,"error":"Cannot ensure boot environment: %s"}\n' \
			"$(last_error_hint)"
		return 0
	fi

	# The trigger is what actually makes U-Boot start the recovery server,
	# so treat an unverified write as a hard failure and do not reboot.
	env_write "$RECOVERY_TRIGGER" 1
	case $? in
		0)
			;;
		*)
			printf '{"success":false,"error":"Cannot set recovery trigger: %s"}\n' \
				"$(last_error_hint)"
			return 0
			;;
	esac

	sync
	( sleep 1; /sbin/reboot ) >/dev/null 2>&1 </dev/null &
	printf '{"success":true}\n'
}

case "$1" in
	list)
		printf '{"getStatus":{},"rebootToUboot":{}}\n'
		;;
	call)
		case "$2" in
			getStatus)
				get_status
				;;
			rebootToUboot)
				reboot_to_uboot
				;;
			*)
				printf '{"error":"Invalid method"}\n'
				;;
		esac
		;;
esac
