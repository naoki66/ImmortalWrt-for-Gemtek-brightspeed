#!/bin/sh

# Airoha XR1710G U-Boot recovery RPC backend for LuCI.
# Reboots the device into the U-Boot HTTP recovery environment and restores
# the original bootcmd automatically on the next boot (see
# /etc/init.d/airoha_bootcmd_restore).

. /lib/functions.sh

BACKUP_ENV="luci_airoha_bootcmd_backup"
FLAG_ENV="airoha_recovery_once"

# One-shot trigger: on the next boot airoha_recovery_once clears itself
# (saveenv) and starts the HTTP recovery server.  Once the flag is gone the
# device falls through to the normal U-Boot boot flow, so a power-cycle or a
# recovery flash returns the device to normal booting instead of looping.
BOOTCMD_TRIGGER="run airoha_recovery_once; run boot_ubi || http_recovery"
FLAG_SCRIPT="setenv airoha_recovery_once; saveenv; http_recovery"
BOOTCMD_DEFAULT="run boot_ubi || http_recovery"

is_supported()
{
	[ "$(board_name 2>/dev/null)" = "gemtek,xr1710g-ubi" ] || return 1
	[ -x /usr/sbin/fw_setenv ] || return 1
	[ -x /usr/sbin/fw_printenv ] || return 1
	[ -r /etc/fw_env.config ] || return 1
	return 0
}

ensure_boot_env()
{
	local var value

	# Once a valid environment exists, U-Boot replaces its compiled-in
	# defaults with it.  Make sure the boot-critical variables are present
	# (e.g. after a fresh flash where the ubootenv volumes are empty) so a
	# normal boot still works after the one-shot recovery trigger is gone.
	while read -r var value; do
		if ! /usr/sbin/fw_printenv -n "$var" >/dev/null 2>&1; then
			/usr/sbin/fw_setenv "$var" "$value" || return 1
		fi
	done <<-EOF
		loadaddr 0x81800000
		bootconf config-1
		bootargs console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait
		boot_production run ubi_read_production && bootm \${loadaddr}#\${bootconf}
		ubi_read_production ubi read \${loadaddr} fit
	EOF
	return 0
}

get_status()
{
	local board="$(board_name 2>/dev/null)"
	local supported=0
	local reason="unsupported-board"
	local recovery_active=0
	local bootcmd=""

	if [ "$board" = "gemtek,xr1710g-ubi" ]; then
		if [ ! -x /usr/sbin/fw_setenv ] || [ ! -x /usr/sbin/fw_printenv ]; then
			reason="uboot-envtools-missing"
		elif [ ! -r /etc/fw_env.config ]; then
			reason="fw-env-config-missing"
		else
			supported=1
			reason=""
			bootcmd=$(/usr/sbin/fw_printenv -n bootcmd 2>/dev/null)
			/usr/sbin/fw_printenv -n recovery_trigger >/dev/null 2>&1 && \
				recovery_active=1
			case "$bootcmd" in
				*airoha_recovery_once*|http_recovery|run\ http_recovery)
					recovery_active=1
					;;
			esac
		fi
	fi

	printf '{"supported":%d,"reason":"%s","recovery_active":%d}\n' \
		"$supported" "$reason" "$recovery_active"
}

reboot_to_uboot()
{
	local current_bootcmd

	is_supported || {
		printf '{"success":false,"error":"U-Boot environment is unavailable"}\n'
		return 0
	}

	current_bootcmd=$(/usr/sbin/fw_printenv -n bootcmd 2>/dev/null) || {
		current_bootcmd="$BOOTCMD_DEFAULT"
	}

	case "$current_bootcmd" in
		*airoha_recovery_once*|http_recovery|run\ http_recovery)
			printf '{"success":false,"error":"Device is already configured to boot into U-Boot recovery"}\n'
			return 0
			;;
	esac

	if ! /usr/sbin/fw_printenv -n "$BACKUP_ENV" >/dev/null 2>&1; then
		/usr/sbin/fw_setenv "$BACKUP_ENV" "$current_bootcmd" || {
			printf '{"success":false,"error":"Cannot save current bootcmd"}\n'
			return 0
		}
	fi

	ensure_boot_env || {
		printf '{"success":false,"error":"Cannot ensure boot environment"}\n'
		return 0
	}

	/usr/sbin/fw_setenv "$FLAG_ENV" "$FLAG_SCRIPT" || {
		printf '{"success":false,"error":"Cannot set recovery trigger"}\n'
		return 0
	}

	/usr/sbin/fw_setenv bootcmd "$BOOTCMD_TRIGGER" || {
		printf '{"success":false,"error":"Cannot set U-Boot bootcmd"}\n'
		return 0
	}

	# Native one-shot trigger on U-Boot builds that support it
	# (board_late_init clears it and starts the HTTP recovery server).
	# The bootcmd trigger above is kept as a fallback for older U-Boot.
	/usr/sbin/fw_setenv recovery_trigger 1 || {
		printf '{"success":false,"error":"Cannot set recovery_trigger"}\n'
		return 0
	}

	sync
	( sleep 1; /sbin/reboot ) >/dev/null 2>&1 </dev/null &
	printf '{"success":true}\n'
}

case "$1" in
	list)
		printf '{"getStatus":{},"rebootToUboot":{}}\n'
		;;
	call)
		case "$2" in
			getStatus)
				get_status
				;;
			rebootToUboot)
				reboot_to_uboot
				;;
			*)
				printf '{"error":"Invalid method"}\n'
				;;
		esac
		;;
esac
