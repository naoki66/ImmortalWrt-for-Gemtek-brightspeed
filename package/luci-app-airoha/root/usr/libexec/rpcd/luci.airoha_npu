#!/bin/sh

# Airoha NPU Status RPC backend for LuCI (NPU + CPU + Offload)

. /lib/functions.sh

. /usr/libexec/rpcd/airoha-common.sh

_has_active_wan() {
	local wan_status up l3_device ipv4 ipv6

	wan_status=$(ubus call network.interface.wan status 2>/dev/null)
	[ -n "$wan_status" ] || return 1

	up=$(printf '%s' "$wan_status" | jsonfilter -e "@.up" 2>/dev/null)
	[ "$up" = "true" ] || return 1

	l3_device=$(printf '%s' "$wan_status" | jsonfilter -e "@.l3_device" 2>/dev/null)
	ipv4=$(printf '%s' "$wan_status" | jsonfilter -e "@['ipv4-address'][0].address" 2>/dev/null)
	ipv6=$(printf '%s' "$wan_status" | jsonfilter -e "@['ipv6-address'][0].address" 2>/dev/null)

	[ -n "$l3_device$ipv4$ipv6" ]
}

_bridge_offload_blocked() {
	_has_active_wan
}

_bridge_offload_block_error() {
	echo '{"error":"Bridge VLAN-tag / PPPoE-passthrough / AP-mode offload is disabled while WAN is active; use Hardware Flow Offload in router mode"}'
}

get_device_mode() {
	local dhcp_ignore

	if _has_active_wan; then
		printf '{"mode":"router","reason":"active_wan","bridge_offload_blocked":true}'
		return
	fi

	dhcp_ignore=$(uci get dhcp.lan.ignore 2>/dev/null)
	if [ "$dhcp_ignore" = "1" ]; then
		printf '{"mode":"ap","reason":"dhcp_disabled","bridge_offload_blocked":false}'
	else
		printf '{"mode":"ap","reason":"no_active_wan","bridge_offload_blocked":false}'
	fi
}

# Discover the active cpufreq policy dir (policy0 is not guaranteed to exist:
# a cpufreq node that fails to probe can leave the driver on another index).
_find_cpufreq_policy() {
	local dir
	for dir in /sys/devices/system/cpu/cpufreq/policy[0-9]* \
		/sys/devices/system/cpu/cpufreq; do
		[ -r "$dir/scaling_governor" ] || continue
		printf '%s' "$dir"
		return 0
	done
	return 1
}

# The Gemtek AN7581 profiles are validated through 1.4 GHz. Keep every CPU
# control path on the same ceiling even if a future kernel exposes experimental
# 1.45-1.6 GHz OPPs.
CPU_MAX_FREQ_KHZ=1400000

_cpu_frequencies() {
	local dir="$1" freq values

	values=$(cat "$dir/scaling_available_frequencies" 2>/dev/null)
	if [ -z "$values" ]; then
		values="$(cat "$dir/scaling_min_freq" 2>/dev/null) \
$(cat "$dir/scaling_max_freq" 2>/dev/null) \
$(cat "$dir/cpuinfo_min_freq" 2>/dev/null) \
$(cat "$dir/cpuinfo_max_freq" 2>/dev/null)"
	fi

	for freq in $values; do
		case "$freq" in ''|*[!0-9]*) continue ;; esac
		[ "$freq" -gt 0 ] 2>/dev/null || continue
		[ "$freq" -le "$CPU_MAX_FREQ_KHZ" ] 2>/dev/null || continue
		printf '%s\n' "$freq"
	done | sort -n -u
}

_cpu_freq_allowed() {
	local dir="$1" freq="$2"

	case "$freq" in ''|*[!0-9]*) return 1 ;; esac
	[ "$freq" -le "$CPU_MAX_FREQ_KHZ" ] 2>/dev/null || return 1
	_cpu_frequencies "$dir" | grep -qx "$freq"
}

get_status() {
	# === NPU Status ===
	local npu_ver=$(airoha_npu_version)

	local npu_loaded="false"
	local npu_device=""
	local npu_driver_path="/sys/bus/platform/drivers/airoha-npu"

	if [ -d "$npu_driver_path" ]; then
		npu_device=$(ls -1 "$npu_driver_path" 2>/dev/null | grep '\.npu$' | head -1)
		if [ -n "$npu_device" ]; then
			npu_loaded="true"
		fi
	fi

	local npu_clock=0
	if [ -f "/sys/kernel/debug/clk/npu/clk_rate" ]; then
		npu_clock=$(cat /sys/kernel/debug/clk/npu/clk_rate 2>/dev/null || echo 0)
	fi

	local npu_cores=$(grep -c "airoha-npu-wdt" /proc/interrupts 2>/dev/null)

	local offload_bound=$(cat /sys/kernel/debug/ppe/bind 2>/dev/null | grep -c "^[0-9a-fA-F]")
	local offload_total=$(cat /sys/kernel/debug/ppe/entries 2>/dev/null | grep -c "^[0-9a-fA-F]")

	# NPU memory regions don't change after boot — cache to avoid slow dmesg on every poll
	local mem_cache="/tmp/npu-mem-regions.json"
	local regions="[]"
	if [ -f "$mem_cache" ]; then
		regions=$(cat "$mem_cache" 2>/dev/null)
	else
		local mem_info=$(dmesg 2>/dev/null | grep "reserved mem.*npu" | head -4)
		if [ -n "$mem_info" ]; then
			regions=$(echo "$mem_info" | awk '
			BEGIN { printf "[" }
			{
				if (NR > 1) printf ","
				match($0, /0x[0-9a-fA-F]+\.\.0x[0-9a-fA-F]+/)
				range = substr($0, RSTART, RLENGTH)
				split(range, a, "\\.\\.")
				match($0, /\([0-9]+ [KMG]i?B\)/)
				size = substr($0, RSTART+1, RLENGTH-2)
				match($0, /non-reusable [^ ]+/)
				name = substr($0, RSTART+13)
				gsub(/@.*/, "", name)
				printf "{\"name\":\"%s\",\"start\":\"%s\",\"end\":\"%s\",\"size\":\"%s\"}", name, a[1], a[2], size
			}
			END { printf "]" }
			')
		fi
		echo "$regions" > "$mem_cache" 2>/dev/null
	fi

	# === CPU Frequency Status ===
	local cpufreq_path cpu_cpufreq_available=0 cpu_cpufreq_reason="no_cpufreq"
	local cpu_cur_freq=0
	local cpu_hw_freq=0
	local cpu_governor="unknown"
	local cpu_avail_governors=""
	local cpu_min_freq=0
	local cpu_max_freq=0
	local cpu_avail_freqs=""

	cpufreq_path=$(_find_cpufreq_policy)
	if [ -n "$cpufreq_path" ]; then
		cpu_cpufreq_available=1
		cpu_cur_freq=$(cat "$cpufreq_path/scaling_cur_freq" 2>/dev/null || echo 0)
		cpu_hw_freq=$(cat "$cpufreq_path/cpuinfo_cur_freq" 2>/dev/null || echo 0)
		cpu_governor=$(cat "$cpufreq_path/scaling_governor" 2>/dev/null || echo "unknown")
		cpu_avail_governors=$(cat "$cpufreq_path/scaling_available_governors" 2>/dev/null || echo "")
		cpu_min_freq=$(cat "$cpufreq_path/scaling_min_freq" 2>/dev/null || echo 0)
		cpu_max_freq=$(cat "$cpufreq_path/scaling_max_freq" 2>/dev/null || echo 0)
		cpu_avail_freqs=$(_cpu_frequencies "$cpufreq_path" | tr '\n' ' ' | sed 's/ $//')

		if [ -z "$cpu_avail_governors" ]; then
			cpu_cpufreq_reason="no_governors"
		else
			if [ -n "$cpu_avail_freqs" ]; then
				cpu_cpufreq_reason="ok"
			else
				cpu_cpufreq_reason="no_frequencies"
			fi
		fi
	fi

	local has_pon
	has_pon=$(airoha_pon_present)

	# Count online CPUs
	local cpu_count=0
	if [ -d "/sys/devices/system/cpu" ]; then
		cpu_count=$(ls -d /sys/devices/system/cpu/cpu[0-9]* 2>/dev/null | wc -l)
	fi

	# CPU architecture info
	local cpu_arch=""
	if [ -f "/proc/cpuinfo" ]; then
		cpu_arch=$(grep -m1 "model name" /proc/cpuinfo | awk -F': ' '{print $2}')
	fi

	# CPU temperature
	local cpu_temp="N/A"
	for zone in /sys/class/thermal/thermal_zone*; do
		if [ -f "$zone/temp" ] && [ -f "$zone/type" ]; then
			local type=$(cat "$zone/type")
			if echo "$type" | grep -qiE 'cpu|airoha|en7581|an7581'; then
				cpu_temp=$(cat "$zone/temp" 2>/dev/null)
				if [ -n "$cpu_temp" ] && [ "$cpu_temp" -gt 0 ]; then
					cpu_temp="$((cpu_temp/1000)).$((cpu_temp%1000/100))°C"
				else
					cpu_temp="N/A"
				fi
				break
			fi
		fi
	done

	# SoC model — read the first device-tree compatible string instead of
	# hardcoding one board's label, so the UI follows whatever it boots on.
	local soc_compat=""
	local dt
	for dt in /proc/device-tree/compatible /sys/firmware/devicetree/base/compatible; do
		if [ -f "$dt" ]; then
			soc_compat=$(tr '\000' '\n' < "$dt" 2>/dev/null | sed -n '1p')
			[ -n "$soc_compat" ] && break
		fi
	done
	[ -n "$soc_compat" ] || soc_compat="Unknown"

	printf '{"npu_version":"%s","npu_loaded":%s,"npu_device":"%s","npu_clock":%d,"npu_cores":%d,"offload_bound":%d,"offload_total":%d,"memory_regions":%s,"cpu_cur_freq":%d,"cpu_hw_freq":%d,"cpu_governor":"%s","cpu_avail_governors":"%s","cpu_min_freq":%d,"cpu_max_freq":%d,"cpu_avail_freqs":"%s","cpu_cpufreq_available":%d,"cpu_cpufreq_reason":"%s","cpu_count":%d,"cpu_arch":"%s","cpu_temp":"%s","soc_compat":"%s","has_pon":%d}' \
		"${npu_ver:-Unknown}" "$npu_loaded" "${npu_device:-}" "${npu_clock:-0}" "${npu_cores:-0}" "${offload_bound:-0}" "${offload_total:-0}" "$regions" \
		"${cpu_cur_freq:-0}" "${cpu_hw_freq:-0}" "${cpu_governor:-unknown}" "${cpu_avail_governors:-}" "${cpu_min_freq:-0}" "${cpu_max_freq:-0}" "${cpu_avail_freqs:-}" "${cpu_cpufreq_available:-0}" "${cpu_cpufreq_reason:-no_cpufreq}" "${cpu_count:-0}" \
		"${cpu_arch:-}" "${cpu_temp:-N/A}" "${soc_compat:-}" "${has_pon:-0}"
}

get_topology() {
	airoha_port_topology_json
}

get_ppe_entries() {
	local entries_file="/sys/kernel/debug/ppe/entries"
	local snapshot="/tmp/luci-airoha-npu.ppe.$$"

	if [ ! -r "$entries_file" ] ||
	   ! _run_with_deadline 2 ppe cp "$entries_file" "$snapshot"; then
		rm -f "$snapshot"
		echo '{"available":false,"entries":[],"total":0}'
		return
	fi

	airoha_ppe_parse "$snapshot" "" 1024
	rm -f "$snapshot"
}

get_token_info() {
	local token_file="/sys/kernel/debug/ieee80211/phy0/mt76/token_info"
	local has_wifi; has_wifi=$(airoha_has_wifi)

	# Gather per-band WiFi station stats (count, retries, failures)
	local sta_json="" band
	for band in 0 1 2; do
		local stats=$(
			for iface in $(iw dev 2>/dev/null | awk '/Interface phy0\.'$band'-/{print $2}'); do
				iw dev "$iface" station dump 2>/dev/null
			done | awk '
			BEGIN { n=0; tp=0; tr=0 }
			/^Station/ { n++ }
			/tx packets:/ { tp += $3 }
			/tx retries:/ { tr += $3 }
			END { printf "%d %d %d", n, tp, tr }'
		)
		set -- $stats
		[ -n "$sta_json" ] && sta_json="${sta_json},"
		sta_json="${sta_json}{\"band\":${band},\"count\":${1:-0},\"tx_packets\":${2:-0},\"tx_retries\":${3:-0}}"
	done

	if [ ! -f "$token_file" ]; then
		printf '{"token_count":0,"token_size":0,"npu_active":false,"tx_queues":[],"station_counts":[%s],"has_wifi":%s}' "$sta_json" "$has_wifi"
		return
	fi

	awk -v stations="$sta_json" -v hw="$has_wifi" '
	BEGIN {
		tc=0; ts=0; npu=0
		tq_n=0
	}
	/^  token_count:/ { tc=$2+0; ts=$4+0 }
	/status:.*active/ { npu=1 }
	/band [0-9]/ {
		gsub(/\|/, " ")
		for(i=1;i<=NF;i++) {
			if($i=="band") tq_band[tq_n]=$(i+1)+0
			if($i=="npu" || $i=="dma") tq_type[tq_n]=$i
		}
		cnt=0
		for(i=1;i<=NF;i++) {
			if($i ~ /^[0-9]+$/ && $(i-1)!="band") {
				tq_v[tq_n,cnt++]=$i+0
			}
		}
		tq_n++
	}
	END {
		printf "{\"token_count\":%d,\"token_size\":%d,\"npu_active\":%s,\"tx_queues\":[", \
			tc, ts, (npu?"true":"false")

		for(i=0;i<tq_n;i++) {
			if(i>0) printf ","
			printf "{\"band\":%d,\"type\":\"%s\",\"ndesc\":%d,\"queued\":%d,\"head\":%d,\"tail\":%d}", \
				tq_band[i], tq_type[i], tq_v[i,0], tq_v[i,1], tq_v[i,2], tq_v[i,3]
		}

		printf "],\"station_counts\":[%s],\"has_wifi\":%s}", stations, hw
	}
	' "$token_file" 2>/dev/null || printf '{"token_count":0,"token_size":0,"npu_active":false,"tx_queues":[],"station_counts":[%s],"has_wifi":%s}' "$sta_json" "$has_wifi"
}

# Persist CPU governor / max_freq to UCI so the choice survives a reboot.
_uci_persist_cpu() {
	uci -q get airoha_npu.@cpu[0] >/dev/null 2>&1 || uci set airoha_npu.@cpu[0]=cpu
	[ -n "$1" ] && uci set airoha_npu.@cpu[0].governor="$1"
	[ -n "$2" ] && uci set airoha_npu.@cpu[0].max_freq="$2"
	uci commit airoha_npu
}

set_governor() {
	local governor cpufreq_path avail
	governor=$(echo "$1" | jsonfilter -e "@.governor" 2>/dev/null)

	if [ -z "$governor" ]; then
		echo '{"error":"missing governor parameter"}'
		return
	fi

	cpufreq_path=$(_find_cpufreq_policy)
	[ -n "$cpufreq_path" ] || {
		echo '{"error":"CPU frequency scaling is not available"}'
		return
	}

	# Validate governor is available
	avail=$(cat "$cpufreq_path/scaling_available_governors" 2>/dev/null)
	if ! echo "$avail" | grep -qw "$governor"; then
		printf '{"error":"invalid governor: %s"}' "$governor"
		return
	fi

	echo "$governor" > "$cpufreq_path/scaling_governor" 2>/dev/null
	if [ $? -eq 0 ]; then
		_uci_persist_cpu "$governor"
		printf '{"result":"ok","governor":"%s"}' "$governor"
	else
		echo '{"error":"failed to set governor"}'
	fi
}

set_max_freq() {
	local freq cpufreq_path
	freq=$(echo "$1" | jsonfilter -e "@.freq" 2>/dev/null)

	if [ -z "$freq" ]; then
		echo '{"error":"missing freq parameter"}'
		return
	fi

	cpufreq_path=$(_find_cpufreq_policy)
	[ -n "$cpufreq_path" ] || {
		echo '{"error":"CPU frequency scaling is not available"}'
		return
	}

	# Accept only a kernel-advertised frequency in the validated range.
	if ! _cpu_freq_allowed "$cpufreq_path" "$freq"; then
		printf '{"error":"invalid frequency: %s"}' "$freq"
		return
	fi

	echo "$freq" > "$cpufreq_path/scaling_max_freq" 2>/dev/null
	if [ $? -eq 0 ]; then
		_uci_persist_cpu "" "$freq"
		printf '{"result":"ok","freq":%d}' "$freq"
	else
		echo '{"error":"failed to set max frequency"}'
	fi
}

# Combined persistence RPC: apply both governor and max_freq, then persist to UCI
# in a single transaction so the choice survives a reboot. Either field may be omitted.
set_cpu_settings() {
	local governor freq cpufreq_path avail_g
	governor=$(echo "$1" | jsonfilter -e "@.governor" 2>/dev/null)
	freq=$(echo "$1" | jsonfilter -e "@.freq" 2>/dev/null)

	if [ -z "$governor" ] && [ -z "$freq" ]; then
		echo '{"error":"missing governor and freq parameters"}'
		return
	fi

	cpufreq_path=$(_find_cpufreq_policy)
	[ -n "$cpufreq_path" ] || {
		echo '{"error":"CPU frequency scaling is not available"}'
		return
	}

	if [ -n "$freq" ] && ! _cpu_freq_allowed "$cpufreq_path" "$freq"; then
		printf '{"error":"invalid frequency: %s"}' "$freq"
		return
	fi

	if [ -n "$governor" ]; then
		avail_g=$(cat "$cpufreq_path/scaling_available_governors" 2>/dev/null)
		if ! echo "$avail_g" | grep -qw "$governor"; then
			printf '{"error":"invalid governor: %s"}' "$governor"
			return
		fi
	fi

	# Raise the limit before switching governor. In particular, performance
	# otherwise remains pinned to the old (lower) ceiling.
	if [ -n "$freq" ]; then
		echo "$freq" > "$cpufreq_path/scaling_max_freq" 2>/dev/null
		if [ $? -ne 0 ]; then
			echo '{"error":"failed to set max frequency"}'
			return
		fi
	fi

	if [ -n "$governor" ]; then
		echo "$governor" > "$cpufreq_path/scaling_governor" 2>/dev/null
		if [ $? -ne 0 ]; then
			echo '{"error":"failed to set governor"}'
			return
		fi
	fi

	_uci_persist_cpu "$governor" "$freq"

	local out='{"result":"ok"'
	[ -n "$governor" ] && out="$out,\"governor\":\"$governor\""
	[ -n "$freq" ] && out="$out,\"freq\":$freq"
	printf '%s}' "$out"
}

get_vlan_offload() {
	airoha_bridge_offload_supported || {
		echo '{"supported":false,"enabled":0}'
		return
	}
	local tagged indev
	# Mirror of this pair's owner semantics (set_vlan_offload): the two keys
	# are one unit, so enabled is reported only when BOTH read 1.
	tagged=$(cat /proc/sys/net/bridge/bridge-nf-filter-vlan-tagged 2>/dev/null)
	indev=$(cat /proc/sys/net/bridge/bridge-nf-pass-vlan-input-dev 2>/dev/null)
	if [ "$tagged" = "1" ] && [ "$indev" = "1" ]; then
		printf '{"enabled":1}'
	else
		printf '{"enabled":0}'
	fi
}

set_vlan_offload() {
	airoha_bridge_offload_supported || {
		echo '{"error":"VLAN offload is not supported on XG2010G"}'
		return
	}
	local enabled
	enabled=$(echo "$1" | jsonfilter -e "@.enabled" 2>/dev/null)
	[ -z "$enabled" ] && enabled="0"
	if [ "$enabled" != "0" ] && [ "$enabled" != "1" ]; then
		echo '{"error":"enabled must be 0 or 1"}'
		return
	fi
	if [ "$enabled" = "1" ] && _bridge_offload_blocked; then
		_bridge_offload_block_error
		return
	fi
	# Owner of the VLAN passthrough pair (bridge-nf-filter-vlan-tagged +
	# bridge-nf-pass-vlan-input-dev). BOTH keys are written unconditionally
	# from "$enabled": VLAN filtering can be turned on AFTER this switch, and
	# the pair must already be in place when that happens - conditioning on a
	# VLAN-filtering bridge existing left a stale =0 snapshot behind on exactly
	# that path. br_netfilter is loaded so the switch can bootstrap itself
	# without AP-mode acceleration.
	modprobe br_netfilter 2>/dev/null
	if ! echo "$enabled" > /proc/sys/net/bridge/bridge-nf-filter-vlan-tagged 2>/dev/null ||
	   ! echo "$enabled" > /proc/sys/net/bridge/bridge-nf-pass-vlan-input-dev 2>/dev/null; then
		echo '{"error":"failed - bridge module may not be loaded"}'
		return
	fi
	{
		echo "net.bridge.bridge-nf-filter-vlan-tagged=$enabled"
		echo "net.bridge.bridge-nf-pass-vlan-input-dev=$enabled"
	} > /etc/sysctl.d/14-vlan-offload.conf
	printf '{"result":"ok","enabled":%d}' "$enabled"
}

get_pppoe_offload() {
	local val
	# Use bridge-nf-filter-pppoe-tagged sysctl.
	val=$(cat /proc/sys/net/bridge/bridge-nf-filter-pppoe-tagged 2>/dev/null)
	printf '{"enabled":%d}' "${val:-0}"
}

set_pppoe_offload() {
	airoha_bridge_offload_supported || {
		echo '{"error":"Bridge offload is not supported on XG2010G"}'
		return
	}
	local enabled
	enabled=$(echo "$1" | jsonfilter -e "@.enabled" 2>/dev/null)
	[ -z "$enabled" ] && enabled="0"
	if [ "$enabled" != "0" ] && [ "$enabled" != "1" ]; then
		echo '{"error":"enabled must be 0 or 1"}'
		return
	fi
	if [ "$enabled" = "1" ] && _bridge_offload_blocked; then
		_bridge_offload_block_error
		return
	fi
	# Load bridge module if needed and set sysctl.
	if [ "$enabled" = "1" ]; then
		modprobe bridge 2>/dev/null
	fi
	if ! echo "$enabled" > /proc/sys/net/bridge/bridge-nf-filter-pppoe-tagged 2>/dev/null; then
		echo '{"error":"failed - bridge module may not be loaded"}'
		return
	fi
	echo "net.bridge.bridge-nf-filter-pppoe-tagged=$enabled" > /etc/sysctl.d/13-pppoe-offload.conf
	# Also load PPTP conntrack helper for PPPoE offload support
	if [ "$enabled" = "1" ]; then
		modprobe nf_conntrack_pptp 2>/dev/null
		modprobe nf_nat_pptp 2>/dev/null
	fi
	printf '{"result":"ok","enabled":%d}' "$enabled"
}

get_flow_offload() {
	# Check the persisted UCI configuration.
	local fo foh
	fo=$(uci get firewall.@defaults[0].flow_offloading 2>/dev/null)
	foh=$(uci get firewall.@defaults[0].flow_offloading_hw 2>/dev/null)
	if [ "$fo" = "1" ] && [ "$foh" = "1" ]; then
		printf '{"enabled":1}'
	else
		printf '{"enabled":0}'
	fi
}

set_flow_offload() {
	local enabled
	enabled=$(echo "$1" | jsonfilter -e "@.enabled" 2>/dev/null)
	[ -z "$enabled" ] && enabled="0"
	if [ "$enabled" != "0" ] && [ "$enabled" != "1" ]; then
		echo '{"error":"enabled must be 0 or 1"}'
		return
	fi
	# Set both flow_offloading and flow_offloading_hw.
	uci set firewall.@defaults[0].flow_offloading="$enabled" 2>/dev/null
	uci set firewall.@defaults[0].flow_offloading_hw="$enabled" 2>/dev/null
	uci commit firewall 2>/dev/null
	# Restart firewall to apply changes
	/etc/init.d/firewall restart 2>/dev/null &
	printf '{"result":"ok","enabled":%d}' "$enabled"
}

get_apmode_offload() {
	airoha_bridge_offload_supported || {
		echo '{"supported":false,"enabled":0}'
		return
	}
	local ipt ip6t arp filter_pppoe_tagged

	# Mirrors set_apmode_offload(). Keep these four keys synchronized:
	#   bridge-nf-call-iptables, bridge-nf-call-ip6tables,
	#   bridge-nf-call-arptables, bridge-nf-filter-pppoe-tagged
	# Mirrors set_apmode_offload() exactly. The VLAN passthrough pair is NOT
	# part of this verdict - it is owned by set/get_vlan_offload, and its
	# state must never influence the AP-mode readout (a stale or disabled VLAN
	# pair would otherwise drag the AP-mode switch down with it).
	ipt=$(cat /proc/sys/net/bridge/bridge-nf-call-iptables 2>/dev/null)
	ip6t=$(cat /proc/sys/net/bridge/bridge-nf-call-ip6tables 2>/dev/null)
	arp=$(cat /proc/sys/net/bridge/bridge-nf-call-arptables 2>/dev/null)
	filter_pppoe_tagged=$(cat /proc/sys/net/bridge/bridge-nf-filter-pppoe-tagged 2>/dev/null)

	if [ "$ipt" = "1" ] && [ "$ip6t" = "1" ] && [ "$arp" = "1" ] && \
	   [ "$filter_pppoe_tagged" = "1" ]; then
		printf '{"enabled":1}'
	else
		printf '{"enabled":0}'
	fi
}

set_apmode_offload() {
	airoha_bridge_offload_supported || {
		echo '{"error":"AP mode acceleration is not supported on XG2010G"}'
		return
	}
	local enabled

	enabled=$(echo "$1" | jsonfilter -e "@.enabled" 2>/dev/null)
	[ -z "$enabled" ] && enabled="0"
	if [ "$enabled" != "0" ] && [ "$enabled" != "1" ]; then
		echo '{"error":"enabled must be 0 or 1"}'
		return
	fi
	if [ "$enabled" = "1" ] && _bridge_offload_blocked; then
		_bridge_offload_block_error
		return
	fi

	modprobe br_netfilter 2>/dev/null

	# AP-mode acceleration owns exactly FOUR unconditional keys: the three
	# bridge-nf-call-* passthroughs plus PPPoE passthrough, all written from
	# "$enabled". VLAN passthrough deliberately is NOT here: VLAN filtering can
	# be enabled after this switch, and a vlan_options snapshot taken now would
	# go stale (=0) on the next reboot. The VLAN pair belongs to
	# set_vlan_offload instead.
	if ! echo "$enabled" > /proc/sys/net/bridge/bridge-nf-call-iptables 2>/dev/null ||
	   ! echo "$enabled" > /proc/sys/net/bridge/bridge-nf-call-ip6tables 2>/dev/null ||
	   ! echo "$enabled" > /proc/sys/net/bridge/bridge-nf-call-arptables 2>/dev/null ||
	   ! echo "$enabled" > /proc/sys/net/bridge/bridge-nf-filter-pppoe-tagged 2>/dev/null; then
		echo '{"error":"failed to configure bridge netfilter"}'
		return
	fi

	if [ "$enabled" = "1" ]; then
		modprobe nf_conntrack_pptp 2>/dev/null
		modprobe nf_nat_pptp 2>/dev/null
		{
			echo 'net.bridge.bridge-nf-call-iptables=1'
			echo 'net.bridge.bridge-nf-call-ip6tables=1'
			echo 'net.bridge.bridge-nf-call-arptables=1'
			echo "net.bridge.bridge-nf-filter-pppoe-tagged=$enabled"
		} > /etc/sysctl.d/12-apmode-offload.conf
	else
		rm -f /etc/sysctl.d/12-apmode-offload.conf 2>/dev/null
	fi

	printf '{"result":"ok","enabled":%d}' "$enabled"
}

case "$1" in
	list)
		echo '{"getStatus":{},"getTopology":{},"getPpeEntries":{},"getTokenInfo":{},"getWifiStats":{},"getVlanOffload":{},"setVlanOffload":{"enabled":"int"},"getPppoeOffload":{},"setPppoeOffload":{"enabled":"int"},"getFlowOffload":{},"setFlowOffload":{"enabled":"int"},"getApModeOffload":{},"setApModeOffload":{"enabled":"int"},"getDeviceMode":{},"setGovernor":{"governor":"str"},"setMaxFreq":{"freq":"int"},"setCpuSettings":{"governor":"str","freq":"int"}}'
		;;
	call)
		case "$2" in
			getStatus)
				get_status
				;;
			getTopology)
				get_topology
				;;
			getDeviceMode)
				get_device_mode
				;;
			getPpeEntries)
				get_ppe_entries
				;;
			getTokenInfo)
				get_token_info
				;;
			setGovernor)
				read input
				set_governor "$input"
				;;
			setMaxFreq)
				read input
				set_max_freq "$input"
				;;
			setCpuSettings)
				read input
				set_cpu_settings "$input"
				;;
			getWifiStats)
				airoha_wifi_stats_json
				;;
			getVlanOffload)
				get_vlan_offload
				;;
			setVlanOffload)
				read input
				set_vlan_offload "$input"
				;;
			getPppoeOffload)
				get_pppoe_offload
				;;
			setPppoeOffload)
				read input
				set_pppoe_offload "$input"
				;;
			getFlowOffload)
				get_flow_offload
				;;
			setFlowOffload)
				read input
				set_flow_offload "$input"
				;;
			getApModeOffload)
				get_apmode_offload
				;;
			setApModeOffload)
				read input
				set_apmode_offload "$input"
				;;
			*)
				echo '{"error":"Invalid method"}'
				;;
		esac
		;;
esac
