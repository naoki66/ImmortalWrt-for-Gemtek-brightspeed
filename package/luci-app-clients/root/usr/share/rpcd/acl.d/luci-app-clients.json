{
	"luci-app-clients": {
		"description": "Grant access to the client list, its traffic counters, the wireless association history and the DNS query archive",
		"read": {
			"cgi-io": [ "exec" ],
			"uci": [ "dhcp", "clients" ],
			"ubus": {
				"file": [ "read", "exec" ],
				"network.device": [ "status" ],
				"luci-rpc": [ "getDHCPLeases", "getHostHints" ]
			},
			"file": {
				"/usr/libexec/clients-probe": [ "exec" ],
				"/usr/libexec/clients-probe nlbw": [ "exec" ],
				"/usr/libexec/clients-probe nlbw *": [ "exec" ],
				"/usr/libexec/clients-probe read *": [ "exec" ],
				"/usr/libexec/clients-probe status *": [ "exec" ],
				"/usr/libexec/clients-dns read": [ "exec" ],
				"/usr/libexec/clients-dns status": [ "exec" ],
				"/tmp/clients-history.json": [ "read" ],
				"/tmp/clients-dns.json": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"file": [ "exec" ]
			},
			"file": {
				"/usr/libexec/clients-probe clear *": [ "exec" ],
				"/usr/libexec/clients-probe collect *": [ "exec" ],
				"/usr/libexec/clients-dns clear": [ "exec" ],
				"/usr/libexec/clients-dns collect": [ "exec" ]
			}
		}
	}
}
