msgstr "保存中…"

msgid "Scan LAN for devices"
msgstr "扫描局域网设备"

msgid "Scan failed"
msgstr "扫描失败"

msgid "Scanning…"
msgstr "扫描中…"

msgid "Score"
msgstr "得分"

msgid "Score difference threshold"
msgstr "分数差阈值"

msgid "Scoring per band"
msgstr "每个频段的评分"

msgid "See who is connected to each AP and who is in whose range:"
msgstr "看各 AP 上连了谁、谁在谁的覆盖范围内："

