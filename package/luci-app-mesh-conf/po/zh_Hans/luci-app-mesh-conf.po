msgstr "（信道会一起被覆盖）"

msgid " (channels are staggered automatically; already-different ones stay as they are)"
msgstr "（信道会自动错开，本已不同的保持不动）"

msgid " · mesh not supported"
msgstr " · 不支持 mesh"

msgid "%d APs"
msgstr "%d 个 AP"

msgid "%d SSIDs still do not have k/v enabled"
msgstr "有 %d 个 SSID 还没有开启 k/v"

msgid "%d entries"
msgstr "%d 条"

msgid "%d interfaces use WPA3 / WPA3 mixed encryption: they have no PSK to derive a local PMK-R0, so enabling R forces ft_psk_generate_local to 0 (1 for other encryption types)."
msgstr "有 %d 个接口使用 WPA3 / WPA3 混合加密：这些接口没有 PSK 可供派生本地 PMK-R0，开启 R 时 ft_psk_generate_local 会强制写 0（其余加密方式写 1）。"

msgid "%d peers"
msgstr "对端 %d 个"

msgid "%d/%d SSIDs enabled"
msgstr "%d/%d 个 SSID 已开启"

