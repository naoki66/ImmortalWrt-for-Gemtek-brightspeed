# luci-app-mesh-conf
#
# Two ways of joining two XR1710G units, kept in separate sections so that one
# can be turned off without disturbing the other.
#
#   mesh    - native 802.11s on one radio (no batman-adv)
#   sync    - wired: discover peers on the LAN and sync /etc/config/wireless
#   roaming - whether 802.11k/v/r has been written into the AP interfaces

config mesh 'mesh'
	option enabled '0'
	option radio 'radio1'
	option mesh_id 'XR1710G-Mesh'
	option encryption 'sae'
	option key ''
	option bridge_lan '1'

config sync 'sync'
	option enabled '0'
	option port '7761'
	option key ''
	option last_sync '0'
	option last_peer ''
	# What to do with the channel when a config arrives from a peer:
	#   stagger (default) - make sure this unit is not on the peer's channel
	#   follow            - take the peer's channels verbatim
	option channel_mode 'stagger'
	# Peers that are not on this L2 (the manual equivalent of handing an AP
	# the controller address) are added as:
	#   list peers '192.168.2.1'

config roaming 'roaming'
	option kvr '0'

# steering - whether the DAWN daemon is in charge of deciding that a client
#   should move to another AP. Its own settings live in /etc/config/dawn;
#   this switch is this package's, so the page has one place to look.
config steering 'steering'
	option enabled '0'
