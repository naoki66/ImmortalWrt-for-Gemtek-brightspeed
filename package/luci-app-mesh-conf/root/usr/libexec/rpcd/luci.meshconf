#!/bin/sh

# rpcd backend for luci-app-mesh-conf.
#
# Two independent ways of joining two XR1710G units, and nothing else:
#
#   * wireless - native 802.11s mesh on one radio, no batman-adv, no HWMP
#     tuning knobs. The mesh interface is bridged into LAN so the two units
#     share one L2 domain.
#   * wired    - the units are already on the same LAN. One of them acts as the
#     controller, discovers its peers over L2 broadcast (/usr/sbin/meshconf-beacon
#     maintains the neighbour table) and pushes or pulls /etc/config/wireless
#     over the sync endpoint. This is what makes 802.11k/v/r consistent: every
#     unit ends up with the same SSIDs, the same mobility domains and the same
#     keys, which is exactly what a client needs in order to roam.
#
# rpcd contract, worth stating once because breaking it produces a completely
# misleading error: rpcd runs this as
#
#     /usr/libexec/rpcd/luci.meshconf call <method>
#
# with the parameters on stdin, and parses all of stdout as a single JSON
# object. Empty or non-JSON stdout - or a process that never exits - is
# reported to the caller as -32000 "Object not found", which reads like a
# missing plugin. Every path here therefore ends in a valid JSON object, and
# the script always exits 0.

# rpcd execs plugins with a trimmed environment: without this, iw / uci /
# uclient-fetch are looked up as if they were missing and the page reports a
# device that is fine.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH

set -f
. /usr/share/libubox/jshn.sh

# Shared with /usr/share/meshconf/www/cgi/sync so that a pulled config keeps
# the local channels exactly like a pushed one does.
MESHCONF_LIB=""
[ -r /usr/share/meshconf/lib.sh ] && . /usr/share/meshconf/lib.sh

WIFI=/etc/config/wireless
CONF=/etc/config/meshconf
BAK="$WIFI.meshconf-bak"
NEIGH_DIR=/tmp/meshconf-neigh
MESH_SEC=meshconf_mesh
SYNC_PORT_DEFAULT=7761
# An announcement is sent every 10s; three missed beacons and a node is gone.
NEIGH_TTL=40

[ -r /lib/functions/network.sh ] && . /lib/functions/network.sh

# ---------------------------------------------------------------------------
# small helpers
# ---------------------------------------------------------------------------
json_escape()
{
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/ /g' | tr -d '\r\n'
}

bool()
{
	[ "$1" = "1" ] && printf true || printf false
}

have()
{
	local name="$1" dir
	for dir in /usr/sbin /sbin /usr/bin /bin; do
		[ -x "$dir/$name" ] && return 0
	done
	command -v "$name" >/dev/null 2>&1
}

# "Is this still alive?" without going through ps: busybox and procps disagree
# on option spelling, and busybox truncates the COMMAND column when stdout is
# not a terminal - which is exactly how rpcd runs this file, so a perfectly
# running beacon could read as dead from here.
proc_running()
{
	local pat="$1" f
	set +f
	for f in /proc/[0-9]*/cmdline; do
		[ -r "$f" ] || continue
		tr '\0' ' ' < "$f" 2>/dev/null | grep -q -- "$pat" && { set -f; return 0; }
	done
	set -f
	return 1
}

# The whole plugin runs noglob (`set -f` above) so that a value coming from the
# browser can never expand into a path. The neighbour directory only ever holds
# names we validated ourselves, so globbing is switched back on for the listing
# and immediately off again.
list_files()
{
	local dir="$1"
	set +f
	printf '%s\n' "$dir"/*
	set -f
}

# procd forks its instances asynchronously: `restart` returns before the child
# exists. Without waiting, the page refreshes into a "service not running"
# warning that disappears a second later, which reads like a broken service.
wait_for_beacon()
{
	local i=0 n="${1:-8}"
	while [ "$i" -lt "$n" ]; do
		proc_running meshconf-beacon && return 0
		sleep 1
		i=$((i + 1))
	done
	return 1
}

# Reachability of this plugin says nothing about the rest of the package: a
# build that shipped /usr/sbin/meshconf-beacon without the exec bit leaves the
# page on "not running" with no way out, because the repair() in
# /etc/init.d/meshconf only runs after procd has already managed to exec that
# script. Doing the same chmods from here makes the page's own button the
# recovery instead of a recompile.
repair_modes()
{
	local f
	for f in /usr/libexec/rpcd/luci.meshconf /usr/sbin/meshconf-beacon \
	         /usr/share/meshconf/www/cgi/sync /etc/init.d/meshconf; do
		[ -f "$f" ] || continue
		chmod 0755 "$f" 2>/dev/null
	done
	[ -e /etc/rc.d/S95meshconf ] || \
		ln -sf ../init.d/meshconf /etc/rc.d/S95meshconf 2>/dev/null
}

ensure_conf()
{
	# `uci get <pkg>.<section>` answers with the section type, so an empty
	# reply means it has to be created - including on a unit where the
	# package's default config was never installed.
	[ -n "$(uci -q get meshconf.mesh 2>/dev/null)" ] || uci -q set meshconf.mesh=mesh
	[ -n "$(uci -q get meshconf.sync 2>/dev/null)" ] || uci -q set meshconf.sync=sync
	[ -n "$(uci -q get meshconf.roaming 2>/dev/null)" ] || uci -q set meshconf.roaming=roaming
}

mc_get()
{
	local v
	v="$(uci -q get meshconf."$1" 2>/dev/null)"
	[ -n "$v" ] || v="$2"
	printf '%s' "$v"
}

sync_port()
{
	local p
	p="$(mc_get sync.port "$SYNC_PORT_DEFAULT")"
	case "$p" in ''|*[!0-9]*) p="$SYNC_PORT_DEFAULT" ;; esac
	[ "$p" -ge 1 ] 2>/dev/null && [ "$p" -le 65535 ] 2>/dev/null || p="$SYNC_PORT_DEFAULT"
	printf '%s' "$p"
}

valid_key()
{
	case "$1" in
		'') return 1 ;;
		*[!A-Za-z0-9_-]*) return 1 ;;
	esac
	return 0
}

reload_wifi()
{
	# Reloading the radios takes seconds. It must not hold the ubus call open:
	# rpcd keeps the plugin process until it exits, and LuCI would sit on a
	# spinner long enough to look like a hang.
	(/sbin/wifi reload >/dev/null 2>&1 &) 2>/dev/null
}

self_ip()
{
	local ip=""
	network_get_ipaddr ip lan 2>/dev/null
	[ -n "$ip" ] || ip="$(ip -4 addr show dev br-lan 2>/dev/null | awk '/inet /{print $2; exit}' | cut -d/ -f1)"
	printf '%s' "$ip"
}

self_mac()
{
	local mac=""
	mac="$(cat /sys/class/net/br-lan/address 2>/dev/null)"
	[ -n "$mac" ] || mac="$(ip -4 link show dev br-lan 2>/dev/null | awk '/ether/{print $2; exit}')"
	printf '%s' "$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
}

board_model()
{
	local m=""
	[ -r /tmp/sysinfo/model ] && m="$(cat /tmp/sysinfo/model 2>/dev/null)"
	if [ -z "$m" ] && [ -r /tmp/sysinfo/board_name ]; then
		m="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
	fi
	[ -n "$m" ] || m="unknown"
	printf '%s' "$m"
}

wifi_rev()
{
	local r
	r="$(md5sum "$WIFI" 2>/dev/null | cut -c1-8)"
	[ -n "$r" ] || r="--------"
	printf '%s' "$r"
}

# Stable 4-hex-digit mobility domain: the same input on every unit yields the
# same domain, which is what lets a client do an FT transition between them.
md_for()
{
	local h
	h="$(printf '%s' "$1" | md5sum 2>/dev/null | cut -c1-4)"
	case "$h" in ''|*[!0-9a-f]*) h="1111" ;; esac
	printf '%s' "$h"
}

# One domain per SSID: every unit (and every band) carrying a given SSID has to
# land in the same domain for FT to be offered at all, while two different
# SSIDs must not share one. The SSID is the key because it is the one thing
# that is identical across units - `network` is only usually so.
ap_md()
{
	local sec="$1" ssid net
	ssid="$(uci -q get wireless."$sec".ssid 2>/dev/null)"
	net="$(uci -q get wireless."$sec".network 2>/dev/null)"
	[ -n "$net" ] || net="lan"
	if [ -n "$ssid" ]; then md_for "$ssid"; else md_for "$net"; fi
}

# Fast BSS Transition needs a key to derive PMK-R0/R1 from, so an open or OWE
# network gets k/v only.
ft_ok()
{
	case "$(uci -q get wireless."$1".encryption 2>/dev/null)" in
		''|none|owe) return 1 ;;
	esac
	return 0
}

# WPA3 (SAE) and WPA3-mixed do not use a PSK at all, so there is nothing for
# hostapd to derive a local PMK-R0 from - ft_psk_generate_local has to stay 0
# on those networks or the R0/R1 keys come out wrong and FT never completes.
# The wpa3* spellings are what LuCI writes when it is asked for WPA3 in words
# rather than by its SAE name.
sae_enc()
{
	case "$(uci -q get wireless."$1".encryption 2>/dev/null)" in
		sae|sae-mixed|wpa3|wpa3-mixed|*sae*) return 0 ;;
	esac
	return 1
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------
wifi_iface_sections()
{
	uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'
}

ap_sections()
{
	local sec
	for sec in $(wifi_iface_sections); do
		[ "$(uci -q get wireless."$sec".mode 2>/dev/null)" = "ap" ] && printf '%s\n' "$sec"
	done
}

radio_sections()
{
	uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-device$/\1/p'
}

# radio section -> phy name. `wifi status` is the only place netifd publishes
# the mapping, and jsonfilter walks both arrays in document order, so lining
# them up by line number is safe.
phy_map_prepare()
{
	WSTAT_N=/tmp/.meshconf-wstat.$$
	WSTAT_P=/tmp/.meshconf-wstatp.$$
	wifi status > "$WSTAT_N.raw" 2>/dev/null
	jsonfilter -i "$WSTAT_N.raw" -e '@.radios[*].name' > "$WSTAT_N" 2>/dev/null
	jsonfilter -i "$WSTAT_N.raw" -e '@.radios[*].config.phy' > "$WSTAT_P" 2>/dev/null
}

phy_map_done()
{
	rm -f "$WSTAT_N" "$WSTAT_P" "$WSTAT_N.raw" 2>/dev/null
}

phy_of()
{
	[ -s "$WSTAT_N" ] || return 0
	awk -v s="$1" 'NR==FNR{a[FNR]=$0;next} a[FNR]==s{print; exit}' "$WSTAT_N" "$WSTAT_P" 2>/dev/null
}

mesh_capable()
{
	local phy="$1"
	# No mapping available (netifd not running, unusual config): stay
	# optimistic rather than hiding every radio.
	[ -n "$phy" ] || { printf 1; return; }
	iw phy "$phy" info 2>/dev/null | grep -q 'mesh point' && printf 1 || printf 0
}

# 802.11s needs a mesh-capable hostapd. There is no clean way to ask it, so
# the binary is grepped for the feature string - a hint for the UI, never a
# hard gate.
wpad_mesh_ok()
{
	[ -x /usr/sbin/hostapd ] || return 1
	grep -aq 'mesh' /usr/sbin/hostapd 2>/dev/null
}

radios_json()
{
	local out="" first=1 sec phy band ch dis
	for sec in $(radio_sections); do
		phy="$(phy_of "$sec")"
		band="$(uci -q get wireless."$sec".band 2>/dev/null)"
		ch="$(uci -q get wireless."$sec".channel 2>/dev/null)"
		dis="$(uci -q get wireless."$sec".disabled 2>/dev/null)"
		[ "$first" = "1" ] || out="$out,"
		out="$out{\"name\":\"$(json_escape "$sec")\",\"band\":\"$(json_escape "$band")\",\"channel\":\"$(json_escape "$ch")\",\"disabled\":$(bool "$dis"),\"phy\":\"$(json_escape "$phy")\",\"mesh_capable\":$(mesh_capable "$phy")}"
		first=0
	done
	printf '%s' "$out"
}

aps_json()
{
	local out="" first=1 sec ssid band net enc k v r md mdset
	for sec in $(ap_sections); do
		ssid="$(uci -q get wireless."$sec".ssid 2>/dev/null)"
		band="$(uci -q get wireless."$sec".band 2>/dev/null)"
		[ -n "$band" ] || band="$(uci -q get wireless."$(uci -q get wireless."$sec".device 2>/dev/null)".band 2>/dev/null)"
		net="$(uci -q get wireless."$sec".network 2>/dev/null)"
		[ -n "$net" ] || net="lan"
		enc="$(uci -q get wireless."$sec".encryption 2>/dev/null)"
		k="$(uci -q get wireless."$sec".ieee80211k 2>/dev/null)"
		v="$(uci -q get wireless."$sec".wnm_sleep_mode 2>/dev/null)"
		[ "$v" = "1" ] || v="$(uci -q get wireless."$sec".ieee80211v 2>/dev/null)"
		r="$(uci -q get wireless."$sec".ieee80211r 2>/dev/null)"
		md="$(uci -q get wireless."$sec".mobility_domain 2>/dev/null)"
		mdset=0; [ -n "$md" ] && mdset=1
		# Show what would be written even before R is switched on, so the
		# operator can check the grouping instead of guessing it.
		[ -n "$md" ] || md="$(ap_md "$sec")"
		[ "$first" = "1" ] || out="$out,"
		out="$out{\"section\":\"$(json_escape "$sec")\",\"ssid\":\"$(json_escape "$ssid")\",\"band\":\"$(json_escape "$band")\",\"network\":\"$(json_escape "$net")\",\"encryption\":\"$(json_escape "$enc")\",\"k\":$(bool "$k"),\"v\":$(bool "$v"),\"r\":$(bool "$r"),\"ft_ok\":$(ft_ok "$sec" && echo true || echo false),\"wpa3\":$(sae_enc "$sec" && echo true || echo false),\"md\":\"$(json_escape "$md")\",\"md_set\":$(bool "$mdset")}"
		first=0
	done
	printf '%s' "$out"
}

mesh_iface_name()
{
	local sec="$1" ifn=""
	ifn="$(uci -q get wireless."$sec".ifname 2>/dev/null)"
	if [ -z "$ifn" ]; then
		# netifd writes ifname back into UCI, but a config that has never
		# been brought up has none - ask the kernel instead.
		ifn="$(iw dev 2>/dev/null | awk '/Interface/{n=$2} /type mesh point/{print n; exit}')"
	fi
	printf '%s' "$ifn"
}

mesh_peer_count()
{
	local ifn="$1"
	[ -n "$ifn" ] || { printf 0; return; }
	iw dev "$ifn" station dump 2>/dev/null | grep -c '^Station'
}

mesh_json()
{
	local enabled radio mesh_id enc key bridge state ifn peers=0 have_sec=0
	enabled="$(mc_get mesh.enabled 0)"
	radio="$(mc_get mesh.radio '')"
	mesh_id="$(mc_get mesh.mesh_id '')"
	enc="$(mc_get mesh.encryption sae)"
	key="$(mc_get mesh.key '')"
	bridge="$(mc_get mesh.bridge_lan 1)"

	[ "$(uci -q get wireless."$MESH_SEC" 2>/dev/null)" = "wifi-iface" ] && have_sec=1

	ifn=""
	state="off"
	if [ "$enabled" = "1" ] && [ "$have_sec" = "1" ]; then
		ifn="$(mesh_iface_name "$MESH_SEC")"
		peers="$(mesh_peer_count "$ifn")"
		if [ -n "$ifn" ]; then
			[ "$peers" -gt 0 ] 2>/dev/null && state="up" || state="waiting"
		else
			state="down"
		fi
	fi

	printf '{"enabled":%s,"radio":"%s","mesh_id":"%s","encryption":"%s","key_set":%s,"bridge_lan":%s,"iface":"%s","peers":%s,"state":"%s","wpad_mesh":%s,"socat":%s}' \
		"$(bool "$enabled")" "$(json_escape "$radio")" "$(json_escape "$mesh_id")" \
		"$(json_escape "$enc")" "$(bool "$( [ -n "$key" ] && echo 1 )")" "$(bool "$bridge")" \
		"$(json_escape "$ifn")" "$peers" "$state" \
		"$(wpad_mesh_ok && echo true || echo false)" "$(have socat && echo true || echo false)"
}

sync_json()
{
	local enabled key port last peer mode running=0 beacon=0 httpd=0 socat=0 initd=0 rclink=0 reason=""
	enabled="$(mc_get sync.enabled 0)"
	key="$(mc_get sync.key '')"
	port="$(sync_port)"
	last="$(mc_get sync.last_sync 0)"
	peer="$(mc_get sync.last_peer '')"
	if [ "$MESHCONF_LIB" = "1" ]; then mode="$(meshconf_channel_mode)"; else mode=stagger; fi

	proc_running meshconf-beacon && beacon=1
	# The private uhttpd that serves /cgi/sync: same feature, second moving
	# part. A peer can be discovered and still refuse to answer without it.
	proc_running meshconf/www && httpd=1
	have socat && socat=1
	[ -x /etc/init.d/meshconf ] && initd=1
	[ -e /etc/rc.d/S95meshconf ] && rclink=1

	if [ "$enabled" = "1" ]; then
		if [ "$initd" != "1" ]; then
			reason="/etc/init.d/meshconf 缺失或没有执行位：luci-app-mesh-conf 没装完整，请重装该包或点“启动服务”修复。"
		elif ! have socat; then
			reason="socat 未安装：二层发现依赖它，请安装 socat 后再点“启动服务”。"
		elif ! have uhttpd; then
			reason="uhttpd 未安装：同步端口 $port 由它提供，请安装 uhttpd 后再点“启动服务”。"
		elif [ ! -x /usr/sbin/meshconf-beacon ]; then
			reason="/usr/sbin/meshconf-beacon 没有执行位，procd 无法启动它；请点“启动服务”自动修复。"
		elif [ "$beacon" != "1" ] && [ "$httpd" != "1" ]; then
			reason="procd 没有拉起服务（连续失败会被放弃），请点“启动服务”。"
		elif [ "$beacon" != "1" ]; then
			reason="发现进程 meshconf-beacon 没有运行，请点“启动服务”。"
		elif [ "$httpd" != "1" ]; then
			reason="同步端口 $port 的 uhttpd 没有运行：检查端口是否被占用。"
		elif [ "$rclink" != "1" ]; then
			reason="服务在运行，但开机自启链接 /etc/rc.d/S95meshconf 缺失，重启后不会再自动起来。"
		fi
		[ "$beacon" = "1" ] && [ "$httpd" = "1" ] && running=1
	fi

	printf '{"enabled":%s,"port":"%s","key_set":%s,"running":%s,"beacon":%s,"httpd":%s,"socat":%s,"initd":%s,"rclink":%s,"reason":"%s","last_sync":%s,"last_peer":"%s","channel_mode":"%s","self_ip":"%s","self_mac":"%s","peers":[%s]}' \
		"$(bool "$enabled")" "$port" "$(bool "$( [ -n "$key" ] && echo 1 )")" \
		"$(bool "$running")" "$(bool "$beacon")" "$(bool "$httpd")" "$(bool "$socat")" \
		"$(bool "$initd")" "$(bool "$rclink")" "$(json_escape "$reason")" \
		"${last:-0}" "$(json_escape "$peer")" "$(json_escape "$mode")" \
		"$(json_escape "$(self_ip)")" "$(json_escape "$(self_mac)")" \
		"$(manual_peers_json)"
}

manual_peers()
{
	uci -q get meshconf.sync.peers 2>/dev/null
}

manual_peers_json()
{
	local out="" first=1 p
	for p in $(manual_peers); do
		[ "$first" = "1" ] || out="$out,"
		out="$out\"$(json_escape "$p")\""
		first=0
	done
	printf '%s' "$out"
}

roaming_json()
{
	local total=0 ready=0 sec k v r
	for sec in $(ap_sections); do
		total=$((total + 1))
		k="$(uci -q get wireless."$sec".ieee80211k 2>/dev/null)"
		v="$(uci -q get wireless."$sec".wnm_sleep_mode 2>/dev/null)"
		[ "$v" = "1" ] || v="$(uci -q get wireless."$sec".ieee80211v 2>/dev/null)"
		r="$(uci -q get wireless."$sec".ieee80211r 2>/dev/null)"
		[ "$k" = "1" ] && [ "$v" = "1" ] && [ "$r" = "1" ] && ready=$((ready + 1))
	done
	printf '{"enabled":%s,"ap_total":%d,"ap_ready":%d}' \
		"$(bool "$(mc_get roaming.kvr 0)")" "$total" "$ready"
}

get_status()
{
	local radios aps
	phy_map_prepare
	radios="$(radios_json)"
	phy_map_done
	aps="$(aps_json)"

	printf '{"local":%s,"radios":[%s],"mesh":%s,"sync":%s,"roaming":%s,"aps":[%s]}' \
		"{\"hostname\":\"$(json_escape "$(cat /proc/sys/kernel/hostname 2>/dev/null)")\",\"model\":\"$(json_escape "$(board_model)")\",\"lan_ip\":\"$(json_escape "$(self_ip)")\",\"mac\":\"$(json_escape "$(self_mac)")\",\"wifirev\":\"$(json_escape "$(wifi_rev)")\",\"fwver\":\"$(json_escape "$(cat /etc/openwrt_version 2>/dev/null || echo unknown)")\"}" \
		"$radios" "$(mesh_json)" "$(sync_json)" "$(roaming_json)" "$aps"
}

# ---------------------------------------------------------------------------
# apply: wireless 802.11s
# ---------------------------------------------------------------------------
apply_mesh()
{
	local args="$1" enabled radio mesh_id enc key bridge old
	json_load "$args" 2>/dev/null || { printf '{"success":false,"error":"bad arguments"}'; return; }
	json_get_var enabled enabled
	json_get_var radio radio
	json_get_var mesh_id mesh_id
	json_get_var enc encryption
	json_get_var key key
	json_get_var bridge bridge_lan

	ensure_conf

	if [ "$enabled" != "1" ]; then
		uci -q set meshconf.mesh.enabled=0
		uci -q delete wireless."$MESH_SEC" 2>/dev/null
		uci -q commit meshconf 2>/dev/null
		uci -q commit wireless 2>/dev/null
		reload_wifi
		printf '{"success":true,"enabled":false}'
		return
	fi

	[ "$(uci -q get wireless."$radio" 2>/dev/null)" = "wifi-device" ] || {
		printf '{"success":false,"error":"radio %s does not exist"}' "$(json_escape "$radio")"
		return
	}
	[ -n "$mesh_id" ] || { printf '{"success":false,"error":"Mesh ID is required"}'; return; }

	case "$enc" in
		none|sae) ;;
		*) printf '{"success":false,"error":"encryption must be none or sae"}'; return ;;
	esac
	if [ "$enc" = "sae" ]; then
		if [ "${#key}" -lt 8 ]; then
			printf '{"success":false,"error":"SAE needs a key of at least 8 characters"}'
			return
		fi
		key="$(printf '%s' "$key" | tr -d '\r\n')"
	fi

	old="$(uci -q get meshconf.mesh.enabled 2>/dev/null)"

	uci -q set meshconf.mesh.enabled=1
	uci -q set meshconf.mesh.radio="$radio"
	uci -q set meshconf.mesh.mesh_id="$mesh_id"
	uci -q set meshconf.mesh.encryption="$enc"
	[ "$enc" = "sae" ] && uci -q set meshconf.mesh.key="$key" || uci -q set meshconf.mesh.key=""
	case "$bridge" in 1|true|on|yes) bridge=1 ;; *) bridge=0 ;; esac
	uci -q set meshconf.mesh.bridge_lan="$bridge"

	uci -q set wireless."$MESH_SEC"=wifi-iface
	uci -q set wireless."$MESH_SEC".device="$radio"
	uci -q set wireless."$MESH_SEC".mode=mesh
	uci -q set wireless."$MESH_SEC".mesh_id="$mesh_id"
	uci -q set wireless."$MESH_SEC".encryption="$enc"
	if [ "$enc" = "sae" ]; then
		uci -q set wireless."$MESH_SEC".key="$key"
	else
		uci -q delete wireless."$MESH_SEC".key 2>/dev/null
	fi
	# HWMP does the forwarding itself - this is plain 802.11s, there is no
	# batman-adv above it.
	uci -q set wireless."$MESH_SEC".mesh_fwding=1
	uci -q set wireless."$MESH_SEC".disabled=0
	# Marker so the page can tell its own interface from a hand written one.
	uci -q set wireless."$MESH_SEC".meshconf=1
	if [ "$bridge" = "1" ]; then
		uci -q set wireless."$MESH_SEC".network=lan
	else
		uci -q delete wireless."$MESH_SEC".network 2>/dev/null
	fi

	uci -q commit meshconf 2>/dev/null
	uci -q commit wireless 2>/dev/null
	reload_wifi

	printf '{"success":true,"enabled":true,"changed":%s}' \
		"$( [ "$old" = "1" ] && echo true || echo false )"
}

# ---------------------------------------------------------------------------
# apply: 802.11k/v/r
# ---------------------------------------------------------------------------
# The three feature groups, exactly as the UI exposes them.
#   k - neighbour + beacon reports, so a client can ask "what else is there"
#   v - BTM transition and sleep mode, so the AP can tell it "go over there"
#   r - fast BSS transition, so the move does not drop the session
ROAM_K="ieee80211k rrm_neighbor_report rrm_beacon_report"
ROAM_V="ieee80211v bss_transition wnm_sleep_mode wnm_sleep_mode_no_keys proxy_arp"
ROAM_R="ieee80211r ft_over_ds reassociation_deadline ft_psk_generate_local mobility_domain"
ROAM_ALL="$ROAM_K $ROAM_V $ROAM_R"

# 802.11r for one interface. ft_over_ds=0 is "Over the Air", which is what
# practically every client implements; the 20s reassociation deadline is the
# usual compromise between "wait for a slow client" and "give up".
#
# ft_psk_generate_local is the exception: 1 everywhere except WPA3/SAE, where
# it must be 0 (see sae_enc). It is written last so nothing can overwrite it.
roam_r_on()
{
	local sec="$1"
	uci -q set wireless."$sec".ieee80211r=1
	uci -q set wireless."$sec".ft_over_ds=0
	uci -q set wireless."$sec".reassociation_deadline=20000
	uci -q set wireless."$sec".mobility_domain="$(ap_md "$sec")"
	if sae_enc "$sec"; then
		uci -q set wireless."$sec".ft_psk_generate_local=0
	else
		uci -q set wireless."$sec".ft_psk_generate_local=1
	fi
}

apply_roaming()
{
	local args="$1" enabled sec opt
	json_load "$args" 2>/dev/null || { printf '{"success":false,"error":"bad arguments"}'; return; }
	json_get_var enabled enabled
	ensure_conf

	if [ "$enabled" = "1" ]; then
		for sec in $(ap_sections); do
			for opt in $ROAM_K $ROAM_V; do
				uci -q set wireless."$sec"."$opt"=1
			done
			ft_ok "$sec" && roam_r_on "$sec"
		done
		uci -q set meshconf.roaming.kvr=1
	else
		for sec in $(ap_sections); do
			for opt in $ROAM_ALL; do
				uci -q delete wireless."$sec"."$opt" 2>/dev/null
			done
		done
		uci -q set meshconf.roaming.kvr=0
	fi

	uci -q commit wireless 2>/dev/null
	uci -q commit meshconf 2>/dev/null
	reload_wifi

	printf '{"success":true,"enabled":%s}' "$(bool "$enabled")"
}

# ---------------------------------------------------------------------------
# apply: one k/v/r feature on one interface
# ---------------------------------------------------------------------------
toggle_roam()
{
	local args="$1" sec feat enabled opt
	json_load "$args" 2>/dev/null || { printf '{"success":false,"error":"bad arguments"}'; return; }
	json_get_var sec section
	json_get_var feat feature
	json_get_var enabled enabled

	# The section name comes straight from the browser, so it is checked
	# against the real config instead of being handed to uci: otherwise any
	# caller could write options into any UCI package.
	case "$sec" in ''|*[!A-Za-z0-9_-]*) printf '{"success":false,"error":"invalid interface name"}'; return ;; esac
	[ "$(uci -q get wireless."$sec" 2>/dev/null)" = "wifi-iface" ] || {
		printf '{"success":false,"error":"interface does not exist"}'; return; }
	[ "$(uci -q get wireless."$sec".mode 2>/dev/null)" = "ap" ] || {
		printf '{"success":false,"error":"not an AP interface"}'; return; }

	ensure_conf

	if [ "$enabled" = "1" ]; then
		case "$feat" in
			k) for opt in $ROAM_K; do uci -q set wireless."$sec"."$opt"=1; done ;;
			v) for opt in $ROAM_V; do uci -q set wireless."$sec"."$opt"=1; done ;;
			r)
				ft_ok "$sec" || {
					printf '{"success":false,"error":"开放/OWE 网络无法开启 802.11r：FT 需要密钥来派生 PMK-R0/R1"}'
					return; }
				roam_r_on "$sec"
				;;
			*) printf '{"success":false,"error":"unknown feature"}'; return ;;
		esac
	else
		case "$feat" in
			k) for opt in $ROAM_K; do uci -q delete wireless."$sec"."$opt" 2>/dev/null; done ;;
			v) for opt in $ROAM_V; do uci -q delete wireless."$sec"."$opt" 2>/dev/null; done ;;
			r) for opt in $ROAM_R; do uci -q delete wireless."$sec"."$opt" 2>/dev/null; done ;;
			*) printf '{"success":false,"error":"unknown feature"}'; return ;;
		esac
	fi

	uci -q commit wireless 2>/dev/null
	reload_wifi

	printf '{"success":true,"section":"%s","feature":"%s","enabled":%s}' \
		"$(json_escape "$sec")" "$feat" "$(bool "$enabled")"
}

# ---------------------------------------------------------------------------
# apply: mobility domain, by hand
# ---------------------------------------------------------------------------
set_md()
{
	local args="$1" sec md ssid target n=0 eff
	json_load "$args" 2>/dev/null || { printf '{"success":false,"error":"bad arguments"}'; return; }
	json_get_var sec section
	json_get_var md md

	# Same guard as toggle_roam: the section name arrives from the browser.
	case "$sec" in ''|*[!A-Za-z0-9_-]*) printf '{"success":false,"error":"invalid interface name"}'; return ;; esac
	[ "$(uci -q get wireless."$sec" 2>/dev/null)" = "wifi-iface" ] || {
		printf '{"success":false,"error":"interface does not exist"}'; return; }
	[ "$(uci -q get wireless."$sec".mode 2>/dev/null)" = "ap" ] || {
		printf '{"success":false,"error":"not an AP interface"}'; return; }

	md="$(printf '%s' "$md" | tr -d '	 \r\n' | tr 'A-F' 'a-f')"
	case "$md" in
		'') ;;                                                  # clear -> auto
		*[!0-9a-f]*) printf '{"success":false,"error":"移动域必须是 4 位十六进制字符（0-9 a-f）"}'; return ;;
		????) ;;
		*) printf '{"success":false,"error":"移动域必须是 4 位十六进制字符（0-9 a-f）"}'; return ;;
	esac

	ensure_conf
	ssid="$(uci -q get wireless."$sec".ssid 2>/dev/null)"

	# Every interface carrying this SSID has to share the domain - otherwise a
	# client roaming between bands would be handed to an AP whose R0 key holder
	# it does not know, and FT silently never happens. Editing one row
	# therefore edits the whole SSID, on this unit at least; syncing carries it
	# to the rest.
	for target in $(ap_sections); do
		[ "$(uci -q get wireless."$target".ssid 2>/dev/null)" = "$ssid" ] || continue
		if [ -n "$md" ]; then
			uci -q set wireless."$target".mobility_domain="$md"
		else
			uci -q delete wireless."$target".mobility_domain 2>/dev/null
		fi
		n=$((n + 1))
	done

	uci -q commit wireless 2>/dev/null
	reload_wifi

	eff="$md"
	[ -n "$eff" ] || eff="$(ap_md "$sec")"
	printf '{"success":true,"section":"%s","md":"%s","auto":%s,"applied":%d}' \
		"$(json_escape "$sec")" "$(json_escape "$eff")" "$(bool "$( [ -z "$md" ] && echo 1 )")" "$n"
}

# ---------------------------------------------------------------------------
# apply: wired sync service
# ---------------------------------------------------------------------------
apply_sync()
{
	local args="$1" enabled port key peers mode p ok=1 running=0
	json_load "$args" 2>/dev/null || { printf '{"success":false,"error":"bad arguments"}'; return; }
	json_get_var enabled enabled
	json_get_var port port
	json_get_var key key
	json_get_var peers peers
	json_get_var mode channel_mode

	ensure_conf

	if [ "$enabled" = "1" ] && ! valid_key "$key"; then
		printf '{"success":false,"error":"sync key must be 1-64 characters of A-Z a-z 0-9 _ -"}'
		return
	fi

	case "$port" in ''|*[!0-9]*) port="$SYNC_PORT_DEFAULT" ;; esac
	[ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || {
		printf '{"success":false,"error":"port out of range"}'
		return
	}

	# Anything that is not a clear "follow" staggers. A unit that ends up on
	# the peer's channel by accident splits airtime instead of adding to it,
	# which is the worse way to be wrong.
	[ "$mode" = "follow" ] || mode=stagger

	uci -q set meshconf.sync.enabled="$enabled"
	uci -q set meshconf.sync.port="$port"
	uci -q set meshconf.sync.key="$key"
	uci -q set meshconf.sync.channel_mode="$mode"
	uci -q delete meshconf.sync.keep_channel 2>/dev/null
	uci -q delete meshconf.sync.peers 2>/dev/null
	# Hand added peers: the manual equivalent of handing an AP the controller
	# address (DHCP option 138 in the TP-Link world) when it is not on this L2.
	for p in $(printf '%s' "$peers" | tr ',; ' '\n\n\n'); do
		case "$p" in ''|*[!0-9.]*) continue ;; esac
		uci -q add_list meshconf.sync.peers="$p"
	done

	uci -q commit meshconf 2>/dev/null

	repair_modes

	# enable is idempotent and near free: the rc.d link is the only thing that
	# brings the service back after a reboot, and nothing else guarantees it.
	/etc/init.d/meshconf enable >/dev/null 2>&1
	/etc/init.d/meshconf restart >/dev/null 2>&1 || ok=0

	# Wait for procd to actually fork the beacon, otherwise the page that
	# refreshes right after this reports a service that is one second old.
	running=0
	if [ "$enabled" = "1" ]; then
		wait_for_beacon 5 || ok=0
		proc_running meshconf-beacon && running=1
	fi

	printf '{"success":true,"enabled":%s,"port":"%s","restarted":%s,"running":%s}' \
		"$(bool "$enabled")" "$port" "$(bool "$ok")" "$(bool "$running")"
}

restart_sync()
{
	local running=0

	repair_modes

	/etc/init.d/meshconf enable >/dev/null 2>&1
	/etc/init.d/meshconf restart >/dev/null 2>&1
	wait_for_beacon 5
	proc_running meshconf-beacon && running=1

	printf '{"success":true,"running":%s}' "$(bool "$running")"
}

# ---------------------------------------------------------------------------
# discovery
# ---------------------------------------------------------------------------
probe_http()
{
	local ip="$1" port="$2" f=/tmp/.meshconf-probe.$$
	uclient-fetch -q -O "$f" -T 3 "http://$ip:$port/cgi/sync?action=hello" >/dev/null 2>&1 || {
		rm -f "$f"
		return 1
	}
	grep -q '"app":"meshconf"' "$f" 2>/dev/null || { rm -f "$f"; return 1; }
	printf '%s' "$f"
}

jf()
{
	jsonfilter -i "$1" -e "$2" 2>/dev/null | head -n1
}

peer_from_hello()
{
	local f="$1" ip="$2" source="$3"
	printf '{"ip":"%s","mac":"%s","hostname":"%s","model":"%s","fwver":"%s","wifirev":"%s","mesh_id":"%s","kvr":%s,"age":0,"source":"%s"}' \
		"$(json_escape "$ip")" \
		"$(json_escape "$(jf "$f" '@.mac')")" \
		"$(json_escape "$(jf "$f" '@.hostname')")" \
		"$(json_escape "$(jf "$f" '@.model')")" \
		"$(json_escape "$(jf "$f" '@.fwver')")" \
		"$(json_escape "$(jf "$f" '@.wifirev')")" \
		"$(json_escape "$(jf "$f" '@.mesh_id')")" \
		"$( [ "$(jf "$f" '@.kvr')" = "true" ] && echo true || echo false )" \
		"$source"
}

# One announcement line -> neighbour file. Split on '|': MESHCONF1|announce|...
store_announce()
{
	local line="$1" now="$2" oldifs ip kind mac
	case "$line" in MESHCONF1\|*) ;; *) return 0 ;; esac
	oldifs="$IFS"
	IFS='|'
	set -- $line
	IFS="$oldifs"
	kind="$2"
	mac="$3"
	ip="$4"
	[ "$kind" = "announce" ] || return 0
	case "$ip" in ''|*[!0-9.]*) return 0 ;; esac
	[ "$mac" = "$(self_mac)" ] && return 0
	printf '%s\n%s\n' "$line" "$now" > "$NEIGH_DIR/.$ip.$$" 2>/dev/null &&
		mv -f "$NEIGH_DIR/.$ip.$$" "$NEIGH_DIR/$ip" 2>/dev/null
	return 0
}

beacon_running()
{
	proc_running meshconf-beacon
}

# No beacon service running (sync disabled, or it just died): listen for a few
# seconds right here so that "scan" still works, instead of returning an empty
# list that looks like a dead feature.
collect_now()
{
	local port="$1" tmp="/tmp/.meshconf-scan.$$" line now pid
	: > "$tmp" 2>/dev/null

	(
		socat -u "UDP4-RECVFROM:$port,reuseaddr" - > "$tmp" 2>/dev/null &
		echo $! > "$tmp.pid"
		wait
	) &
	pid=$!

	sleep 0.3
	[ -x /usr/sbin/meshconf-beacon ] && /usr/sbin/meshconf-beacon discover >/dev/null 2>&1
	sleep 3

	[ -f "$tmp.pid" ] && kill "$(cat "$tmp.pid" 2>/dev/null)" 2>/dev/null
	kill "$pid" 2>/dev/null
	rm -f "$tmp.pid"

	mkdir -p "$NEIGH_DIR" 2>/dev/null
	now="$(date +%s 2>/dev/null || echo 0)"
	while IFS= read -r line; do
		store_announce "$line" "$now"
	done < "$tmp"
	rm -f "$tmp"
}

scan_peers()
{
	local port now f ip stamp line age out="" first=1
	local mac host model fwver wifirev mesh_id kvr uptime oldifs
	local seen=" " p
	port="$(sync_port)"
	now="$(date +%s 2>/dev/null || echo 0)"

	# Nudge the neighbours: they answer a discover immediately instead of
	# making the page wait for the next 10s announcement.
	if beacon_running; then
		[ -x /usr/sbin/meshconf-beacon ] && /usr/sbin/meshconf-beacon discover >/dev/null 2>&1
		sleep 1
	else
		have socat && collect_now "$port"
	fi

	for f in $(list_files "$NEIGH_DIR"); do
		[ -f "$f" ] || continue
		ip="${f##*/}"
		case "$ip" in ''|*[!0-9.]*) continue ;; esac
		line="$(sed -n 1p "$f" 2>/dev/null)"
		stamp="$(sed -n 2p "$f" 2>/dev/null)"
		case "$stamp" in ''|*[!0-9]*) stamp=0 ;; esac
		age=$((now - stamp))
		[ "$age" -ge 0 ] 2>/dev/null && [ "$age" -le "$NEIGH_TTL" ] || continue

		oldifs="$IFS"
		IFS='|'
		set -- $line
		IFS="$oldifs"
		[ "$2" = "announce" ] || continue
		mac="$3"; host="$5"; model="$6"; fwver="$7"; wifirev="$8"; mesh_id="$9"
		kvr="${10}"; uptime="${11}"

		# Announcements carry the sender's own address, and the file name is
		# the address it came from - trust the file name, it is the one that
		# has to be reachable.
		seen="$seen$ip "
		[ "$first" = "1" ] || out="$out,"
		out="$out{\"ip\":\"$(json_escape "$ip")\",\"mac\":\"$(json_escape "$mac")\",\"hostname\":\"$(json_escape "$host")\",\"model\":\"$(json_escape "$model")\",\"fwver\":\"$(json_escape "$fwver")\",\"wifirev\":\"$(json_escape "$wifirev")\",\"mesh_id\":\"$(json_escape "$mesh_id")\",\"kvr\":$(bool "$kvr"),\"age\":$age,\"source\":\"lan\"}"
		first=0
	done

	for p in $(manual_peers); do
		case "$p" in ''|*[!0-9.]*) continue ;; esac
		case "$seen" in *" $p "*) continue ;; esac
		f="$(probe_http "$p" "$port")"
		[ -n "$f" ] || continue
		[ "$first" = "1" ] || out="$out,"
		out="$out$(peer_from_hello "$f" "$p" manual)"
		rm -f "$f"
		first=0
	done

	printf '{"peers":[%s],"self_wifirev":"%s","port":"%s"}' \
		"$out" "$(json_escape "$(wifi_rev)")" "$port"
}

# ---------------------------------------------------------------------------
# config transfer
# ---------------------------------------------------------------------------
http_post_file()
{
	local url="$1" file="$2" out="$3"
	if have uclient-fetch; then
		uclient-fetch -q -O "$out" -T 30 --post-file="$file" "$url" >/dev/null 2>&1 && return 0
	fi
	if have wget; then
		wget -q -O "$out" -T 30 --post-file="$file" "$url" >/dev/null 2>&1 && return 0
	fi
	return 1
}

sync_peer()
{
	local args="$1" ip dir key port f cfg bytes saved staggered
	json_load "$args" 2>/dev/null || { printf '{"success":false,"error":"bad arguments"}'; return; }
	json_get_var ip ip
	json_get_var dir direction

	case "$ip" in ''|*[!0-9.]*) printf '{"success":false,"error":"invalid peer address"}'; return ;; esac
	case "$dir" in push|pull) ;; *) printf '{"success":false,"error":"direction must be push or pull"}'; return ;; esac

	key="$(mc_get sync.key '')"
	if ! valid_key "$key"; then
		printf '{"success":false,"error":"set a sync key first (all units must use the same one)"}'
		return
	fi
	port="$(sync_port)"

	if [ "$dir" = "pull" ]; then
		f=/tmp/.meshconf-pull.$$
		cfg=/tmp/.meshconf-pullcfg.$$
		uclient-fetch -q -O "$f" -T 30 "http://$ip:$port/cgi/sync?action=get&key=$key" >/dev/null 2>&1 || {
			rm -f "$f"
			printf '{"success":false,"error":"peer did not answer (offline, or a different sync key)"}'
			return
		}
		jsonfilter -i "$f" -e '@.config' > "$cfg" 2>/dev/null
		rm -f "$f"
		[ -s "$cfg" ] || { rm -f "$cfg"; printf '{"success":false,"error":"peer sent no configuration"}'; return; }

		# Two units in the same room must not be pushed onto one channel -
		# they would split airtime instead of adding to it. Whoever receives
		# decides: the push path applies the same rule on the far end.
		staggered=0
		if [ "$MESHCONF_LIB" = "1" ] && meshconf_stagger_enabled; then
			meshconf_rewrite_channels "$cfg" && staggered=1
		fi

		mkdir -p /tmp/.meshconf-uci 2>/dev/null
		cp -f "$cfg" /tmp/.meshconf-uci/wireless 2>/dev/null
		if ! uci -c /tmp/.meshconf-uci show wireless >/dev/null 2>&1; then
			rm -f "$cfg"
			printf '{"success":false,"error":"peer configuration does not parse as UCI"}'
			return
		fi

		cp -f "$WIFI" "$BAK" 2>/dev/null
		cp -f "$cfg" "$WIFI" 2>/dev/null || { rm -f "$cfg"; printf '{"success":false,"error":"could not write the wireless config"}'; return; }
		bytes="$(wc -c < "$cfg" 2>/dev/null | tr -d ' ')"
		rm -f "$cfg"

		ensure_conf
		uci -q set meshconf.sync.last_sync="$(date +%s 2>/dev/null || echo 0)"
		uci -q set meshconf.sync.last_peer="$ip"
		uci -q commit meshconf 2>/dev/null
		reload_wifi

		printf '{"success":true,"direction":"pull","peer":"%s","bytes":%s,"backup":true,"staggered":%s}' \
			"$(json_escape "$ip")" "${bytes:-0}" "$(bool "$staggered")"
		return
	fi

	f=/tmp/.meshconf-push.$$
	if ! http_post_file "http://$ip:$port/cgi/sync?action=put&key=$key" "$WIFI" "$f"; then
		rm -f "$f"
		printf '{"success":false,"error":"upload failed (peer offline, wrong key, or no http client)"}'
		return
	fi
	if ! grep -q '"success":true' "$f" 2>/dev/null; then
		msg="$(jf "$f" '@.error')"
		rm -f "$f"
		printf '{"success":false,"error":"peer rejected the upload%s"}' \
			"$( [ -n "$msg" ] && printf ': %s' "$(json_escape "$msg")" )"
		return
	fi
	rm -f "$f"

	ensure_conf
	uci -q set meshconf.sync.last_sync="$(date +%s 2>/dev/null || echo 0)"
	uci -q set meshconf.sync.last_peer="$ip"
	uci -q commit meshconf 2>/dev/null

	printf '{"success":true,"direction":"push","peer":"%s","backup":false}' "$(json_escape "$ip")"
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
case "$1" in
	list)
		printf '{"getStatus":{},"scanPeers":{},"applyMesh":{"enabled":"string","radio":"string","mesh_id":"string","encryption":"string","key":"string","bridge_lan":"string"},"applyRoaming":{"enabled":"string"},"toggleRoam":{"section":"string","feature":"string","enabled":"string"},"setMd":{"section":"string","md":"string"},"applySync":{"enabled":"string","port":"string","key":"string","peers":"string","channel_mode":"string"},"restartSync":{},"syncPeer":{"ip":"string","direction":"string"}}'
		;;
	call)
		args="$(cat)"
		# Every method prints its own JSON; this only has to make sure that
		# something JSON-shaped comes out even if one of them is silent,
		# because silence is what rpcd turns into -32000.
		rc_out=""
		case "$2" in
			getStatus) rc_out="$(get_status)" ;;
			scanPeers) rc_out="$(scan_peers)" ;;
			applyMesh) rc_out="$(apply_mesh "$args")" ;;
			applyRoaming) rc_out="$(apply_roaming "$args")" ;;
			toggleRoam) rc_out="$(toggle_roam "$args")" ;;
			setMd) rc_out="$(set_md "$args")" ;;
			applySync) rc_out="$(apply_sync "$args")" ;;
			restartSync) rc_out="$(restart_sync)" ;;
			syncPeer) rc_out="$(sync_peer "$args")" ;;
			*) rc_out='{"success":false,"error":"unknown method"}' ;;
		esac
		rc_rc=$?
		case "$rc_out" in
			\{*) printf '%s' "$rc_out" ;;
			*)
				printf '{"success":false,"error":"backend produced no JSON output (method=%s, rc=%s)","raw":"%s"}' \
					"$(json_escape "${2:-}")" "$rc_rc" \
					"$(printf '%s' "$rc_out" | tr -d '\r\n' | cut -c1-200 | sed 's/\\/\\\\/g; s/"/\\"/g')"
				;;
		esac
		# Always exit 0: a non-zero status makes rpcd report the call as
		# failed even when a good error object was printed.
		exit 0
		;;
esac

exit 0
