#!/bin/sh

# rpcd backend for luci-app-mesh-conf: batman-adv mesh backhaul (wired and/or
# wireless), master/slave roles, unified wireless coverage and mesh topology
# discovery. Switching the upstream WAN mode (AP / DHCP / PPPoE) lives in the
# separate luci-app-netmode package.
#
# rpcd contract, worth stating once because breaking it produces a completely
# misleading error message: rpcd runs this script as
#
#     /usr/libexec/rpcd/luci.meshconf call <method>
#
# and parses all of stdout as a single JSON object. If stdout is empty, or is
# not valid JSON, or the process never exits, rpcd answers the caller with
#
#     -32000 Object not found
#
# which looks like a missing plugin even when the plugin is installed and the
# real failure was something else entirely. So every path through this script
# has to end in a valid JSON object - hence the "|| return 1" sites below
# pairing with a printed error, and the die_json helper for bail-outs.

set -f
. /usr/share/libubox/jshn.sh

# Emit a JSON error object and stop. Used by the argument-validation paths that
# used to "return 1" silently, which surfaced as -32000 instead of a reason.
die_json()
{
	printf '{"success":false,"error":"%s"}' "$(json_escape "$1")"
	exit 0
}

MAX_WIFI_MESH=8
# One radio may carry several AP interfaces (multi-SSID), so the per-SSID
# list needs a much larger bound than the mesh radio count.
MAX_AP_ENTRIES=64
MAX_VLANS=32
# Announced gateway bandwidth for a gw_mode=server node. There is no UI knob
# for it any more: the master always advertises the maximum so batman-adv
# picks it purely on link quality (TQ) instead of a throttled number.
GW_BANDWIDTH_MAX="10000000/10000000"

# Every 802.11s operating parameter netifd understands. Kept in sync with
# package/network/config/wifi-scripts:
#   files/lib/netifd/wireless/mac80211.sh    (MP_CONFIG_INT / _BOOL / _STRING)
#   files-ucode/lib/netifd/wireless/mac80211.sh (mesh_param_list, adds mesh_nolearn)
# Note the upstream spelling mistake in mesh_sync_offset_max_neighor - it must
# be written exactly like that or netifd silently drops the value.
MESH_PARAM_INT="mesh_retry_timeout mesh_confirm_timeout mesh_holding_timeout mesh_max_peer_links
	mesh_max_retries mesh_ttl mesh_element_ttl mesh_hwmp_max_preq_retries
	mesh_path_refresh_time mesh_min_discovery_timeout mesh_hwmp_active_path_timeout
	mesh_hwmp_preq_min_interval mesh_hwmp_net_diameter_traversal_time mesh_hwmp_rootmode
	mesh_hwmp_rann_interval mesh_gate_announcements mesh_sync_offset_max_neighor
	mesh_rssi_threshold mesh_hwmp_active_path_to_root_timeout mesh_hwmp_root_interval
	mesh_hwmp_confirmation_interval mesh_awake_window mesh_plink_timeout"
MESH_PARAM_BOOL="mesh_auto_open_plinks mesh_fwding mesh_nolearn"
MESH_PARAM_STRING="mesh_power_mode"

# Backhaul protocol carried by the 802.11s link.
#   batman - batman-adv does the L2 routing, HWMP forwarding stays off
#   hwmp   - plain 802.11s, the kernel HWMP protocol routes, mesh iface is
#            bridged straight into lan
MESH_PROTOS="batman hwmp"

# Wireless channel width accepted by netifd/mac80211.
HTMODES="auto NOHT HT20 HT40 VHT20 VHT40 VHT80 VHT80_80 VHT160
	HE20 HE40 HE80 HE80_80 HE160 EHT20 EHT40 EHT80 EHT160"

json_escape()
{
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/ /g'
}

json_file_string()
{
	awk 'BEGIN { printf "\"" }
	{
		gsub(/\\/, "\\\\")
		gsub(/"/, "\\\"")
		gsub(/\t/, "\\t")
		gsub(/\r/, "")
		if (NR > 1) printf "\\n"
		printf "%s", $0
	}
	END { printf "\"" }' "$1"
}

bool()
{
	[ "$1" = "1" ] && printf true || printf false
}

# Write a UCI option as an explicit 0/1 instead of removing it: hostapd
# options such as ft_over_ds are read back by the UI and an absent option
# would look like "never configured" rather than "off".
uci_bool01()
{
	case "$2" in
		1|true|on|yes) uci -q set "$1"='1' ;;
		*) uci -q set "$1"='0' ;;
	esac
}

# rpcd launches plugins with a trimmed environment and does not guarantee the
# usual PATH, so "command -v batctl" answered "not found" on a router that
# demonstrably ships /usr/sbin/batctl - the UI then claimed batctl and iw were
# missing on a fully provisioned image. Probe the known binary locations
# first and fall back to PATH only if none of them exist.
have_command()
{
	local name="$1" dir
	case "$name" in
		batctl) dir="/usr/sbin /sbin /usr/bin /bin" ;;
		iw) dir="/usr/sbin /sbin /usr/bin /bin" ;;
		wpa_supplicant|hostapd) dir="/usr/sbin /sbin" ;;
		board_name|hostname|iw) dir="/usr/sbin /sbin /usr/bin /bin" ;;
		*) dir="/usr/sbin /sbin /usr/bin /bin" ;;
	esac
	for dir in $dir; do
		[ -x "$dir/$name" ] && return 0
	done
	command -v "$name" >/dev/null 2>&1
}

command_flag()
{
	have_command "$1" && printf 1 || printf 0
}

board_name_safe()
{
	if have_command board_name; then
		board_name 2>/dev/null
	elif [ -r /tmp/sysinfo/board_name ]; then
		cat /tmp/sysinfo/board_name
	else
		printf unknown
	fi
}

hostname_safe()
{
	uci -q get system.@system[0].hostname 2>/dev/null || hostname 2>/dev/null || printf ImmortalWrt
}

first_lan_ip()
{
	local ip
	ip="$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e "@['ipv4-address'][0].address" 2>/dev/null)"
	[ -n "$ip" ] && {
		printf '%s' "$ip"
		return 0
	}
	ip="$(uci -q get network.lan.ipaddr 2>/dev/null | awk '{print $1}')"
	ip="${ip%%/*}"
	[ -n "$ip" ] && printf '%s' "$ip" || printf ''
}

first_wan_ip()
{
	local ip
	ip="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e "@['ipv4-address'][0].address" 2>/dev/null)"
	[ -n "$ip" ] && {
		printf '%s' "$ip"
		return 0
	}
	ip="$(uci -q get network.wan.ipaddr 2>/dev/null | awk '{print $1}')"
	ip="${ip%%/*}"
	[ -n "$ip" ] && printf '%s' "$ip" || printf ''
}

interface_ipv4_addresses()
{
	local sec proto ips ip first=1
	printf '['
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=interface$/\1/p'); do
		case "$sec" in loopback|wan|wan6|meshconf_wired_mesh|meshconf_wmesh_*) continue ;; esac
		proto="$(uci -q get network."$sec".proto 2>/dev/null)"
		[ "$proto" = "static" ] || continue
		ips="$(uci -q get network."$sec".ipaddr 2>/dev/null)"
		for ip in $ips; do
			ip="${ip%%/*}"
			valid_ipv4 "$ip" || continue
			[ "$first" = "1" ] || printf ','
			printf '{"interface":"%s","address":"%s"}' "$(json_escape "$sec")" "$(json_escape "$ip")"
			first=0
		done
	done
	printf ']'
}

valid_ipv4()
{
	echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
	echo "$1" | awk -F. '{ exit !($1 < 256 && $2 < 256 && $3 < 256 && $4 < 256) }'
}

valid_text_value()
{
	[ "$(printf '%s' "$1" | tr -d '\n\r')" = "$1" ]
}

valid_mesh_key()
{
	local n
	n=${#1}
	[ "$n" -ge 8 ] && [ "$n" -le 63 ] && valid_text_value "$1"
}

valid_wifi_ssid()
{
	local n
	n=${#1}
	[ "$n" -ge 1 ] && [ "$n" -le 32 ] && valid_text_value "$1"
}

# Devices configured from stock LuCI often carry a cipher suffix
# (psk2+ccmp, sae+ccmp, sae-mixed+ccmp ...). hostapd treats those as the
# same security mode as the bare name, so drop the suffix to keep the UI
# select in sync with what is on disk.
normalize_encryption()
{
	local base="${1%%+*}"
	case "$base" in
		none|owe|psk2|psk-mixed|sae|sae-mixed) printf '%s' "$base" ;;
		*) printf '%s' "$1" ;;
	esac
}

valid_wifi_encryption()
{
	case "$1" in
		none|owe|psk2|psk-mixed|sae|sae-mixed) return 0 ;;
	esac
	return 1
}

valid_wifi_key()
{
	local n
	n=${#1}
	[ "$n" -ge 8 ] && [ "$n" -le 63 ] && valid_text_value "$1"
}

valid_uint()
{
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	return 0
}

valid_gw_bandwidth()
{
	local down up
	[ -z "$1" ] && return 0
	valid_text_value "$1" || return 1
	down="${1%/*}"
	up="${1#*/}"
	[ "$down" != "$1" ] || return 1
	valid_uint "$down" && valid_uint "$up"
}

valid_netdev_name()
{
	case "$1" in
		''|.*|*/*|*\\*|*[^A-Za-z0-9_.:-]*) return 1 ;;
	esac
	[ -d "/sys/class/net/$1" ]
}

# Signed integer - mesh_rssi_threshold is negative in practice.
valid_int()
{
	case "$1" in
		''|-|*[^0-9-]*) return 1 ;;
		-*) [ "${1#-}" != "" ] && printf '%s' "${1#-}" | grep -Eq '^[0-9]+$' ;;
		*) return 0 ;;
	esac
}

valid_hex4()
{
	printf '%s' "$1" | grep -Eq '^[0-9A-Fa-f]{4}$'
}

valid_htmode()
{
	local m
	[ -z "$1" ] && return 0
	valid_text_value "$1" || return 1
	for m in $HTMODES; do
		[ "$m" = "$1" ] && return 0
	done
	return 1
}

# Radios carrying an 802.11s backhaul. 802.11s only peers with nodes that use
# the same mesh id, key AND channel, so these radios must never be given a
# different channel than the master when a child config is generated.
mesh_backhaul_radios()
{
	local sec radio out=""
	for sec in $(uci -q show wireless | sed -n 's/^wireless\.\(meshconf_mesh_[0-9]*\)=wifi-iface$/\1/p'); do
		radio="$(uci -q get wireless."$sec".device 2>/dev/null)"
		[ -n "$radio" ] || continue
		out="${out:+$out }$radio"
	done
	printf '%s' "$out"
}

radio_is_mesh_backhaul()
{
	local want="$1" r
	for r in $(mesh_backhaul_radios); do
		[ "$r" = "$want" ] && return 0
	done
	return 1
}

# wpad-basic-* ships hostapd/wpa_supplicant too but has no 802.11s support, so
# mere presence of the binaries says nothing. netifd probes the binary the same
# way (mac80211.sh: wpa_supplicant -vmesh).
wpad_mesh_support()
{
	have_command wpa_supplicant || return 1
	# Run it by absolute path: the probe itself must not depend on PATH.
	"$(command_path wpa_supplicant)" -vmesh >/dev/null 2>&1
}

# Resolve a binary to an absolute path without relying on PATH.
command_path()
{
	local name="$1" dir
	for dir in /usr/sbin /sbin /usr/bin /bin; do
		[ -x "$dir/$name" ] && { printf '%s' "$dir/$name"; return 0; }
	done
	command -v "$name" 2>/dev/null
}

wpad_variant()
{
	local p
	for p in wpad-mesh-mbedtls wpad-mesh-openssl wpad-mesh-wolfssl \
		wpad-mbedtls wpad-openssl wpad-wolfssl wpad \
		wpad-basic-mbedtls wpad-basic-openssl wpad-basic-wolfssl wpad-basic wpad-mini; do
		[ -f "/usr/lib/opkg/info/$p.control" ] && {
			printf '%s' "$p"
			return 0
		}
	done
	printf 'unknown'
}

# Is a full featured iw installed? "iw dev X station set MAC plink_action"
# only exists in the iw-full build.
iw_full_support()
{
	local bin
	[ -f /usr/lib/opkg/info/iw-full.control ] && return 0
	have_command iw || return 1
	bin="$(command_path iw)"
	[ -n "$bin" ] || return 1
	# Read the help into a variable first: piping straight into "grep -q"
	# makes iw die of SIGPIPE once grep exits early, and some shells surface
	# that as a failed pipeline that can take the whole RPC call down.
	"$bin" help 2>&1 | grep 'plink_action' >/dev/null 2>&1
}

# A foreign 802.11s interface (hand written or owned by mesh11sd) is not
# managed by this page, so warn instead of silently ignoring it.
foreign_mesh_sections()
{
	local sec out=""
	for sec in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'); do
		case "$sec" in meshconf_mesh_*) continue ;; esac
		[ "$(uci -q get wireless."$sec".mode 2>/dev/null)" = "mesh" ] || continue
		out="${out:+$out }$sec"
	done
	printf '%s' "$out"
}

mesh11sd_state()
{
	local installed=0 enabled=0
	[ -x /etc/init.d/mesh11sd ] && installed=1
	[ -f /usr/lib/opkg/info/mesh11sd.control ] && installed=1
	[ "$installed" = "1" ] && [ -x /etc/init.d/mesh11sd ] && \
		/etc/init.d/mesh11sd enabled >/dev/null 2>&1 && enabled=1
	printf '{"installed":%s,"enabled":%s}' "$(bool "$installed")" "$(bool "$enabled")"
}

find_bridge_section()
{
	local sec name type
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=device$/\1/p'); do
		name="$(uci -q get network."$sec".name 2>/dev/null)"
		type="$(uci -q get network."$sec".type 2>/dev/null)"
		[ "$name" = "$1" ] && [ "$type" = "bridge" ] && {
			printf '%s' "$sec"
			return 0
		}
	done
	return 1
}

ensure_lan_bridge()
{
	local sec olddev
	sec="$(find_bridge_section br-lan)"
	if [ -z "$sec" ]; then
		uci -q set network.meshconf_br_lan='device'
		uci -q set network.meshconf_br_lan.name='br-lan'
		uci -q set network.meshconf_br_lan.type='bridge'
		sec="meshconf_br_lan"
	fi

	olddev="$(uci -q get network.lan.device 2>/dev/null)"
	if [ -n "$olddev" ] && [ "$olddev" != "br-lan" ] && [ "$olddev" != "bat0" ]; then
		ensure_bridge_port br-lan "$olddev"
	fi
	uci -q set network.lan='interface'
	# A VLAN aware setup keeps lan on a sub-interface (br-lan.1); forcing the
	# device back to br-lan would silently flatten every VLAN bound SSID.
	case "$olddev" in
		br-lan.*) ;;
		*) uci -q set network.lan.device='br-lan' ;;
	esac
	printf '%s' "$sec"
}

bridge_has_port()
{
	local sec port p
	sec="$1"
	port="$2"
	for p in $(uci -q get network."$sec".ports 2>/dev/null); do
		[ "$p" = "$port" ] && return 0
	done
	return 1
}

ensure_bridge_port()
{
	local bridge port sec
	bridge="$1"
	port="$2"
	[ -n "$port" ] || return 0
	sec="$(find_bridge_section "$bridge")"
	if [ -z "$sec" ]; then
		[ "$bridge" = "br-lan" ] && sec="$(ensure_lan_bridge)"
	fi
	[ -n "$sec" ] || return 1
	bridge_has_port "$sec" "$port" || uci -q add_list network."$sec".ports="$port"
}

remove_bridge_port()
{
	local bridge port sec
	bridge="$1"
	port="$2"
	sec="$(find_bridge_section "$bridge")"
	[ -n "$sec" ] || return 0
	while bridge_has_port "$sec" "$port"; do
		uci -q del_list network."$sec".ports="$port" || break
	done
}

# Does this network interface ride the LAN bridge?
#
# Only interfaces on br-lan (or one of its 802.1Q sub-interfaces br-lan.N) are
# carried across the batman-adv fabric, so only those end up in the master's
# flat subnet and only those have to give up their address authority. A
# separate bridge - a hand built guest network on br-guest for example - is
# not bridged into bat0: it stays a per node L2 segment and each node has to
# keep serving it, otherwise clients there get no address at all.
#
# $2 is an optional UCI directory (used when generating a child config).
iface_on_lan_bridge()
{
	local iface="$1" dir="$2" dev
	[ -n "$iface" ] || return 1
	if [ -n "$dir" ]; then
		dev="$(uci -c "$dir" -q get network."$iface".device 2>/dev/null)"
		[ -n "$dev" ] || dev="$(uci -c "$dir" -q get network."$iface".ifname 2>/dev/null)"
	else
		dev="$(uci -q get network."$iface".device 2>/dev/null)"
		[ -n "$dev" ] || dev="$(uci -q get network."$iface".ifname 2>/dev/null)"
	fi
	case "$dev" in
		br-lan|br-lan.*) return 0 ;;
		'') [ "$iface" = "lan" ] ;;
		*) return 1 ;;
	esac
}

disable_lan_dhcp_servers()
{
	local sec iface
	for sec in $(uci -q show dhcp | sed -n 's/^dhcp\.\([^=]*\)=dhcp$/\1/p'); do
		iface="$(uci -q get dhcp."$sec".interface 2>/dev/null)"
		case "$iface" in
			''|wan|wan6) continue ;;
		esac
		iface_on_lan_bridge "$iface" || continue
		uci -q set dhcp."$sec".ignore='1'
		uci -q set dhcp."$sec".dynamicdhcp='0'
		uci -q set dhcp."$sec".dhcpv4='disabled'
		uci -q set dhcp."$sec".dhcpv6='disabled'
		uci -q set dhcp."$sec".ra='disabled'
	done
}

wifi_iface_has_network()
{
	local sec="$1" wanted="$2" net
	for net in $(uci -q get wireless."$sec".network 2>/dev/null); do
		[ "$net" = "$wanted" ] && return 0
	done
	return 1
}

# The AP the page treats as "the" interface of a radio. With multi-SSID a
# radio may have no interface bound to lan at all (every SSID sits on its
# own VLAN), so fall back to the first AP interface of that radio.
find_primary_ap_for_radio()
{
	local radio="$1" sec first_ap=""
	for sec in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get wireless."$sec".device 2>/dev/null)" = "$radio" ] || continue
		[ "$(uci -q get wireless."$sec".mode 2>/dev/null)" = "ap" ] || continue
		wifi_iface_has_network "$sec" lan && {
			printf '%s' "$sec"
			return 0
		}
		[ -n "$first_ap" ] || first_ap="$sec"
	done
	[ -n "$first_ap" ] && {
		printf '%s' "$first_ap"
		return 0
	}
	return 1
}

wifi_radio_count()
{
	uci -q show wireless | grep -c '^wireless\.[^=]*=wifi-device'
}

valid_uci_section_name()
{
	case "$1" in
		''|*[^A-Za-z0-9_]*) return 1 ;;
	esac
	return 0
}

# Every AP interface of one radio, in file order. This is what drives the
# multi-SSID editor: each entry is one SSID with its own VLAN binding and
# its own 802.11k/v roaming switches.
ap_iface_list()
{
	local radio="$1" sec ssid encryption disabled network has_key
	local ieee80211k bss_transition wnm proxy_arp isolate first=1
	local ieee80211r mobility_domain ft_over_ds ft_psk_generate_local
	local reassociation_deadline pmk_r1_push

	printf '['
	for sec in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get wireless."$sec".device 2>/dev/null)" = "$radio" ] || continue
		[ "$(uci -q get wireless."$sec".mode 2>/dev/null)" = "ap" ] || continue

		ssid="$(uci -q get wireless."$sec".ssid 2>/dev/null)"
		encryption="$(uci -q get wireless."$sec".encryption 2>/dev/null)"
		[ -n "$encryption" ] || encryption=none
		encryption="$(normalize_encryption "$encryption")"
		disabled="$(uci -q get wireless."$sec".disabled 2>/dev/null)"
		network="$(uci -q get wireless."$sec".network 2>/dev/null)"
		network="${network%% *}"
		[ -n "$network" ] || network=lan
		ieee80211k="$(uci -q get wireless."$sec".ieee80211k 2>/dev/null)"
		bss_transition="$(uci -q get wireless."$sec".bss_transition 2>/dev/null)"
		wnm="$(uci -q get wireless."$sec".wnm_sleep_mode 2>/dev/null)"
		proxy_arp="$(uci -q get wireless."$sec".proxy_arp 2>/dev/null)"
		isolate="$(uci -q get wireless."$sec".isolate 2>/dev/null)"
		ieee80211r="$(uci -q get wireless."$sec".ieee80211r 2>/dev/null)"
		mobility_domain="$(uci -q get wireless."$sec".mobility_domain 2>/dev/null)"
		ft_over_ds="$(uci -q get wireless."$sec".ft_over_ds 2>/dev/null)"
		ft_psk_generate_local="$(uci -q get wireless."$sec".ft_psk_generate_local 2>/dev/null)"
		reassociation_deadline="$(uci -q get wireless."$sec".reassociation_deadline 2>/dev/null)"
		pmk_r1_push="$(uci -q get wireless."$sec".pmk_r1_push 2>/dev/null)"
		uci -q get wireless."$sec".key >/dev/null 2>&1 && has_key=1 || has_key=0
		[ "$disabled" = "1" ] && disabled=0 || disabled=1

		[ "$first" = "1" ] || printf ','
		printf '{"section":"%s","ssid":"%s","encryption":"%s","has_key":%s,"network":"%s","enabled":%s,"ieee80211k":%s,"bss_transition":%s,"wnm_sleep_mode":%s,"proxy_arp":%s,"isolate":%s,"ieee80211r":%s,"mobility_domain":"%s","ft_over_ds":%s,"ft_psk_generate_local":%s,"reassociation_deadline":"%s","pmk_r1_push":%s}' \
			"$(json_escape "$sec")" "$(json_escape "$ssid")" "$(json_escape "$encryption")" "$(bool "$has_key")" \
			"$(json_escape "$network")" "$(bool "$disabled")" "$(bool "$ieee80211k")" "$(bool "$bss_transition")" \
			"$(bool "$wnm")" "$(bool "$proxy_arp")" "$(bool "$isolate")" \
			"$(bool "$ieee80211r")" "$(json_escape "$mobility_domain")" "$(bool "$ft_over_ds")" \
			"$(bool "$ft_psk_generate_local")" "$(json_escape "$reassociation_deadline")" "$(bool "$pmk_r1_push")"
		first=0
	done
	printf ']'
}

ap_config_list()
{
	local radio sec ssid encryption disabled band channel htmode has_key first=1

	printf '['
	for radio in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-device$/\1/p'); do
		sec="$(find_primary_ap_for_radio "$radio")"
		ssid="$(uci -q get wireless."$sec".ssid 2>/dev/null)"
		encryption="$(uci -q get wireless."$sec".encryption 2>/dev/null)"
		disabled="$(uci -q get wireless."$sec".disabled 2>/dev/null)"
		band="$(uci -q get wireless."$radio".band 2>/dev/null)"
		channel="$(uci -q get wireless."$radio".channel 2>/dev/null)"
		htmode="$(uci -q get wireless."$radio".htmode 2>/dev/null)"
		[ "$disabled" = "1" ] && disabled=0 || disabled=1
		[ -n "$encryption" ] || encryption=none
		encryption="$(normalize_encryption "$encryption")"
		uci -q get wireless."$sec".key >/dev/null 2>&1 && has_key=1 || has_key=0

		[ "$first" = "1" ] || printf ','
		printf '{"radio":"%s","band":"%s","channel":"%s","htmode":"%s","iface":"%s","enabled":%s,"ssid":"%s","encryption":"%s","has_key":%s,"aps":' \
			"$(json_escape "$radio")" "$(json_escape "$band")" "$(json_escape "$channel")" "$(json_escape "$htmode")" \
			"$(json_escape "$sec")" "$(bool "$disabled")" "$(json_escape "$ssid")" "$(json_escape "$encryption")" "$(bool "$has_key")"
		ap_iface_list "$radio"
		printf '}'
		first=0
	done
	printf ']'
}

# Split a bridge-vlan port list ("lan2:u* lan3:u* wan:t") into the plain
# port names carrying that egress mode. Used to prefill the UI checkboxes.
# Egress role of one bridge-vlan port spec, using the same grammar LuCI's
# tools/bridgevlan.js parsePortSpec() implements:
#
#   port       flags ""   -> untagged + PVID   (what the Switch view writes)
#   port:u*    flags "u*" -> untagged + PVID   (what older releases wrote)
#   port:u     flags "u"  -> untagged
#   port:t     flags "t"  -> tagged
#   port:t*    flags "t*" -> tagged + PVID
#   port:ut    flags "ut" -> tagged and untagged at once
#   port:*     flags "*"  -> PVID only, neither egress mode
#
# Prints u (untagged), t (tagged), b (both) or n (neither/unknown).
#
# Getting this wrong is not cosmetic. The VLAN editor rebuilds each ports list
# from what it parsed, so a spec that is mis-read as "port not in this VLAN"
# is silently dropped from the bridge on the next apply.
vlan_port_role()
{
	local flags has_u=0 has_t=0
	flags="${1#*:}"
	[ "$flags" = "$1" ] && flags=""

	case "$flags" in
		*[!ut*]*) printf 'n'; return 0 ;;
	esac
	case "$flags" in *u*) has_u=1 ;; esac
	case "$flags" in *t*) has_t=1 ;; esac
	[ -z "$flags" ] && has_u=1

	if [ "$has_u" = "1" ] && [ "$has_t" = "1" ]; then printf 'b'; return 0; fi
	[ "$has_u" = "1" ] && { printf 'u'; return 0; }
	[ "$has_t" = "1" ] && { printf 't'; return 0; }
	printf 'n'
}

vlan_ports_of()
{
	local p out="" role
	for p in $1; do
		role="$(vlan_port_role "$p")"
		case "$2:$role" in
			u:u|u:b) out="$out ${p%%:*}" ;;
			t:t) out="$out ${p%%:*}" ;;
		esac
	done
	printf '%s' "${out# }"
}

# Port specs on br-lan that this editor cannot write back losslessly: both
# egress modes at once ("port:ut"), or the PVID flag with no egress mode at
# all ("port:*"). The Switch view calls both unsupported and refuses to render
# the bridge; here they would be flattened on the next apply, so applying is
# refused until they are corrected by hand.
vlan_foreign_specs()
{
	local sec dev p role out=""
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=bridge-vlan$/\1/p'); do
		dev="$(uci -q get network."$sec".device 2>/dev/null)"
		[ "$dev" = "br-lan" ] || continue
		for p in $(uci -q get network."$sec".ports 2>/dev/null); do
			case "${p%%:*}" in bat0|mesh_*) continue ;; esac
			role="$(vlan_port_role "$p")"
			case "$role" in b|n) out="${out:+$out }$p" ;; esac
		done
	done
	printf '%s' "$out"
}

# Is $1 still a member of any br-lan bridge-vlan?
vlan_uses_port()
{
	local want="$1" sec p dev
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=bridge-vlan$/\1/p'); do
		dev="$(uci -q get network."$sec".device 2>/dev/null)"
		[ "$dev" = "br-lan" ] || continue
		for p in $(uci -q get network."$sec".ports 2>/dev/null); do
			[ "${p%%:*}" = "$want" ] && return 0
		done
	done
	return 1
}

# Every port name currently referenced by a br-lan bridge-vlan.
vlan_member_ports()
{
	local sec p dev
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=bridge-vlan$/\1/p'); do
		dev="$(uci -q get network."$sec".device 2>/dev/null)"
		[ "$dev" = "br-lan" ] || continue
		for p in $(uci -q get network."$sec".ports 2>/dev/null); do
			printf '%s\n' "${p%%:*}"
		done
	done
}

# "flat" as long as br-lan carries no bridge-vlan: the bridge does no 802.1Q
# filtering, bat0 is an ordinary port and the whole deployment shares one
# broadcast domain. "filtered" from the first bridge-vlan on - bat0 then only
# carries the VLANs it is a tagged member of.
#
# The two modes must not be mixed inside one deployment. A flat node sends
# untagged frames the filtered side drops, and the filtered side sends tagged
# frames the flat node cannot deliver, so the pair looks like a perfectly
# healthy mesh (batctl lists the neighbours) that moves no traffic at all.
bridge_vlan_mode()
{
	local sec dev
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=bridge-vlan$/\1/p'); do
		dev="$(uci -q get network."$sec".device 2>/dev/null)"
		[ "$dev" = "br-lan" ] && { printf 'filtered'; return 0; }
	done
	printf 'flat'
}

# Drop ports that used to belong to a VLAN but are now in none of them: a
# port with no VLAN left must not stay enslaved to br-lan.
#
# Only ports that were VLAN members beforehand are considered, so a flat
# (non VLAN filtered) setup is never touched.
vlan_prune_bridge_ports()
{
	local port
	for port in $1; do
		# bat0 / mesh_* are enslaved to br-lan by the mesh setup, not by
		# VLAN membership. With bridge-vlan in place bat0 *is* a member
		# (tagged) of the VLANs that cross the mesh, so unchecking "carry
		# over the mesh" would otherwise detach it from the bridge and
		# take the whole fabric down.
		case "$port" in bat0|mesh_*) continue ;; esac
		vlan_uses_port "$port" || remove_bridge_port br-lan "$port"
	done
	return 0
}

# Network interfaces an SSID may be bridged into. Everything the mesh
# backend owns (bat0, hardifs) and the upstream WAN is filtered out.
network_option_list()
{
	local sec proto dev ip first=1
	printf '['
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=interface$/\1/p'); do
		case "$sec" in loopback|wan|wan6|bat0|meshconf_wired_mesh|meshconf_wmesh_*) continue ;; esac
		proto="$(uci -q get network."$sec".proto 2>/dev/null)"
		dev="$(uci -q get network."$sec".device 2>/dev/null)"
		ip="$(uci -q get network."$sec".ipaddr 2>/dev/null)"
		ip="${ip%% *}"
		ip="${ip%%/*}"
		[ "$first" = "1" ] || printf ','
		printf '{"name":"%s","device":"%s","proto":"%s","ipaddr":"%s"}' \
			"$(json_escape "$sec")" "$(json_escape "$dev")" "$(json_escape "$proto")" "$(json_escape "$ip")"
		first=0
	done
	printf ']'
}

# Is $1 a switch port rather than a virtual interface that happens to be
# enslaved to br-lan? netifd puts bat0, every mesh_* backhaul interface and
# every wireless VAP into the bridge too, but none of them can carry the tagged
# egress the U/T grid writes. The stock Switch view lists physical
# ethernet/DSA members only, so this page has to agree with it - otherwise the
# two pages show different port sets for the same bridge.
is_physical_lan_port()
{
	case "$1" in
		bat0|mesh_*|wl*|wlan*|phy*|br-*|tun*|tap*|ppp*|wg*|gre*|sit*|6in4*) return 1 ;;
		*) return 0 ;;
	esac
}

# Ports currently enslaved to the LAN bridge - the candidate list for VLAN
# membership.
bridge_port_list()
{
	local sec p first=1
	sec="$(find_bridge_section br-lan)"
	[ -n "$sec" ] || { printf '[]'; return 0; }
	printf '['
	for p in $(uci -q get network."$sec".ports 2>/dev/null); do
		p="${p%%:*}"
		is_physical_lan_port "$p" || continue
		[ "$first" = "1" ] || printf ','
		printf '"%s"' "$(json_escape "$p")"
		first=0
	done
	printf ']'
}

vlan_list()
{
	local sec sec2 dev vlan ports iface proto ipaddr netmask gateway dns first=1
	local trunk p lv ignore dhcpv4

	printf '['
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=bridge-vlan$/\1/p'); do
		dev="$(uci -q get network."$sec".device 2>/dev/null)"
		vlan="$(uci -q get network."$sec".vlan 2>/dev/null)"
		ports="$(uci -q get network."$sec".ports 2>/dev/null)"
		[ -n "$vlan" ] || continue
		# Does this VLAN ride the mesh backhaul? bat0 is only ever a
		# tagged member, so its presence is the whole answer.
		trunk=0
		for p in $ports; do
			[ "${p%%:*}" = "bat0" ] && trunk=1
		done
		# The Switch view exposes "Local"; netifd defaults it to true when
		# the option is absent, so absence has to read as 1 here as well,
		# otherwise the two pages disagree about the same section.
		lv="$(uci -q get network."$sec".local 2>/dev/null)"
		case "$lv" in
			0|false|no|off|disabled) lv=0 ;;
			*) lv=1 ;;
		esac
		iface=""
		for sec2 in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=interface$/\1/p'); do
			[ "$(uci -q get network."$sec2".device 2>/dev/null)" = "${dev}.${vlan}" ] && {
				iface="$sec2"
				break
			}
		done
		proto=""
		ipaddr=""
		netmask=""
		gateway=""
		dns=""
		if [ -n "$iface" ]; then
			proto="$(uci -q get network."$iface".proto 2>/dev/null)"
			ipaddr="$(uci -q get network."$iface".ipaddr 2>/dev/null)"
			ipaddr="${ipaddr%% *}"
			netmask="$(uci -q get network."$iface".netmask 2>/dev/null)"
			gateway="$(uci -q get network."$iface".gateway 2>/dev/null)"
			dns="$(uci -q get network."$iface".dns 2>/dev/null)"
			dns="${dns%% *}"
		fi
		# Report whether a DHCPv4 server is actually running on the segment.
		# Without this the editor always showed "off" on load and the next
		# apply of any unrelated VLAN silently switched a live server off.
		dhcpv4=0
		if [ -n "$iface" ]; then
			ignore="$(uci -q get dhcp."$iface".ignore 2>/dev/null)"
			[ "$(uci -q get dhcp."$iface".dhcpv4 2>/dev/null)" = "disabled" ] && ignore=1
			[ "$ignore" = "1" ] || dhcpv4=1
		fi
		[ "$first" = "1" ] || printf ','
		printf '{"section":"%s","device":"%s","vlan":"%s","iface":"%s","proto":"%s","ipaddr":"%s","netmask":"%s","gateway":"%s","dns":"%s","untagged":"%s","tagged":"%s","trunk":%s,"local":%s,"dhcp":%s}' \
			"$(json_escape "$sec")" "$(json_escape "$dev")" "$(json_escape "$vlan")" "$(json_escape "$iface")" \
			"$(json_escape "$proto")" "$(json_escape "$ipaddr")" "$(json_escape "$netmask")" \
			"$(json_escape "$gateway")" "$(json_escape "$dns")" \
			"$(json_escape "$(vlan_ports_of "$ports" u)")" "$(json_escape "$(vlan_ports_of "$ports" t)")" \
			"$trunk" "$lv" "$dhcpv4"
		first=0
	done
	printf ']'
}

# VLAN ids that carry the batman-adv backhaul. Once a bridge-vlan exists
# netifd turns 802.1Q filtering on and a port belonging to no VLAN forwards
# nothing at all, so bat0 has to be a member of every VLAN that must cross
# the mesh.
bat0_vlan_ids()
{
	local sec dev vlan p out=""
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=bridge-vlan$/\1/p'); do
		dev="$(uci -q get network."$sec".device 2>/dev/null)"
		[ "$dev" = "br-lan" ] || continue
		vlan="$(uci -q get network."$sec".vlan 2>/dev/null)"
		[ -n "$vlan" ] || continue
		for p in $(uci -q get network."$sec".ports 2>/dev/null); do
			[ "${p%%:*}" = "bat0" ] && { out="${out:+$out,}$vlan"; break; }
		done
	done
	printf '%s' "$out"
}

firewall_lan_zone()
{
	local sec
	for sec in $(uci -q show firewall | sed -n 's/^firewall\.\([^=]*\)=zone$/\1/p'); do
		[ "$(uci -q get firewall."$sec".name 2>/dev/null)" = "lan" ] && {
			printf '%s' "$sec"
			return 0
		}
	done
	return 1
}

firewall_zone_has_network()
{
	local net n
	for n in $(uci -q get firewall."$1".network 2>/dev/null); do
		[ "$n" = "$2" ] && return 0
	done
	return 1
}

# Multi-SSID editor: one entry per AP interface of a radio.
#   section - existing wifi-iface to update; empty creates a new one
#   remove  - 1 deletes that wifi-iface instead of updating it
#   network - interface the SSID bridges into (usually a VLAN sub-interface)
apply_ap_configs()
{
	local configs="$1" idx=0 radio section enabled ssid encryption key network
	local ieee80211k bss_transition wnm proxy_arp isolate remove sec n any=0
	local ieee80211r mobility_domain ft_over_ds ft_psk_generate_local
	local reassociation_deadline pmk_r1_push

	valid_text_value "$configs" || {
		printf '{"success":false,"error":"invalid AP settings"}'
		return 1
	}

	while [ "$idx" -lt "$MAX_AP_ENTRIES" ]; do
		radio="$(jsonfilter -s "$configs" -e "@[$idx].radio" 2>/dev/null)"
		[ -n "$radio" ] || break
		idx=$((idx + 1))

		valid_uci_section_name "$radio" || {
			printf '{"success":false,"error":"invalid radio name"}'
			return 1
		}
		[ "$(uci -q get wireless."$radio" 2>/dev/null)" = "wifi-device" ] || {
			printf '{"success":false,"error":"radio %s does not exist"}' "$radio"
			return 1
		}

		section="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].section" 2>/dev/null)"
		remove="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].remove" 2>/dev/null)"
		enabled="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].enabled" 2>/dev/null)"
		ssid="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].ssid" 2>/dev/null)"
		encryption="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].encryption" 2>/dev/null)"
		key="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].key" 2>/dev/null)"
		network="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].network" 2>/dev/null)"
		ieee80211k="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].ieee80211k" 2>/dev/null)"
		bss_transition="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].bss_transition" 2>/dev/null)"
		wnm="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].wnm_sleep_mode" 2>/dev/null)"
		proxy_arp="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].proxy_arp" 2>/dev/null)"
		isolate="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].isolate" 2>/dev/null)"
		ieee80211r="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].ieee80211r" 2>/dev/null)"
		mobility_domain="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].mobility_domain" 2>/dev/null)"
		ft_over_ds="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].ft_over_ds" 2>/dev/null)"
		ft_psk_generate_local="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].ft_psk_generate_local" 2>/dev/null)"
		reassociation_deadline="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].reassociation_deadline" 2>/dev/null)"
		pmk_r1_push="$(jsonfilter -s "$configs" -e "@[$((idx - 1))].pmk_r1_push" 2>/dev/null)"

		case "$remove" in
			1|true)
				[ -n "$section" ] || continue
				[ "$(uci -q get wireless."$section" 2>/dev/null)" = "wifi-iface" ] || continue
				[ "$(uci -q get wireless."$section".device 2>/dev/null)" = "$radio" ] || continue
				uci -q delete wireless."$section" 2>/dev/null
				any=$((any + 1))
				continue
				;;
		esac

		case "$enabled" in
			0|false) enabled=0 ;;
			*) enabled=1 ;;
		esac
		[ -n "$encryption" ] || encryption=sae-mixed
		valid_wifi_encryption "$encryption" || {
			printf '{"success":false,"error":"radio %s: unsupported encryption"}' "$radio"
			return 1
		}
		[ -n "$network" ] || network=lan
		valid_uci_section_name "$network" || {
			printf '{"success":false,"error":"radio %s: invalid network name"}' "$radio"
			return 1
		}
		[ -n "$(uci -q get network."$network" 2>/dev/null)" ] || {
			printf '{"success":false,"error":"radio %s: network %s does not exist"}' "$radio" "$network"
			return 1
		}
		if [ "$enabled" = "1" ]; then
			valid_wifi_ssid "$ssid" || {
				printf '{"success":false,"error":"radio %s: SSID must be 1-32 characters"}' "$radio"
				return 1
			}
		else
			# a switched-off SSID left blank is simply left alone
			[ -n "$ssid" ] || continue
		fi

		sec=""
		if [ -n "$section" ] &&
			[ "$(uci -q get wireless."$section" 2>/dev/null)" = "wifi-iface" ] &&
			[ "$(uci -q get wireless."$section".device 2>/dev/null)" = "$radio" ]; then
			sec="$section"
		else
			n=0
			while [ "$n" -le "$MAX_AP_ENTRIES" ]; do
				sec="meshconf_ap_${radio}_${n}"
				[ -z "$(uci -q get wireless."$sec" 2>/dev/null)" ] && break
				sec=""
				n=$((n + 1))
			done
			[ -n "$sec" ] || {
				printf '{"success":false,"error":"radio %s: no free AP section"}' "$radio"
				return 1
			}
			uci -q set wireless."$sec"='wifi-iface'
			uci -q set wireless."$sec".device="$radio"
			uci -q set wireless."$sec".mode='ap'
		fi

		# an empty key means "keep what is already configured", which is how
		# the form avoids rewriting every password on each apply
		if [ "$encryption" != "none" ] && [ -z "$key" ]; then
			key="$(uci -q get wireless."$sec".key 2>/dev/null)"
		fi
		if [ "$encryption" != "none" ] && ! valid_wifi_key "$key"; then
			printf '{"success":false,"error":"radio %s: wireless key must be 8-63 characters"}' "$radio"
			return 1
		fi

		# 802.11r (FT) hands a roaming client over without a full
		# re-authentication. Every AP advertising the same SSID has to share
		# the 4 hex digit mobility domain, and an open/OWE network cannot
		# do FT at all.
		case "$ieee80211r" in
			1|true)
				case "$encryption" in
					none|owe)
						printf '{"success":false,"error":"radio %s: 802.11r 需要 WPA2/WPA3 加密，开放网络不支持"}' "$radio"
						return 1
						;;
				esac
				valid_hex4 "$mobility_domain" || {
					printf '{"success":false,"error":"radio %s: 移动域必须是 4 位十六进制字符"}' "$radio"
					return 1
				}
				if [ -n "$reassociation_deadline" ]; then
					valid_uint "$reassociation_deadline" || {
						printf '{"success":false,"error":"radio %s: 重关联时限必须是正整数"}' "$radio"
						return 1
					}
					[ "$reassociation_deadline" -ge 1 ] 2>/dev/null && \
						[ "$reassociation_deadline" -le 65535 ] 2>/dev/null || {
						printf '{"success":false,"error":"radio %s: 重关联时限范围是 1-65535"}' "$radio"
						return 1
					}
				fi
				;;
		esac

		if [ "$enabled" = "1" ]; then
			uci -q set wireless."$sec".disabled='0'
		else
			uci -q set wireless."$sec".disabled='1'
		fi
		uci -q set wireless."$sec".ssid="$ssid"
		uci -q set wireless."$sec".encryption="$encryption"
		uci -q set wireless."$sec".network="$network"
		if [ "$encryption" = "none" ]; then
			uci -q delete wireless."$sec".key 2>/dev/null
		else
			uci -q set wireless."$sec".key="$key"
		fi

		# 802.11k / 802.11v roaming aids, written the same way stock LuCI
		# does so the resulting config stays portable
		if [ "$ieee80211k" = "1" ] || [ "$ieee80211k" = "true" ]; then
			uci -q set wireless."$sec".ieee80211k='1'
		else
			uci -q delete wireless."$sec".ieee80211k 2>/dev/null
		fi
		if [ "$bss_transition" = "1" ] || [ "$bss_transition" = "true" ]; then
			uci -q set wireless."$sec".bss_transition='1'
		else
			uci -q delete wireless."$sec".bss_transition 2>/dev/null
		fi
		if [ "$wnm" = "1" ] || [ "$wnm" = "true" ]; then
			uci -q set wireless."$sec".wnm_sleep_mode='1'
			uci -q set wireless."$sec".wnm_sleep_mode_no_keys='1'
		else
			uci -q delete wireless."$sec".wnm_sleep_mode 2>/dev/null
			uci -q delete wireless."$sec".wnm_sleep_mode_no_keys 2>/dev/null
		fi
		if [ "$proxy_arp" = "1" ] || [ "$proxy_arp" = "true" ]; then
			uci -q set wireless."$sec".proxy_arp='1'
		else
			uci -q delete wireless."$sec".proxy_arp 2>/dev/null
		fi
		if [ "$isolate" = "1" ] || [ "$isolate" = "true" ]; then
			uci -q set wireless."$sec".isolate='1'
		else
			uci -q delete wireless."$sec".isolate 2>/dev/null
		fi

		# 802.11r fast BSS transition
		if [ "$ieee80211r" = "1" ] || [ "$ieee80211r" = "true" ]; then
			uci -q set wireless."$sec".ieee80211r='1'
			uci -q set wireless."$sec".mobility_domain="$(printf '%s' "$mobility_domain" | tr 'a-f' 'A-F')"
			uci_bool01 wireless."$sec".ft_over_ds "$ft_over_ds"
			uci_bool01 wireless."$sec".ft_psk_generate_local "$ft_psk_generate_local"
			if [ -n "$reassociation_deadline" ]; then
				uci -q set wireless."$sec".reassociation_deadline="$reassociation_deadline"
			else
				uci -q delete wireless."$sec".reassociation_deadline 2>/dev/null
			fi
			if [ "$pmk_r1_push" = "1" ] || [ "$pmk_r1_push" = "true" ]; then
				uci -q set wireless."$sec".pmk_r1_push='1'
			else
				uci -q delete wireless."$sec".pmk_r1_push 2>/dev/null
			fi
		else
			for p in ieee80211r mobility_domain ft_over_ds ft_psk_generate_local \
				reassociation_deadline pmk_r1_push; do
				uci -q delete wireless."$sec"."$p" 2>/dev/null
			done
		fi

		any=$((any + 1))
	done

	if [ "$any" -gt 0 ]; then
		return 0
	fi
	printf '{"success":false,"error":"没有需要应用的 SSID 配置"}'
	return 1
}

# Push the per-SSID wireless settings without touching batman-adv. Editing
# SSIDs on a plain AP must not silently create a mesh interface.
reload_wifi_later()
{
	local launcher=""
	command -v setsid >/dev/null 2>&1 && launcher="setsid"
	$launcher /bin/sh -c '
		sleep 1
		wifi reload >/dev/null 2>&1 || wifi up >/dev/null 2>&1
	' >/dev/null 2>&1 &
	return 0
}

apply_wireless()
{
	local args="$1" ap_configs channels

	json_load "$args" 2>/dev/null || {
		printf '{"success":false,"error":"bad arguments"}'
		return
	}
	json_get_var ap_configs ap_configs
	json_get_var channels channels

	# Same contract as apply_mesh: an empty AP list means "nothing to
	# rewrite", which is what the page sends now that the per-SSID editor is
	# gone. Only the channel plan is written here in that case.
	case "$(printf '%s' "$ap_configs" | tr -d '[:space:]')" in
		''|'[]') ;;
		*) apply_ap_configs "$ap_configs" || return 1 ;;
	esac
	apply_radio_channels "$channels" || {
		printf '{"success":false,"error":"invalid radio channel settings"}'
		return
	}

	uci -q commit wireless
	reload_wifi_later

	printf '{"success":true,"applied":true}'
}

# ---------------------------------------------------------------------------
# VLAN / network segmentation.
#
# One entry describes a bridge-vlan on the LAN bridge plus the interface that
# rides on top of it (br-lan.<id>); that interface name is what an SSID picks
# as its "network". VLAN 1 carries the management LAN and is never removed,
# otherwise applying the page could lock the operator out.
#
# There are exactly two modes and the page defaults to the first one:
#
#   flat  ("全部透传"): no bridge-vlan at all. netifd does no 802.1Q
#         filtering, bat0 is an ordinary bridge member, and the whole
#         deployment shares one broadcast domain and one subnet. This is what
#         a deployment that never touched VLANs already runs - segmentation
#         is opt-in, and the mesh carries every port with nothing to
#         configure. apply_flat_bridge() below is the way back, and is what
#         collapses a filtered bridge into this state.
#   custom: one bridge-vlan per segment, with bat0 added to every segment it
#         has to carry (the default - see the trunk handling in apply_vlans).
# ---------------------------------------------------------------------------
vlan_delete()
{
	local section="$1" iface="$2" zsec

	if [ -n "$section" ] && [ "$(uci -q get network."$section" 2>/dev/null)" = "bridge-vlan" ]; then
		uci -q delete network."$section" 2>/dev/null
	fi
	if [ -n "$iface" ] && [ "$(uci -q get network."$iface" 2>/dev/null)" = "interface" ]; then
		uci -q delete network."$iface" 2>/dev/null
		uci -q delete dhcp."$iface" 2>/dev/null
		zsec="$(firewall_lan_zone)" && {
			while firewall_zone_has_network "$zsec" "$iface"; do
				uci -q del_list firewall."$zsec".network="$iface" || break
			done
		}
	fi
	return 0
}

# Ports claimed by any br-lan bridge-vlan, in either egress mode.
vlan_claimed_ports()
{
	local sec p dev
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=bridge-vlan$/\1/p'); do
		dev="$(uci -q get network."$sec".device 2>/dev/null)"
		[ "$dev" = "br-lan" ] || continue
		for p in $(uci -q get network."$sec".ports 2>/dev/null); do
			printf '%s\n' "${p%%:*}"
		done
	done
}

port_claimed()
{
	local want="$1" p
	for p in $2; do
		[ "$p" = "$want" ] && return 0
	done
	return 1
}

# Once br-lan carries at least one bridge-vlan netifd turns on VLAN filtering,
# and an interface attached to the bridge itself (br-lan) stops carrying any
# traffic - only the br-lan.<id> sub-interfaces do. Leaving the management
# interface on br-lan therefore blackholes the very connection used to apply
# the change.
#
# VLAN 1 is the management segment this page already reserves, so make sure it
# exists and point network.lan at br-lan.1.
vlan_sync_lan_device()
{
	local dev claimed p sec
	dev="$(uci -q get network.lan.device 2>/dev/null)"
	case "$dev" in
		''|br-lan) ;;
		*) return 0 ;;
	esac

	if [ "$(uci -q get network.meshconf_vlan_1.vlan 2>/dev/null)" = "1" ]; then
		# The management address lives on br-lan.1, so this section has to
		# terminate locally - with local 0 netifd never builds br-lan.1 and
		# the LAN address disappears.
		uci -q set network.meshconf_vlan_1.local='1'
		uci -q set network.lan='interface'
		uci -q set network.lan.device='br-lan.1'
		return 0
	fi

	# No management VLAN and no other VLAN either: this is still a flat,
	# non filtered bridge, so there is nothing to fix up.
	claimed="$(vlan_claimed_ports)"
	[ -n "$claimed" ] || return 0

	uci -q set network.meshconf_vlan_1='bridge-vlan'
	uci -q set network.meshconf_vlan_1.device='br-lan'
	uci -q set network.meshconf_vlan_1.vlan='1'
	uci -q set network.meshconf_vlan_1.local='1'
	uci -q delete network.meshconf_vlan_1.ports 2>/dev/null
	sec="$(find_bridge_section br-lan)"
	for p in $(uci -q get network."$sec".ports 2>/dev/null); do
		p="${p%%:*}"
		# bat0 / mesh_* are backhaul members, they ride tagged, never as
		# the untagged management segment
		case "$p" in bat0|mesh_*) continue ;; esac
		port_claimed "$p" "$claimed" && continue
		uci -q add_list network.meshconf_vlan_1.ports="${p}"
	done

	uci -q set network.lan='interface'
	uci -q set network.lan.device='br-lan.1'
	return 0
}

# Collapse br-lan back into one flat, unfiltered broadcast domain - the mode
# this page ships with ("全部透传").
#
# Without a single bridge-vlan netifd does no 802.1Q filtering, so bat0 is an
# ordinary bridge member and *every* port's traffic crosses the mesh. That is
# also why a node that never configured a VLAN still carries everything: the
# bridge itself is the batman-adv hardif and bat0 sits in it like any other
# member, so no per-port or per-VLAN setup is required for the mesh to work.
#
# Going flat has to undo three things the filtered mode leaves behind:
#   * the bridge-vlan sections themselves,
#   * the br-lan.<id> interfaces riding on them - netifd stops building those
#     devices, so the interfaces would sit on nothing and still show up on the
#     Network page,
#   * the port pruning. A port that ended up in no VLAN was detached from
#     br-lan, and the bridge-vlan port lists deleted here are the only record
#     of it, so the set has to be harvested before the sections go.
apply_flat_bridge()
{
	local sec dev vlan p iface ports="" changed=0

	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=bridge-vlan$/\1/p'); do
		[ "$(uci -q get network."$sec".device 2>/dev/null)" = "br-lan" ] || continue
		for p in $(uci -q get network."$sec".ports 2>/dev/null); do
			p="${p%%:*}"
			is_physical_lan_port "$p" || continue
			port_claimed "$p" "$ports" || ports="$ports $p"
		done
	done

	# Only interfaces actually riding on br-lan.<id> are segment interfaces;
	# skipping `lan` explicitly matters, because in the filtered mode the
	# management interface is exactly the one sitting on br-lan.1.
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=interface$/\1/p'); do
		[ "$sec" = "lan" ] && continue
		dev="$(uci -q get network."$sec".device 2>/dev/null)"
		case "$dev" in
			br-lan.*) vlan_delete "" "$sec" ;;
		esac
	done

	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=bridge-vlan$/\1/p'); do
		[ "$(uci -q get network."$sec".device 2>/dev/null)" = "br-lan" ] || continue
		vlan="$(uci -q get network."$sec".vlan 2>/dev/null)"
		uci -q delete network."$sec" 2>/dev/null
		changed=$((changed + 1))
		logger -t meshconf "flat mode: removed br-lan bridge-vlan ${vlan:-?}"
	done

	# Point the management interface back at the bridge *before* the bridge is
	# ensured. ensure_lan_bridge() re-adds whatever network.lan.device names as
	# a bridge port, so leaving "br-lan.1" in place would add it as a literal
	# port that no device ever provides. Only touched when lan exists: a device
	# that never had one is not this function's business.
	[ -n "$(uci -q get network.lan 2>/dev/null)" ] && uci -q set network.lan.device='br-lan'

	ensure_lan_bridge
	for p in $ports; do
		ensure_bridge_port br-lan "$p"
	done

	# A running mesh keeps bat0 in the bridge; that single membership is what
	# makes all ports reachable across the fabric without any VLAN setup.
	uci -q get network.bat0.proto >/dev/null 2>&1 && ensure_bridge_port br-lan bat0

	uci -q commit network
	uci -q commit dhcp
	uci -q commit firewall
	[ "$changed" -gt 0 ] && reload_network_later

	printf '{"success":true,"changed":%d,"mode":"flat","lan_device":"%s","restored_ports":"%s"}' \
		"$changed" "$(json_escape "$(uci -q get network.lan.device 2>/dev/null)")" \
		"$(json_escape "$(printf '%s' "$ports" | sed 's/^ *//')")"
}

apply_vlans()
{
	local args="$1" vlans idx=0 section vlan iface ipaddr netmask gateway dns mode
	local untagged tagged remove dhcp trunk port sec zsec bsec changed=0 before_ports
	local keep_lan_addr=0 localon foreign pv pu pseen=""

	json_load "$args" 2>/dev/null || {
		printf '{"success":false,"error":"bad arguments"}'
		return
	}
	json_get_var mode mode
	# "flat" is an explicit request for the all-transparent default; it takes
	# no VLAN list with it and is handled entirely on its own.
	if [ "$mode" = "flat" ]; then
		apply_flat_bridge
		return
	fi
	json_get_var vlans vlans
	[ -n "$vlans" ] || {
		printf '{"success":false,"error":"empty VLAN list"}'
		return
	}
	valid_text_value "$vlans" || {
		printf '{"success":false,"error":"invalid VLAN list"}'
		return
	}

	# Ports marked "ut" (both egress modes at once) or "*" (PVID with no egress
	# mode) cannot be expressed in the U/T grid, and this function rewrites
	# every br-lan bridge-vlan section from that grid. Refuse rather than
	# quietly flatten them into a single membership.
	foreign="$(vlan_foreign_specs)"
	[ -n "$foreign" ] && {
		printf '{"success":false,"error":"br-lan 上有本页无法表示的端口标记：%s。请先在 网络 → 交换机/VLAN 页改正后再应用。"}' \
			"$(json_escape "$foreign")"
		return
	}

	# Validate the whole payload before the first uci write. A validation
	# failure halfway through would otherwise leave half-applied changes
	# staged in the rpcd session, ready to be committed by the next call.
	idx=0
	while [ "$idx" -lt "$MAX_VLANS" ]; do
		pv="$(jsonfilter -s "$vlans" -e "@[$idx].vlan" 2>/dev/null)"
		[ -n "$pv" ] || break
		idx=$((idx + 1))
		case "$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].remove" 2>/dev/null)" in
			1|true) continue ;;
		esac
		for pu in $(jsonfilter -s "$vlans" -e "@[$((idx - 1))].untagged" 2>/dev/null); do
			case "$pu" in bat0|mesh_*) continue ;; esac
			case " $pseen " in
				*" $pu "*)
					printf '{"success":false,"error":"端口 %s 被多个 VLAN 设为 untagged；同一端口只能有一个 untagged 网段。"}' \
						"$(json_escape "$pu")"
					return ;;
			esac
			pseen="$pseen $pu"
		done
	done
	idx=0

	# snapshot taken before the first change: afterwards every port that is
	# no longer part of any VLAN is detached from br-lan
	before_ports="$(vlan_member_ports)"

	while [ "$idx" -lt "$MAX_VLANS" ]; do
		vlan="$(jsonfilter -s "$vlans" -e "@[$idx].vlan" 2>/dev/null)"
		[ -n "$vlan" ] || break
		idx=$((idx + 1))

		valid_uint "$vlan" || {
			printf '{"success":false,"error":"invalid VLAN id"}'
			return
		}
		[ "$vlan" -ge 1 ] 2>/dev/null && [ "$vlan" -le 4094 ] 2>/dev/null || {
			printf '{"success":false,"error":"VLAN id must be 1-4094"}'
			return
		}

		section="$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].section" 2>/dev/null)"
		remove="$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].remove" 2>/dev/null)"
		iface="$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].iface" 2>/dev/null)"
		ipaddr="$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].ipaddr" 2>/dev/null)"
		netmask="$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].netmask" 2>/dev/null)"
		gateway="$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].gateway" 2>/dev/null)"
		dns="$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].dns" 2>/dev/null)"
		untagged="$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].untagged" 2>/dev/null)"
		tagged="$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].tagged" 2>/dev/null)"
		dhcp="$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].dhcp" 2>/dev/null)"
		trunk="$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].trunk" 2>/dev/null)"
		localon="$(jsonfilter -s "$vlans" -e "@[$((idx - 1))].local" 2>/dev/null)"

		# VLAN 1 is the management segment and reuses the existing lan
		# interface - stock OpenWrt keeps lan on br-lan.1 as well, so no
		# second interface has to be invented for it.
		if [ -z "$iface" ]; then
			if [ "$vlan" = "1" ]; then iface="lan"; else iface="lan${vlan}"; fi
		fi
		valid_uci_section_name "$iface" || {
			printf '{"success":false,"error":"invalid interface name %s"}' "$iface"
			return
		}
		# blank fields on the existing lan interface mean "keep what is
		# there"; wiping them would drop the management address
		[ "$iface" = "lan" ] && keep_lan_addr=1 || keep_lan_addr=0

		case "$remove" in
			1|true)
				[ "$vlan" = "1" ] && {
					printf '{"success":false,"error":"VLAN 1 是管理网络，不能删除"}'
					return
				}
				vlan_delete "$section" "$iface"
				changed=$((changed + 1))
				continue
				;;
		esac

		# Local termination decides whether a br-lan.<ID> interface exists at
		# all, so it is written explicitly rather than left to the netifd
		# default of true - the Switch view shows it as a checkbox, and a
		# section written without the option would silently disagree with
		# what an operator unchecks there. VLAN 1 carries the management
		# address on br-lan.1, so it is always locally terminated.
		case "$localon" in
			0|false|no|off) localon=0 ;;
			*) localon=1 ;;
		esac
		[ "$vlan" = "1" ] && localon=1

		# A transit-only VLAN has no interface, so its address fields are
		# inactive - validating them would reject input nobody can see.
		if [ "$localon" = "1" ] && [ -n "$ipaddr" ]; then
			valid_ipv4 "$ipaddr" || {
				printf '{"success":false,"error":"VLAN %s: invalid IP address"}' "$vlan"
				return
			}
		fi
		if [ "$localon" = "1" ] && [ -n "$netmask" ]; then
			valid_ipv4 "$netmask" || {
				printf '{"success":false,"error":"VLAN %s: invalid netmask"}' "$vlan"
				return
			}
		fi
		if [ "$localon" = "1" ] && [ -n "$gateway" ]; then
			valid_ipv4 "$gateway" || {
				printf '{"success":false,"error":"VLAN %s: invalid gateway"}' "$vlan"
				return
			}
		fi
		if [ "$localon" = "1" ] && [ -n "$dns" ]; then
			valid_ipv4 "$dns" || {
				printf '{"success":false,"error":"VLAN %s: invalid DNS server"}' "$vlan"
				return
			}
		fi

		if [ -n "$section" ] && [ "$(uci -q get network."$section" 2>/dev/null)" = "bridge-vlan" ]; then
			sec="$section"
		else
			sec="meshconf_vlan_${vlan}"
		fi

		uci -q set network."$sec"='bridge-vlan'
		uci -q set network."$sec".device='br-lan'
		uci -q set network."$sec".vlan="$vlan"
		uci -q set network."$sec".local="$localon"
		uci -q delete network."$sec".ports 2>/dev/null
		for port in $untagged; do
			# bat0 / mesh_* are owned by the mesh setup: the "carry over
			# the mesh" flag below is the single source of truth for
			# them, so they must never come in through the port lists.
			case "$port" in bat0|mesh_*) continue ;; esac
			# A bare port name means untagged + PVID, which is exactly what
			# the Switch view's formatPortSpec() writes. The old ":u*"
			# spelling parses identically but made the raw UCI differ from
			# every other writer in the tree.
			uci -q add_list network."$sec".ports="${port}"
			ensure_bridge_port br-lan "$port"
		done
		for port in $tagged; do
			case "$port" in bat0|mesh_*) continue ;; esac
			uci -q add_list network."$sec".ports="${port}:t"
			ensure_bridge_port br-lan "$port"
		done
		# Which segments cross the mesh is decided here and nowhere else.
		# bat0 only ever rides tagged, and once 802.1Q filtering is on a
		# port that belongs to no VLAN forwards nothing at all.
		#
		# bat0 is only claimed when it is already enslaved to br-lan. Adding
		# it here would leave a dangling bridge member on nodes that run no
		# mesh at all; creating the backhaul port is enable_batman_core's
		# job, this only decides which VLANs it carries.
		#
		# An absent flag means carried. "全部透传" is the default this page
		# ships with, and the Switch view - the other writer of this model -
		# has no such option at all, so a bridge-vlan it created must not end
		# up as a segment that silently stays on one node.
		case "$trunk" in
			0|false|no|off|disabled) ;;
			*)
				bsec="$(find_bridge_section br-lan)"
				[ -n "$bsec" ] && bridge_has_port "$bsec" bat0 &&
					uci -q add_list network."$sec".ports='bat0:t'
				;;
		esac

		if [ "$localon" = "0" ]; then
			# Transit-only segment: this node forwards the VLAN but does not
			# terminate it, so no br-lan.<ID> interface belongs here. Remove
			# one left over from an earlier local setup - it would otherwise
			# sit on a device netifd no longer builds and still be listed on
			# the Network page. `lan` is never touched: VLAN 1 is pinned
			# local above precisely because it carries the management
			# address.
			if [ "$iface" != "lan" ] && [ "$(uci -q get network."$iface" 2>/dev/null)" = "interface" ]; then
				vlan_delete "" "$iface"
			fi
			changed=$((changed + 1))
			continue
		fi

		uci -q set network."$iface"='interface'
		uci -q set network."$iface".device="br-lan.${vlan}"
		uci -q set network."$iface".proto='static'
		uci -q set network."$iface".delegate='0'
		if [ -n "$ipaddr" ]; then
			uci -q set network."$iface".ipaddr="$ipaddr"
		elif [ "$keep_lan_addr" = "0" ]; then
			uci -q delete network."$iface".ipaddr 2>/dev/null
		fi
		if [ -n "$netmask" ]; then
			uci -q set network."$iface".netmask="$netmask"
		elif [ "$keep_lan_addr" = "0" ]; then
			uci -q delete network."$iface".netmask 2>/dev/null
		fi
		if [ -n "$gateway" ]; then
			uci -q set network."$iface".gateway="$gateway"
			# an AP-side segment must not steal the default route
			uci -q set network."$iface".defaultroute='0'
		elif [ "$keep_lan_addr" = "0" ]; then
			uci -q delete network."$iface".gateway 2>/dev/null
			uci -q delete network."$iface".defaultroute 2>/dev/null
		fi
		if [ -n "$dns" ] || [ "$keep_lan_addr" = "0" ]; then
			uci -q delete network."$iface".dns 2>/dev/null
			[ -n "$dns" ] && uci -q add_list network."$iface".dns="$dns"
		fi

		uci -q set dhcp."$iface"='dhcp'
		uci -q set dhcp."$iface".interface="$iface"
		if [ "$dhcp" = "1" ] || [ "$dhcp" = "true" ]; then
			uci -q delete dhcp."$iface".ignore 2>/dev/null
			uci -q delete dhcp."$iface".dynamicdhcp 2>/dev/null
			uci -q set dhcp."$iface".dhcpv4='server'
			uci -q set dhcp."$iface".start='100'
			uci -q set dhcp."$iface".limit='150'
			uci -q set dhcp."$iface".leasetime='12h'
		elif [ "$keep_lan_addr" = "0" ]; then
			uci -q set dhcp."$iface".ignore='1'
			uci -q set dhcp."$iface".dynamicdhcp='0'
		fi

		zsec="$(firewall_lan_zone)" && {
			firewall_zone_has_network "$zsec" "$iface" ||
				uci -q add_list firewall."$zsec".network="$iface"
		}

		changed=$((changed + 1))
	done

	vlan_prune_bridge_ports "$before_ports"
	vlan_sync_lan_device

	uci -q commit network
	uci -q commit dhcp
	uci -q commit firewall
	[ "$changed" -gt 0 ] && reload_network_later

	printf '{"success":true,"changed":%d,"mode":"custom","lan_device":"%s","bridge_mode":"%s","bat0_vlans":"%s"}' \
		"$changed" "$(json_escape "$(uci -q get network.lan.device 2>/dev/null)")" \
		"$(bridge_vlan_mode)" "$(json_escape "$(bat0_vlan_ids)")"
}

# ---------------------------------------------------------------------------
# Mesh roles.
#
# A wired/wireless mesh is operated as one flat subnet: the master keeps the
# address authority (DHCPv4/DHCPv6/RA) while every slave node stays in the
# same subnet and stops answering address requests. The batman-adv gateway
# role is derived from the node role so traffic always leaves through the
# master unless the user explicitly picks a peer (gateway off) setup.
# ---------------------------------------------------------------------------
apply_master_node_role()
{
	uci -q set dhcp.lan='dhcp'
	uci -q set dhcp.lan.interface='lan'
	uci -q delete dhcp.lan.ignore 2>/dev/null
	uci -q set dhcp.lan.dhcpv4='server'
	uci -q set dhcp.lan.dhcpv6='server'
	uci -q set dhcp.lan.ra='server'
	uci -q set dhcp.lan.start='100'
	uci -q set dhcp.lan.limit='150'
	uci -q set dhcp.lan.leasetime='12h'
	[ -n "$(uci -q get network.lan.proto 2>/dev/null)" ] || uci -q set network.lan.proto='static'
}

apply_slave_node_role()
{
	local suffix="$1"

	# keep the node inside the master subnet: when it already holds a static
	# address only the host part is rewritten, so the prefix is preserved.
	[ "$(uci -q get network.lan.proto 2>/dev/null)" = "static" ] && \
		valid_uint "$suffix" && [ "$suffix" -ge 2 ] 2>/dev/null && [ "$suffix" -le 254 ] 2>/dev/null && {
		rewrite_child_static_ips /etc/config "$suffix"
	}

	disable_lan_dhcp_servers
}

# ---------------------------------------------------------------------------
# Unified coverage (wired mesh / EasyMesh style): every radio advertises the
# same SSID, encryption and key so the whole deployment looks like one
# network. Channels stay per-radio (or come from the supplied channel list)
# so neighbouring cells do not sit on the same channel.
# ---------------------------------------------------------------------------
apply_unified_ap()
{
	local ssid="$1" encryption="$2" key="$3" radio sec sec_key any=0

	valid_text_value "$ssid" || return 1
	valid_wifi_ssid "$ssid" || return 1
	[ -n "$encryption" ] || encryption=sae-mixed
	valid_wifi_encryption "$encryption" || return 1

	for radio in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-device$/\1/p'); do
		sec="$(find_primary_ap_for_radio "$radio")"
		if [ -z "$sec" ]; then
			sec="meshconf_ap_${radio}"
			uci -q set wireless."$sec"='wifi-iface'
			uci -q set wireless."$sec".device="$radio"
			uci -q set wireless."$sec".mode='ap'
			uci -q set wireless."$sec".network='lan'
		fi
		uci -q set wireless."$sec".disabled='0'
		uci -q set wireless."$sec".ssid="$ssid"
		uci -q set wireless."$sec".encryption="$encryption"
		if [ "$encryption" = "none" ]; then
			uci -q delete wireless."$sec".key 2>/dev/null
		else
			sec_key="$key"
			[ -n "$sec_key" ] || sec_key="$(uci -q get wireless."$sec".key 2>/dev/null)"
			valid_wifi_key "$sec_key" || return 1
			uci -q set wireless."$sec".key="$sec_key"
		fi
		any=$((any + 1))
	done

	[ "$any" -gt 0 ]
}

apply_radio_channels()
{
	local channels="$1" idx=0 radio channel htmode
	[ -n "$channels" ] || return 0
	valid_text_value "$channels" || return 1
	while [ "$idx" -le "$MAX_WIFI_MESH" ]; do
		radio="$(jsonfilter -s "$channels" -e "@[$idx].radio" 2>/dev/null)"
		channel="$(jsonfilter -s "$channels" -e "@[$idx].channel" 2>/dev/null)"
		htmode="$(jsonfilter -s "$channels" -e "@[$idx].htmode" 2>/dev/null)"
		idx=$((idx + 1))
		[ -n "$radio" ] && [ -n "$channel" ] || continue
		valid_uci_section_name "$radio" || return 1
		[ "$(uci -q get wireless."$radio" 2>/dev/null)" = "wifi-device" ] || return 1
		if [ "$channel" = "auto" ]; then
			uci -q set wireless."$radio".channel='auto'
		else
			valid_uint "$channel" || return 1
			[ "$channel" -ge 1 ] 2>/dev/null && [ "$channel" -le 233 ] 2>/dev/null || return 1
			uci -q set wireless."$radio".channel="$channel"
		fi
		# Channel width matters for a wireless backhaul: an 802.11ax radio
		# peering with an 802.11ac only one has to use the older width
		# (e.g. VHT80 on both), otherwise the link never comes up.
		case "$htmode" in
			''|auto) uci -q delete wireless."$radio".htmode 2>/dev/null ;;
			*)
				valid_htmode "$htmode" || return 1
				uci -q set wireless."$radio".htmode="$htmode"
				;;
		esac
	done
	return 0
}

ipv4_with_suffix()
{
	local value="$1" suffix="$2" ip mask a b c d
	ip="${value%%/*}"
	mask=""
	[ "$ip" != "$value" ] && mask="/${value#*/}"
	valid_ipv4 "$ip" || return 1
	IFS=. read -r a b c d <<EOF
$ip
EOF
	printf '%s.%s.%s.%s%s' "$a" "$b" "$c" "$suffix" "$mask"
}

rewrite_child_static_ips()
{
	local dir="$1" suffix="$2" sec ips ip new_ip count use_list new_ips
	for sec in $(uci -c "$dir" -q show network | sed -n 's/^network\.\([^=]*\)=interface$/\1/p'); do
		[ "$(uci -c "$dir" -q get network."$sec".proto 2>/dev/null)" = "static" ] || continue
		ips="$(uci -c "$dir" -q get network."$sec".ipaddr 2>/dev/null)"
		[ -n "$ips" ] || continue
		count=0
		use_list=0
		new_ips=""
		for ip in $ips; do
			new_ip="$(ipv4_with_suffix "$ip" "$suffix" 2>/dev/null || printf '%s' "$ip")"
			new_ips="${new_ips}${new_ips:+ }$new_ip"
			count=$((count + 1))
			case "$new_ip" in */*) use_list=1 ;; esac
		done
		[ "$count" -gt 1 ] && use_list=1
		uci -c "$dir" -q delete network."$sec".ipaddr 2>/dev/null
		if [ "$use_list" = "1" ]; then
			for ip in $new_ips; do
				uci -c "$dir" -q add_list network."$sec".ipaddr="$ip"
			done
		else
			uci -c "$dir" -q set network."$sec".ipaddr="$new_ips"
		fi
	done
}

disable_child_dhcp_servers()
{
	local dir="$1" sec iface
	for sec in $(uci -c "$dir" -q show dhcp | sed -n 's/^dhcp\.\([^=]*\)=dhcp$/\1/p'); do
		iface="$(uci -c "$dir" -q get dhcp."$sec".interface 2>/dev/null)"
		case "$iface" in
			''|wan|wan6) continue ;;
		esac
		# Same rule as disable_lan_dhcp_servers(): only the LAN bridge is
		# folded into the batman-adv fabric, so only it loses its DHCP server.
		iface_on_lan_bridge "$iface" "$dir" || continue
		uci -c "$dir" -q set dhcp."$sec".ignore='1'
		uci -c "$dir" -q set dhcp."$sec".dynamicdhcp='0'
		uci -c "$dir" -q set dhcp."$sec".dhcpv4='disabled'
		uci -c "$dir" -q set dhcp."$sec".dhcpv6='disabled'
		uci -c "$dir" -q set dhcp."$sec".ra='disabled'
	done
}

configure_child_firewall()
{
	local dir="$1" sec name src dest net
	for sec in $(uci -c "$dir" -q show firewall | sed -n 's/^firewall\.\([^=]*\)=zone$/\1/p'); do
		name="$(uci -c "$dir" -q get firewall."$sec".name 2>/dev/null)"
		if [ "$name" = "lan" ]; then
			uci -c "$dir" -q set firewall."$sec".input='ACCEPT'
			uci -c "$dir" -q set firewall."$sec".output='ACCEPT'
			uci -c "$dir" -q set firewall."$sec".forward='ACCEPT'
		elif [ "$name" = "wan" ]; then
			for net in $(uci -c "$dir" -q get firewall."$sec".network 2>/dev/null); do
				case "$net" in
					wan|wan6) uci -c "$dir" -q del_list firewall."$sec".network="$net" ;;
				esac
			done
		fi
	done
	for sec in $(uci -c "$dir" -q show firewall | sed -n 's/^firewall\.\([^=]*\)=forwarding$/\1/p'); do
		src="$(uci -c "$dir" -q get firewall."$sec".src 2>/dev/null)"
		dest="$(uci -c "$dir" -q get firewall."$sec".dest 2>/dev/null)"
		[ "$src" = "lan" ] && [ "$dest" = "wan" ] && uci -c "$dir" -q delete firewall."$sec"
	done
}

# Preferred non-overlapping channels per band; this list must stay in sync
# with CHANNEL_SPREAD in meshconf.js. Child node ordinal $2 (0 = master, may
# be negative) selects the channel via modulo.
child_band_channel()
{
	local band="$1" off="$2" n idx
	case "$band" in
		2g) set -- 1 6 11 2 7 12 3 8 13 ;;
		5g) set -- 36 149 44 153 52 157 60 161 100 165 ;;
		6g) set -- 37 5 69 101 133 165 197 229 ;;
		*) return 1 ;;
	esac
	n=$#
	idx=$(( (off % n + n) % n + 1 ))
	eval "printf '%s' \"\${$idx}\""
}

# Whether $2 is one of the preferred pool entries for band $1. "auto" and any
# value outside the pool returns false so the master can be pinned to slot 0
# before children are generated.
channel_in_pool()
{
	local band="$1" ch="$2" pool i
	case "$band" in
		2g) pool="1 6 11 2 7 12 3 8 13" ;;
		5g) pool="36 149 44 153 52 157 60 161 100 165" ;;
		6g) pool="37 5 69 101 133 165 197 229" ;;
		*) return 1 ;;
	esac
	for i in $pool; do
		[ "$i" = "$ch" ] && return 0
	done
	return 1
}

# Pin master radios whose channel is auto or off-pool to slot 0 of their band
# pool so child nodes (offset >= 1) never share a channel with the master.
# Backhaul radios are always pinned when they are on "auto": an 802.11s link
# cannot form on an auto channel because every node has to pick the same one.
# Only commits when something actually changed; collects the per-radio
# adjustment JSON in global MASTER_ADJUSTMENTS_JSON.
master_fix_channels()
{
	local radio band cur fixed el bh
	MASTER_ADJUSTMENTS_JSON=""
	for radio in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-device$/\1/p'); do
		band="$(uci -q get wireless."$radio".band 2>/dev/null)"
		cur="$(uci -q get wireless."$radio".channel 2>/dev/null)"
		radio_is_mesh_backhaul "$radio" && bh=1 || bh=0
		case "$cur" in
			auto|'') : ;;
			*) [ "$bh" = "1" ] && continue
				channel_in_pool "$band" "$cur" && continue ;;
		esac
		fixed="$(child_band_channel "$band" 0)" || continue
		[ "$fixed" = "$cur" ] && continue
		uci -q set wireless."$radio".channel="$fixed"
		el="$(printf '{"radio":"%s","band":"%s","from":"%s","to":"%s","backhaul":%s}' \
			"$(json_escape "$radio")" "$(json_escape "$band")" \
			"$(json_escape "$cur")" "$(json_escape "$fixed")" "$(bool "$bh")")"
		if [ -n "$MASTER_ADJUSTMENTS_JSON" ]; then
			MASTER_ADJUSTMENTS_JSON="$MASTER_ADJUSTMENTS_JSON,$el"
		else
			MASTER_ADJUSTMENTS_JSON="$el"
		fi
	done
	[ -n "$MASTER_ADJUSTMENTS_JSON" ] && uci -q commit wireless
}

# Rewrite channels in the child config copy so same-band APs never share a
# channel.
#
# Radios carrying the 802.11s backhaul are deliberately left on the master's
# channel: 802.11s peers only on a shared channel, so spreading those radios
# would produce a child that can never establish a peer link.
#
# Runs in the current shell (uci staging must survive until the caller
# commits) and returns the "channels":[...] JSON elements in the global
# CHILD_CHANNEL_JSON.
child_spread_channels()
{
	local dir="$1" offset="$2" radio band ch el bh
	CHILD_CHANNEL_JSON=""
	for radio in $(uci -c "$dir" -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-device$/\1/p'); do
		band="$(uci -c "$dir" -q get wireless."$radio".band 2>/dev/null)"
		if radio_is_mesh_backhaul "$radio"; then
			bh=1
			# master_fix_channels already committed the pinned value
			ch="$(uci -q get wireless."$radio".channel 2>/dev/null)"
			[ -n "$ch" ] || ch="$(child_band_channel "$band" 0)" || continue
		else
			bh=0
			ch="$(child_band_channel "$band" "$offset")" || continue
		fi
		uci -c "$dir" -q set wireless."$radio".channel="$ch"
		el="$(printf '{"radio":"%s","band":"%s","channel":"%s","backhaul":%s}' \
			"$(json_escape "$radio")" "$(json_escape "$band")" "$(json_escape "$ch")" "$(bool "$bh")")"
		if [ -n "$CHILD_CHANNEL_JSON" ]; then
			CHILD_CHANNEL_JSON="$CHILD_CHANNEL_JSON,$el"
		else
			CHILD_CHANNEL_JSON="$el"
		fi
	done
}

generate_child_config()
{
	local args="$1" ip_suffix offset dir stamp f
	json_load "$args" 2>/dev/null || { printf '{"success":false,"error":"bad arguments"}'; return; }
	json_get_var ip_suffix ip_suffix
	json_get_var offset offset
	valid_uint "$ip_suffix" || { printf '{"success":false,"error":"invalid child IP suffix"}'; return; }
	[ "$ip_suffix" -ge 2 ] 2>/dev/null && [ "$ip_suffix" -le 254 ] 2>/dev/null || {
		printf '{"success":false,"error":"child IP suffix must be 2-254"}'
		return
	}
	printf '%s' "$offset" | grep -Eq '^-?[0-9]+$' || offset=0

	stamp="$(date +%Y%m%d-%H%M%S 2>/dev/null || date +%s)-$$"
	dir="/tmp/meshconf-child-$stamp"
	mkdir -p "$dir" 2>/dev/null || { printf '{"success":false,"error":"failed to create child config directory"}'; return; }
	for f in network wireless dhcp firewall; do
		if [ -f "/etc/config/$f" ]; then
			cp -p "/etc/config/$f" "$dir/$f" 2>/dev/null || {
				printf '{"success":false,"error":"failed to copy %s"}' "$f"
				return
			}
		else
			: > "$dir/$f"
		fi
	done

	uci -c "$dir" -q delete network.wan 2>/dev/null
	uci -c "$dir" -q delete network.wan6 2>/dev/null
	rewrite_child_static_ips "$dir" "$ip_suffix"
	disable_child_dhcp_servers "$dir"
	configure_child_firewall "$dir"
	# Pin master off-pool / auto radios to slot 0 before spreading children
	# so the master never shares a channel with any of its children.
	master_fix_channels
	child_spread_channels "$dir" "$offset"
	for f in network wireless dhcp firewall; do
		uci -c "$dir" -q commit "$f"
	done

	printf '{"success":true,"path":"%s","master_adjustments":[%s],"channels":[%s],"files":{"network":' \
		"$(json_escape "$dir")" "$MASTER_ADJUSTMENTS_JSON" "$CHILD_CHANNEL_JSON"
	json_file_string "$dir/network"
	printf ',"wireless":'
	json_file_string "$dir/wireless"
	printf ',"dhcp":'
	json_file_string "$dir/dhcp"
	printf ',"firewall":'
	json_file_string "$dir/firewall"
	printf '}}'
}

# Commit happens before this call and the RPC reply is produced after it.
# The delayed reload must not start until the reply has reached the browser,
# otherwise switching the management IP (e.g. router -> AP/DHCP) tears down
# the very TCP connection carrying the success response and the UI reports
# a false failure. Fully detach the job (new session, all fds redirected) so
# rpcd/uhttpd do not wait on it either.
reload_network_later()
{
	local launcher=""
	command -v setsid >/dev/null 2>&1 && launcher="setsid"
	$launcher /bin/sh -c '
		sleep 2
		/etc/init.d/network reload >/dev/null 2>&1 || /etc/init.d/network restart >/dev/null 2>&1
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
		/etc/init.d/odhcpd restart >/dev/null 2>&1
		/etc/init.d/firewall reload >/dev/null 2>&1
		wifi reload >/dev/null 2>&1
	' </dev/null >/dev/null 2>&1 &
}

delete_mesh_sections()
{
	local i
	uci -q delete network.meshconf_wired_mesh 2>/dev/null
	for i in $(seq 0 "$MAX_WIFI_MESH"); do
		uci -q delete network.meshconf_wmesh_"$i" 2>/dev/null
		uci -q delete wireless.meshconf_mesh_"$i" 2>/dev/null
	done
}

# ---------------------------------------------------------------------------
# 802.11s operating parameters.
#
# netifd supports far more than the handful this page writes by default
# (mesh_fwding / mesh_ttl / mesh_auto_open_plinks / mcast_rate). Every other
# parameter is optional: an empty value removes the UCI option so the kernel
# default applies again. Names are taken verbatim from netifd's
# mesh_param_list - including the upstream typo mesh_sync_offset_max_neighor.
# ---------------------------------------------------------------------------
apply_mesh_params()
{
	local sec="$1" params="$2" p v

	# clear first so a field the operator emptied really falls back to the
	# kernel default instead of keeping a stale value
	for p in $MESH_PARAM_INT $MESH_PARAM_BOOL $MESH_PARAM_STRING; do
		uci -q delete wireless."$sec"."$p" 2>/dev/null
	done

	[ -n "$params" ] || return 0
	valid_text_value "$params" || return 1

	for p in $MESH_PARAM_INT $MESH_PARAM_BOOL $MESH_PARAM_STRING; do
		v="$(jsonfilter -s "$params" -e "@.$p" 2>/dev/null)"
		[ -n "$v" ] || continue
		case " $MESH_PARAM_INT " in
			*" $p "*) valid_int "$v" || return 1 ;;
		esac
		case " $MESH_PARAM_BOOL " in
			*" $p "*)
				case "$v" in 0|1) ;; *) return 1 ;; esac
				;;
		esac
		case " $MESH_PARAM_STRING " in
			*" $p "*)
				case "$v" in active|light|deep) ;; *) return 1 ;; esac
				;;
		esac
		uci -q set wireless."$sec"."$p"="$v"
	done
	return 0
}

mesh_param_list_json()
{
	local sec="$1" p v first=1
	printf '{'
	for p in $MESH_PARAM_INT $MESH_PARAM_BOOL $MESH_PARAM_STRING; do
		v="$(uci -q get wireless."$sec"."$p" 2>/dev/null)"
		[ -n "$v" ] || continue
		[ "$first" = "1" ] || printf ','
		printf '"%s":"%s"' "$p" "$(json_escape "$v")"
		first=0
	done
	printf '}'
}

# One batman-adv mesh setting. $3 is the default used when the operator left
# the field empty or typed something out of range - netifd would reject a bad
# value at reload time and take the whole interface down, so clamp instead.
bat_param_value()
{
	local key="$1" adv="$2" v
	v="$(jsonfilter -s "$adv" -e "@.$key" 2>/dev/null)"
	if [ -n "$v" ]; then
		case "$key" in
			hop_penalty)
				if valid_uint "$v" && [ "$v" -le 255 ] 2>/dev/null; then printf '%s' "$v"; return 0; fi ;;
			orig_interval)
				if valid_uint "$v" && [ "$v" -le 100000 ] 2>/dev/null; then printf '%s' "$v"; return 0; fi ;;
			multicast_fanout)
				if valid_uint "$v" && [ "$v" -ge 1 ] 2>/dev/null && [ "$v" -le 64 ] 2>/dev/null; then
					printf '%s' "$v"; return 0; fi ;;
			log_level)
				if valid_uint "$v" && [ "$v" -le 15 ] 2>/dev/null; then printf '%s' "$v"; return 0; fi ;;
			fragmentation|network_coding|bonding|multicast_mode|distributed_arp_table|bridge_loop_avoidance|ap_isolation)
				case "$v" in 0|1) printf '%s' "$v"; return 0 ;; esac ;;
		esac
	fi
	printf '%s' "$3"
}

enable_batman_core()
{
	local algo="$1" adv="$2"
	case "$algo" in
		BATMAN_IV|BATMAN_V) ;;
		*) algo=BATMAN_IV ;;
	esac
	uci -q set network.bat0='interface'
	uci -q set network.bat0.proto='batadv'
	uci -q set network.bat0.routing_algo="$algo"
	uci -q set network.bat0.aggregated_ogms='1'
	uci -q set network.bat0.bridge_loop_avoidance="$(bat_param_value bridge_loop_avoidance "$adv" 1)"
	uci -q set network.bat0.distributed_arp_table="$(bat_param_value distributed_arp_table "$adv" 1)"
	uci -q set network.bat0.fragmentation="$(bat_param_value fragmentation "$adv" 1)"
	uci -q set network.bat0.hop_penalty="$(bat_param_value hop_penalty "$adv" 30)"
	uci -q set network.bat0.log_level="$(bat_param_value log_level "$adv" 0)"
	uci -q set network.bat0.multicast_fanout="$(bat_param_value multicast_fanout "$adv" 16)"
	uci -q set network.bat0.multicast_mode="$(bat_param_value multicast_mode "$adv" 1)"
	uci -q set network.bat0.network_coding="$(bat_param_value network_coding "$adv" 0)"
	uci -q set network.bat0.orig_interval="$(bat_param_value orig_interval "$adv" 1000)"
	uci -q set network.bat0.bonding="$(bat_param_value bonding "$adv" 0)"
	uci -q set network.bat0.ap_isolation="$(bat_param_value ap_isolation "$adv" 0)"
	ensure_lan_bridge
	ensure_bridge_port br-lan bat0
}

bat_settings_json()
{
	local k v first=1
	printf '{'
	for k in routing_algo aggregated_ogms bridge_loop_avoidance distributed_arp_table \
		fragmentation hop_penalty log_level multicast_fanout multicast_mode \
		network_coding orig_interval bonding ap_isolation gw_mode gw_sel_class gw_bandwidth; do
		v="$(uci -q get network.bat0."$k" 2>/dev/null)"
		[ -n "$v" ] || continue
		[ "$first" = "1" ] || printf ','
		printf '"%s":"%s"' "$k" "$(json_escape "$v")"
		first=0
	done
	printf '}'
}

apply_mesh()
{
	local args="$1" wired wireless mesh_radios mesh_id mesh_key gateway gw_bandwidth gw_sel_class ap_sync ap_configs radio idx netif ifname
	local role backhaul unified unified_ssid unified_encryption unified_key channels mesh_radio slave_ip_suffix
	local mesh_proto mesh_params bat_algo bat_advanced use_batman fwding band
	local old_iface=""

	json_load "$args" 2>/dev/null || { printf '{"success":false,"error":"bad arguments"}'; return; }
	json_get_var wired wired
	json_get_var wireless wireless
	json_get_var mesh_radios mesh_radios
	json_get_var mesh_id mesh_id
	json_get_var mesh_key mesh_key
	json_get_var gateway gateway
	json_get_var gw_bandwidth gw_bandwidth
	json_get_var gw_sel_class gw_sel_class
	json_get_var ap_sync ap_sync
	json_get_var ap_configs ap_configs
	role=""
	backhaul=""
	unified=""
	unified_ssid=""
	unified_encryption=""
	unified_key=""
	channels=""
	mesh_radio=""
	slave_ip_suffix=""
	json_get_var role role
	json_get_var backhaul backhaul
	json_get_var unified unified
	json_get_var unified_ssid unified_ssid
	json_get_var unified_encryption unified_encryption
	json_get_var unified_key unified_key
	json_get_var channels channels
	json_get_var mesh_radio mesh_radio
	json_get_var slave_ip_suffix slave_ip_suffix
	json_get_var mesh_proto mesh_proto
	json_get_var mesh_params mesh_params
	json_get_var bat_algo bat_algo
	json_get_var bat_advanced bat_advanced

	# Backhaul mode is the primary switch; the legacy wired/wireless flags
	# are still accepted when no mode is supplied. Only one link is offered
	# at a time - a node is either wired or wireless.
	case "$backhaul" in
		wired) wired=1; wireless=0 ;;
		wireless) wired=0; wireless=1 ;;
		off) wired=0; wireless=0 ;;
	esac

	# Wireless backhaul is a single select (5G / 6G radio), not a checkbox
	# set. An explicit single radio overrides any legacy list.
	[ -n "$mesh_radio" ] && {
		valid_uci_section_name "$mesh_radio" || { printf '{"success":false,"error":"invalid mesh radio"}'; return; }
		mesh_radios="[\"$mesh_radio\"]"
	}

	# Node role drives the batman-adv gateway role so master/slave stays
	# consistent with the address authority (DHCP) on the LAN side.
	case "$role" in
		master) gateway=server ;;
		slave) gateway=client ;;
		peer) gateway=off ;;
	esac

	[ "$wired" = "1" ] || wired=0
	[ "$wireless" = "1" ] || wireless=0
	[ "$ap_sync" = "1" ] || ap_sync=0
	[ "$unified" = "1" ] && ap_sync=1
	[ "$wired" = "1" ] || [ "$wireless" = "1" ] || ap_sync=0
	mesh_id="${mesh_id:-XR1710G-MESH}"
	mesh_key="${mesh_key:-12345678}"
	gateway="${gateway:-off}"
	gw_bandwidth=""
	gw_sel_class="${gw_sel_class:-20}"

	case "$mesh_proto" in
		''|batman) mesh_proto=batman ;;
		hwmp) ;;
		*) printf '{"success":false,"error":"invalid backhaul protocol"}'; return ;;
	esac
	# hwmp describes how the *wireless* link routes. A wired backhaul has no
	# L2 routing protocol of its own, so it keeps batman-adv regardless.
	use_batman=1
	if [ "$mesh_proto" = "hwmp" ] && [ "$wired" != "1" ]; then
		use_batman=0
	fi
	if [ "$mesh_proto" = "hwmp" ]; then fwding=1; else fwding=0; fi

	# Wired backhaul always rides br-lan itself: the bridge is the
	# batman-adv hardif and every LAN/WAN port transparently carries mesh
	# traffic (bridge loop avoidance on bat0 prevents L2 loops).
	valid_text_value "$mesh_id" || { printf '{"success":false,"error":"invalid mesh id"}'; return; }
	case "$gateway" in
		off|server|client) ;;
		*) printf '{"success":false,"error":"invalid mesh gateway role"}'; return ;;
	esac
	if [ "$wireless" = "1" ] && [ -n "$mesh_radios" ]; then
		for radio in $(printf '%s' "$mesh_radios" | jsonfilter -e '@[*]' 2>/dev/null); do
			valid_uci_section_name "$radio" || { printf '{"success":false,"error":"invalid mesh radio list"}'; return; }
			[ "$(uci -q get wireless."$radio" 2>/dev/null)" = "wifi-device" ] || {
				printf '{"success":false,"error":"mesh radio %s does not exist"}' "$(json_escape "$radio")"
				return
			}
			# Only 5G/6G may carry the 802.11s backhaul. The 2.4G radio is
			# the band every legacy client still depends on and has neither
			# the bandwidth nor the airtime for a mesh link, so a request
			# that names it is a mistake rather than a preference. An empty
			# / unknown band is left alone: drivers that predate the band
			# option would otherwise be impossible to configure at all.
			band="$(uci -q get wireless."$radio".band 2>/dev/null)"
			case "$band" in
				''|5g|6g) ;;
				*)
					printf '{"success":false,"error":"mesh radio %s is a %s radio; only 5G/6G radios can carry the wireless backhaul"}' \
						"$(json_escape "$radio")" "$(json_escape "$band")"
					return
					;;
			esac
		done
	fi
	valid_gw_bandwidth "$gw_bandwidth" || {
		printf '{"success":false,"error":"invalid gateway bandwidth, expected down/up kbit such as 1000000/1000000"}'
		return
	}
	valid_uint "$gw_sel_class" || { printf '{"success":false,"error":"invalid gateway selection class"}'; return; }
	[ "$wireless" = "0" ] || valid_mesh_key "$mesh_key" || {
		printf '{"success":false,"error":"wireless mesh key must be 8-63 characters"}'
		return
	}
	if [ "$unified" = "1" ]; then
		valid_text_value "$unified_ssid" || {
			printf '{"success":false,"error":"invalid unified SSID"}'
			return
		}
		valid_wifi_ssid "$unified_ssid" || {
			printf '{"success":false,"error":"unified SSID must be 1-32 characters"}'
			return
		}
		[ -n "$unified_encryption" ] || unified_encryption=sae-mixed
		valid_wifi_encryption "$unified_encryption" || {
			printf '{"success":false,"error":"invalid unified encryption"}'
			return
		}
		if [ "$unified_encryption" != "none" ] && [ -n "$unified_key" ] && ! valid_wifi_key "$unified_key"; then
			printf '{"success":false,"error":"unified wireless key must be 8-63 characters"}'
			return
		fi
	elif [ "$ap_sync" = "1" ] && [ -n "$ap_configs" ]; then
		# The payload is optional now: the page no longer carries a per-SSID
		# editor, so a node whose radios are all dedicated to the backhaul
		# legitimately sends nothing. Only a malformed payload is an error -
		# refusing an empty one would fail the whole apply for a node that
		# has nothing to say about coverage.
		valid_text_value "$ap_configs" || {
			printf '{"success":false,"error":"invalid AP settings"}'
			return
		}
	fi

	# migration: builds with a dedicated wired hardif removed one port from
	# br-lan; remember it so it rejoins the bridge before sections are wiped
	if uci -q get network.meshconf_wired_mesh.proto >/dev/null 2>&1; then
		old_iface="$(uci -q get network.meshconf_wired_mesh.device 2>/dev/null)"
		[ "$old_iface" = "br-lan" ] && old_iface=""
	fi

	delete_mesh_sections

	if [ "$wired" = "1" ] || [ "$wireless" = "1" ]; then
		if [ "$use_batman" = "1" ]; then
			enable_batman_core "$bat_algo" "$bat_advanced"
			uci -q set network.bat0.gw_mode="$gateway"
			uci -q set network.bat0.meshconf_ap_sync="$ap_sync"
			uci -q delete network.bat0.gw_bandwidth 2>/dev/null
			uci -q delete network.bat0.gw_sel_class 2>/dev/null
			if [ "$gateway" = "server" ]; then
				# no UI knob any more: always announce the maximum bandwidth so
				# gateway selection depends on link quality only
				[ -n "$gw_bandwidth" ] || gw_bandwidth="$GW_BANDWIDTH_MAX"
				uci -q set network.bat0.gw_bandwidth="$gw_bandwidth"
			elif [ "$gateway" = "client" ]; then
				uci -q set network.bat0.gw_sel_class="$gw_sel_class"
			fi
		else
			# plain 802.11s with the kernel HWMP protocol: no batman-adv at
			# all, the mesh interface is bridged into lan below
			remove_bridge_port br-lan bat0
			uci -q delete network.bat0 2>/dev/null
			ensure_lan_bridge
		fi

		# master keeps the LAN address authority, a slave hands it over so
		# every mesh node ends up in one subnet with a single DHCP server
		case "$role" in
			master) apply_master_node_role ;;
			slave) apply_slave_node_role "$slave_ip_suffix" ;;
		esac
	else
		remove_bridge_port br-lan bat0
		uci -q delete network.bat0 2>/dev/null
	fi

	if [ "$wired" = "1" ] && [ "$use_batman" = "1" ]; then
		# a port previously dedicated to mesh rejoins br-lan before the
		# whole bridge is used as the hardif
		if [ -n "$old_iface" ] && [ "$old_iface" != "br-lan" ] && valid_netdev_name "$old_iface"; then
			ensure_bridge_port br-lan "$old_iface"
		fi

		# br-lan itself is the hardif (batctl -M allows bridges); every
		# LAN/WAN port carries batman-adv traffic, bridge_loop_avoidance on
		# bat0 prevents L2 loops.
		uci -q set network.meshconf_wired_mesh='interface'
		uci -q set network.meshconf_wired_mesh.proto='batadv_hardif'
		uci -q set network.meshconf_wired_mesh.master='bat0'
		uci -q set network.meshconf_wired_mesh.device='br-lan'
	else
		# mesh wired transport disabled: return a previously dedicated port
		# to br-lan (AP mode without a stored section also re-adds wan)
		if [ -n "$old_iface" ] && [ "$old_iface" != "br-lan" ] && valid_netdev_name "$old_iface"; then
			ensure_bridge_port br-lan "$old_iface"
		elif [ "$(uci -q get network.lan.proto 2>/dev/null)" = "dhcp" ]; then
			ensure_bridge_port br-lan wan
		fi
	fi

	idx=0
	if [ "$wireless" = "1" ]; then
		for radio in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-device$/\1/p'); do
			[ "$idx" -le "$MAX_WIFI_MESH" ] || break
			mesh_radio_selected "$radio" "$mesh_radios" || continue
			netif="meshconf_wmesh_$idx"
			ifname="mesh_${radio}"
			uci -q set wireless.meshconf_mesh_"$idx"='wifi-iface'
			uci -q set wireless.meshconf_mesh_"$idx".device="$radio"
			uci -q set wireless.meshconf_mesh_"$idx".ifname="$ifname"
			uci -q set wireless.meshconf_mesh_"$idx".mode='mesh'
			uci -q set wireless.meshconf_mesh_"$idx".mesh_id="$mesh_id"
			uci -q set wireless.meshconf_mesh_"$idx".mcast_rate='24000'
			uci -q set wireless.meshconf_mesh_"$idx".encryption='sae'
			uci -q set wireless.meshconf_mesh_"$idx".key="$mesh_key"
		uci -q set wireless.meshconf_mesh_"$idx".disabled='0'
		# marker so the page can restore the selected backhaul protocol;
		# ignored by netifd, which only reads the options it knows
		uci -q set wireless.meshconf_mesh_"$idx".meshconf_proto="$mesh_proto"

		# optional parameters first, so the defaults below only fill in
			# what the operator left empty
			apply_mesh_params "meshconf_mesh_$idx" "$mesh_params" || {
				printf '{"success":false,"error":"802.11s 参数无效"}'
				return
			}
			[ -n "$(uci -q get wireless.meshconf_mesh_"$idx".mesh_ttl 2>/dev/null)" ] ||
				uci -q set wireless.meshconf_mesh_"$idx".mesh_ttl='1'
			[ -n "$(uci -q get wireless.meshconf_mesh_"$idx".mesh_auto_open_plinks 2>/dev/null)" ] ||
				uci -q set wireless.meshconf_mesh_"$idx".mesh_auto_open_plinks='0'
			[ -n "$(uci -q get wireless.meshconf_mesh_"$idx".mesh_fwding 2>/dev/null)" ] ||
				uci -q set wireless.meshconf_mesh_"$idx".mesh_fwding="$fwding"

			if [ "$use_batman" = "1" ]; then
				uci -q set network."$netif"='interface'
				uci -q set network."$netif".proto='batadv_hardif'
				uci -q set network."$netif".master='bat0'
				uci -q set network."$netif".device="$ifname"
				uci -q set network."$netif".mtu='2304'
				uci -q set wireless.meshconf_mesh_"$idx".network="$netif"
			else
				# plain 802.11s: HWMP does the routing, so the mesh
				# interface is bridged straight into the LAN
				uci -q delete network."$netif" 2>/dev/null
				uci -q set wireless.meshconf_mesh_"$idx".network='lan'
			fi
			idx=$((idx + 1))
		done
	fi

	if [ "$unified" = "1" ]; then
		apply_unified_ap "$unified_ssid" "$unified_encryption" "$unified_key" || {
			printf '{"success":false,"error":"invalid unified wireless settings"}'
			return
		}
	elif [ "$ap_sync" = "1" ]; then
		# A non-empty payload is still honoured: this RPC is part of the
		# published interface and callers built on it have to keep working.
		# The page itself sends [] - its SSID / encryption / key stay on the
		# wireless page, and a child receives them through the generated
		# bundle, which copies /etc/config/wireless verbatim.
		case "$(printf '%s' "$ap_configs" | tr -d '[:space:]')" in
			''|'[]') ;;
			*) apply_ap_configs "$ap_configs" || return 1 ;;
		esac
	fi

	# channels belong to the radio, but they are still part of "push these
	# wireless settings": skipping the AP sync must leave them untouched
	if [ "$ap_sync" = "1" ]; then
		apply_radio_channels "$channels" || {
			printf '{"success":false,"error":"invalid radio channel settings"}'
			return
		}
	fi

	uci -q commit network
	uci -q commit wireless
	uci -q commit dhcp
	reload_network_later

	[ -n "$backhaul" ] || {
		if [ "$wired" = "1" ] && [ "$wireless" = "1" ]; then
			backhaul=wired
		elif [ "$wired" = "1" ]; then
			backhaul=wired
		elif [ "$wireless" = "1" ]; then
			backhaul=wireless
		else
			backhaul=off
		fi
	}
	[ -n "$role" ] || {
		case "$gateway" in
			server) role=master ;;
			client) role=slave ;;
			*) role=peer ;;
		esac
	}

	printf '{"success":true,"backhaul":"%s","role":"%s","wired":%s,"wireless":%s,"gateway":"%s","radios":%d,"unified":%s,"ap_sync":%s,"mesh_proto":"%s","batman":%s}' \
		"$(json_escape "$backhaul")" "$(json_escape "$role")" "$(bool "$wired")" "$(bool "$wireless")" "$gateway" "$idx" "$(bool "$unified")" "$(bool "$ap_sync")" \
		"$(json_escape "$mesh_proto")" "$(bool "$use_batman")"
}

mesh_wireless_count()
{
	uci -q show wireless | grep -c '^wireless\.meshconf_mesh_[0-9]*=wifi-iface'
}

# JSON array of radios currently carrying an 802.11s mesh backhaul.
mesh_radio_list()
{
	local sec radio first=1
	printf '['
	for sec in $(uci -q show wireless | sed -n 's/^wireless\.\(meshconf_mesh_[0-9]*\)=wifi-iface$/\1/p'); do
		radio="$(uci -q get wireless."$sec".device 2>/dev/null)"
		[ -n "$radio" ] || continue
		[ "$first" = "1" ] || printf ','
		printf '"%s"' "$(json_escape "$radio")"
		first=0
	done
	printf ']'
}

# Check whether $1 (radio name) is contained in the JSON array $2.
# An empty/invalid array selects every radio (legacy behaviour).
mesh_radio_selected()
{
	local radio="$1" list="$2" r
	[ -n "$list" ] || return 0
	for r in $(printf '%s' "$list" | jsonfilter -e '@[*]' 2>/dev/null); do
		[ "$r" = "$radio" ] && return 0
	done
	return 1
}

detect_mode()
{
	local wan_proto lan_proto dhcp_ignore
	wan_proto="$(uci -q get network.wan.proto 2>/dev/null)"
	lan_proto="$(uci -q get network.lan.proto 2>/dev/null)"
	dhcp_ignore="$(uci -q get dhcp.lan.ignore 2>/dev/null)"
	if [ "$lan_proto" = "dhcp" ] && [ "$dhcp_ignore" = "1" ]; then
		printf ap
	elif [ "$wan_proto" = "pppoe" ]; then
		printf pppoe
	elif [ "$wan_proto" = "dhcp" ]; then
		printf dhcp
	else
		printf unknown
	fi
}

# The 802.11r mobility domain is shared by every AP of an SSID, so the page
# offers the value already in use as the default for new SSIDs.
first_mobility_domain()
{
	local sec d
	for sec in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'); do
		d="$(uci -q get wireless."$sec".mobility_domain 2>/dev/null)"
		[ -n "$d" ] && {
			printf '%s' "$d"
			return 0
		}
	done
	return 0
}

foreign_mesh_json()
{
	local s first=1
	printf '['
	for s in $(foreign_mesh_sections); do
		[ "$first" = "1" ] || printf ','
		printf '"%s"' "$(json_escape "$s")"
		first=0
	done
	printf ']'
}

get_status()
{
	local mode lan_ip wan_ip wan_proto wan_up mesh_enabled wired wireless_count mesh_id gateway gw_bandwidth gw_sel_class ap_sync ap_configs radio_count bat_up role
	local dep_batctl dep_iw dep_wpad board host bat_device
	local dep_wpad_mesh dep_iw_full wpad_var lan_dev mesh_proto
	local mesh_params_val bat_settings mesh11sd ft_domain ap_sync_set
	local bridge_mode trunk_vlans

	mode="$(detect_mode)"
	lan_ip="$(first_lan_ip)"
	wan_ip="$(first_wan_ip)"
	wan_proto="$(uci -q get network.wan.proto 2>/dev/null)"
	wan_up="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)"
	[ "$wan_up" = "true" ] || wan_up=false
	mesh_enabled=0
	uci -q get network.bat0.proto >/dev/null 2>&1 && mesh_enabled=1
	uci -q get network.meshconf_wired_mesh.proto >/dev/null 2>&1 && wired=1 || wired=0
	wireless_count="$(mesh_wireless_count)"
	mesh_id="$(uci -q get wireless.meshconf_mesh_0.mesh_id 2>/dev/null)"
	gateway="$(uci -q get network.bat0.gw_mode 2>/dev/null || printf off)"
	gw_bandwidth="$(uci -q get network.bat0.gw_bandwidth 2>/dev/null)"
	gw_sel_class="$(uci -q get network.bat0.gw_sel_class 2>/dev/null)"
	ap_sync="$(uci -q get network.bat0.meshconf_ap_sync 2>/dev/null)"
	# The page defaults this switch to *on*, so it has to be able to tell a
	# stored 0 from "never configured": the flag alone cannot, and defaulting
	# a switched-off setting back on would undo the operator's choice on
	# every reload.
	ap_sync_set=1
	[ -n "$ap_sync" ] || ap_sync_set=0
	# node role mirrors the batman-adv gateway role: master serves the whole
	# subnet, slaves only bridge it
	role=peer
	[ "$gateway" = "server" ] && role=master
	[ "$gateway" = "client" ] && role=slave
	if [ "$ap_sync_set" = "0" ] && [ "$wireless_count" -gt 0 ]; then
		ap_sync=1
	fi
	ap_configs="$(ap_config_list)"
	radio_count="$(wifi_radio_count)"
	bat_up="$(ubus call network.interface.bat0 status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)"
	[ "$bat_up" = "true" ] || bat_up=false
	bat_device="$(ubus call network.interface.bat0 status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)"
	dep_batctl="$(command_flag batctl)"
	dep_iw="$(command_flag iw)"
	dep_wpad="$(command_flag wpa_supplicant)"
	# wpad-basic ships the binaries but has no 802.11s; netifd's own probe
	# (wpa_supplicant -vmesh) is the only trustworthy answer
	dep_wpad_mesh=0
	wpad_mesh_support && dep_wpad_mesh=1
	dep_iw_full=0
	iw_full_support && dep_iw_full=1
	wpad_var="$(wpad_variant)"
	board="$(board_name_safe)"
	host="$(hostname_safe)"
	lan_dev="$(uci -q get network.lan.device 2>/dev/null)"

	# backhaul routing protocol: the marker written by apply_mesh wins,
	# otherwise derive it from how the mesh interface is attached
	mesh_proto="$(uci -q get wireless.meshconf_mesh_0.meshconf_proto 2>/dev/null)"
	case "$mesh_proto" in
		batman|hwmp) ;;
		*)
			mesh_proto=batman
			if [ "$mesh_enabled" != "1" ] && [ "$wireless_count" -gt 0 ] && \
				[ "$(uci -q get wireless.meshconf_mesh_0.network 2>/dev/null)" = "lan" ]; then
				mesh_proto=hwmp
			fi
			;;
	esac
	mesh_params_val="$(mesh_param_list_json meshconf_mesh_0)"
	bat_settings="$(bat_settings_json)"
	mesh11sd="$(mesh11sd_state)"
	ft_domain="$(first_mobility_domain)"

	printf '{"mode":"%s","board":"%s","hostname":"%s","lan_ip":"%s","wan_proto":"%s","wan_up":%s,"wan_ip":"%s","lan_device":"%s","wpad_variant":"%s","ft_domain":"%s",' \
		"$mode" "$(json_escape "$board")" "$(json_escape "$host")" "$(json_escape "$lan_ip")" "$(json_escape "$wan_proto")" "$wan_up" "$(json_escape "$wan_ip")" \
		"$(json_escape "$lan_dev")" "$(json_escape "$wpad_var")" "$(json_escape "$ft_domain")"
	printf '"mesh":{"enabled":%s,"up":%s,"device":"%s","role":"%s","wired":%s,"wireless_count":%d,"mesh_radios":' \
		"$(bool "$mesh_enabled")" "$bat_up" "$(json_escape "$bat_device")" "$(json_escape "$role")" \
		"$(bool "$wired")" "$wireless_count"
	mesh_radio_list
	printf ',"mesh_id":"%s","gateway":"%s","gw_bandwidth":"%s","gw_sel_class":"%s","ap_sync":%s,"ap_sync_set":%s,"ap_configs":%s,"radio_count":%d,"proto":"%s","params":%s,"batman":%s},' \
		"$(json_escape "$mesh_id")" "$(json_escape "$gateway")" \
		"$(json_escape "$gw_bandwidth")" "$(json_escape "$gw_sel_class")" "$(bool "$ap_sync")" "$ap_sync_set" \
		"$ap_configs" "$radio_count" "$mesh_proto" "$mesh_params_val" "$bat_settings"
	printf '"addresses":'
	interface_ipv4_addresses
	printf ',"networks":'
	network_option_list
	printf ',"vlans":'
	vlan_list
	printf ',"vlan_foreign":"%s"' "$(json_escape "$(vlan_foreign_specs)")"
	bridge_mode="$(bridge_vlan_mode)"
	trunk_vlans="$(bat0_vlan_ids)"
	printf ',"bridge":{"name":"br-lan","ports":'
	bridge_port_list
	printf ',"mode":"%s","trunk_vlans":"%s"}' "$bridge_mode" "$(json_escape "$trunk_vlans")"
	printf ',"mesh11sd":%s,"foreign_mesh":%s,' "$mesh11sd" "$(foreign_mesh_json)"
	printf '"deps":{"batctl":%s,"iw":%s,"wpad":%s,"wpad_mesh":%s,"iw_full":%s}}' \
		"$(bool "$dep_batctl")" "$(bool "$dep_iw")" "$(bool "$dep_wpad")" \
		"$dep_wpad_mesh" "$dep_iw_full"
}

append_node()
{
	local id="$1" label="$2" ip="$3" mac="$4" kind="$5" iface="$6" tq="$7" last_seen="$8"
	[ -n "$DISC_NODES" ] && DISC_NODES="$DISC_NODES,"
	DISC_NODES="${DISC_NODES}{\"id\":\"$(json_escape "$id")\",\"label\":\"$(json_escape "$label")\",\"ip\":\"$(json_escape "$ip")\",\"mac\":\"$(json_escape "$mac")\",\"kind\":\"$(json_escape "$kind")\",\"iface\":\"$(json_escape "$iface")\",\"tq\":\"$(json_escape "$tq")\",\"last_seen\":\"$(json_escape "$last_seen")\"}"
}

append_link()
{
	local from="$1" to="$2" kind="$3"
	[ -n "$DISC_LINKS" ] && DISC_LINKS="$DISC_LINKS,"
	DISC_LINKS="${DISC_LINKS}{\"from\":\"$(json_escape "$from")\",\"to\":\"$(json_escape "$to")\",\"kind\":\"$(json_escape "$kind")\"}"
}

discover_mesh()
{
	local local_id local_mac local_ip host mac ip name seen_macs batmac tmp iface tq last_seen
	local addr_table merged label addr
	DISC_NODES=""
	DISC_LINKS=""
	host="$(hostname_safe)"
	local_mac="$(cat /sys/class/net/br-lan/address 2>/dev/null || cat /sys/class/net/lan2/address 2>/dev/null || printf local)"
	local_ip="$(first_lan_ip)"
	local_id="${local_mac:-local}"
	append_node "$local_id" "$host" "$local_ip" "$local_mac" "local" "" "" ""
	seen_macs=" $(printf '%s' "$local_mac" | tr 'A-F' 'a-f')"

	# A dual stack client is visible several times over: a DHCPv4 lease plus
	# one neighbour entry per address (IPv4, global IPv6 and a link-local
	# fe80:: one). Everything is collected as (MAC, address) pairs and merged
	# by MAC below, so the topology counts devices instead of addresses.
	addr_table="/tmp/luci-meshconf-addr.$$"
	: > "$addr_table"

	if [ -r /tmp/dhcp.leases ]; then
		while read -r _ mac ip name _; do
			[ -n "$mac" ] && [ -n "$ip" ] || continue
			printf '%s\t%s\t%s\n' \
				"$(printf '%s' "$mac" | tr 'A-F' 'a-f')" "$ip" "${name:-}" >> "$addr_table"
		done < /tmp/dhcp.leases
	fi

	if command -v ip >/dev/null 2>&1; then
		tmp="/tmp/luci-meshconf-neigh.$$"
		ip neigh show dev br-lan 2>/dev/null | awk '/lladdr/ && $NF != "FAILED" { print $1, tolower($5) }' > "$tmp"
		while read -r ip mac; do
			[ -n "$ip" ] && [ -n "$mac" ] || continue
			printf '%s\t%s\t\n' "$mac" "$ip" >> "$addr_table"
		done < "$tmp"
		rm -f "$tmp"
	fi

	# merge by MAC: link-local fe80::/10, 169.254/16 and ::1 are per
	# interface, not per device, so they never identify a node. At most one
	# IPv4 and one global IPv6 are kept per MAC.
	merged="/tmp/luci-meshconf-merged.$$"
	awk -F'\t' '
		$2 ~ /^[Ff][Ee]80:/ { next }
		$2 ~ /^169\.254\./ { next }
		$2 == "::1" { next }
		{
			mac = $1; ip = $2; name = $3
			if (!(mac in known)) { known[mac] = 1; order[++n] = mac }
			if (name != "" && label[mac] == "") label[mac] = name
			if (ip ~ /:/) { if (!(mac in v6)) v6[mac] = ip } else if (!(mac in v4)) v4[mac] = ip
		}
		END {
			for (i = 1; i <= n; i++) {
				m = order[i]
				addr = (m in v4 ? v4[m] : "")
				if (m in v6) addr = (addr == "" ? v6[m] : addr ", " v6[m])
				if (addr == "") continue
				print m "|" (label[m] != "" ? label[m] : addr) "|" addr
			}
		}' "$addr_table" > "$merged"
	rm -f "$addr_table"

	while IFS='|' read -r mac label addr; do
		[ -n "$mac" ] && [ -n "$addr" ] || continue
		case " $seen_macs " in *" $mac "*) continue ;; esac
		append_node "$mac" "$label" "$addr" "$mac" "lan" "" "" ""
		append_link "$local_id" "$mac" "lan"
		seen_macs="$seen_macs $mac"
	done < "$merged"
	rm -f "$merged"

	if command -v batctl >/dev/null 2>&1; then
		while read -r iface batmac last_seen; do
			[ -n "$batmac" ] || continue
			batmac="$(printf '%s' "$batmac" | tr 'A-F' 'a-f')"
			case " $seen_macs " in *" $batmac "*) ;; *)
				append_node "$batmac" "$batmac" "" "$batmac" "mesh" "$iface" "" "$last_seen"
				;;
			esac
			append_link "$local_id" "$batmac" "mesh"
			seen_macs="$seen_macs $batmac"
		done <<EOF
$(batctl n 2>/dev/null | awk '
	$0 ~ /Neighbor/ { next }
	{
		for (i = 1; i <= NF; i++) {
			if ($i ~ /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/) {
				iface = (i > 1 ? $(i - 1) : "")
				if (iface == "*") iface = (i > 2 ? $(i - 2) : iface)
				print iface, tolower($i), $(i + 1)
				break
			}
		}
	}')
EOF

		while read -r batmac tq last_seen iface; do
			[ -n "$batmac" ] || continue
			batmac="$(printf '%s' "$batmac" | tr 'A-F' 'a-f')"
			case " $seen_macs " in *" $batmac "*) ;; *)
				append_node "$batmac" "$batmac" "" "$batmac" "mesh" "$iface" "$tq" "$last_seen"
				;;
			esac
			append_link "$local_id" "$batmac" "mesh"
			seen_macs="$seen_macs $batmac"
		done <<EOF
$(batctl o 2>/dev/null | awk '
	$1 ~ /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/ {
		tq = $3
		gsub(/[()]/, "", tq)
		iface = $NF
		gsub(/[\[\]]/, "", iface)
		print tolower($1), tq, $2, iface
	}')
EOF
	fi

	printf '{"nodes":[%s],"links":[%s],"updated":%d}' "$DISC_NODES" "$DISC_LINKS" "$(date +%s 2>/dev/null || echo 0)"
}

# ---------------------------------------------------------------------------
# 802.11s link diagnostics.
#
# batctl only reports what batman-adv knows. With a plain HWMP backhaul - or
# when the peer link never comes up - there is no batman-adv at all, so the
# kernel is the only source of truth:
#   iw dev X station dump   -> peer link state, signal, rate, per peer metric
#   iw dev X mpath dump     -> the HWMP path table (next hop, metric, hops)
#   iw dev X get mesh_param -> the values the driver actually runs with, which
#                              can differ from UCI when netifd rejected one
# ---------------------------------------------------------------------------
valid_mac()
{
	printf '%s' "$1" | grep -Eq '^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$'
}

# Network device names of every mesh interface that is up right now - managed
# sections as well as hand written or mesh11sd owned ones.
mesh_runtime_ifaces()
{
	local sec ifn out=""
	for sec in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get wireless."$sec".mode 2>/dev/null)" = "mesh" ] || continue
		ifn="$(uci -q get wireless."$sec".ifname 2>/dev/null)"
		[ -n "$ifn" ] || continue
		[ -d "/sys/class/net/$ifn" ] || continue
		out="${out:+$out }$ifn"
	done
	# no usable ifname in UCI (netifd generated names): ask the kernel
	if [ -z "$out" ] && command -v iw >/dev/null 2>&1; then
		out="$(iw dev 2>/dev/null | awk '/^[[:space:]]*Interface / { d = $2 } /type mesh point/ { if (d != "") printf "%s ", d }')"
	fi
	printf '%s' "$out"
}

mesh_iface_info()
{
	local ifn="$1"
	iw dev "$ifn" info 2>/dev/null | awk '
		/^[[:space:]]*wiphy / { phy = "phy" $2 }
		/type mesh point/ { mp = 1 }
		/^[[:space:]]*channel / {
			line = $0
			sub(/^[ \t]+/, "", line)
			ch = line
			sub(/,.*$/, "", ch)
			sub(/^channel /, "", ch)
			if (match(line, /width: [^,]+/)) width = substr(line, RSTART + 7, RLENGTH - 7)
		}
		END {
			printf "{\"phy\":\"%s\",\"channel\":\"%s\",\"width\":\"%s\",\"mesh_point\":%s}", \
				phy, ch, width, (mp ? "true" : "false")
		}'
}

mesh_peer_list()
{
	local ifn="$1"
	iw dev "$ifn" station dump 2>/dev/null | awk '
		function kv_out(k) { return (k in kv ? kv[k] : "") }
		function emit() {
			if (mac == "") return
			if (n++) printf ","
			printf "{\"mac\":\"%s\",\"plink\":\"%s\",\"signal\":\"%s\",\"tx_bitrate\":\"%s\"," \
				"\"rx_bytes\":\"%s\",\"tx_bytes\":\"%s\",\"inactive\":\"%s\",\"metric\":\"%s\"," \
				"\"airtime\":\"%s\",\"throughput\":\"%s\",\"authorized\":\"%s\"}", \
				mac, kv_out("mesh plink"), kv_out("signal"), kv_out("tx bitrate"), \
				kv_out("rx bytes"), kv_out("tx bytes"), kv_out("inactive time"), \
				kv_out("mesh metric"), kv_out("mesh airtime link metric"), \
				kv_out("mesh expected throughput"), kv_out("mesh authorized")
		}
		/^Station / { emit(); mac = $2; delete kv; next }
		{
			line = $0
			sub(/^[ \t]+/, "", line)
			p = index(line, ":")
			if (p == 0) next
			k = substr(line, 1, p - 1)
			v = substr(line, p + 1)
			sub(/[ \t]+$/, "", k)
			sub(/^[ \t]+/, "", v)
			kv[k] = v
		}
		END { emit(); printf "" }'
}

mesh_mpath_list()
{
	local ifn="$1"
	iw dev "$ifn" mpath dump 2>/dev/null | awk '
		$1 ~ /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/ {
			if (n++) printf ","
			printf "{\"dst\":\"%s\",\"next_hop\":\"%s\",\"iface\":\"%s\",\"sn\":\"%s\"," \
				"\"metric\":\"%s\",\"qlen\":\"%s\",\"exptime\":\"%s\",\"flags\":\"%s\"}", \
				$1, $2, $3, $4, $5, $6, $7, $NF
		}'
}

mesh_live_params()
{
	local ifn="$1"
	iw dev "$ifn" get mesh_param 2>/dev/null | awk '
		{
			p = index($0, "=")
			if (p == 0) next
			k = substr($0, 1, p - 1)
			v = substr($0, p + 1)
			gsub(/^[ \t]+|[ \t]+$/, "", k)
			gsub(/^[ \t]+|[ \t]+$/, "", v)
			m = split(k, a, /[ \t]+/)
			k = a[m]
			if (k == "") next
			if (n++) printf ","
			printf "\"%s\":\"%s\"", k, v
		}'
}

batman_diag_json()
{
	local algo gws ifs ocount tcount
	[ -d /sys/class/net/bat0 ] || { printf '{"present":false}'; return 0; }
	algo="$(cat /sys/class/net/bat0/mesh/routing_algo 2>/dev/null)"
	gws="$(batctl gwl 2>/dev/null | awk '
		{
			mac = ""; tq = ""; bw = ""
			for (i = 1; i <= NF; i++) {
				if (mac == "" && $i ~ /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/) { mac = $i; continue }
				if (mac != "" && tq == "" && $i ~ /^\(?[0-9]+\)?$/) { tq = $i; gsub(/[()]/, "", tq); continue }
				if ($i ~ /^[0-9.]+\/[0-9.]+$/) bw = $i
			}
			if (mac == "") next
			if (n++) printf ","
			printf "{\"mac\":\"%s\",\"tq\":\"%s\",\"bandwidth\":\"%s\",\"selected\":%s}", \
				mac, tq, bw, (index($0, "=>") ? "true" : "false")
		}')"
	ifs="$(batctl if 2>/dev/null | awk '
		{
			p = index($0, ":")
			if (p == 0) next
			n = substr($0, 1, p - 1)
			s = substr($0, p + 1)
			gsub(/^[ \t]+|[ \t]+$/, "", n)
			gsub(/^[ \t]+|[ \t]+$/, "", s)
			if (n == "") next
			if (c++) printf ","
			printf "{\"iface\":\"%s\",\"status\":\"%s\"}", n, s
		}')"
	ocount="$(batctl o 2>/dev/null | grep -Ec '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}')"
	tcount="$(batctl tg 2>/dev/null | grep -Ec '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}')"
	printf '{"present":true,"routing_algo":"%s","gw_mode":"%s","gateways":[%s],"hardifs":[%s],"originators":%d,"translations":%d}' \
		"$(json_escape "$algo")" "$(json_escape "$(batctl gw_mode 2>/dev/null)")" \
		"$gws" "$ifs" "${ocount:-0}" "${tcount:-0}"
}

get_mesh_diag()
{
	local ifn sec mesh_id first=1
	printf '{"ifaces":['
	for ifn in $(mesh_runtime_ifaces); do
		[ "$first" = "1" ] || printf ','
		mesh_id=""
		for sec in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'); do
			[ "$(uci -q get wireless."$sec".ifname 2>/dev/null)" = "$ifn" ] || continue
			mesh_id="$(uci -q get wireless."$sec".mesh_id 2>/dev/null)"
			break
		done
		printf '{"iface":"%s","mesh_id":"%s","info":%s,"peers":[%s],"mpath":[%s],"params":{%s}}' \
			"$(json_escape "$ifn")" "$(json_escape "$mesh_id")" \
			"$(mesh_iface_info "$ifn")" "$(mesh_peer_list "$ifn")" \
			"$(mesh_mpath_list "$ifn")" "$(mesh_live_params "$ifn")"
		first=0
	done
	printf '],"batman":%s,"iw_full":%s,"updated":%d}' \
		"$(batman_diag_json)" "$(iw_full_support && echo true || echo false)" \
		"$(date +%s 2>/dev/null || echo 0)"
}

# Manually blocking a peer is the 802.11s equivalent of a blacklist; it needs
# "iw ... plink_action", which only the iw-full build carries.
block_mesh_peer()
{
	local args="$1" ifn mac action
	json_load "$args" 2>/dev/null || { printf '{"success":false,"error":"bad arguments"}'; return; }
	json_get_var ifn iface
	json_get_var mac mac
	json_get_var action action
	case "$action" in
		block|open) ;;
		*) printf '{"success":false,"error":"invalid action"}'; return ;;
	esac
	valid_netdev_name "$ifn" || { printf '{"success":false,"error":"invalid interface"}'; return; }
	valid_mac "$mac" || { printf '{"success":false,"error":"invalid MAC address"}'; return; }
	iw_full_support || {
		printf '{"success":false,"error":"需要 iw-full 才能手动阻塞邻居（opkg install iw-full）"}'
		return
	}
	if iw dev "$ifn" station set "$mac" plink_action "$action" 2>/dev/null; then
		printf '{"success":true,"iface":"%s","mac":"%s","action":"%s"}' \
			"$(json_escape "$ifn")" "$(json_escape "$mac")" "$action"
	else
		printf '{"success":false,"error":"iw plink_action failed"}'
	fi
}

case "$1" in
	list)
		printf '{"getStatus":{},"discoverMesh":{},"getMeshDiag":{},"blockMeshPeer":{"iface":"string","mac":"string","action":"string"},"applyMesh":{"backhaul":"string","role":"string","wired":"string","wireless":"string","mesh_radio":"string","mesh_radios":"string","mesh_id":"string","mesh_key":"string","gateway":"string","gw_bandwidth":"string","gw_sel_class":"string","slave_ip_suffix":"string","unified":"string","unified_ssid":"string","unified_encryption":"string","unified_key":"string","ap_sync":"string","ap_configs":"string","channels":"string","mesh_proto":"string","mesh_params":"string","bat_algo":"string","bat_advanced":"string"},"generateChildConfig":{"ip_suffix":"string","offset":"string"},"applyVlans":{"vlans":"string","mode":"string"},"applyWireless":{"ap_configs":"string","channels":"string"}}'
		;;
	call)
		args="$(cat)"
		# rpcd parses stdout as one JSON object; an empty stdout is reported to
		# the caller as "-32000 Object not found", which reads like a missing
		# plugin rather than a failed call. So capture whatever the method
		# prints and guarantee a JSON object comes out either way.
		rc_out=""
		case "$2" in
			getStatus) rc_out="$(get_status)" ;;
			discoverMesh) rc_out="$(discover_mesh)" ;;
			getMeshDiag) rc_out="$(get_mesh_diag)" ;;
			blockMeshPeer) rc_out="$(block_mesh_peer "$args")" ;;
			applyMesh) rc_out="$(apply_mesh "$args")" ;;
			generateChildConfig) rc_out="$(generate_child_config "$args")" ;;
			applyVlans) rc_out="$(apply_vlans "$args")" ;;
			applyWireless) rc_out="$(apply_wireless "$args")" ;;
			*) rc_out='{"success":false,"error":"unknown method"}' ;;
		esac
		rc_rc=$?
		case "$rc_out" in
			\{*) printf '%s' "$rc_out" ;;
			*)
				# Nothing usable on stdout. Report a real reason instead of
				# letting rpcd turn the silence into -32000.
				printf '{"success":false,"error":"backend produced no JSON output (method=%s, rc=%s)","raw":"%s"}' \
					"$(json_escape "${2:-}")" "$rc_rc" \
					"$(printf '%s' "$rc_out" | tr -d '\r\n' | cut -c1-200 | sed 's/\\/\\\\/g; s/"/\\"/g')"
				;;
		esac
		# Always exit 0: a non-zero status makes rpcd report the call as
		# failed even when a perfectly good error object was printed.
		exit 0
		;;
esac
