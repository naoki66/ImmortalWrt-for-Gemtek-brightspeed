{
	"luci-app-mesh-conf": {
		"description": "Grant access to the mesh configuration page",
		"read": {
			"ubus": {
				"luci.meshconf": [ "getStatus", "scanPeers" ],
				"dawn": [ "get_network", "get_hearing_map" ],
				"luci-rpc": [ "getHostHints" ]
			}
		},
		"write": {
			"ubus": {
				"luci.meshconf": [ "applyMesh", "applyRoaming", "toggleRoam", "setMd", "applySync", "restartSync", "syncPeer", "applySteer", "steerService" ]
			}
		}
	}
}
