{
	"luci-app-mesh-conf": {
		"description": "Grant access to the batman-adv mesh configuration wizard",
		"read": {
			"ubus": {
				"luci.meshconf": [ "getStatus", "discoverMesh", "getMeshDiag", "listBackups" ]
			}
		},
		"write": {
			"ubus": {
				"luci.meshconf": [ "applyMesh", "generateChildConfig", "applyVlans", "applyWireless", "restoreBackup", "blockMeshPeer" ]
			}
		}
	}
}
