msgstr ""
"Project-Id-Version: luci-app-netmode\n"
"Language: zh_Hans\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "AP mode"
msgstr "AP 模式"

msgid "AP mode applied"
msgstr "AP 模式已应用"

msgid "Apply failed"
msgstr "应用失败"

msgid "Automatic detection timed out."
msgstr "自动检测超时。"

msgid "Bridged to br-lan"
msgstr "桥接至 br-lan"

msgid "Broadband account"
msgstr "宽带账号"

msgid "Broadband password"
msgstr "宽带密码"

msgid "Cancel"
msgstr "取消"

msgid "Choose how this device connects to the upstream network."
msgstr "选择这台设备如何连接上级网络。"

msgid "Click any mode card to switch; the change takes effect immediately."
msgstr "点击任一模式卡片即可切换，配置将立即生效。"

msgid "Close"
msgstr "关闭"

msgid "Configuration applied"
msgstr "配置已应用"

msgid "Configuration submitted; the device is switching internet mode."
msgstr "配置已成功提交，设备正在切换上网模式。"

msgid "Configuration submitted; the device is switching to AP mode."
msgstr "配置已成功提交，设备正在切换到 AP 模式。"

msgid "Configuration submitted; the device is switching to DHCP router mode."
msgstr "配置已成功提交，设备正在切换到 DHCP 路由模式。"

msgid "Configuration submitted; the device is switching to PPPoE router mode."
msgstr "配置已成功提交，设备正在切换到 PPPoE 路由模式。"

msgid "Configuration submitted; the network service is reloading…"
msgstr "配置已提交，网络服务正在重载…"

msgid "Confirm switch"
msgstr "确认切换"

msgid "Current"
msgstr "当前"

msgid "Current status"
msgstr "当前状态"

msgid "DHCP router"
msgstr "DHCP 路由"

msgid "DHCP router mode applied"
msgstr "DHCP 路由模式已应用"

msgid "Device detected; current management address: %s"
msgstr "已检测到设备，当前管理地址: %s"

msgid "Device model"
msgstr "设备型号"

msgid "Failed to load data"
msgstr "加载数据失败"

msgid "Hostname"
msgstr "主机名"

msgid "In AP mode the LAN IP is the address used to reach this device; leave it blank to let the upstream router assign one."
msgstr "AP 模式下 LAN IP 即为访问本机的地址，留空由上级路由自动分配。"

msgid "In router mode the LAN IP is the gateway; leave it blank to use 192.168.50.1. The PPPoE account and password are only needed in PPPoE mode."
msgstr "LAN IP 在路由模式下为网关，留空则使用 192.168.50.1；PPPoE 账号与密码仅在 PPPoE 模式需要。"

msgid "Internet mode"
msgstr "上网模式"

msgid "LAN IP"
msgstr "LAN IP"

msgid "Loading…"
msgstr "获取中…"

msgid "Management address (LAN)"
msgstr "管理地址 (LAN)"

msgid "Not obtained"
msgstr "未获取"

msgid "One-click switch"
msgstr "一键切换"

msgid "Open new address"
msgstr "打开新地址"

msgid "Open with this address"
msgstr "用这个地址打开"

msgid "PPPoE account"
msgstr "PPPoE 账号"

msgid "PPPoE dial-up"
msgstr "PPPoE 拨号"

msgid "PPPoE password"
msgstr "PPPoE 密码"

msgid "PPPoE router mode applied"
msgstr "PPPoE 路由模式已应用"

msgid "Please enter the PPPoE account first."
msgstr "请先填写 PPPoE 账号。"

msgid "Refresh"
msgstr "刷新"

msgid "Reload page"
msgstr "刷新页面"

msgid "Still waiting for the device… (%d s left)"
msgstr "仍在等待设备…（剩余 %d 秒）"

msgid "Still waiting for the device… (probing starts in %d s, %d s left)"
msgstr "仍在等待设备…（%d 秒后开始检测，剩余 %d 秒）"

msgid "Switch to %s"
msgstr "切换到 %s"

msgid "The WAN port dials up; the LAN uses a static address with DHCP enabled."
msgstr "WAN 口拨号上网，LAN 使用静态地址并开启 DHCP。"

msgid "The WAN port dials with the broadband account and password; this device provides NAT and DHCP."
msgstr "WAN 口用宽带账号密码拨号，本机负责 NAT 与 DHCP。"

msgid "The WAN port joins br-lan; the upstream router assigns the address and this device only bridges."
msgstr "WAN 口并入 br-lan，由上级路由分配地址，本机只做桥接。"

msgid "The WAN port joins br-lan; this device takes an address from the upstream router and disables DHCP."
msgstr "WAN 口并入 br-lan，本机改为由上级路由分配地址并关闭 DHCP。"

msgid "The WAN port obtains an upstream address automatically; the LAN uses a static address with DHCP enabled."
msgstr "WAN 口自动获取上级地址，LAN 使用静态地址并开启 DHCP。"

msgid "The WAN port obtains an upstream address automatically; this device provides NAT and DHCP."
msgstr "WAN 口自动获取上级地址，本机负责 NAT 与 DHCP。"

msgid "The configuration takes effect immediately and the network will be reloaded."
msgstr "配置将立即生效并重新加载网络。"

msgid "The configuration was applied, but the device could not be found at the current address."
msgstr "配置已经下发成功，只是没能在当前地址上重新找到设备。"

msgid "The current management address %s will stop working; the upstream router will assign a new one."
msgstr "当前管理地址 %s 将失效，改由上级路由分配。"

msgid "The device has finished switching."
msgstr "设备已完成切换。"

msgid "The device is now in AP mode."
msgstr "设备已进入 AP 模式。"

msgid "The device is now in DHCP router mode."
msgstr "设备已进入 DHCP 路由模式。"

msgid "The device is now in PPPoE router mode."
msgstr "设备已进入 PPPoE 路由模式。"

msgid "The device is responding; waiting for the mode switch to finish… (%d s left)"
msgstr "设备已有响应，等待模式切换完成…（剩余 %d 秒）"

msgid "The management address will be assigned by the upstream router."
msgstr "管理地址将改为由上级路由分配。"

msgid "The new address is assigned by the upstream router, usually on the same subnet as the previous WAN address %s; look it up by hostname \"%s\" or MAC in the DHCP leases of the upstream router."
msgstr "新地址由上级路由分配，通常与切换前的 WAN 地址 %s 同网段；请按主机名「%s」或 MAC 在上级路由的 DHCP 租约里查找。"

msgid "The new address is assigned by the upstream router; look it up by hostname \"%s\" or MAC in the DHCP leases of the upstream router."
msgstr "新地址由上级路由分配；请按主机名「%s」或 MAC 在上级路由的 DHCP 租约里查找。"

msgid "The new address is the static LAN address %s; make sure the cable is in a LAN port and the computer is set to obtain an address automatically (DHCP)."
msgstr "新地址为 LAN 静态地址 %s；请确认网线接在 LAN 口，且本机网卡已设为自动获取（DHCP）。"

msgid "The switch changes the management address back to the static LAN address; this page disconnecting is expected and does not mean failure."
msgstr "切换会把管理地址改回 LAN 静态地址，当前页面断开属于正常现象，并不表示失败。"

msgid "The switch changes the management address to an upstream DHCP lease; this page disconnecting is expected and does not mean failure."
msgstr "切换会把管理地址改为上级路由 DHCP 分配，当前页面断开属于正常现象，并不表示失败。"

msgid "The switch changes the management address; this page disconnecting is expected and does not mean failure."
msgstr "切换会改变管理地址，当前页面断开属于正常现象，并不表示失败。"

msgid "Unknown mode"
msgstr "未知模式"

msgid "Updated %s"
msgstr "更新于 %s"

msgid "WAN address"
msgstr "WAN 地址"

msgid "WAN bridged"
msgstr "WAN 已桥接"

msgid "WAN connected"
msgstr "WAN 已连接"

msgid "WAN disconnected"
msgstr "WAN 未连接"

msgid "WAN not configured"
msgstr "WAN 未配置"
