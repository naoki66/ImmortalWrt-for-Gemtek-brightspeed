#!/bin/sh

# rpcd backend for luci-app-netmode: switch how this device connects to the
# upstream network - AP bridge, DHCP client or PPPoE. The batman-adv mesh
# backhaul lives in the separate luci-app-mesh-conf package.

set -f
. /usr/share/libubox/jshn.sh

json_escape()
{
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/ /g'
}

bool()
{
	[ "$1" = "1" ] && printf true || printf false
}

board_name_safe()
{
	if command -v board_name >/dev/null 2>&1; then
		board_name 2>/dev/null
	elif [ -r /tmp/sysinfo/board_name ]; then
		cat /tmp/sysinfo/board_name
	else
		printf unknown
	fi
}

hostname_safe()
{
	uci -q get system.@system[0].hostname 2>/dev/null || hostname 2>/dev/null || printf ImmortalWrt
}

first_lan_ip()
{
	local ip
	ip="$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e "@['ipv4-address'][0].address" 2>/dev/null)"
	[ -n "$ip" ] && {
		printf '%s' "$ip"
		return 0
	}
	ip="$(uci -q get network.lan.ipaddr 2>/dev/null | awk '{print $1}')"
	ip="${ip%%/*}"
	[ -n "$ip" ] && printf '%s' "$ip" || printf ''
}

first_wan_ip()
{
	local ip
	ip="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e "@['ipv4-address'][0].address" 2>/dev/null)"
	[ -n "$ip" ] && {
		printf '%s' "$ip"
		return 0
	}
	ip="$(uci -q get network.wan.ipaddr 2>/dev/null | awk '{print $1}')"
	ip="${ip%%/*}"
	[ -n "$ip" ] && printf '%s' "$ip" || printf ''
}

interface_ipv4_addresses()
{
	local sec proto ips ip first=1
	printf '['
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=interface$/\1/p'); do
		case "$sec" in loopback|wan|wan6|bat0|meshconf_*|netmode_wired_mesh|netmode_wmesh_*) continue ;; esac
		proto="$(uci -q get network."$sec".proto 2>/dev/null)"
		[ "$proto" = "static" ] || continue
		ips="$(uci -q get network."$sec".ipaddr 2>/dev/null)"
		for ip in $ips; do
			ip="${ip%%/*}"
			valid_ipv4 "$ip" || continue
			[ "$first" = "1" ] || printf ','
			printf '{"interface":"%s","address":"%s"}' "$(json_escape "$sec")" "$(json_escape "$ip")"
			first=0
		done
	done
	printf ']'
}

valid_ipv4()
{
	echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
	echo "$1" | awk -F. '{ exit !($1 < 256 && $2 < 256 && $3 < 256 && $4 < 256) }'
}

valid_text_value()
{
	[ "$(printf '%s' "$1" | tr -d '\n\r')" = "$1" ]
}

valid_uint()
{
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	return 0
}

find_bridge_section()
{
	local sec name type
	for sec in $(uci -q show network | sed -n 's/^network\.\([^=]*\)=device$/\1/p'); do
		name="$(uci -q get network."$sec".name 2>/dev/null)"
		type="$(uci -q get network."$sec".type 2>/dev/null)"
		[ "$name" = "$1" ] && [ "$type" = "bridge" ] && {
			printf '%s' "$sec"
			return 0
		}
	done
	return 1
}

ensure_lan_bridge()
{
	local sec olddev
	sec="$(find_bridge_section br-lan)"
	if [ -z "$sec" ]; then
		uci -q set network.netmode_br_lan='device'
		uci -q set network.netmode_br_lan.name='br-lan'
		uci -q set network.netmode_br_lan.type='bridge'
		sec="netmode_br_lan"
	fi

	olddev="$(uci -q get network.lan.device 2>/dev/null)"
	if [ -n "$olddev" ] && [ "$olddev" != "br-lan" ] && [ "$olddev" != "bat0" ]; then
		ensure_bridge_port br-lan "$olddev"
	fi
	uci -q set network.lan='interface'
	uci -q set network.lan.device='br-lan'
	printf '%s' "$sec"
}

bridge_has_port()
{
	local sec port p
	sec="$1"
	port="$2"
	for p in $(uci -q get network."$sec".ports 2>/dev/null); do
		[ "$p" = "$port" ] && return 0
	done
	return 1
}

ensure_bridge_port()
{
	local bridge port sec
	bridge="$1"
	port="$2"
	[ -n "$port" ] || return 0
	sec="$(find_bridge_section "$bridge")"
	if [ -z "$sec" ]; then
		[ "$bridge" = "br-lan" ] && sec="$(ensure_lan_bridge)"
	fi
	[ -n "$sec" ] || return 1
	bridge_has_port "$sec" "$port" || uci -q add_list network."$sec".ports="$port"
}

remove_bridge_port()
{
	local bridge port sec
	bridge="$1"
	port="$2"
	sec="$(find_bridge_section "$bridge")"
	[ -n "$sec" ] || return 0
	while bridge_has_port "$sec" "$port"; do
		uci -q del_list network."$sec".ports="$port" || break
	done
}

has_reusable_ap_topology()
{
	local sec net

	uci -q show network | grep -q '^network\.[^=]*=bridge-vlan$' && return 0

	for sec in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get wireless."$sec".mode 2>/dev/null)" = "ap" ] || continue
		for net in $(uci -q get wireless."$sec".network 2>/dev/null); do
			[ "$net" != "lan" ] && return 0
		done
	done

	return 1
}

disable_lan_dhcp_servers()
{
	local sec iface
	for sec in $(uci -q show dhcp | sed -n 's/^dhcp\.\([^=]*\)=dhcp$/\1/p'); do
		iface="$(uci -q get dhcp."$sec".interface 2>/dev/null)"
		[ "$iface" = "wan" ] && continue
		uci -q set dhcp."$sec".ignore='1'
		uci -q set dhcp."$sec".dynamicdhcp='0'
		uci -q set dhcp."$sec".dhcpv4='disabled'
		uci -q set dhcp."$sec".dhcpv6='disabled'
		uci -q set dhcp."$sec".ra='disabled'
	done
}

find_firewall_zone()
{
	local sec name
	for sec in $(uci -q show firewall | sed -n 's/^firewall\.\([^=]*\)=zone$/\1/p'); do
		name="$(uci -q get firewall."$sec".name 2>/dev/null)"
		[ "$name" = "$1" ] && {
			printf '%s' "$sec"
			return 0
		}
	done
	return 1
}

ensure_firewall_zone()
{
	local zone="$1" sec
	sec="$(find_firewall_zone "$zone")"
	if [ -z "$sec" ]; then
		sec="netmode_${zone}"
		uci -q set firewall."$sec"='zone'
		uci -q set firewall."$sec".name="$zone"
	fi
	printf '%s' "$sec"
}

fw_zone_has_network()
{
	local sec="$1" net="$2" n
	for n in $(uci -q get firewall."$sec".network 2>/dev/null); do
		[ "$n" = "$net" ] && return 0
	done
	return 1
}

fw_zone_add_network()
{
	local sec="$1" net="$2"
	fw_zone_has_network "$sec" "$net" || uci -q add_list firewall."$sec".network="$net"
}

fw_zone_remove_network()
{
	local sec="$1" net="$2"
	while fw_zone_has_network "$sec" "$net"; do
		uci -q del_list firewall."$sec".network="$net" || break
	done
}

ensure_lan_wan_forwarding()
{
	local sec src dest
	for sec in $(uci -q show firewall | sed -n 's/^firewall\.\([^=]*\)=forwarding$/\1/p'); do
		src="$(uci -q get firewall."$sec".src 2>/dev/null)"
		dest="$(uci -q get firewall."$sec".dest 2>/dev/null)"
		[ "$src" = "lan" ] && [ "$dest" = "wan" ] && return 0
	done
	uci -q add firewall forwarding >/dev/null
	uci -q set firewall.@forwarding[-1].src='lan'
	uci -q set firewall.@forwarding[-1].dest='wan'
}

delete_lan_wan_forwarding()
{
	local sec src dest
	for sec in $(uci -q show firewall | sed -n 's/^firewall\.\([^=]*\)=forwarding$/\1/p'); do
		src="$(uci -q get firewall."$sec".src 2>/dev/null)"
		dest="$(uci -q get firewall."$sec".dest 2>/dev/null)"
		[ "$src" = "lan" ] && [ "$dest" = "wan" ] && uci -q delete firewall."$sec"
	done
}

configure_firewall_ap()
{
	local lan_sec wan_sec
	lan_sec="$(ensure_firewall_zone lan)"
	uci -q set firewall."$lan_sec".input='ACCEPT'
	uci -q set firewall."$lan_sec".output='ACCEPT'
	uci -q set firewall."$lan_sec".forward='ACCEPT'
	fw_zone_add_network "$lan_sec" lan

	wan_sec="$(find_firewall_zone wan)"
	if [ -n "$wan_sec" ]; then
		fw_zone_remove_network "$wan_sec" wan
		fw_zone_remove_network "$wan_sec" wan6
	fi
	delete_lan_wan_forwarding
}

configure_firewall_router()
{
	local lan_sec wan_sec
	lan_sec="$(ensure_firewall_zone lan)"
	wan_sec="$(ensure_firewall_zone wan)"

	uci -q set firewall."$lan_sec".input='ACCEPT'
	uci -q set firewall."$lan_sec".output='ACCEPT'
	uci -q set firewall."$lan_sec".forward='ACCEPT'
	uci -q delete firewall."$lan_sec".network 2>/dev/null
	fw_zone_add_network "$lan_sec" lan

	uci -q set firewall."$wan_sec".input='REJECT'
	uci -q set firewall."$wan_sec".output='ACCEPT'
	uci -q set firewall."$wan_sec".forward='REJECT'
	uci -q set firewall."$wan_sec".masq='1'
	uci -q set firewall."$wan_sec".mtu_fix='1'
	uci -q delete firewall."$wan_sec".network 2>/dev/null
	fw_zone_add_network "$wan_sec" wan
	fw_zone_add_network "$wan_sec" wan6

	ensure_lan_wan_forwarding
}

set_lan_static()
{
	local ip="${1:-192.168.50.1}"
	valid_ipv4 "$ip" || return 1
	uci -q set network.lan='interface'
	uci -q set network.lan.device='br-lan'
	uci -q set network.lan.proto='static'
	uci -q delete network.lan.ipaddr 2>/dev/null
	uci -q add_list network.lan.ipaddr="$ip/24"
	uci -q set network.lan.ip6assign='64'
	uci -q set dhcp.lan='dhcp'
	uci -q set dhcp.lan.interface='lan'
	uci -q delete dhcp.lan.ignore 2>/dev/null
	uci -q set dhcp.lan.dhcpv4='server'
	uci -q set dhcp.lan.start='100'
	uci -q set dhcp.lan.limit='150'
	uci -q set dhcp.lan.leasetime='12h'
}

set_lan_ap_client()
{
	uci -q set network.lan='interface'
	uci -q set network.lan.device='br-lan'
	uci -q set network.lan.proto='dhcp'
	uci -q delete network.lan.ipaddr 2>/dev/null
	uci -q delete network.lan.gateway 2>/dev/null
	uci -q delete network.lan.dns 2>/dev/null
	uci -q delete network.lan.ip6assign 2>/dev/null
	uci -q set dhcp.lan='dhcp'
	uci -q set dhcp.lan.interface='lan'
	uci -q set dhcp.lan.ignore='1'
	uci -q set dhcp.lan.dhcpv4='disabled'
	uci -q set dhcp.lan.dhcpv6='disabled'
	uci -q set dhcp.lan.ra='disabled'
}

# Commit happens before this call and the RPC reply is produced after it.
# The delayed reload must not start until the reply has reached the browser,
# otherwise switching the management IP (e.g. router -> AP/DHCP) tears down
# the very TCP connection carrying the success response and the UI reports
# a false failure. Fully detach the job (new session, all fds redirected) so
# rpcd/uhttpd do not wait on it either.
reload_network_later()
{
	local launcher=""
	command -v setsid >/dev/null 2>&1 && launcher="setsid"
	$launcher /bin/sh -c '
		sleep 2
		/etc/init.d/network reload >/dev/null 2>&1 || /etc/init.d/network restart >/dev/null 2>&1
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
		/etc/init.d/odhcpd restart >/dev/null 2>&1
		/etc/init.d/firewall reload >/dev/null 2>&1
		wifi reload >/dev/null 2>&1
	' </dev/null >/dev/null 2>&1 &
}

apply_mode()
{
	local args="$1" mode username password lan_ip

	json_load "$args" 2>/dev/null || { printf '{"success":false,"error":"bad arguments"}'; return; }
	json_get_var mode mode
	json_get_var username username
	json_get_var password password
	json_get_var lan_ip lan_ip

	case "$mode" in
		ap|dhcp|pppoe) ;;
		*) printf '{"success":false,"error":"unsupported mode"}'; return ;;
	esac

	valid_text_value "$username" || { printf '{"success":false,"error":"invalid PPPoE username"}'; return; }
	valid_text_value "$password" || { printf '{"success":false,"error":"invalid PPPoE password"}'; return; }
	[ -z "$lan_ip" ] || valid_ipv4 "$lan_ip" || { printf '{"success":false,"error":"invalid LAN IP"}'; return; }

	# must not leak the section name to stdout: for an anonymous device
	# section it is a literal "@device[0]" which corrupts the JSON reply
	# and makes rpcd return an error even though everything was applied
	ensure_lan_bridge >/dev/null

	case "$mode" in
		ap)
			if has_reusable_ap_topology; then
				disable_lan_dhcp_servers
			else
				ensure_bridge_port br-lan wan
				set_lan_ap_client
			fi
			uci -q delete network.wan 2>/dev/null
			uci -q delete network.wan6 2>/dev/null
			configure_firewall_ap
			;;
		dhcp)
			remove_bridge_port br-lan wan
			set_lan_static "${lan_ip:-192.168.50.1}" || { printf '{"success":false,"error":"invalid LAN IP"}'; return; }
			uci -q set network.wan='interface'
			uci -q set network.wan.device='wan'
			uci -q set network.wan.proto='dhcp'
			uci -q delete network.wan.username 2>/dev/null
			uci -q delete network.wan.password 2>/dev/null
			uci -q set network.wan6='interface'
			uci -q set network.wan6.device='@wan'
			uci -q set network.wan6.proto='dhcpv6'
			configure_firewall_router
			;;
		pppoe)
			[ -n "$username" ] || { printf '{"success":false,"error":"missing PPPoE username"}'; return; }
			remove_bridge_port br-lan wan
			set_lan_static "${lan_ip:-192.168.50.1}" || { printf '{"success":false,"error":"invalid LAN IP"}'; return; }
			uci -q set network.wan='interface'
			uci -q set network.wan.device='wan'
			uci -q set network.wan.proto='pppoe'
			uci -q set network.wan.username="$username"
			uci -q set network.wan.password="$password"
			uci -q set network.wan.ipv6='1'
			uci -q set network.wan6='interface'
			uci -q set network.wan6.device='@wan'
			uci -q set network.wan6.proto='dhcpv6'
			configure_firewall_router
			;;
	esac

	uci -q set dhcp.wan='dhcp'
	uci -q set dhcp.wan.interface='wan'
	uci -q set dhcp.wan.ignore='1'

	uci -q commit network
	uci -q commit dhcp
	uci -q commit firewall
	reload_network_later

	printf '{"success":true,"mode":"%s","addresses":' "$mode"
	interface_ipv4_addresses
	printf '}'
}

detect_mode()
{
	local wan_proto lan_proto dhcp_ignore
	wan_proto="$(uci -q get network.wan.proto 2>/dev/null)"
	lan_proto="$(uci -q get network.lan.proto 2>/dev/null)"
	dhcp_ignore="$(uci -q get dhcp.lan.ignore 2>/dev/null)"
	if [ "$lan_proto" = "dhcp" ] && [ "$dhcp_ignore" = "1" ]; then
		printf ap
	elif [ "$wan_proto" = "pppoe" ]; then
		printf pppoe
	elif [ "$wan_proto" = "dhcp" ]; then
		printf dhcp
	else
		printf unknown
	fi
}

get_status()
{
	local mode lan_ip wan_ip wan_proto wan_up board host

	mode="$(detect_mode)"
	lan_ip="$(first_lan_ip)"
	wan_ip="$(first_wan_ip)"
	wan_proto="$(uci -q get network.wan.proto 2>/dev/null)"
	wan_up="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)"
	[ "$wan_up" = "true" ] || wan_up=false
	board="$(board_name_safe)"
	host="$(hostname_safe)"

	printf '{"mode":"%s","board":"%s","hostname":"%s","lan_ip":"%s","wan_proto":"%s","wan_up":%s,"wan_ip":"%s",' \
		"$mode" "$(json_escape "$board")" "$(json_escape "$host")" "$(json_escape "$lan_ip")" "$(json_escape "$wan_proto")" "$wan_up" "$(json_escape "$wan_ip")"
	printf '"addresses":'
	interface_ipv4_addresses
	printf '}'
}

case "$1" in
	list)
		printf '{"getStatus":{},"applyMode":{"mode":"string","username":"string","password":"string","lan_ip":"string"}}'
		;;
	call)
		args="$(cat)"
		case "$2" in
			getStatus) get_status ;;
			applyMode) apply_mode "$args" ;;
			*) printf '{"error":"unknown method"}' ;;
		esac
		;;
esac
