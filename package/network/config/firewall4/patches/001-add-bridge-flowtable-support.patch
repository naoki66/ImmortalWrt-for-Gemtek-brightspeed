From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bohdan Chubuk <chbgdn@gmail.com>
Date: Wed, 1 Jul 2026 08:24:50 +0300
Subject: [PATCH] firewall4: add bridge flowtable support

Generate a bridge-family flowtable (table bridge fw4, flowtable fb)
when the offload device list contains bridge ports, so L2-forwarded
traffic can be offloaded via nft_flow_offload. Probe the complete bridge
rules with nft --check first: kernels without the bridge flowtable
backport must still be able to load the inet firewall after LAN comes up.

Signed-off-by: Bohdan Chubuk <chbgdn@gmail.com>
---
--- a/root/usr/share/ucode/fw4.uc	2026-07-01 09:54:35.812914268 +0300
+++ b/root/usr/share/ucode/fw4.uc	2026-07-01 09:54:55.802938364 +0300
@@ -575,6 +575,59 @@
 		return false;
 	},
 
+	check_bridge_flowtable: function() {
+		for (let item in nft_json_command("list", "flowtables", "bridge"))
+			if (item.flowtable?.table == "fw4" && item.flowtable?.name == "fb")
+				return true;
+
+		return false;
+	},
+
+	supports_bridge_flowtable: function(devices) {
+		let flags = this.default_option("flow_offloading_hw") ? "flags offload;" : "";
+		let nft_test = `
+			add table bridge fw4-bridge-offload-test;
+			add flowtable bridge fw4-bridge-offload-test fb {
+				hook ingress priority 0;
+				devices = ${this.set(devices, true)};
+				counter; ${flags}
+			}
+			add chain bridge fw4-bridge-offload-test forward {
+				type filter hook forward priority filter; policy accept;
+				meta l4proto { tcp, udp } flow offload @fb;
+			}
+		`;
+		return system(`/usr/sbin/nft -c '${replace(nft_test, "'", "'\\''")}' 2>/dev/null`) == 0;
+	},
+
+	resolve_bridge_devices: function(devices) {
+		let bridge_devs = [];
+
+		if (!length(devices))
+			return bridge_devs;
+
+		let devstatus = {};
+		let bus = ubus.connect();
+		if (bus) {
+			devstatus = bus.call("network.device", "status") || {};
+			bus.disconnect();
+		}
+
+		let dir = fs.opendir("/sys/class/net");
+		let entry;
+
+		if (dir) {
+			while ((entry = dir.read()) != null)
+				if (fs.access(`/sys/class/net/${entry}/brport`))
+					push(bridge_devs,
+						...resolve_lower_devices(devstatus, entry));
+
+			dir.close();
+		}
+
+		return sort(uniq(bridge_devs));
+	},
+
 	read_state: function() {
 		let fd = fs.open(STATEFILE, "r");
 		let state = null;
--- a/root/usr/share/firewall4/templates/ruleset.uc	2026-07-01 09:54:35.813882416 +0300
+++ b/root/usr/share/firewall4/templates/ruleset.uc	2026-07-01 09:55:01.833025066 +0300
@@ -469,4 +469,31 @@
 	}
 {% fw4.includes('table-append') %}
 }
+table bridge fw4
+flush table bridge fw4
+{% if (fw4.check_bridge_flowtable()): %}
+delete flowtable bridge fw4 fb
+{% endif %}
+
+{% let bridge_devices = fw4.resolve_bridge_devices(flowtable_devices); %}
+{% if (length(bridge_devices) > 0 && fw4.supports_bridge_flowtable(bridge_devices)): %}
+table bridge fw4 {
+	#
+	# Bridge flowtable
+	#
+	flowtable fb {
+		hook ingress priority 0;
+		devices = {{ fw4.set(bridge_devices, true) }};
+		counter;
+{% if (fw4.default_option("flow_offloading_hw")): %}
+		flags offload;
+{% endif %}
+	}
+
+	chain forward {
+		type filter hook forward priority filter; policy accept;
+		meta l4proto { tcp, udp } flow offload @fb;
+	}
+}
+{% endif %}
 {% fw4.includes('ruleset-append') %}
