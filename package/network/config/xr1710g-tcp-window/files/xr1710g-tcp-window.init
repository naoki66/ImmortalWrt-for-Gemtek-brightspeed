#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
 [ "$(uci -q get xr1710g_tcp_window.main.enabled)" = 1 ] || return 0
 procd_open_instance
 procd_set_param command /usr/sbin/xr1710g-tcp-window
 procd_set_param file /etc/config/xr1710g_tcp_window
 procd_set_param respawn 3600 5 5
 procd_set_param term_timeout 15
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
service_triggers() {
 procd_add_reload_trigger xr1710g_tcp_window
}
