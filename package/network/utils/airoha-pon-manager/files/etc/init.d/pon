#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=19
STOP=89

USE_PROCD=1
EXTRA_COMMANDS="apply mode"
EXTRA_HELP="	apply	Apply configured GPON/EPON identity and EPON MAC settings
	mode <mode>	Switch PON mode without reboot"

PRE_XPON_MODULES="
airoha_ecnt_hook
airoha_ecnt_scu
airoha_ecnt_xpon
airoha_ecnt_pon_phy
airoha_arht_board
airoha_arht_serdes
phy_10g
"

OPTIONAL_MODULES="
airoha_ecnt_olt_phy
airoha_an7583_combo_phy
"

ensure_node() {
	local path="$1"
	local major="$2"
	local minor="$3"

	[ -c "$path" ] || mknod "$path" c "$major" "$minor"
	chmod 0600 "$path" 2>/dev/null
}

mode_to_param() {
	local mode

	mode="$(printf '%s' "${1:-auto}" | tr 'A-Z_' 'a-z-')"
	case "$mode" in
		auto|0) printf '0\n' ;;
		gpon|1) printf '1\n' ;;
		epon|2) printf '2\n' ;;
		10g-1g-epon|3) printf '3\n' ;;
		10g-10g-epon|4) printf '4\n' ;;
		1g-1g-epon|5) printf '5\n' ;;
		xgpon|6) printf '6\n' ;;
		xgspon|7) printf '7\n' ;;
		ngpon2-10g-10g|8) printf '8\n' ;;
		ngpon2-10g-2g|9) printf '9\n' ;;
		ngpon2-2g-2g|10) printf '10\n' ;;
		gpon-sym|11) printf '11\n' ;;
		turbo-epon|12) printf '12\n' ;;
		*) return 1 ;;
	esac
}

config_get_line() {
	local var="$1"
	local option="$2"
	local default="$3"

	config_get "$var" line0 "$option" ""
	eval "[ -n \"\$$var\" ]" && return 0
	config_get "$var" global "$option" "$default"
}

load_one_module() {
	local mod="$1"
	local arg="$2"

	grep -q "^$mod " /proc/modules 2>/dev/null && return 0
	if [ -n "$arg" ]; then
		modprobe "$mod" "$arg" 2>/dev/null || {
			logger -t pon "unable to load module $mod $arg"
			return 1
		}
	else
		modprobe "$mod" 2>/dev/null || {
			logger -t pon "unable to load module $mod"
			return 1
		}
	fi

	return 0
}

load_modules() {
	local mod mode mode_param loaded_mode requested_mode

	requested_mode="$1"

	for mod in $PRE_XPON_MODULES; do
		load_one_module "$mod" || return 1
	done

	for mod in $OPTIONAL_MODULES; do
		grep -q "^$mod " /proc/modules 2>/dev/null && continue
		modprobe "$mod" >/dev/null 2>&1 || true
	done

	if [ -n "$requested_mode" ]; then
		mode="$requested_mode"
	else
		config_get_line mode mode auto
	fi
	if ! mode_param="$(mode_to_param "$mode")"; then
		logger -t pon "unsupported PON mode '$mode', falling back to auto"
		mode_param=0
	fi

	if grep -q "^xpon_10g " /proc/modules 2>/dev/null; then
		loaded_mode="$(cat /sys/module/xpon_10g/parameters/mode 2>/dev/null)"
		[ -z "$loaded_mode" ] || [ "$loaded_mode" = "$mode_param" ] || {
			apply_helper mode "$mode_param" || {
				logger -t pon "failed to switch xpon_10g from mode=$loaded_mode to mode=$mode_param"
				return 1
			}
		}
		return 0
	fi

	load_one_module xpon_10g "mode=$mode_param"
}

setup_links() {
	local dev pon_dev omci_dev oam_dev

	config_get_line pon_dev device pon
	config_get_line omci_dev omci_device omci
	config_get_line oam_dev oam_device oam

	for dev in "$pon_dev" pon0 "$omci_dev" "$oam_dev"; do
		[ -n "$dev" ] || continue
		ip link show dev "$dev" >/dev/null 2>&1 || continue
		ip link set dev "$dev" up 2>/dev/null || true
	done
}

setup_lan_links() {
	local dev

	for dev in lan1 lan2 lan3 lan4; do
		ip link show dev "$dev" >/dev/null 2>&1 || continue
		ip link set dev "$dev" up 2>/dev/null || true
	done
}

apply_helper() {
	local output ret

	output="$(/usr/sbin/ponctl-helper "$@" 2>&1)"
	ret="$?"
	[ -z "$output" ] || logger -t pon "$output"
	return "$ret"
}

load_dsd_env() {
	local env_file=/tmp/dsd.env

	[ -x /usr/sbin/dsdctl ] || return 0
	[ -r /dev/mtdblock2 ] || return 0
	if /usr/sbin/dsdctl env > "$env_file" 2>/dev/null; then
		chmod 0600 "$env_file"
		# The helper emits shell-quoted assignments from a read-only source.
		. "$env_file"
	else
		rm -f "$env_file"
	fi
}

apply_config() {
	local serial password loid loid_password
	local password_format
	local llid_index llid_mask mac epon_loid epon_loid_password
	local dying_gasp rx_fec tx_fec rate_mode

	config_get serial line0_gpon serial ""
	config_get password line0_gpon password ""
	config_get password_format line0_gpon password_format "ascii"
	config_get loid line0_gpon loid ""
	config_get loid_password line0_gpon loid_password ""
	# Reuse factory FSAN only when the user supplied the password; this
	# avoids inventing an incomplete credential pair from DSD alone.
	[ -n "$serial" ] || [ -z "$password" ] || serial="${fsan:-}"

	if [ -n "$loid" ]; then
		apply_helper gpon-loid "${serial:-"-"}" "$loid" "$loid_password" || \
			logger -t pon "failed to apply GPON LOID settings"
	elif [ -n "$serial$password" ]; then
		apply_helper gpon-sn "$serial" "$password" "$password_format" || \
			logger -t pon "failed to apply GPON SN settings"
	fi

	config_get llid_index line0_epon llid_index "0"
	config_get llid_mask line0_epon llid_mask ""
	config_get mac line0_epon mac ""
	config_get epon_loid line0_epon loid ""
	config_get epon_loid_password line0_epon loid_password ""
	config_get dying_gasp line0_epon dying_gasp ""
	config_get rx_fec line0_epon rx_fec ""
	config_get tx_fec line0_epon tx_fec ""
	config_get rate_mode line0_epon rate_mode ""

	[ -z "$epon_loid" ] || apply_helper epon-loid "$epon_loid" "$epon_loid_password" || \
		logger -t pon "failed to apply EPON LOID settings"
	[ -z "$llid_mask" ] || apply_helper epon-llid-mask "$llid_mask" || \
		logger -t pon "failed to apply EPON LLID mask"
	[ -z "$mac" ] || apply_helper epon-mac "$llid_index" "$mac" || \
		logger -t pon "failed to apply EPON MAC"
	[ -z "$rx_fec" ] || apply_helper epon-rx-fec "$llid_index" "$rx_fec" || \
		logger -t pon "failed to apply EPON RX FEC"
	[ -z "$tx_fec" ] || apply_helper epon-tx-fec "$llid_index" "$tx_fec" || \
		logger -t pon "failed to apply EPON TX FEC"
	[ -z "$dying_gasp" ] || apply_helper epon-dying-gasp "$dying_gasp" || \
		logger -t pon "failed to apply EPON dying gasp mode"
	[ -z "$rate_mode" ] || apply_helper epon-rate-mode "$rate_mode" || \
		logger -t pon "failed to apply EPON rate mode"
}

start_service() {
	local auto_start

	config_load pon
	config_get_bool auto_start line0 auto_start ""
	[ -n "$auto_start" ] || config_get_bool auto_start global auto_start 1
	[ "$auto_start" -eq 1 ] || return 0

	ensure_node /dev/pon 190 0
	ensure_node /dev/epon_mac 221 0
	load_dsd_env
	load_modules || return 1
	setup_links
	setup_lan_links
	touch /tmp/.xponconfig
	apply_config
}

stop_service() {
	local dev

	for dev in oam omci pon0 pon; do
		ip link show dev "$dev" >/dev/null 2>&1 || continue
		ip link set dev "$dev" down 2>/dev/null || true
	done
}

reload_service() {
	stop_service
	start_service
}

apply() {
	config_load pon
	ensure_node /dev/pon 190 0
	ensure_node /dev/epon_mac 221 0
	apply_config
}

mode() {
	local requested normalized

	requested="$2"
	[ -n "$requested" ] || {
		logger -t pon "usage: /etc/init.d/pon mode <mode>"
		return 1
	}

	if ! mode_to_param "$requested" >/dev/null; then
		logger -t pon "unsupported PON mode '$requested'"
		return 1
	fi

	normalized="$(printf '%s' "$requested" | tr 'A-Z_' 'a-z-')"
	config_load pon
	ensure_node /dev/pon 190 0
	ensure_node /dev/epon_mac 221 0
	load_dsd_env
	load_modules "$normalized" || return 1
	setup_links
	setup_lan_links
	apply_config

	uci -q set "pon.line0.mode=$normalized" || return 1
	uci -q commit pon || return 1
	logger -t pon "PON mode active: $normalized"
}

service_triggers() {
	procd_add_reload_trigger pon
}
