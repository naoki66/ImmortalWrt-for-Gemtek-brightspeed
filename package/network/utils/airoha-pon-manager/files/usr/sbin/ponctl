#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

KNOWN_MODULES="
airoha_ecnt_hook
airoha_ecnt_scu
airoha_ecnt_xpon
airoha_ecnt_pon_phy
airoha_ecnt_olt_phy
airoha_arht_board
airoha_arht_serdes
airoha_an7583_combo_phy
phy_10g
xpon_10g
"

usage() {
	cat <<'EOF'
Usage: ponctl <status|config|mode-map|modules|devices|links|procs|nodes|apply|start|stop|reload>
EOF
}

uci_get() {
	uci -q get "$1"
}

line_get() {
	local option="$1"
	local default="$2"
	local value

	value="$(uci_get "pon.line0.$option")"
	[ -n "$value" ] || value="$(uci_get "pon.global.$option")"
	printf '%s\n' "${value:-$default}"
}

yesno_configured() {
	local value="$1"

	[ -n "$value" ] && printf 'configured\n' || printf 'unset\n'
}

mode_to_param() {
	local mode

	mode="$(printf '%s' "${1:-auto}" | tr 'A-Z_' 'a-z-')"
	case "$mode" in
		auto|0) printf '0\n' ;;
		gpon|1) printf '1\n' ;;
		epon|2) printf '2\n' ;;
		10g-1g-epon|3) printf '3\n' ;;
		10g-10g-epon|4) printf '4\n' ;;
		1g-1g-epon|5) printf '5\n' ;;
		xgpon|6) printf '6\n' ;;
		xgspon|7) printf '7\n' ;;
		ngpon2-10g-10g|8) printf '8\n' ;;
		ngpon2-10g-2g|9) printf '9\n' ;;
		ngpon2-2g-2g|10) printf '10\n' ;;
		gpon-sym|11) printf '11\n' ;;
		turbo-epon|12) printf '12\n' ;;
		*) return 1 ;;
	esac
}

show_mode_map() {
	cat <<'EOF'
mode.auto=0
mode.gpon=1
mode.epon=2
mode.10g-1g-epon=3
mode.10g-10g-epon=4
mode.1g-1g-epon=5
mode.xgpon=6
mode.xgspon=7
mode.ngpon2-10g-10g=8
mode.ngpon2-10g-2g=9
mode.ngpon2-2g-2g=10
mode.gpon-sym=11
mode.turbo-epon=12
EOF
}

show_config() {
	local mode mode_param auto_start device omci_device oam_device
	local serial password loid loid_password
	local llid_index llid_mask mac epon_loid epon_loid_password
	local ctc_oam dying_gasp rx_fec tx_fec rate_mode
	local password_format

	mode="$(line_get mode auto)"
	auto_start="$(line_get auto_start 1)"
	device="$(line_get device pon)"
	omci_device="$(line_get omci_device omci)"
	oam_device="$(line_get oam_device oam)"

	printf 'xpon.auto_start=%s\n' "$auto_start"
	printf 'xpon.mode=%s\n' "$mode"
	if mode_param="$(mode_to_param "$mode")"; then
		printf 'xpon.mode_param=%s\n' "$mode_param"
	else
		printf 'xpon.mode_param=invalid\n'
	fi
	printf 'xpon.device=%s\n' "$device"
	printf 'xpon.omci_device=%s\n' "$omci_device"
	printf 'xpon.oam_device=%s\n' "$oam_device"

	serial="$(uci_get pon.line0_gpon.serial)"
	password="$(uci_get pon.line0_gpon.password)"
	password_format="$(uci_get pon.line0_gpon.password_format)"
	loid="$(uci_get pon.line0_gpon.loid)"
	loid_password="$(uci_get pon.line0_gpon.loid_password)"
	printf 'gpon.serial=%s\n' "$(yesno_configured "$serial")"
	printf 'gpon.password=%s\n' "$(yesno_configured "$password")"
	printf 'gpon.password_format=%s\n' "${password_format:-ascii}"
	printf 'gpon.loid=%s\n' "$(yesno_configured "$loid")"
	printf 'gpon.loid_password=%s\n' "$(yesno_configured "$loid_password")"

	llid_index="$(uci_get pon.line0_epon.llid_index)"
	llid_mask="$(uci_get pon.line0_epon.llid_mask)"
	mac="$(uci_get pon.line0_epon.mac)"
	epon_loid="$(uci_get pon.line0_epon.loid)"
	epon_loid_password="$(uci_get pon.line0_epon.loid_password)"
	ctc_oam="$(uci_get pon.line0_epon.ctc_oam)"
	dying_gasp="$(uci_get pon.line0_epon.dying_gasp)"
	rx_fec="$(uci_get pon.line0_epon.rx_fec)"
	tx_fec="$(uci_get pon.line0_epon.tx_fec)"
	rate_mode="$(uci_get pon.line0_epon.rate_mode)"
	printf 'epon.llid_index=%s\n' "${llid_index:-0}"
	printf 'epon.llid_mask=%s\n' "$(yesno_configured "$llid_mask")"
	printf 'epon.mac=%s\n' "$(yesno_configured "$mac")"
	printf 'epon.loid=%s\n' "$(yesno_configured "$epon_loid")"
	printf 'epon.loid_password=%s\n' "$(yesno_configured "$epon_loid_password")"
	printf 'epon.ctc_oam=%s\n' "${ctc_oam:-0}"
	printf 'epon.dying_gasp=%s\n' "${dying_gasp:-1}"
	printf 'epon.rx_fec=%s\n' "$(yesno_configured "$rx_fec")"
	printf 'epon.tx_fec=%s\n' "$(yesno_configured "$tx_fec")"
	printf 'epon.rate_mode=%s\n' "$(yesno_configured "$rate_mode")"

	printf 'config.apply=ponctl apply\n'
}

show_modules() {
	local mod mode

	printf '\nmodules:\n'
	for mod in $KNOWN_MODULES; do
		if grep -q "^$mod " /proc/modules 2>/dev/null; then
			printf '  %-22s loaded\n' "$mod"
		else
			printf '  %-22s missing\n' "$mod"
		fi
	done
	mode="$(cat /sys/module/xpon_10g/parameters/mode 2>/dev/null)"
	[ -z "$mode" ] || printf '  %-22s %s\n' "xpon_10g.mode" "$mode"
}

show_devnodes() {
	local node

	printf '\ndevices:\n'
	for node in /dev/pon /dev/epon_mac; do
		if [ -c "$node" ]; then
			ls -l "$node"
		else
			printf '%s missing\n' "$node"
		fi
	done
}

show_links() {
	local dev

	printf '\nlinks:\n'
	for dev in pon pon0 omci oam; do
		if ip link show dev "$dev" >/dev/null 2>&1; then
			ip -brief link show dev "$dev"
		else
			printf '%s missing\n' "$dev"
		fi
	done
}

read_proc_file() {
	local file="$1"

	[ -r "$file" ] || return 0
	printf '\n[%s]\n' "$file"
	cat "$file"
}

show_proc_dir() {
	local dir="$1"
	local name

	[ -d "$dir" ] || return 0
	for name in linkstate state onuid counter errcnt errsts keyinfo debug max_dscv_gate; do
		read_proc_file "$dir/$name"
	done
}

show_procs() {
	show_proc_dir /proc/xgpon
	show_proc_dir /proc/gpon
	show_proc_dir /proc/epon
	show_proc_dir /proc/pon_phy
}

create_nodes() {
	[ -c /dev/pon ] || mknod /dev/pon c 190 0
	[ -c /dev/epon_mac ] || mknod /dev/epon_mac c 221 0
	chmod 0600 /dev/pon /dev/epon_mac 2>/dev/null
}

status() {
	printf 'Airoha PON status\n'
	show_config
	show_modules
	show_devnodes
	show_links
	show_procs
}

case "$1" in
	status|"")
		status
		;;
	config)
		show_config
		;;
	mode-map)
		show_mode_map
		;;
	modules)
		show_modules
		;;
	devices)
		show_devnodes
		;;
	links)
		show_links
		;;
	nodes)
		create_nodes
		show_devnodes
		;;
	apply|start|stop|reload)
		"/etc/init.d/pon" "$1"
		;;
	procs)
		show_procs
		;;
	*)
		usage >&2
		exit 1
		;;
esac
