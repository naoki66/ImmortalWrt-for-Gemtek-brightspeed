From: naoki66 <naoki66@qq.com>
Subject: [PATCH] argon: link the LuCI footer entries to immortalwrt/luci

Both footers hard-code https://github.com/openwrt/luci. This firmware
tracks immortalwrt/luci, so point the "Powered by LuCI" link in the
desktop footer and the LuCI Master entry on the login page there.

---
--- a/ucode/template/themes/argon/footer.ut
+++ b/ucode/template/themes/argon/footer.ut
@@ -19,7 +19,7 @@
 		</div>
 		<footer class="mobile-hide" style="text-wrap: auto">
 			<div class="footer-content" style="display: flex; flex-wrap: wrap; gap: 0.5em; justify-content: end;">
-				<a class="luci-link" href="https://github.com/openwrt/luci" target="_blank">Powered by {{ version.luciname }} ({{ version.luciversion }})</a>
+				<a class="luci-link" href="https://github.com/immortalwrt/luci" target="_blank">Powered by {{ version.luciname }} ({{ version.luciversion }})</a>
 
 				<span class="footer-separator">|</span>
 
--- a/ucode/template/themes/argon/footer_login.ut
+++ b/ucode/template/themes/argon/footer_login.ut
@@ -23,7 +23,7 @@
 %}
 <footer>
 	<div class="login-footer-links">
-		<a href="https://github.com/openwrt/luci" target="_blank" title="{{ entityencode(luci_info, true) }}">{{ split(version.luciname, ' (')[0] }}</a>
+		<a href="https://github.com/immortalwrt/luci" target="_blank" title="{{ entityencode(luci_info, true) }}">{{ split(version.luciname, ' (')[0] }}</a>
 		<a href="https://github.com/jerrykuku/luci-theme-argon" target="_blank">ArgonTheme {# vPKG_VERSION #}</a>
 	</div>
 	<a href="{{ version.disturl }}" target="_blank" title="{{ entityencode(firmware_info, true) }}">{{ firmware_info }}</a>
