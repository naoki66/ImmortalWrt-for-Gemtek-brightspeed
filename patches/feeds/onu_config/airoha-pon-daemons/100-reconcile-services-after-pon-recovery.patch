@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+
+#[derive(Clone, Copy, Eq, PartialEq)]
+struct LinkState {
+    up: bool,
+    changes: u64,
+}
+
+pub struct LinkMonitor {
+    directory: PathBuf,
+    last: Option<LinkState>,
+}
+
+impl LinkMonitor {
+    pub fn new(directory: PathBuf) -> Self {
+        Self {
+            directory,
+            last: None,
+        }
+    }
+
+    pub fn is_up(&self) -> bool {
+        self.last.is_some_and(|state| state.up)
+    }
+
+    /// The counter also detects a down/up cycle completed between two samples.
+    pub fn refresh(&mut self) -> io::Result<bool> {
+        let changes = fs::read_to_string(self.directory.join("carrier_changes"))?
+            .trim()
+            .parse()
+            .map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "invalid carrier change count"))?;
+        let up = match fs::read_to_string(self.directory.join("carrier")) {
+            Ok(value) => match value.trim() {
+                "0" => false,
+                "1" => true,
+                _ => return Err(io::Error::new(io::ErrorKind::InvalidData, "invalid carrier")),
+            },
+            // Linux returns EINVAL for carrier reads on an administratively down netdev.
+            Err(error) if error.raw_os_error() == Some(22) => false,
+            Err(error) => return Err(error),
+        };
+        let current = LinkState { up, changes };
+        Ok(self.last.replace(current).is_some_and(|old| old != current))
+    }
+}
+
+/// Read back the kernel value instead of caching success across registration resets.
+/// Any failed read/write is retried by the next agent iteration.
+pub fn sync_service_ready(path: Option<&Path>, ready: bool) -> io::Result<()> {
+    let Some(path) = path else {
+        return Ok(());
+    };
+    let desired = if ready { "1" } else { "0" };
+    if fs::read_to_string(path)?.trim() != desired {
+        fs::write(path, format!("{desired}\n"))?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    static NEXT_FIXTURE: AtomicUsize = AtomicUsize::new(0);
+
+    struct Fixture(PathBuf);
+
+    impl Fixture {
+        fn new() -> Self {
+            let root = std::env::temp_dir().join(format!(
+                "pond-oam-test-{}-{}",
+                std::process::id(),
+                NEXT_FIXTURE.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::create_dir(&root).unwrap();
+            Self(root)
+        }
+
+        fn set_link(&self, up: bool, changes: u64) {
+            fs::write(self.0.join("carrier"), if up { "1\n" } else { "0\n" }).unwrap();
+            fs::write(self.0.join("carrier_changes"), changes.to_string()).unwrap();
+        }
+    }
+
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            fs::remove_dir_all(&self.0).unwrap();
+        }
+    }
+
+    #[test]
+    fn detects_down_up_and_a_fast_registration_cycle() {
+        let fixture = Fixture::new();
+        fixture.set_link(true, 1);
+        let mut monitor = LinkMonitor::new(fixture.0.clone());
+        assert!(!monitor.refresh().unwrap());
+        assert!(monitor.is_up());
+        assert!(!monitor.refresh().unwrap());
+        fixture.set_link(false, 2);
+        assert!(monitor.refresh().unwrap());
+        assert!(!monitor.is_up());
+        fixture.set_link(true, 3);
+        assert!(monitor.refresh().unwrap());
+        fixture.set_link(true, 5);
+        assert!(monitor.refresh().unwrap());
+        assert!(monitor.is_up());
+    }
+
+    #[test]
+    fn readiness_is_republished_after_the_kernel_clears_it() {
+        let fixture = Fixture::new();
+        let path = fixture.0.join("service_ready");
+        fs::write(&path, "0\n").unwrap();
+        sync_service_ready(Some(&path), true).unwrap();
+        assert_eq!(fs::read_to_string(&path).unwrap(), "1\n");
+        fs::write(&path, "0\n").unwrap();
+        sync_service_ready(Some(&path), true).unwrap();
+        assert_eq!(fs::read_to_string(&path).unwrap(), "1\n");
+        sync_service_ready(Some(&path), false).unwrap();
+        assert_eq!(fs::read_to_string(&path).unwrap(), "0\n");
+    }
+
+    #[test]
+    fn a_failed_publication_is_not_remembered_as_success() {
+        let fixture = Fixture::new();
+        let path = fixture.0.join("service_ready");
+        assert!(sync_service_ready(Some(&path), true).is_err());
+        fs::write(&path, "0\n").unwrap();
+        sync_service_ready(Some(&path), true).unwrap();
+        assert_eq!(fs::read_to_string(&path).unwrap(), "1\n");
+    }
+}
