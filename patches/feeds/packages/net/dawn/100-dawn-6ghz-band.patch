+++ b/net/dawn/patches/100-add-6ghz-band.patch
@@ -0,0 +1,102 @@
+diff --git a/src/include/datastorage.h b/src/include/datastorage.h
+index a20d7ad..cd689de 100644
+--- a/src/include/datastorage.h
++++ b/src/include/datastorage.h
+@@ -45,9 +45,12 @@ int get_band(int freq);
+ 
+ // Band definitions
+ // Keep them sorted by frequency, in ascending order
++// The order matters: get_band() walks this list and the frequency table below
++// in lockstep, so a band has to sit above the ones below its upper frequency.
+ enum dawn_bands {
+     DAWN_BAND_80211G,
+     DAWN_BAND_80211A,
++    DAWN_BAND_80211A_6G,
+     __DAWN_BAND_MAX
+ };
+ 
+diff --git a/src/storage/datastorage.c b/src/storage/datastorage.c
+index 0184b50..5f9af84 100644
+--- a/src/storage/datastorage.c
++++ b/src/storage/datastorage.c
+@@ -25,14 +25,18 @@ static int compare_station_count(ap* ap_entry_own, ap* ap_entry_to_compare, stru
+ // config section name
+ const char *band_config_name[__DAWN_BAND_MAX] = {
+     "802_11g",
+-    "802_11a"
++    "802_11a",
++    "802_11a_6g"
+ };
+ 
+ // starting frequency
+ // TODO: make this configurable
+ const int max_band_freq[__DAWN_BAND_MAX] = {
+     2500,
+-    5925 // This may cause trouble because there's overlap between bands in different countries
++    5925, // This may cause trouble because there's overlap between bands in different countries
++    7150  // 6 GHz stops at channel 233 = 7115 MHz; without this the band falls
++          // through to get_band()'s "beyond the last known band" branch and a
++          // 6 GHz radio silently reuses the 802_11a metrics.
+ };
+ 
+ // FIXME: Using ratio of 4 to exercise skip handling in small network.  Set to 32, 64 or 128 for real use on larger network.
