. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

#
# Gemtek XR1710G / W1700K: LAN side is lan2 lan3 lan4, WAN side is the
# separate "wan" netdev.
#
# NOTE on board.json.bridge: ucidef_set_bridge_device() is deliberately NOT
# used here.  config_generate's "[ -n "$bridge" ]" branch runs for EVERY
# board.json network entry, so declaring a bridge would fold "wan" into it as
# well and hand both interfaces the same "br-lan.1" device.  Leaving bridge
# unset keeps the plain "lan -> br-lan" path.
#
# Whether br-lan becomes VLAN-aware is the operator's decision, not the
# firmware's: LuCI's Network -> Switch view (switch-vlan.js) writes both the
# vlan_filtering flag and the bridge-vlan sections as soon as a VLAN is
# configured there.  Should that happen, these ports qualify for that view --
# it requires every member to resolve to getType() "ethernet" or "switch",
# and "lan3"/"lan4" are internal GSW (DSA) ports while "lan2" is &gdm4.
#
gemtek_setup_interfaces()
{
	ucidef_set_interfaces_lan_wan "lan2 lan3 lan4" "wan"
}

an7581_setup_interfaces()
{
	local board="$1"

	case "$board" in
	airoha,an7581-evb)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "eth1"
		;;
	gemtek,w1700k-ubi|\
		gemtek,xr1710g-ubi)
		gemtek_setup_interfaces
		;;
	nokia,valyrian)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 10g" "wan"
		;;
	nokia,xg-040g-md |\
	nokia,xg-040g-md-ubi)
		ucidef_set_interface_lan "lan1 lan2 lan3 lan4"
		;;
	quantum,q1000k-ubi)
		# Both copper ports are LAN; the upstream connection is PON.
		ucidef_set_interface_lan "lan1 lan2"
		;;
	*)
		echo "Unsupported hardware. Network interfaces not initialized"
		;;
	esac
}

board_config_update
board=$(board_name)
an7581_setup_interfaces $board
board_config_flush

exit 0
