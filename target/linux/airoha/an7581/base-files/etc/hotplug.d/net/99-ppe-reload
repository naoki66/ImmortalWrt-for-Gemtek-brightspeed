#!/bin/sh

case "$ACTION" in
    ifup|add) ;;
    *) exit 0 ;;
esac

dev_name="${DEVICE:-$INTERFACE}"

case "$dev_name" in
    phy*|ap*)
        (
            lock /var/run/fw_reload.lock || exit 0
            trap 'lock -u /var/run/fw_reload.lock' EXIT

            sleep 2

            [ -x /etc/init.d/firewall ] || exit 0

            logger -t wifi-fix "Reload firewall for $dev_name"

            /etc/init.d/firewall reload
        ) &
        ;;
esac
