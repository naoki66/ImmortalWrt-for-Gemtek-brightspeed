#include "an7581-nokia_xg-040g-md-common.dtsi"

/ {
	model = "Gemtek XG2010G";
	compatible = "gemtek,xg2010g-ubi", "airoha,an7581", "airoha,en7581";

	memory@80000000 {
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};

	chosen {
		rootdisk = <&ubi_fit>;
		bootargs = "console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait rdinit=/sbin/init";
	};

	scu@1fb00000 {
		compatible = "econet,ecnt-scu";
		reg = <0x0 0x1fb00000 0x0 0x960>,
		      <0x0 0x1fa20000 0x0 0x360>,
		      <0x0 0x1fa2ff30 0x0 0x10>;
		interrupts = <GIC_SPI 47 IRQ_TYPE_LEVEL_HIGH>;
	};

	xpon@1fb64000 {
		compatible = "econet,ecnt-xpon";
		reg = <0x0 0x1fb64000 0x0 0x3e8>,
		      <0x0 0x1fb66000 0x0 0x23c>,
		      <0x0 0x1fb65000 0x0 0xff8>;
		interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
	};

	pon_phy@1faf0000 {
		compatible = "econet,ecnt-pon_phy";
		reg = <0x0 0x1faf0000 0x0 0x1fff>,
		      <0x0 0x1fa2ff24 0x0 0x4>,
		      <0x0 0x1faf3000 0x0 0xfff>,
		      <0x0 0x1faf4000 0x0 0xfff>;
	};

	tod: tod@1fbe2300 {
		compatible = "econet,ecnt-tod";
		reg = <0x0 0x1fbe2300 0x0 0xd0>;
		interrupts = <GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH>;
		status = "okay";
	};

	pcm_spi: pcm-spi@1fbc0000 {
		compatible = "airoha,en7581-pcm-spi-si32192";
		reg = <0x0 0x1fbc0000 0x0 0x30>,
		      <0x0 0x1fbd0000 0x0 0x5000>;
		reg-names = "spi", "pcm";
		airoha,chip-scu = <&chip_scu>;
		airoha,np-scu = <&scuclk>;
		pinctrl-names = "default";
		pinctrl-0 = <&pcm_spi_pins>;
		status = "okay";
	};
};

&en7581_pinctrl {
	pcm_spi_pins: pcm-spi-pins {
		mux {
			function = "pcm_spi";
			groups = "pcm_spi", "pcm_spi_int", "pcm_spi_rst",
				 "pcm_spi_cs1";
		};
	};
};

&i2c0 {
	compatible = "airoha,airoha-i2c";
	clock-frequency = <400000>;
	status = "okay";
};

&i2c1 {
	compatible = "airoha,airoha-i2c";
	clock-frequency = <400000>;
	status = "okay";
};

&spi_nand {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		bootloader@0 {
			label = "bootloader";
			reg = <0x00000000 0x00200000>;
			read-only;
		};

		uenv@200000 {
			label = "uenv";
			reg = <0x00200000 0x00200000>;
			read-only;
		};

		dsd@400000 {
			label = "dsd";
			reg = <0x00400000 0x00200000>;
			read-only;
		};

		ubi@600000 {
			label = "ubi";
			reg = <0x00600000 0x1b800000>;
			compatible = "linux,ubi";

			volumes {
				ubi-volume-bosa {
					volname = "bosa";
				};

				ubi-volume-factory {
					volname = "ri";

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <1>;
						#size-cells = <1>;

						macaddr_factory_3e: macaddr@3e {
							compatible = "mac-base";
							reg = <0x3e 0x6>;
							#nvmem-cell-cells = <1>;
						};
					};
				};

				ubi_fit: ubi-volume-fit {
					volname = "fit";
				};

				ubi-volume-fip {
					volname = "fip";
				};
			};
		};

		reserved-bmt@1be00000 {
			label = "reserved_bmt";
			reg = <0x1be00000 0x04200000>;
			read-only;
		};
	};
};

&pcie0 { status = "disabled"; };
&pcie1 { status = "disabled"; };
&pcie2 { status = "disabled"; };
&usb0 { status = "disabled"; };
&usb1 { status = "disabled"; };
&mmc0 { status = "disabled"; };

/* XG2010G stock firmware also starts the generic EN7581 NPU. */
&npu { status = "okay"; };

/* Stock firmware brings up the EN7581 AFE/PCM audio block before the ProSLIC.
 * Keep the I2S/ETDM DAI available for the XG2010G voice stack while the
 * Si32192 control path stays owned by the PCM-SPI driver above.
 */
&afe { status = "okay"; };

/* Let the mainline Ethernet owner expose the legacy PON register ABI. */
&eth {
	airoha,pon-compat;
};

/* Route CPUfreq through the SoC SCU when BL31's AVS SMC is unavailable:
 * the pmdomain driver only falls back to direct PLL programming when the
 * cpufreq node carries reg/reg-names (otherwise it bails with "ATF SMC not
 * available and no chip-scu reg in DT"). Mirrors the XR1710G and is a no-op
 * whenever airoha_cpu_smc_available() succeeds. */
&cpufreq {
	reg = <0x0 0x1FA20000 0x0 0x2C0
	       0x0 0x1EFBE000 0x0 0x800>;
	reg-names = "chip-scu", "mcucfg";
};

&mdio {
	rtl8261n_lan1: ethernet-phy@5 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <5>;

		reset-gpios = <&en7581_pinctrl 29 GPIO_ACTIVE_LOW>;
		reset-assert-us = <200000>;
		reset-deassert-us = <200000>;
		reset-before-id-read;

		realtek,sds-mode = <0x88c6>;
		realtek,patch-rtk-serdes;
	};

	rtl8261n_lan2: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <8>;

		reset-gpios = <&en7581_pinctrl 27 GPIO_ACTIVE_LOW>;
		reset-assert-us = <200000>;
		reset-deassert-us = <200000>;
		reset-before-id-read;

		realtek,sds-mode = <0x88c6>;
		realtek,patch-rtk-serdes;
	};
};

&gdm2 {
	status = "okay";

	phy-mode = "usxgmii";
	managed = "in-band-status";

	openwrt,netdev-name = "pon";
};

&pcie_pcs {
	status = "okay";
};

&gdm4 {
	#address-cells = <1>;
	#size-cells = <0>;

	eth_port0: eth-port@0 {
		compatible = "airoha,eth-port";
		reg = <0>;

		pcs-handle = <&eth_pcs>;

		phy-handle = <&rtl8261n_lan1>;
		phy-mode = "usxgmii";
		managed = "in-band-status";

		openwrt,netdev-name = "lan1";

		nvmem-cell-names = "mac-address";
		nvmem-cells = <&macaddr_factory_3e (0)>;

		status = "okay";
	};

	eth_port1: eth-port@1 {
		compatible = "airoha,eth-port";
		reg = <1>;

		pcs-handle = <&usb_pcs>;

		phy-handle = <&en8811>;
		phy-mode = "2500base-x";

		openwrt,netdev-name = "lan3";

		status = "okay";
	};
};

&usb_pcs {
	status = "okay";
};

&eth {
	gdm3: ethernet@3 {
		compatible = "airoha,eth-mac";
		reg = <3>;

		pcs-handle = <&pcie_pcs 1>;

		phy-handle = <&rtl8261n_lan2>;
		phy-mode = "usxgmii";
		managed = "in-band-status";

		openwrt,netdev-name = "lan2";

		status = "okay";
	};
};

&gsw_port2 {
	status = "disabled";
};

&gsw_port3 {
	status = "disabled";
};
