/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/phy/phy.h>
#include "an7581.dtsi"

/ {
	model = "Gemtek XG2010G";
	compatible = "gemtek,xg2010g",
		     "airoha,an7581", "airoha,en7581";
	aliases {
		led-boot = &led_status_red;
		led-failsafe = &led_status_blue;
		led-running = &led_status_green;
		led-upgrade = &led_status_blue;
		serial0 = &uart1;
	};

	chosen {
		rootdisk = <&ubi_rootfs>;
		bootargs = "console=ttyS0,115200 earlycon cpufreq.default_governor=powersave ubi.block=0,fit root=/dev/fit0 rootwait rdinit=/sbin/init";
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		/* The board contains 1 GiB of DRAM. */
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status_red: led-status-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 43 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led_status_green: led-status-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 44 GPIO_ACTIVE_LOW>;
		};

		led_status_blue: led-status-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 45 GPIO_ACTIVE_LOW>;
		};
		
		led_status_white: led-status-white {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 33 GPIO_ACTIVE_LOW>;
		};

		led-internet {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&en7581_pinctrl 14 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-online";
		};

		/* The green PON LED reflects O1-O3, O4, and O5 registration stages. */
		led-pon {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-registration";
		};

		/* The red PON LED indicates optical signal loss. */
		led-pon-los {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 16 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-los";
		};

		/* GPIO42 and GPIO46 drive the LAN4 1GbE bicolor indicator. */
		led-lan-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <4>;
			gpios = <&en7581_pinctrl 46 GPIO_ACTIVE_LOW>;
		};

		led-lan-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <4>;
			gpios = <&en7581_pinctrl 42 GPIO_ACTIVE_LOW>;
		};
	};
};

&cpufreq {
	reg = <0x0 0x1fa20000 0x0 0x2c0
	       0x0 0x1efbe000 0x0 0x800>;
	reg-names = "chip-scu", "mcucfg";
	airoha,force-direct-pll;
};

&cpu_opp_table {
	opp-1250000000 {
		opp-hz = /bits/ 64 <1250000000>;
		required-opps = <&smcc_opp15>;
	};

	opp-1300000000 {
		opp-hz = /bits/ 64 <1300000000>;
		required-opps = <&smcc_opp16>;
	};

	opp-1350000000 {
		opp-hz = /bits/ 64 <1350000000>;
		required-opps = <&smcc_opp17>;
	};

	opp-1400000000 {
		opp-hz = /bits/ 64 <1400000000>;
		required-opps = <&smcc_opp18>;
	};
};

&cpu_smcc_opp_table {
	smcc_opp15: opp15 {
		opp-level = <15>;
	};

	smcc_opp16: opp16 {
		opp-level = <16>;
	};

	smcc_opp17: opp17 {
		opp-level = <17>;
	};

	smcc_opp18: opp18 {
		opp-level = <18>;
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};
	};

	pon_pins: pon-pins {
		mux {
			/* Leave GPIO38/TX_DISABLE under optical frontend control. */
			function = "pon";
			groups = "pon_tx_disable_gpio";
		};
	};
};

&snfi {
	status = "okay";
};

&spi_nand {
	#address-cells = <1>;
	#size-cells = <1>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x00000000 0x00200000>;
			read-only;
		};

		partition@200000 {
			label = "uenv";
			reg = <0x00200000 0x00200000>;
		};

		partition@400000 {
			label = "dsd";
			reg = <0x00400000 0x00200000>;
		};

		partition@600000 {
			label = "chainloader";
			reg = <0x00600000 0x00100000>;
			read-only;
		};

		partition@700000 {
			label = "system";
			reg = <0x00700000 0x1b700000>;
			compatible = "linux,ubi";

			volumes {
				/*
				 * No ubootenv/ubootenv2 volumes here: the chainloader U-Boot
				 * keeps its environment in the "uenv" MTD partition
				 * (CONFIG_ENV_IS_IN_MTD=y, CONFIG_ENV_MTD_DEV="uenv",
				 * CONFIG_ENV_OFFSET=0x0, CONFIG_ENV_SIZE=0x4000) -- the same
				 * place the stock firmware uses.  Only XR1710G moves the
				 * environment into UBI volumes (CONFIG_ENV_IS_IN_UBI).
				 */
				ubi_rootfs: ubi-volume-fit {
					volname = "fit";
				};

				/*
				 * Holds an OOB-stripped copy of the whole 2 MiB "dsd"
				 * partition, not a repacked subset.  The chainloader
				 * U-Boot must dump dsd -> factory wholesale (the way
				 * pbs05/uboot-an758x does), otherwise every offset
				 * below reads back as 0xff.
				 */
				ubi_factory: ubi-volume-factory {
					volname = "factory";
				};
			};
		};

		/* reserved for bad block table */
		reserved_bmt@1be00000 {
			label = "reserved_bmt";
			reg = <0x1be00000 0x04200000>;
			read-only;
		};
	};
};

/*
 * PON serial, MACs and optical calibration all live in the stock "dsd" area.
 * The "factory" UBI volume mirrors that whole 2 MiB partition, so the offsets
 * below are the raw DSD offsets.  Verified against the stock dump
 * mtd2-dsd-stock.bin (sha256 f98919ee154cbf0c777db0cdc622590ab0db52c0b27da96
 * cdcd33891fd66ae8c):
 *
 *   0x00000-0x0010b  key=value text block:
 *                    admin_password= / admin_username= / wan_mac= / lan_mac= /
 *                    serial_number= / clei_code= / fsan= / manufacturer= /
 *                    acDisable / dcDisable
 *   0x0006c  17 B    "00:58:28:B8:B5:AA"  PON/WAN MAC   (wan_mac= value)
 *   0x00086  17 B    "00:58:28:B8:B5:AB"  LAN base MAC  (lan_mac= value)
 *   0x000a6  20 B    "XG2010G2414004129"  board serial  (serial_number= value)
 *   0x000c2  10 B    "BVMN500GRA"         CLEI          (clei_code= value)
 *   0x000d2  12 B    "AXON10503683"       PON serial    (fsan= value)
 *   0x12014  36 B    ECONET / EN7572 ASCII identifiers
 *   0x12160  160 B   optical calibration / board data
 *
 * The stock firmware reads these through /usr/sbin/gtk_dsd (get <key> on
 * /dev/mtdblock2) and /usr/bin/xpon-dsd-env.sh; OpenWrt consumes the same
 * bytes through nvmem instead.
 */
&ubi_factory {
	nvmem-layout {
		compatible = "fixed-layout";
		#address-cells = <1>;
		#size-cells = <1>;

		pon_serial: pon-serial@d2 {
			/* DSD fsan stores a 4-byte vendor ID and hexadecimal VSSN. */
			reg = <0x000000d2 0x0000000c>;
		};

		pon_mac: mac-address@6c {
			/* DSD wan_mac keeps the original 17-byte colon-delimited text. */
			compatible = "mac-base";
			reg = <0x0000006c 0x00000011>;
			#nvmem-cell-cells = <1>;
		};

		lan_mac: mac-address@86 {
			/* +0: LAN1 10GbE, +1: LAN2 10GbE, +2: LAN3 2.5GbE, +3: CPU. */
			compatible = "mac-base";
			reg = <0x00000086 0x00000011>;
			#nvmem-cell-cells = <1>;
		};

		pon_calibration: calibration@12000 {
			/* Optical calibration sits at DSD offset 0x12000. */
			reg = <0x00012000 0x00000200>;
		};
	};
};

&i2c0 {
	status = "okay";

	en7572: optical-front-end@50 {
		compatible = "airoha,en7572";
		reg = <0x50>;
		/* GPIO38 high disables optical transmission during calibration and faults. */
		tx-disable-gpios = <&en7581_pinctrl 38 GPIO_ACTIVE_HIGH>;
		nvmem-cells = <&pon_calibration>;
		nvmem-cell-names = "calibration";
	};
};

&npu {
	status = "okay";
};

&eth {
	status = "okay";

	/* GDM3 NBQ4 and NBQ5 connect the PCIe0 and PCIe1 SerDes paths. */
	gdm3: ethernet@3 {
		compatible = "airoha,eth-mac";
		reg = <3>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		lan_10g_pcie1: ethernet-port@5 {
			compatible = "airoha,eth-port";
			reg = <5>;
			managed = "in-band-status";
			pcs-handle = <&pcie_pcs 1>;
			phy-handle = <&rtl8261n_8>;
			phy-mode = "usxgmii";
			nvmem-cells = <&lan_mac 1>;
			nvmem-cell-names = "mac-address";
			openwrt,netdev-name = "lan2";
			status = "okay";
		};
	};
};

&gdm1 {
	nvmem-cells = <&lan_mac 3>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&pon_pcs {
	status = "okay";
};

&xpon_mac {
	pinctrl-names = "default";
	pinctrl-0 = <&pon_pins>;
	optical-front-end = <&en7572>;
	data-path = <&gdm2>;
	nvmem-cells = <&pon_serial>;
	nvmem-cell-names = "pon-serial";
	status = "okay";
};

&gdm2 {
	nvmem-cells = <&pon_mac 0>;
	nvmem-cell-names = "mac-address";
	airoha,pon-data-path;
	status = "okay";
};

&pciephy {
	/* The dual-port Ethernet PCS manages the shared PMA for PCIe1 RTL8261N. */
	status = "disabled";
};

&pcie_pcs {
	status = "okay";
};

&usb_pcs {
	status = "okay";
};

&eth_pcs {
	status = "okay";
};

&gdm4 {
	/delete-property/ pcs-handle;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/* NBQ0 connects the Ethernet SerDes for the first panel 10GbE port. */
	lan_10g_eth: ethernet-port@0 {
		compatible = "airoha,eth-port";
		reg = <0>;
		managed = "in-band-status";
		pcs-handle = <&eth_pcs>;
		phy-handle = <&rtl8261n_5>;
		phy-mode = "usxgmii";
		nvmem-cells = <&lan_mac 0>;
		nvmem-cell-names = "mac-address";
		openwrt,netdev-name = "lan1";
		status = "okay";
	};

	/* NBQ1 connects USB1 SerDes to the EN8811H 2500BASE-X host link. */
	lan_2p5g: ethernet-port@1 {
		compatible = "airoha,eth-port";
		reg = <1>;
		pcs-handle = <&usb_pcs>;
		phy-handle = <&en8811>;
		phy-mode = "2500base-x";
		nvmem-cells = <&lan_mac 2>;
		nvmem-cell-names = "mac-address";
		openwrt,netdev-name = "lan3";
		status = "okay";
	};
};

&switch {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
	status = "okay";
};

&mdio {
	/* EN8811H uses MDIO address 0x0f and mode 1 for 2500BASE-X. */
	en8811: ethernet-phy@f {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <0x0f>;
		/* GPIO31 resets EN8811H before MD32 firmware loading. */
		reset-gpios = <&en7581_pinctrl 31 GPIO_ACTIVE_LOW>;
		reset-assert-us = <1000000>;
		reset-deassert-us = <100000>;
	};

	/* GPIO29 and GPIO27 are active-low resets for the two RTL8261N PHYs. */
	rtl8261n_5: ethernet-phy@5 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <5>;
		reset-gpios = <&en7581_pinctrl 29 GPIO_ACTIVE_LOW>;
		reset-assert-us = <200000>;
		reset-deassert-us = <200000>;
		reset-before-id-read;
		tx-polarity = <PHY_POL_INVERT>;
		rx-polarity = <PHY_POL_INVERT>;
	};

	rtl8261n_8: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <8>;
		reset-gpios = <&en7581_pinctrl 27 GPIO_ACTIVE_LOW>;
		reset-assert-us = <200000>;
		reset-deassert-us = <200000>;
		reset-before-id-read;
		tx-polarity = <PHY_POL_INVERT>;
		rx-polarity = <PHY_POL_INVERT>;
	};
};

&gsw_phy4 {
	/* Switch port 4 connects the 1GbE PHY at MDIO address 0x0c. */
	interrupts = <4>;
	/* PHY LEDs are disabled; provide the driver's named state without pins. */
	pinctrl-names = "gbe-led";
	pinctrl-0 = <>;
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

/*
 * Local XG2010G voice stack. Keep it after the PON-aligned blocks above.
 * The two RJ11 sockets are wired in parallel to one Si32192. Expose one
 * logical FXS line; AFE remains available for the SoC audio DAI.
 */
/ {
	tod: tod@1fbe2300 {
		compatible = "econet,ecnt-tod";
		reg = <0x0 0x1fbe2300 0x0 0xd0>;
		interrupts = <GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH>;
		status = "okay";
	};

	pcm0: pcm@1fbd0000 {
		compatible = "airoha,en7581-pcm";
		reg = <0x0 0x1fbd0000 0x0 0x1000>;
		reg-names = "pcm";
		interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
		airoha,pcm-interface-control = <0xf5051306>;
		airoha,tx-slot-config = <0x10101000 0x10301020
					 0x10501040 0x10701060>;
		airoha,rx-slot-config = <0x10101000 0x10301020
					 0x10501040 0x10701060>;
		airoha,dma-channel-mask = <0x01>;
		status = "okay";
	};

	isi0: spi@1fbd1000 {
		compatible = "airoha,en7581-isi-spi";
		reg = <0x0 0x1fbd1000 0x0 0x1000>;
		reg-names = "isi";
		airoha,scu = <&scuclk>;
		airoha,chip-scu = <&chip_scu>;
		pinctrl-names = "default";
		pinctrl-0 = <&pcm_spi_pins>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		proslic@0 {
			compatible = "silabs,si32192";
			reg = <0>;
			spi-max-frequency = <10000000>;
			spi-cpha;
			spi-cpol;
			airoha,pcm = <&pcm0>;
			airoha,pcm-channel = <0>;
			silabs,pcm-slot-skew = <0>;
		};
	};
};

&en7581_pinctrl {
	pcm_spi_pins: pcm-spi-pins {
		mux {
			function = "pcm_spi";
			/*
			 * GPIO1/GPIO2 are shared with MDIO in the vendor
			 * MDIO workaround. The ISI controller uses the SCU reset
			 * sequence and does not claim pcm_spi_int/pcm_spi_rst.
			 */
			groups = "pcm_spi", "pcm_spi_cs1";
		};
	};
};

&i2c1 {
	compatible = "airoha,airoha-i2c";
	clock-frequency = <400000>;
	status = "okay";
};

&afe {
	status = "okay";
};
