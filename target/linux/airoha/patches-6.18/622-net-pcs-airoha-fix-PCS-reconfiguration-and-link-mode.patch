@@ -596,9 +769,11 @@ static int airoha_pcs_config(struct phyl
 	/* Setup AN Link Timer */
 	if (interface == PHY_INTERFACE_MODE_SGMII ||
 	    interface == PHY_INTERFACE_MODE_1000BASEX) {
-		u32 an_timer;
+		int an_timer;
 
