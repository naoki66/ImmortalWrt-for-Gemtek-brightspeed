From: naoki66 <naoki66@qq.com>
Subject: [PATCH] net: phy: realtek: allow board-specific RTL826x SDS mode

The RTL826x firmware tables are shared by several PHY variants and boards,
so board-specific host-side SerDes setup does not belong in those tables.

Allow a board to provide the value for the RTL826x host-side SDS mode
register through the optional realtek,sds-mode property. Apply it after
the common firmware table, since the table loader resets and initializes
the SerDes block.

This is needed on the Gemtek XR1710G LAN2 path. Its vendor U-Boot writes
SDS page 6 register 3 to 0x88c6, while the common Linux initialization
sequence currently leaves that board setting out.

Signed-off-by: naoki66 <naoki66@qq.com>
---
 drivers/net/phy/realtek/phy_patch_rtl826x.h |  2 ++
 drivers/net/phy/realtek/realtek_main.c      | 39 +++++++++++++++++++++
 2 files changed, 41 insertions(+)

--- a/drivers/net/phy/realtek/phy_patch_rtl826x.h
+++ b/drivers/net/phy/realtek/phy_patch_rtl826x.h
@@ -5,6 +5,8 @@
 
 #include <linux/phy.h>
 
+int rtl826x_phy_patch_sds_set(struct phy_device *phydev, u32 sds_page,
+			      u32 sds_reg, u32 data);
 int rtl8261n_phy_patch_db_init(struct phy_device *phydev);
 int rtl8264b_phy_patch_db_init(struct phy_device *phydev);
 
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -216,6 +216,9 @@
 #define RTL826X_VEND1_VERSION_ID		0x104
 #define   RTL826X_VEND1_VERSION_ID_VARIANT	GENMASK(2, 0)
 
+#define RTL826X_SDS_HOST_MODE_PAGE		6
+#define RTL826X_SDS_HOST_MODE_REG		3
+
 #define RTL826X_VND2_INER			0xA424
 #define   RTL826X_VND2_INER_LINK_STATUS		BIT(4)
 #define   RTL826X_VND2_INER_PME			BIT(7)
@@ -2397,6 +2400,38 @@ static int rtl826x_probe(struct phy_device
 	return 0;
 }
 
+static int rtl826x_config_sds_mode(struct phy_device *phydev)
+{
+	struct device *dev = &phydev->mdio.dev;
+	u32 mode;
+	int ret;
+
+	if (!device_property_present(dev, "realtek,sds-mode"))
+		return 0;
+
+	ret = device_property_read_u32(dev, "realtek,sds-mode", &mode);
+	if (ret) {
+		phydev_err(phydev, "failed to read SDS mode: %d\n", ret);
+		return ret;
+	}
+
+	if (mode > 0xffff) {
+		phydev_err(phydev, "invalid SDS mode 0x%x\n", mode);
+		return -EINVAL;
+	}
+
+	ret = rtl826x_phy_patch_sds_set(phydev, RTL826X_SDS_HOST_MODE_PAGE,
+					RTL826X_SDS_HOST_MODE_REG, mode);
+	if (ret) {
+		phydev_err(phydev, "failed to set SDS mode 0x%04x: %d\n", mode, ret);
+		return ret;
+	}
+
+	phydev_info(phydev, "configured SDS mode 0x%04x\n", mode);
+
+	return 0;
+}
+
 static int rtl826x_config_serdes_polarity(struct phy_device *phydev)
 {
 	struct device *dev = &phydev->mdio.dev;
@@ -2473,6 +2508,10 @@ static int rtl826x_config_init(struct phy
 		return ret;
 	}
 
+	ret = rtl826x_config_sds_mode(phydev);
+	if (ret)
+		return ret;
+
 	return rtl826x_config_serdes_polarity(phydev);
 }
