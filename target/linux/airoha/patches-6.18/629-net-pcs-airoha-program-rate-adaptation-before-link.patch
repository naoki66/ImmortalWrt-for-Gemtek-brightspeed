-				   rate_adapt);
+		priv->usxgmii_rate_adapt_speed[port->index] = speed;
 	}
 
 	if (neg_mode != PHYLINK_PCS_NEG_INBAND_ENABLED) {
@@ -1495,6 +1516,10 @@
 
 	priv->dev = dev;
 	priv->data = data;
