From: naoki66 <naoki66@qq.com>
Subject: [PATCH] net: phy: realtek: add RTL826x initialization diagnostics

Some Gemtek XR1710G units establish the RTL8261BE copper link while the
AN7581 Ethernet PCS never receives a valid USXGMII status word.  Record
the silicon identifiers, selected firmware table, table size and each
config_init invocation so working and failing units can be compared.

Also read back the board-specific host SerDes mode after programming it
and report the AN7581 product ID and RX calibration policy.  These are
diagnostics only; the existing reset, firmware and calibration behavior
is unchanged.

Signed-off-by: naoki66 <naoki66@qq.com>
---
 drivers/net/pcs/airoha/pcs-airoha-common.c  |  6 +++
 drivers/net/phy/realtek/phy_patch_rtl826x.c |  5 ++-
 drivers/net/phy/realtek/phy_patch_rtl826x.h |  2 +
 drivers/net/phy/realtek/realtek.h           |  1 +
 drivers/net/phy/realtek/realtek_main.c      | 70 +++++++++++++++++++++++++++--
 5 files changed, 78 insertions(+), 6 deletions(-)

diff --git a/drivers/net/pcs/airoha/pcs-airoha-common.c b/drivers/net/pcs/airoha/pcs-airoha-common.c
--- a/drivers/net/pcs/airoha/pcs-airoha-common.c
+++ b/drivers/net/pcs/airoha/pcs-airoha-common.c
@@ -15,5 +15,6 @@
 #include <linux/reset.h>
 #include <linux/rtnetlink.h>
+#include <linux/string_choices.h>
 
 #include "pcs-airoha.h"
 
@@ -1336,4 +1337,9 @@ static int airoha_pcs_probe(struct platform_device *pdev)
 			priv->manual_rx_calib = true;
+
+		dev_info(dev,
+			 "AN7581 PDIDR=%#010x product-id=%#06x manual RX calibration %s\n",
+			 val, FIELD_GET(AIROHA_SCU_PRODUCT_ID, val),
+			 str_enabled_disabled(priv->manual_rx_calib));
 	}
 
 	for (index = 0; index < data->num_port; index++) {
diff --git a/drivers/net/phy/realtek/phy_patch_rtl826x.c b/drivers/net/phy/realtek/phy_patch_rtl826x.c
--- a/drivers/net/phy/realtek/phy_patch_rtl826x.c
+++ b/drivers/net/phy/realtek/phy_patch_rtl826x.c
@@ -66,7 +66,7 @@ static int rtl826x_phy_patch_wait(struct phy_device *phydev, u32 mmd_addr, u32 mm
 	return 0;
 }
 
-static int rtl826x_phy_patch_sds_get(struct phy_device *phydev, u32 sds_page, u32 sds_reg)
+int rtl826x_phy_patch_sds_get(struct phy_device *phydev, u32 sds_page, u32 sds_reg)
 {
 	u32 sds_addr = 0x8000 + (sds_reg << 6) + sds_page;
 	int ret;
@@ -254,6 +254,9 @@ static int rtl826x_phy_patch_db_init(struct phy_device *phydev, const char *fw_na
 	patches = (struct rtlgen_hwpatch *)fw->data;
 	count = fw->size / sizeof(*patches);
 
+	phydev_info(phydev, "firmware %s: %zu bytes, %zu operations\n",
+		    fw_name, fw->size, count);
+
 	patch_db = devm_kzalloc(dev, struct_size(patch_db, conf, count), GFP_KERNEL);
 	if (!patch_db) {
 		ret = -ENOMEM;
diff --git a/drivers/net/phy/realtek/phy_patch_rtl826x.h b/drivers/net/phy/realtek/phy_patch_rtl826x.h
--- a/drivers/net/phy/realtek/phy_patch_rtl826x.h
+++ b/drivers/net/phy/realtek/phy_patch_rtl826x.h
@@ -5,6 +5,8 @@
 
 #include <linux/phy.h>
 
+int rtl826x_phy_patch_sds_get(struct phy_device *phydev, u32 sds_page,
+			      u32 sds_reg);
 int rtl826x_phy_patch_sds_set(struct phy_device *phydev, u32 sds_page,
 			      u32 sds_reg, u32 data);
 int rtl8261n_phy_patch_db_init(struct phy_device *phydev);
diff --git a/drivers/net/phy/realtek/realtek.h b/drivers/net/phy/realtek/realtek.h
--- a/drivers/net/phy/realtek/realtek.h
+++ b/drivers/net/phy/realtek/realtek.h
@@ -10,6 +10,7 @@
 
 struct rtl826x_priv {
 	struct rtlgen_phy_patch_db *patch;
+	unsigned int config_init_count;
 	bool enable_pma_low_power:1;
 };
 
diff --git a/drivers/net/phy/realtek/realtek_main.c b/drivers/net/phy/realtek/realtek_main.c
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -2357,16 +2357,33 @@ static int rtlgen_sfp_config_aneg(struct phy_device *phydev)
 
 static int rtl826x_patch_db_init(struct phy_device *phydev)
 {
-	int ver;
+	const char *fw_name;
+	int pkg, ver;
+
+	pkg = phy_read_mmd(phydev, MDIO_MMD_VEND1, RTL826X_VEND1_PKG_MODEL);
+	if (pkg < 0)
+		phydev_warn(phydev, "failed to read package model: %d\n", pkg);
 
 	ver = phy_read_mmd(phydev, MDIO_MMD_VEND1, RTL826X_VEND1_VERSION_ID);
 	if (ver < 0)
 		return ver;
 
+	fw_name = ver & RTL826X_VEND1_VERSION_ID_VARIANT ?
+		  "rtl8261n.bin" : "rtl8264b.bin";
+	if (pkg < 0)
+		phydev_info(phydev, "version=0x%04x variant=%u selects %s\n",
+			    ver, FIELD_GET(RTL826X_VEND1_VERSION_ID_VARIANT, ver),
+			    fw_name);
+	else
+		phydev_info(phydev,
+			    "package=0x%04x version=0x%04x variant=%u selects %s\n",
+			    pkg, ver, FIELD_GET(RTL826X_VEND1_VERSION_ID_VARIANT, ver),
+			    fw_name);
+
 	if (ver & RTL826X_VEND1_VERSION_ID_VARIANT)
 		return rtl8261n_phy_patch_db_init(phydev);
-	else
-		return rtl8264b_phy_patch_db_init(phydev);
+
+	return rtl8264b_phy_patch_db_init(phydev);
 }
 
 static int rtl826x_probe(struct phy_device *phydev)
@@ -2401,6 +2418,7 @@ static int rtl826x_config_sds_mode(struct phy_device *phydev)
 {
 	struct device *dev = &phydev->mdio.dev;
 	u32 mode;
+	int readback;
 	int ret;
 
 	if (!device_property_present(dev, "realtek,sds-mode"))
@@ -2426,7 +2444,17 @@ static int rtl826x_config_sds_mode(struct phy_device *phydev)
 		return ret;
 	}
 
-	phydev_info(phydev, "configured SDS mode 0x%04x\n", mode);
+	readback = rtl826x_phy_patch_sds_get(phydev, RTL826X_SDS_HOST_MODE_PAGE,
+					     RTL826X_SDS_HOST_MODE_REG);
+	if (readback < 0) {
+		phydev_warn(phydev, "failed to read back SDS mode: %d\n", readback);
+	} else if (readback != mode) {
+		phydev_warn(phydev, "SDS mode readback mismatch: wrote 0x%04x, read 0x%04x\n",
+			    mode, readback);
+	} else {
+		phydev_info(phydev, "configured SDS mode 0x%04x, readback 0x%04x\n",
+			    mode, readback);
+	}
 
 	return 0;
 }
@@ -2463,10 +2491,20 @@ static int rtl826x_config_serdes_polarity(struct phy_device *phydev)
 
 static int rtl826x_config_init(struct phy_device *phydev)
 {
+	struct rtl826x_priv *priv = phydev->priv;
 	const unsigned int max_dereset_tries = 5;
+	unsigned int sequence;
 	unsigned int tries = 0;
+	int global_cfg, sds_mode;
 	int ret;
 
+	sequence = ++priv->config_init_count;
+	phydev_info(phydev,
+		    "config-init #%u begin, interface=%s external-reset=%u/%u us\n",
+		    sequence, phy_modes(phydev->interface),
+		    phydev->mdio.reset_assert_delay,
+		    phydev->mdio.reset_deassert_delay);
+
 	/* Suppress PHY interrupt output before the hardware reset below.
 	 * The RTL8261N asserts its interrupt pin during power-on reset, which
 	 * races with phylib registering phy_interrupt. If the IRQ fires first
@@ -2500,6 +2538,9 @@ static int rtl826x_config_init(struct phy_device *phydev)
 		return ret;
 	}
 
+	phydev_info(phydev, "config-init #%u internal reset released after %u ms (%u tries)\n",
+		    sequence, tries * 30, tries);
+
 	msleep(30);
 
 	ret = rtlgen_phy_patch(phydev);
@@ -2508,11 +2549,30 @@ static int rtl826x_config_init(struct phy_device *phydev)
 		return ret;
 	}
 
+	phydev_info(phydev, "config-init #%u firmware patch applied\n", sequence);
+
 	ret = rtl826x_config_sds_mode(phydev);
 	if (ret)
 		return ret;
 
-	return rtl826x_config_serdes_polarity(phydev);
+	ret = rtl826x_config_serdes_polarity(phydev);
+	if (ret)
+		return ret;
+
+	global_cfg = phy_read_mmd(phydev, MDIO_MMD_VEND1,
+				  RTL826X_VEND1_SERDES_GLOBAL_CFG);
+	sds_mode = rtl826x_phy_patch_sds_get(phydev, RTL826X_SDS_HOST_MODE_PAGE,
+					     RTL826X_SDS_HOST_MODE_REG);
+	if (global_cfg < 0 || sds_mode < 0)
+		phydev_warn(phydev,
+			    "config-init #%u final state read failed: global-cfg=%d sds-page6-reg3=%d\n",
+			    sequence, global_cfg, sds_mode);
+	else
+		phydev_info(phydev,
+			    "config-init #%u complete: global-cfg=%#06x sds-page6-reg3=%#06x\n",
+			    sequence, global_cfg, sds_mode);
+
+	return 0;
 }
 
 static int rtl826x_suspend(struct phy_device *phydev)
-- 
2.51.0
