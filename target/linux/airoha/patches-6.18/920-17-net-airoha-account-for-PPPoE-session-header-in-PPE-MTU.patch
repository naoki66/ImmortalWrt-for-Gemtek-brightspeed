From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: naoki66 <naoki66@local>
Date: Wed, 14 Oct 2026 09:00:00 +0800
Subject: [PATCH] net: airoha: account for the PPPoE session header in PPE/WAN
 egress MTU

920-16 accounts for VLAN_ETH_HLEN only. The PPE egress MTU register and the
WAN MTU register are compared against the L2 frame length without the FCS
(hardware reset value 0x05EA = 1514 = ETH_HLEN + 1500), so any L2
encapsulation sitting between the Ethernet header and the IP payload has to
be added to the programmed length.

A PPPoE session frame carries PPPOE_SES_HLEN (8) extra bytes: 6 bytes of
PPPoE header plus the 2-byte PPP protocol field. On the uplink GDM that a
PPPoE session egresses through, an MTU of 1492 therefore produces frames of
up to 1492 + 8 + VLAN_ETH_HLEN bytes once the operator VLAN tag is also
present. With only VLAN_ETH_HLEN added, the register is programmed to 1510
while the longest valid frame is 1518, so the hardware drops full-size PPPoE
session frames. The symptom is the familiar "small pings pass, large ones
vanish" pattern.

Add the PPPoE session header on the uplink GDM devices only. In
airoha_ppe_set_mtu() the MTU is aggregated across every device sharing the
QDMA/port, so the check happens per-device inside the aggregation loop: a
PPPoE-capable uplink contributes mtu + VLAN_ETH_HLEN + PPPOE_SES_HLEN, while
a LAN port keeps the VLAN-only accounting and is not given eight bytes of
needless headroom.

Signed-off-by: naoki66 <naoki66@local>
---
 drivers/net/ethernet/airoha/airoha_eth.c | 13 ++++++++++---
 drivers/net/ethernet/airoha/airoha_ppe.c | 24 ++++++++++++++++++++----
 2 files changed, 30 insertions(+), 7 deletions(-)

--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -17,6 +17,7 @@
 #include <net/pkt_cls.h>
 #include <net/tcp.h>
 #include <uapi/linux/ppp_defs.h>
+#include <linux/if_pppox.h>
 
 #include "airoha_regs.h"
 #include "airoha_eth.h"
@@ -2150,12 +2151,23 @@
 static void airoha_dev_set_mtu(struct net_device *netdev)
 {
 	struct airoha_gdm_dev *dev = netdev_priv(netdev);
+	u32 len = netdev->mtu;
 
 	airoha_ppe_set_mtu(dev);
-	if (!airoha_is_lan_gdm_dev(dev))
+	/* A PPPoE session can only egress through an uplink GDM; its 8-byte
+	 * session header (PPPOE_SES_HLEN) sits between the Ethernet header and
+	 * the IP payload, so it counts into the L2 frame length the WAN MTU
+	 * register is compared against, on top of the operator VLAN tag that
+	 * VLAN_ETH_HLEN already covers. LAN ports stay VLAN-only.
+	 */
+	if (!airoha_is_lan_gdm_dev(dev)) {
+		if (dev->flags & AIROHA_PRIV_F_PON)
+			len += PPPOE_SES_HLEN;
+
 		airoha_fe_rmw(dev->eth, REG_WAN_MTU0,
 			      WAN_MTU0_MASK,
-			      FIELD_PREP(WAN_MTU0_MASK, netdev->mtu + VLAN_ETH_HLEN));
+			      FIELD_PREP(WAN_MTU0_MASK, len + VLAN_ETH_HLEN));
+	}
 }
 
 static int airoha_dev_open(struct net_device *netdev)
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -11,6 +11,7 @@
 #include <linux/rhashtable.h>
 #include <net/ipv6.h>
 #include <linux/if_vlan.h>
+#include <linux/if_pppox.h>
 #include <net/pkt_cls.h>
 #include <net/route.h>
 
@@ -115,6 +116,7 @@
 		struct airoha_gdm_dev *d = port->devs[i];
 		struct net_device *netdev;
 		struct airoha_qdma *q;
+		u32 mtu;
 
 		if (!d)
 			continue;
@@ -124,11 +126,21 @@
 			continue;
 
 		netdev = netdev_from_priv(d);
-		if (netif_running(netdev))
-			len = max_t(u32, len, netdev->mtu);
-	}
+		if (!netif_running(netdev))
+			continue;
 
-	len += VLAN_ETH_HLEN;
+		/* The register is compared against the on-wire L2 length, so
+		 * every encapsulation on this egress path has to be added to
+		 * the aggregated MTU. VLAN_ETH_HLEN applies to all ports; an
+		 * uplink GDM (PON) can additionally carry a PPPoE session whose
+		 * PPPOE_SES_HLEN sits between Ethernet and the IP payload.
+		 */
+		mtu = netdev->mtu + VLAN_ETH_HLEN;
+		if (d->flags & AIROHA_PRIV_F_PON)
+			mtu += PPPOE_SES_HLEN;
+
+		len = max_t(u32, len, mtu);
+	}
 	ppe_id = !airoha_is_lan_gdm_dev(dev) && airoha_ppe_is_enabled(eth, 1);
 	index = port->id == AIROHA_GDM4_IDX ? 7 : port->id;
 	airoha_fe_rmw(eth, REG_PPE_MTU(ppe_id, index),
