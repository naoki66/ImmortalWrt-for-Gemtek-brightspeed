From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 20 Sep 2026 00:00:00 +0800
Subject: [PATCH] net: airoha: add legacy xPON compatibility layer

Expose the legacy FE/QDMA register and IRQ view, the PPE multicast
compatibility provider and the Airoha ToD PHC build option used by the
vendor EN7581 xPON modules. This is a property of the shared AN7581
target, so it is applied on every AN7581 board: PON and non-PON alike.

It stays functional only when CONFIG_AIROHA_PON_COMPAT is selected (the
xPON packages do this); otherwise the code is compiled out and non-PON
boards keep their original behaviour.
Signed-off-by: naoki66 <naoki66@qq.com>

---
diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 433a646..d474b26 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -17,6 +17,19 @@
 #include "airoha_regs.h"
 #include "airoha_eth.h"
 
+#define AIROHA_PON_FE_BASE		0x1fb50000
+#define AIROHA_PON_FE_SIZE		0x00002600
+#define AIROHA_PON_QDMA0_BASE		0x1fb54000
+#define AIROHA_PON_QDMA_SIZE		0x00002000
+#define AIROHA_PON_QDMA1_BASE		0x1fb56000
+#define AIROHA_PON_SWITCH_BASE		0x1fb58000
+#define AIROHA_PON_SWITCH_SIZE		0x00008000
+
+static struct airoha_eth *airoha_pon_eth;
+static phys_addr_t airoha_pon_qdma_lan_buffer_base;
+static phys_addr_t airoha_pon_qdma_wan_buffer_base;
+static phys_addr_t airoha_pon_ppe_buffer_base;
+
 u32 airoha_rr(void __iomem *base, u32 offset)
 {
 	return readl(base + offset);
@@ -1345,6 +1358,172 @@ static int airoha_qdma_init_irq_banks(struct platform_device *pdev,
 	return 0;
 }
 
+static void __iomem *airoha_pon_reg_base(struct airoha_eth *eth,
+						 u32 reg, u32 *offset)
+{
+	u32 reg_phy = reg;
+
+	if (reg_phy > 0xa0000000)
+		reg_phy &= 0x1fffffff;
+
+	if (reg_phy & 0x3)
+		return NULL;
+
+	if (reg_phy >= AIROHA_PON_FE_BASE &&
+	    reg_phy < AIROHA_PON_FE_BASE + AIROHA_PON_FE_SIZE) {
+		*offset = reg_phy - AIROHA_PON_FE_BASE;
+		return eth->fe_regs;
+	}
+
+	if (reg_phy >= AIROHA_PON_QDMA0_BASE &&
+	    reg_phy < AIROHA_PON_QDMA0_BASE + AIROHA_PON_QDMA_SIZE) {
+		*offset = reg_phy - AIROHA_PON_QDMA0_BASE;
+		return eth->qdma[0].regs;
+	}
+
+	if (reg_phy >= AIROHA_PON_QDMA1_BASE &&
+	    reg_phy < AIROHA_PON_QDMA1_BASE + AIROHA_PON_QDMA_SIZE) {
+		*offset = reg_phy - AIROHA_PON_QDMA1_BASE;
+		return eth->qdma[1].regs;
+	}
+
+	if (reg_phy >= AIROHA_PON_SWITCH_BASE &&
+	    reg_phy < AIROHA_PON_SWITCH_BASE + AIROHA_PON_SWITCH_SIZE &&
+	    eth->pon_switch_regs) {
+		*offset = reg_phy - AIROHA_PON_SWITCH_BASE;
+		return eth->pon_switch_regs;
+	}
+
+	return NULL;
+}
+
+u32 get_frame_engine_data(u32 reg)
+{
+	struct airoha_eth *eth = READ_ONCE(airoha_pon_eth);
+	void __iomem *base;
+	u32 offset;
+
+	if (!eth)
+		return 0;
+
+	base = airoha_pon_reg_base(eth, reg, &offset);
+	if (!base)
+		return 0;
+
+	return airoha_rr(base, offset);
+}
+EXPORT_SYMBOL(get_frame_engine_data);
+
+void set_frame_engine_data(u32 reg, u32 val)
+{
+	struct airoha_eth *eth = READ_ONCE(airoha_pon_eth);
+	void __iomem *base;
+	u32 offset;
+
+	if (!eth)
+		return;
+
+	base = airoha_pon_reg_base(eth, reg, &offset);
+	if (base)
+		airoha_wr(base, offset, val);
+}
+EXPORT_SYMBOL(set_frame_engine_data);
+
+struct device *get_frame_engine_dev(void)
+{
+	struct airoha_eth *eth = READ_ONCE(airoha_pon_eth);
+
+	return eth ? eth->dev : NULL;
+}
+EXPORT_SYMBOL(get_frame_engine_dev);
+
+struct airoha_eth *airoha_pon_compat_get_eth(void)
+{
+	return READ_ONCE(airoha_pon_eth);
+}
+EXPORT_SYMBOL_GPL(airoha_pon_compat_get_eth);
+
+int get_qdma_lan_irq(int index)
+{
+	struct airoha_eth *eth = READ_ONCE(airoha_pon_eth);
+
+	if (!eth || index < 0 || index >= ARRAY_SIZE(eth->qdma[0].irq_banks))
+		return -ENODEV;
+
+	return eth->qdma[0].irq_banks[index].irq;
+}
+EXPORT_SYMBOL(get_qdma_lan_irq);
+
+int get_qdma_wan_irq(int index)
+{
+	struct airoha_eth *eth = READ_ONCE(airoha_pon_eth);
+
+	if (!eth || index < 0 || index >= ARRAY_SIZE(eth->qdma[1].irq_banks))
+		return -ENODEV;
+
+	return eth->qdma[1].irq_banks[index].irq;
+}
+EXPORT_SYMBOL(get_qdma_wan_irq);
+
+int get_fe_irq(void)
+{
+	struct airoha_eth *eth = READ_ONCE(airoha_pon_eth);
+
+	return eth ? eth->fe_irq : -ENODEV;
+}
+EXPORT_SYMBOL(get_fe_irq);
+
+int get_pdma_irq(void)
+{
+	struct airoha_eth *eth = READ_ONCE(airoha_pon_eth);
+
+	return eth ? eth->pdma_irq : -ENODEV;
+}
+EXPORT_SYMBOL(get_pdma_irq);
+
+int get_tdma_irq(int index)
+{
+	(void)index;
+	return -ENODEV;
+}
+EXPORT_SYMBOL(get_tdma_irq);
+
+void ecnt_qdma_lan_set_buffer_base(phys_addr_t buffer_base)
+{
+	airoha_pon_qdma_lan_buffer_base = buffer_base;
+}
+EXPORT_SYMBOL(ecnt_qdma_lan_set_buffer_base);
+
+unsigned int ecnt_qdma_lan_get_buffer_base(void)
+{
+	return (unsigned int)airoha_pon_qdma_lan_buffer_base;
+}
+EXPORT_SYMBOL(ecnt_qdma_lan_get_buffer_base);
+
+void ecnt_qdma_wan_set_buffer_base(phys_addr_t buffer_base)
+{
+	airoha_pon_qdma_wan_buffer_base = buffer_base;
+}
+EXPORT_SYMBOL(ecnt_qdma_wan_set_buffer_base);
+
+unsigned int ecnt_qdma_wan_get_buffer_base(void)
+{
+	return (unsigned int)airoha_pon_qdma_wan_buffer_base;
+}
+EXPORT_SYMBOL(ecnt_qdma_wan_get_buffer_base);
+
+void ecnt_ppe_set_buffer_base(phys_addr_t buffer_base)
+{
+	airoha_pon_ppe_buffer_base = buffer_base;
+}
+EXPORT_SYMBOL(ecnt_ppe_set_buffer_base);
+
+unsigned int ecnt_ppe_get_buffer_base(void)
+{
+	return (unsigned int)airoha_pon_ppe_buffer_base;
+}
+EXPORT_SYMBOL(ecnt_ppe_get_buffer_base);
+
 static int airoha_qdma_init(struct platform_device *pdev,
 			    struct airoha_eth *eth,
 			    struct airoha_qdma *qdma)
@@ -2920,6 +3093,7 @@ static int airoha_probe(struct platform_device *pdev)
 	struct device_node *np;
 	struct airoha_eth *eth;
 	int i, err;
+	bool pon_compat;
 
 	eth = devm_kzalloc(&pdev->dev, sizeof(*eth), GFP_KERNEL);
 	if (!eth)
@@ -2938,6 +3112,19 @@ static int airoha_probe(struct platform_device *pdev)
 		return dev_err_probe(eth->dev, PTR_ERR(eth->fe_regs),
 				     "failed to iomap fe regs\n");
 
+	pon_compat = of_property_read_bool(pdev->dev.of_node,
+						  "airoha,pon-compat");
+	if (pon_compat) {
+		eth->pon_switch_regs = devm_ioremap(eth->dev,
+						    AIROHA_PON_SWITCH_BASE,
+						    AIROHA_PON_SWITCH_SIZE);
+		if (!eth->pon_switch_regs)
+			return -ENOMEM;
+	}
+
+	eth->fe_irq = platform_get_irq_optional(pdev, 8);
+	eth->pdma_irq = platform_get_irq_optional(pdev, 9);
+
 	eth->rsts[0].id = "fe";
 	eth->rsts[1].id = "pdma";
 	eth->rsts[2].id = "qdma";
@@ -2993,6 +3180,8 @@ static int airoha_probe(struct platform_device *pdev)
 		}
 	}
 
+	WRITE_ONCE(airoha_pon_eth, eth);
+
 	return 0;
 
 error_napi_stop:
@@ -4265,4 +4265,6 @@ static void airoha_remove(struct platform_device *pdev)
 	struct airoha_eth *eth = platform_get_drvdata(pdev);
 	int i;
 
+	WRITE_ONCE(airoha_pon_eth, NULL);
+
 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
index cd13c1c..1ee1496 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -580,6 +580,11 @@ struct airoha_eth {
 
 	struct airoha_qdma qdma[AIROHA_MAX_NUM_QDMA];
 	struct airoha_gdm_port *ports[AIROHA_MAX_NUM_GDM_PORTS];
+
+	/* Optional legacy xPON register/IRQ compatibility view. */
+	void __iomem *pon_switch_regs;
+	int fe_irq;
+	int pdma_irq;
 };
 
 u32 airoha_rr(void __iomem *base, u32 offset);
--
2.47.0

diff --git a/include/linux/airoha_ppe_compat.h b/include/linux/airoha_ppe_compat.h
new file mode 100644
--- /dev/null
+++ b/include/linux/airoha_ppe_compat.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_AIROHA_PPE_COMPAT_H
+#define __LINUX_AIROHA_PPE_COMPAT_H
+
+#include <linux/types.h>
+
+struct net_device;
+
+#define AIROHA_PPE_MC_PROTO_IPV4	4
+#define AIROHA_PPE_MC_PROTO_IPV6	6
+#define AIROHA_PPE_MC_UPDATE_VLAN	(1U << 0)
+#define AIROHA_PPE_MC_UPDATE_GRPIP	(1U << 1)
+#define AIROHA_PPE_MC_UPDATE_SRCIP	(1U << 2)
+
+struct airoha_ppe_mc_info {
+	u32 proto;
+	u32 vlan_tag_num;
+	u16 outer_tci;
+	u16 inner_tci;
+	u8 grp_addr[16];
+	u8 src_addr[16];
+	struct net_device *orig_dev;
+	u16 br_vid;
+};
+
+int airoha_ppe_mc_update(const struct airoha_ppe_mc_info *info,
+			 u32 update_mode, u32 op_type, u32 port_mask, u32 local);
+int airoha_ppe_mc_clear(void);
+int airoha_ppe_mc_get_portmask(const struct airoha_ppe_mc_info *info,
+			       u32 foe_index);
+int airoha_ppe_mc_subscribe(const struct airoha_ppe_mc_info *info,
+			   u32 update_mode);
+int airoha_ppe_mc_get_local(const struct airoha_ppe_mc_info *info);
+int airoha_ppe_mc_get_origdev(struct airoha_ppe_mc_info *info);
+
+#endif
diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -786,5 +786,203 @@ static int airoha_ppe_foe_commit_entry(struct airoha_ppe *ppe,
 	return err;
 }
+
+#include <linux/airoha_ppe_compat.h>
+extern struct airoha_eth *airoha_pon_compat_get_eth(void);
+
+static struct airoha_ppe *airoha_ppe_mc_instance(void)
+{
+	struct airoha_eth *eth = airoha_pon_compat_get_eth();
+
+	return eth ? READ_ONCE(eth->ppe) : NULL;
+}
+
+static void airoha_ppe_mc_group_mac(const struct airoha_ppe_mc_info *info,
+					    u8 *mac)
+{
+	memset(mac, 0, ETH_ALEN);
+
+	if (info->proto == AIROHA_PPE_MC_PROTO_IPV4) {
+		mac[0] = 0x01;
+		mac[1] = 0x00;
+		mac[2] = 0x5e;
+		mac[3] = info->grp_addr[1] & 0x7f;
+		mac[4] = info->grp_addr[2];
+		mac[5] = info->grp_addr[3];
+	} else if (info->proto == AIROHA_PPE_MC_PROTO_IPV6) {
+		mac[0] = 0x33;
+		mac[1] = 0x33;
+		memcpy(&mac[2], &info->grp_addr[12], 4);
+	}
+}
+
+static bool airoha_ppe_mc_match(const struct airoha_foe_entry *hwe,
+					const struct airoha_ppe_mc_info *info)
+{
+	u8 mac[ETH_ALEN];
+
+	if (!(hwe->bridge.ib2 & AIROHA_FOE_IB2_MULTICAST))
+		return false;
+
+	airoha_ppe_mc_group_mac(info, mac);
+	return hwe->bridge.l2.common.dest_mac_hi == get_unaligned_be32(mac) &&
+	       hwe->bridge.l2.common.dest_mac_lo == get_unaligned_be16(mac + 4);
+}
+
+static struct airoha_foe_entry *
+airoha_ppe_mc_find_locked(struct airoha_ppe *ppe,
+				  const struct airoha_ppe_mc_info *info,
+				  u32 foe_index, u32 *hash)
+{
+	u32 total = airoha_ppe_get_total_num_entries(ppe);
+	u32 i;
+
+	if (foe_index < total) {
+		struct airoha_foe_entry *hwe;
+
+		hwe = airoha_ppe_foe_get_entry_locked(ppe, foe_index);
+		if (hwe && airoha_ppe_mc_match(hwe, info)) {
+			*hash = foe_index;
+			return hwe;
+		}
+	}
+
+	for (i = 0; i < total; i++) {
+		struct airoha_foe_entry *hwe;
+
+		if (i == foe_index)
+			continue;
+		hwe = airoha_ppe_foe_get_entry_locked(ppe, i);
+		if (hwe && airoha_ppe_mc_match(hwe, info)) {
+			*hash = i;
+			return hwe;
+		}
+	}
+
+	return NULL;
+}
+
+static int airoha_ppe_mc_apply(struct airoha_ppe *ppe,
+				 struct airoha_foe_entry *hwe, u32 hash,
+				 u32 port_mask)
+{
+	int err;
+
+	/* SDK bits 0-3 are the only unambiguous EN7581 LAN mapping. */
+	if (port_mask & ~0x0fU)
+		return -EOPNOTSUPP;
+
+	hwe->bridge.ib2 &= ~AIROHA_FOE_IB2_PORT_AG;
+	hwe->bridge.ib2 |= FIELD_PREP(AIROHA_FOE_IB2_PORT_AG, port_mask);
+	err = airoha_ppe_foe_commit_entry(ppe, hwe, hash, false);
+
+	return err;
+}
+
+int airoha_ppe_mc_update(const struct airoha_ppe_mc_info *info,
+			 u32 update_mode, u32 op_type, u32 port_mask, u32 local)
+{
+	struct airoha_ppe *ppe;
+	struct airoha_foe_entry *hwe;
+	u32 hash;
+	int err;
+
+	if (!info || (info->proto != AIROHA_PPE_MC_PROTO_IPV4 &&
+		      info->proto != AIROHA_PPE_MC_PROTO_IPV6))
+		return -EINVAL;
+	if (update_mode & (AIROHA_PPE_MC_UPDATE_VLAN |
+			   AIROHA_PPE_MC_UPDATE_SRCIP))
+		return -EOPNOTSUPP;
+	if (op_type != 0 || local)
+		return -EOPNOTSUPP;
+
+	ppe = airoha_ppe_mc_instance();
+	if (!ppe)
+		return -ENODEV;
+
+	spin_lock_bh(&ppe_lock);
+	hwe = airoha_ppe_mc_find_locked(ppe, info, 0xffff, &hash);
+	if (!hwe)
+		err = -ENOENT;
+	else if (!port_mask)
+		err = -ENOENT;
+	else
+		err = airoha_ppe_mc_apply(ppe, hwe, hash, port_mask);
+	spin_unlock_bh(&ppe_lock);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_ppe_mc_update);
+
+int airoha_ppe_mc_clear(void)
+{
+	struct airoha_ppe *ppe = airoha_ppe_mc_instance();
+	u32 total, sram, i;
+
+	if (!ppe)
+		return -ENODEV;
+
+	total = airoha_ppe_get_total_num_entries(ppe);
+	sram = airoha_ppe_get_total_sram_num_entries(ppe);
+	spin_lock_bh(&ppe_lock);
+	for (i = 0; i < total; i++) {
+		struct airoha_foe_entry *hwe;
+
+		hwe = airoha_ppe_foe_get_entry_locked(ppe, i);
+		if (!hwe || !(hwe->bridge.ib2 & AIROHA_FOE_IB2_MULTICAST))
+			continue;
+		hwe->ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+		hwe->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
+					AIROHA_FOE_STATE_INVALID);
+		if (i < sram)
+			airoha_ppe_foe_commit_sram_entry(ppe, i);
+	}
+	spin_unlock_bh(&ppe_lock);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_ppe_mc_clear);
+
+int airoha_ppe_mc_get_portmask(const struct airoha_ppe_mc_info *info,
+			       u32 foe_index)
+{
+	struct airoha_ppe *ppe = airoha_ppe_mc_instance();
+	struct airoha_foe_entry *hwe;
+	u32 hash, port_mask;
+
+	if (!info)
+		return -EINVAL;
+
+	if (!ppe)
+		return -ENODEV;
+
+	spin_lock_bh(&ppe_lock);
+	hwe = airoha_ppe_mc_find_locked(ppe, info, foe_index, &hash);
+	port_mask = hwe ? FIELD_GET(AIROHA_FOE_IB2_PORT_AG,
+					  hwe->bridge.ib2) : 0;
+	spin_unlock_bh(&ppe_lock);
+
+	return hwe ? (port_mask & 0x0f) : -ENOENT;
+}
+EXPORT_SYMBOL_GPL(airoha_ppe_mc_get_portmask);
+
+int airoha_ppe_mc_subscribe(const struct airoha_ppe_mc_info *info,
+			   u32 update_mode)
+{
+	return info && update_mode ? 0 : -EINVAL;
+}
+EXPORT_SYMBOL_GPL(airoha_ppe_mc_subscribe);
+
+int airoha_ppe_mc_get_local(const struct airoha_ppe_mc_info *info)
+{
+	return info ? 0 : -EINVAL;
+}
+EXPORT_SYMBOL_GPL(airoha_ppe_mc_get_local);
+
+int airoha_ppe_mc_get_origdev(struct airoha_ppe_mc_info *info)
+{
+	return info ? -EOPNOTSUPP : -EINVAL;
+}
+EXPORT_SYMBOL_GPL(airoha_ppe_mc_get_origdev);
 
 static void airoha_ppe_foe_remove_flow(struct airoha_ppe *ppe,
 				       struct airoha_flow_table_entry *e)
--
2.47.0

diff --git a/drivers/ptp/Kconfig b/drivers/ptp/Kconfig
--- a/drivers/ptp/Kconfig
+++ b/drivers/ptp/Kconfig
@@ -69,4 +69,17 @@ config PTP_1588_CLOCK_QORIQ
 	  will be called ptp_qoriq.

+config PTP_1588_CLOCK_AIROHA_TOD
+	tristate "Airoha EN7581 ToD clock"
+	depends on PTP_1588_CLOCK
+	depends on HAS_IOMEM
+	depends on ARCH_AIROHA || COMPILE_TEST
+	help
+	  This driver exposes the EN7581 Time of Day generator as a Linux
+	  PTP hardware clock. It supports reading and setting the 48-bit
+	  seconds counter and signed hardware timestamp offsets.
+
+	  Frequency adjustment is intentionally left disabled until the
+	  vendor FREQ_ADJ_* unit scaling is documented for this SoC.
+
 comment "Enable PHYLIB and NETWORK_PHY_TIMESTAMPING to see the additional clocks."
 	depends on PHYLIB=n || NETWORK_PHY_TIMESTAMPING=n
diff --git a/drivers/ptp/Makefile b/drivers/ptp/Makefile
--- a/drivers/ptp/Makefile
+++ b/drivers/ptp/Makefile
@@ -11,3 +11,4 @@ obj-$(CONFIG_PTP_1588_CLOCK_VMCLOCK)	+= ptp_vmclock.o
 obj-$(CONFIG_PTP_1588_CLOCK_QORIQ)	+= ptp_qoriq.o
+obj-$(CONFIG_PTP_1588_CLOCK_AIROHA_TOD)	+= ptp_airoha_tod.o
 obj-$(CONFIG_PTP_1588_CLOCK_IDTCM)	+= ptp_clockmatrix.o
 obj-$(CONFIG_PTP_1588_CLOCK_FC3W)	+= ptp_fc3.o

diff --git a/drivers/net/ethernet/airoha/Kconfig b/drivers/net/ethernet/airoha/Kconfig
index 7899065..f9eff6a 100644
--- a/drivers/net/ethernet/airoha/Kconfig
+++ b/drivers/net/ethernet/airoha/Kconfig
@@ -25,6 +25,13 @@ config NET_AIROHA
 	  This driver supports the gigabit ethernet MACs in the
 	  Airoha SoC family.
 
+config AIROHA_PON_COMPAT
+	bool "Airoha legacy xPON compatibility"
+	depends on NET_AIROHA
+	help
+	  Export the legacy FE, QDMA and PPE multicast interfaces required by
+	  the vendor EN7581 xPON modules. Keep this disabled on non-PON boards.
+
 config NET_AIROHA_FLOW_STATS
 	default y
 	bool "Airoha flow stats"
diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 6d4f8fd..25ce64a 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -21,6 +21,7 @@
 #include "airoha_regs.h"
 #include "airoha_eth.h"
 
+#ifdef CONFIG_AIROHA_PON_COMPAT
 #define AIROHA_PON_FE_BASE		0x1fb50000
