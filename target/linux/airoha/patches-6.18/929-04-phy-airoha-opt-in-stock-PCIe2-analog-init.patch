+/* XR1710G stock PCIe2 analog setup, kept separate from USB3 SSC/reset. */
+static int airoha_usb_phy_pcie_init(struct airoha_usb_phy_priv *priv)
+{
+	unsigned int b20, b18, b00, b04;
+	int ret;
+
+	ret = regmap_update_bits(priv->regmap, AIROHA_USB_PHY_U3_PHYA_REG8,
+				 AIROHA_USB_PHY_SSUSB_CDR_RST_DLY,
+				 AIROHA_USB_PHY_SSUSB_CDR_RST_DLY_32);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->regmap, AIROHA_USB_PHY_U3_PHYA_REG6,
+				 AIROHA_USB_PHY_SSUSB_CDR_RESERVE,
+				 FIELD_PREP(AIROHA_USB_PHY_SSUSB_CDR_RESERVE, 0xe));
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->regmap, AIROHA_USB_PHY_U3_PHYA_REG0,
+				 AIROHA_USB_PHY_SSUSB_BG_DIV,
+				 AIROHA_USB_PHY_SSUSB_BG_DIV_4);
+	if (ret)
+		return ret;
+
+	ret = regmap_set_bits(priv->regmap, AIROHA_USB_PHY_U3_PHYA_REG1,
+			      FIELD_PREP(AIROHA_USB_PHY_SSUSB_XTAL_TOP_RESERVE, 0x600));
+	if (ret)
+		return ret;
+
+	ret = regmap_read(priv->regmap, AIROHA_USB_PHY_U3_PHYA_REG8, &b20);
+	if (ret)
+		return ret;
+	ret = regmap_read(priv->regmap, AIROHA_USB_PHY_U3_PHYA_REG6, &b18);
+	if (ret)
+		return ret;
+	ret = regmap_read(priv->regmap, AIROHA_USB_PHY_U3_PHYA_REG0, &b00);
+	if (ret)
+		return ret;
+	ret = regmap_read(priv->regmap, AIROHA_USB_PHY_U3_PHYA_REG1, &b04);
+	if (ret)
+		return ret;
+
+	dev_info(priv->dev,
+		 "PCIe2 stock analog init: b20=%#x b18=%#x b00=%#x b04=%#x\n",
+		 b20, b18, b00, b04);
+	return 0;
+}
+
