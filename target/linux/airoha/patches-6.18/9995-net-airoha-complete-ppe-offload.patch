+/* IB1 VPM selects the TPID used for the outer tag the PPE inserts:
+ * 1 -> 0x8100, 2 -> 0x88a8.
+ */
+static u32 airoha_ppe_vpm(const struct airoha_flow_data *data)
+{
+	if (!data->vlan.num)
+		return 0;
+
+	return data->vlan.hdr[0].proto == htons(ETH_P_8021AD) ? 2 : 1;
+}
