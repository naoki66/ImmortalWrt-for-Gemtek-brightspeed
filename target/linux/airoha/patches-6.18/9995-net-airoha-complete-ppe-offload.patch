+static u16 airoha_ppe_mc_vlan(const struct airoha_foe_entry *hwe, bool l2b,
+			      int index)
+{
+	if (l2b)
+		return index ? hwe->l2b.vlan2 : hwe->l2b.vlan1;
+
+	return index ? hwe->bridge.l2.common.vlan2 :
+		       hwe->bridge.l2.common.vlan1;
+}
+
+static void airoha_ppe_mc_dest_mac(const struct airoha_foe_entry *hwe, bool l2b,
+				   u8 *mac)
+{
+	u32 hi = l2b ? hwe->l2b.dest_mac_hi :
+		       hwe->bridge.l2.common.dest_mac_hi;
+	u16 lo = l2b ? hwe->l2b.dest_mac_lo :
+		       hwe->bridge.l2.common.dest_mac_lo;
+
+	put_unaligned_be32(hi, mac);
+	put_unaligned_be16(lo, mac + 4);
+}
+
+static bool airoha_ppe_mc_match(const struct airoha_ppe *ppe,
+				const struct airoha_foe_entry *hwe,
+				const struct airoha_ppe_mc_info *info)
+{
+	u8 mac[ETH_ALEN], entry_mac[ETH_ALEN];
+	u16 outer, inner, vlan1, vlan2;
+	bool l2b;
+
+	if (FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) !=
+	    PPE_PKT_TYPE_BRIDGE)
+		return false;
+
+	l2b = airoha_ppe_mc_uses_l2b(ppe, hwe);
+	if (!(airoha_ppe_mc_ib2(hwe, l2b) & AIROHA_FOE_IB2_MULTICAST))
 		return false;
 
 	airoha_ppe_mc_group_mac(info, mac);
-	return hwe->bridge.l2.common.dest_mac_hi == get_unaligned_be32(mac) &&
-	       hwe->bridge.l2.common.dest_mac_lo == get_unaligned_be16(mac + 4);
+	airoha_ppe_mc_dest_mac(hwe, l2b, entry_mac);
+	if (!ether_addr_equal(mac, entry_mac))
+		return false;
+
+	vlan1 = airoha_ppe_mc_vlan(hwe, l2b, 0) & VLAN_VID_MASK;
+	vlan2 = airoha_ppe_mc_vlan(hwe, l2b, 1) & VLAN_VID_MASK;
+
+	/* Untagged video services carry no tag in the FOE even when the
+	 * bridge is VLAN aware, so such an entry always matches.
+	 */
+	if (!vlan1 && !vlan2)
+		return true;
+
+	if (!info->vlan_tag_num)
+		return false;
+
+	outer = info->outer_tci & VLAN_VID_MASK;
+	inner = info->inner_tci & VLAN_VID_MASK;
+	if (inner)
+		return vlan1 == outer && vlan2 == inner;
+
+	return vlan1 == outer || vlan2 == outer;
 }
 
