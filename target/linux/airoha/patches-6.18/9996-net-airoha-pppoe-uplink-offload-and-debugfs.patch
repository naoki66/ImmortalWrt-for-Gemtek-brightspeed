+++ b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
@@ -244,6 +244,7 @@
 		[AIROHA_PPE_DROP_PORTS] = "ports",
 		[AIROHA_PPE_DROP_INVALID_MAC] = "invalid_mac",
 		[AIROHA_PPE_DROP_PON_MAPPING] = "pon_mapping",
+		[AIROHA_PPE_DROP_PPP_UPLINK] = "ppp_uplink",
 		[AIROHA_PPE_DROP_WDMA] = "wdma",
 	};
 	u64 entry_packets[ARRAY_SIZE(ppe_type_str)] = {};
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -4,6 +4,7 @@
  * Author: Lorenzo Bianconi <lorenzo@kernel.org>
  */
 
+#include <linux/debugfs.h>
 #include <linux/devcoredump.h>
 #include <linux/devm-helpers.h>
 #include <linux/firmware.h>
@@ -12,6 +13,7 @@
 #include <linux/of_platform.h>
 #include <linux/of_reserved_mem.h>
 #include <linux/regmap.h>
+#include <linux/seq_file.h>
 
 #include "airoha_eth.h"
 
@@ -214,10 +216,14 @@
 
 	spin_unlock_bh(&core->lock);
 
-	if (ret == -ETIMEDOUT)
+	if (ret == -ETIMEDOUT) {
+		atomic64_inc(&npu->mbox_timeouts);
 		dev_err_ratelimited(npu->dev,
 				    "mailbox function %d timed out\n",
 				    func_id);
+	} else if (ret) {
+		atomic64_inc(&npu->mbox_errors);
+	}
 
 	return ret;
 }
@@ -723,6 +729,45 @@
 	.disable_locking	= true,
 };
 
+static int airoha_npu_debugfs_info(struct seq_file *m, void *data)
+{
+	struct airoha_npu *npu = m->private;
+	int i;
+
+	seq_printf(m, "firmware: %u.%u\n",
+		   npu->version >> 16, npu->version & 0xffff);
+	seq_printf(m, "mailbox_errors: %llu\n",
+		   (u64)atomic64_read(&npu->mbox_errors));
+	seq_printf(m, "mailbox_timeouts: %llu\n",
+		   (u64)atomic64_read(&npu->mbox_timeouts));
+	seq_printf(m, "ppe_stats: %s\n",
+		   npu->stats ? "mapped" : "unavailable");
+
+	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
+		u32 val[3];
+
+		regmap_bulk_read(npu->regmap, REG_PC_DBG(i), val,
+				 ARRAY_SIZE(val));
+		seq_printf(m, "core%u: pc=%08x sp=%08x lr=%08x\n",
+			   i, val[0], val[1], val[2]);
+	}
+
+	return 0;
+}
+
+static int airoha_npu_debugfs_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, airoha_npu_debugfs_info, inode->i_private);
+}
+
+static const struct file_operations airoha_npu_debugfs_fops = {
+	.owner = THIS_MODULE,
+	.open = airoha_npu_debugfs_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
 static int airoha_npu_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -837,9 +882,15 @@
 	msleep(100);
 
 	if (!airoha_npu_wlan_msg_get(npu, 0, WLAN_FUNC_GET_WAIT_NPU_VERSION,
-				     &val, sizeof(val), GFP_KERNEL))
+				     &val, sizeof(val), GFP_KERNEL)) {
+		npu->version = val;
 		dev_info(dev, "NPU fw version: %0d.%d\n",
 			 (val >> 16) & 0xffff, val & 0xffff);
+	}
+
+	debugfs_create_file("info", 0444,
+			    debugfs_create_dir("airoha_npu", NULL),
+			    npu, &airoha_npu_debugfs_fops);
 
 	platform_set_drvdata(pdev, npu);
 
--- a/include/linux/soc/airoha/airoha_offload.h
+++ b/include/linux/soc/airoha/airoha_offload.h
@@ -182,6 +182,11 @@
 
 	struct airoha_foe_stats __iomem *stats;
 
+	/* Firmware version reported by the NPU and mailbox health counters. */
+	u32 version;
+	atomic64_t mbox_errors;
+	atomic64_t mbox_timeouts;
+
 	struct {
 		int (*ppe_init)(struct airoha_npu *npu);
 		int (*ppe_deinit)(struct airoha_npu *npu);
