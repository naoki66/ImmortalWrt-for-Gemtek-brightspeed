+/* Only netdevs owned by this driver keep airoha_gdm_dev in their private
+ * area. DSA user ports and VLAN uppers are also bridge ports, so the type
+ * must be checked before netdev_priv() is dereferenced.
+ */
+struct airoha_gdm_dev *airoha_netdev_to_gdm_dev(struct net_device *netdev)
+{
+	if (!netdev || netdev->netdev_ops != &airoha_netdev_ops)
