+
+/* ---- 桥接组播登记（IGMP snooping MDB → PPE L2B） ----------------------
+ *
+ * 桥代码在 MDB add/del 时通过 switchdev blocking notifier 通知每个桥端口。
+ * AN7581 的 L2B 组播条目由硬件在首个组播包到达时学习，CPU 只能修改它的
+ * 出向端口掩码，不能创建条目（key/ingress_vlan 等字段是硬件私有的）。
+ * 所以 ADD 先登记，立即尝试一次 update；若硬件尚未学到（-ENOENT），由
+ * delayed work 每秒重试，直到绑定成功或该组被删除。
+ */
+#define AIROHA_PPE_MC_RETRY_MS	1000
+
+struct airoha_ppe_mc_entry {
+	struct list_head list;
+	struct airoha_eth *eth;
+	struct airoha_ppe *ppe;
+	u8 mac[ETH_ALEN];
+	u16 vid;
+	u32 port_mask;
+	unsigned int retries;
+	bool bound;
+	int last_err;
+	/* mc_match() 从 IP 组地址推导组播 MAC；orig_dev 必须留空，
+	 * 避免桥端口 netdev 消失后留下悬挂指针。
+	 */
+	struct airoha_ppe_mc_info info;
+};
+
+static LIST_HEAD(airoha_ppe_mc_list);
+static DEFINE_MUTEX(airoha_ppe_mc_lock);
+static u64 airoha_ppe_mc_add_count;
+static u64 airoha_ppe_mc_del_count;
+static u64 airoha_ppe_mc_update_ok_count;
+static u64 airoha_ppe_mc_update_missing_count;
+static u64 airoha_ppe_mc_skipped_count;
+#if IS_ENABLED(CONFIG_NET_DSA)
+static u64 airoha_ppe_mc_dsa_count;
 #endif
 
+static void airoha_ppe_mc_retry_work(struct work_struct *work);
+static DECLARE_DELAYED_WORK(airoha_ppe_mc_work, airoha_ppe_mc_retry_work);
+
+/* 把桥 MDB 的组播 MAC 还原成 airoha_ppe_mc_match() 使用的组地址。
+ * 非 IP 组播 MAC（静态 L2 MDB）无法用现有匹配逻辑表达，直接跳过。
+ */
+static int airoha_ppe_mc_info_from_mdb(struct airoha_ppe_mc_info *info,
+				       const u8 *mac, u16 vid)
+{
+	memset(info, 0, sizeof(*info));
+
+	if (!is_multicast_ether_addr(mac))
+		return -EINVAL;
+
+	if (mac[0] == 0x01 && mac[1] == 0x00 && mac[2] == 0x5e) {
+		info->proto = AIROHA_PPE_MC_PROTO_IPV4;
+		info->grp_addr[0] = 224;
+		info->grp_addr[1] = mac[3] & 0x7f;
+		info->grp_addr[2] = mac[4];
+		info->grp_addr[3] = mac[5];
+	} else if (mac[0] == 0x33 && mac[1] == 0x33) {
+		info->proto = AIROHA_PPE_MC_PROTO_IPV6;
+		memcpy(&info->grp_addr[12], &mac[2], 4);
+	} else {
+		return -EOPNOTSUPP;
+	}
+
+	if (vid) {
+		info->vlan_tag_num = 1;
+		info->outer_tci = vid;
+	}
+
+	return 0;
+}
+
+static struct airoha_ppe_mc_entry *
+airoha_ppe_mc_find(struct airoha_eth *eth, const u8 *mac, u16 vid)
+{
+	struct airoha_ppe_mc_entry *entry;
+
+	list_for_each_entry(entry, &airoha_ppe_mc_list, list) {
+		if (entry->eth == eth && entry->vid == vid &&
+		    ether_addr_equal(entry->mac, mac))
+			return entry;
+	}
+
+	return NULL;
+}
+
+static void airoha_ppe_mc_schedule_retry(void)
+{
+	schedule_delayed_work(&airoha_ppe_mc_work,
+			      msecs_to_jiffies(AIROHA_PPE_MC_RETRY_MS));
+}
+
+/* 重试尚未绑定的组：硬件只有在收到首个组播包后才会创建 L2B 条目。 */
+static void airoha_ppe_mc_retry_work(struct work_struct *work)
+{
+	struct airoha_ppe_mc_entry *entry;
+	bool retry = false;
+
+	mutex_lock(&airoha_ppe_mc_lock);
+	list_for_each_entry(entry, &airoha_ppe_mc_list, list) {
+		int err;
+
+		if (entry->bound)
+			continue;
+
+		err = airoha_ppe_mc_update_ppe(entry->ppe, &entry->info,
+					       entry->port_mask);
+		entry->retries++;
+		entry->last_err = err;
+		if (!err) {
+			entry->bound = true;
+			airoha_ppe_mc_update_ok_count++;
+		} else if (err == -ENOENT || err == -ENODEV) {
+			if (err == -ENOENT)
+				airoha_ppe_mc_update_missing_count++;
+			retry = true;
+		}
+	}
+
+	if (retry)
+		airoha_ppe_mc_schedule_retry();
+	mutex_unlock(&airoha_ppe_mc_lock);
+}
+
+static int airoha_ppe_mc_switchdev_event(struct notifier_block *nb,
+					 unsigned long event, void *ptr)
+{
+	struct switchdev_notifier_port_obj_info *obj_info = ptr;
+	const struct switchdev_obj_port_mdb *mdb;
+	struct airoha_ppe_mc_entry *entry;
+	struct airoha_ppe_mc_info info;
+	struct airoha_gdm_dev *dev;
+	struct airoha_eth *eth;
+	struct airoha_ppe *ppe;
+	u32 bit;
+	int err;
+
+	if (event != SWITCHDEV_PORT_OBJ_ADD &&
+	    event != SWITCHDEV_PORT_OBJ_DEL)
+		return NOTIFY_DONE;
+
+	/* HOST_MDB 是 CPU 本地组，不影响 L2B 出向掩码。 */
+	if (!obj_info->obj || obj_info->obj->id != SWITCHDEV_OBJ_ID_PORT_MDB)
+		return NOTIFY_DONE;
+
+	/* 先按本驱动的 GDM netdev 解析；VLAN 上层等非本驱动口安全忽略。 */
+	dev = airoha_netdev_to_gdm_dev(obj_info->obj->orig_dev);
+#if IS_ENABLED(CONFIG_NET_DSA)
+	if (!dev || !dev->port) {
+		struct dsa_port *dp;
+		struct net_device *conduit;
+
+		/* DSA 用户口无法用 PPE 出向掩码表达（它没有独立的 GDM 位），
+		 * 只能换算成交换机 conduit（gdm1..gdm4）的 bit，把帧送到交换机，
+		 * 末跳由 DSA 驱动（mt7530）依据自身 MDB/泛洪完成。
+		 */
+		dp = dsa_port_from_netdev(obj_info->obj->orig_dev);
+		if (!IS_ERR(dp)) {
+			conduit = dsa_port_to_conduit(dp);
+			if (conduit) {
+				dev = airoha_netdev_to_gdm_dev(conduit);
+				if (dev && dev->port)
+					airoha_ppe_mc_dsa_count++;
+			}
+		}
+	}
+#endif
+	if (!dev || !dev->port) {
+		airoha_ppe_mc_skipped_count++;
+		return NOTIFY_DONE;
+	}
+
+	if (!airoha_is_lan_gdm_dev(dev) ||
+	    test_bit(AIROHA_DEV_F_PON, &dev->flags) ||
+	    dev->port->id < AIROHA_GDM1_IDX ||
+	    dev->port->id > AIROHA_GDM4_IDX) {
+		/* PON/WAN 端口无法用 SDK 的 GDM LAN 掩码表达。 */
+		airoha_ppe_mc_skipped_count++;
+		return NOTIFY_DONE;
+	}
+
+	eth = dev->eth;
+	ppe = eth ? READ_ONCE(eth->ppe) : NULL;
+	if (!ppe) {
+		airoha_ppe_mc_skipped_count++;
+		return NOTIFY_DONE;
+	}
+
+	mdb = SWITCHDEV_OBJ_PORT_MDB(obj_info->obj);
+	if (airoha_ppe_mc_info_from_mdb(&info, mdb->addr, mdb->vid)) {
+		airoha_ppe_mc_skipped_count++;
+		return NOTIFY_DONE;
+	}
+
+	/* GDM1..GDM4 → PORT_AG bit 0..3。 */
+	bit = BIT(dev->port->id - 1);
+
+	mutex_lock(&airoha_ppe_mc_lock);
+	entry = airoha_ppe_mc_find(eth, mdb->addr, mdb->vid);
+
+	if (event == SWITCHDEV_PORT_OBJ_ADD) {
+		airoha_ppe_mc_add_count++;
+		if (!entry) {
+			entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+			if (!entry)
+				goto unlock;
+
+			entry->eth = eth;
+			entry->ppe = ppe;
+			entry->vid = mdb->vid;
+			ether_addr_copy(entry->mac, mdb->addr);
+			entry->info = info;
+			list_add_tail(&entry->list, &airoha_ppe_mc_list);
+		}
+		entry->port_mask |= bit;
+	} else {
+		airoha_ppe_mc_del_count++;
+		if (!entry)
+			goto unlock;
+
+		entry->port_mask &= ~bit;
+		if (!entry->port_mask) {
+			/* 最后一个桥端口离开：只失效这一条硬件条目。 */
+			airoha_ppe_mc_invalidate_ppe(ppe, &entry->info);
+			list_del(&entry->list);
+			kfree(entry);
+			goto unlock;
+		}
+	}
+
+	err = airoha_ppe_mc_update_ppe(ppe, &entry->info, entry->port_mask);
+	entry->last_err = err;
+	if (!err) {
+		entry->bound = true;
+		airoha_ppe_mc_update_ok_count++;
+	} else if (err == -ENOENT) {
+		/* 硬件还没学到该组：保留登记，等待重试。 */
+		entry->bound = false;
+		airoha_ppe_mc_update_missing_count++;
+		airoha_ppe_mc_schedule_retry();
+	} else {
+		entry->bound = false;
+	}
+
+unlock:
+	mutex_unlock(&airoha_ppe_mc_lock);
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block airoha_ppe_mc_nb = {
+	.notifier_call = airoha_ppe_mc_switchdev_event,
+};
+
+#ifdef CONFIG_DEBUG_FS
+void airoha_ppe_mc_dump(struct seq_file *m)
+{
+	struct airoha_ppe_mc_entry *entry;
+
+	mutex_lock(&airoha_ppe_mc_lock);
+	seq_puts(m, "mac               vid mask bound retries last_err\n");
+	list_for_each_entry(entry, &airoha_ppe_mc_list, list)
+		seq_printf(m, "%pM %5u %04x %5u %7u %8d\n",
+			   entry->mac, entry->vid, entry->port_mask,
+			   entry->bound, entry->retries, entry->last_err);
+	seq_printf(m,
+		   "counters: add=%llu del=%llu update_ok=%llu update_missing=%llu skipped=%llu",
+		   airoha_ppe_mc_add_count, airoha_ppe_mc_del_count,
+		   airoha_ppe_mc_update_ok_count,
+		   airoha_ppe_mc_update_missing_count,
+		   airoha_ppe_mc_skipped_count);
+#if IS_ENABLED(CONFIG_NET_DSA)
+	seq_printf(m, " dsa=%llu", airoha_ppe_mc_dsa_count);
+#endif
+	seq_puts(m, "\n");
+	mutex_unlock(&airoha_ppe_mc_lock);
+}
+#endif
+
+static int airoha_ppe_mc_init(void)
+{
+	return register_switchdev_blocking_notifier(&airoha_ppe_mc_nb);
+}
+
+static void airoha_ppe_mc_deinit(struct airoha_eth *eth)
+{
+	struct airoha_ppe_mc_entry *entry, *tmp;
+
+	unregister_switchdev_blocking_notifier(&airoha_ppe_mc_nb);
+	cancel_delayed_work_sync(&airoha_ppe_mc_work);
+
+	mutex_lock(&airoha_ppe_mc_lock);
+	list_for_each_entry_safe(entry, tmp, &airoha_ppe_mc_list, list) {
+		if (eth && entry->eth != eth)
+			continue;
+		list_del(&entry->list);
+		kfree(entry);
+	}
+	mutex_unlock(&airoha_ppe_mc_lock);
+}
+
 static void airoha_ppe_foe_remove_flow(struct airoha_ppe *ppe,
 				       struct airoha_flow_table_entry *e)
 {
@@ -2545,12 +2907,18 @@
 	if (err)
 		goto error_flow_table_destroy;
 
-	err = airoha_ppe_debugfs_init(ppe);
+	err = airoha_ppe_mc_init();
 	if (err)
 		goto error_l2_flow_table_destroy;
 
+	err = airoha_ppe_debugfs_init(ppe);
+	if (err)
+		goto error_mc_deinit;
+
 	return 0;
 
+error_mc_deinit:
+	airoha_ppe_mc_deinit(eth);
 error_l2_flow_table_destroy:
 	rhashtable_destroy(&ppe->l2_flows);
 error_flow_table_destroy:
@@ -2563,6 +2931,9 @@
 {
 	struct airoha_npu *npu;
 
+	/* 先停止 MDB 钩子与重试工作，之后才能安全释放 PPE/FOE。 */
+	airoha_ppe_mc_deinit(eth);
+
 	mutex_lock(&flow_offload_mutex);
 
