+/* 只更新硬件已经学到的 L2B 组播条目，绝不在这里创建条目。
+ *
+ * EN7581 的 L2B 条目由硬件在首个组播包到达时按 native l2b 布局学习，
+ * 其查找 key（key/ingress_vlan 等）是硬件私有字段，CPU 无法凭空构造。
+ * 因此找不到条目时返回 -ENOENT，由调用方登记后重试。
+ */
+static int airoha_ppe_mc_update_ppe(struct airoha_ppe *ppe,
+				    const struct airoha_ppe_mc_info *info,
+				    u32 port_mask)
 {
-	struct airoha_ppe *ppe;
 	struct airoha_foe_entry *hwe;
 	u32 hash;
 	int err;
 
+	spin_lock_bh(&ppe_lock);
+	hwe = airoha_ppe_mc_find_locked(ppe, info, 0xffff, &hash);
+	if (!hwe)
+		err = -ENOENT;
+	else if (!port_mask)
+		err = -ENOENT;
+	else
+		err = airoha_ppe_mc_apply(ppe, hwe, hash, port_mask);
+	spin_unlock_bh(&ppe_lock);
+
+	return err;
+}
+
+/* 只失效指定组的条目，其它组播/普通 FOE 条目保持不变。 */
+static int airoha_ppe_mc_invalidate_ppe(struct airoha_ppe *ppe,
+					const struct airoha_ppe_mc_info *info)
+{
+	struct airoha_foe_entry *hwe;
+	u32 hash, sram;
+	int err = -ENOENT;
+
+	sram = airoha_ppe_get_total_sram_num_entries(ppe);
+	spin_lock_bh(&ppe_lock);
+	hwe = airoha_ppe_mc_find_locked(ppe, info, 0xffff, &hash);
+	if (hwe) {
+		hwe->ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+		hwe->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
+				       AIROHA_FOE_STATE_INVALID);
+		if (hash < sram)
+			airoha_ppe_foe_commit_sram_entry(ppe, hash);
+		err = 0;
+	}
+	spin_unlock_bh(&ppe_lock);
+
+	return err;
+}
