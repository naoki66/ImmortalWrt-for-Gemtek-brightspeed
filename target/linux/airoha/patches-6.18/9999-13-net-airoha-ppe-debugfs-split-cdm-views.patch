From: liujixings <liujixings@outlook.com>
Subject: [PATCH] net: airoha: ppe: split debugfs bind and summary per CDM

The SRAM flow table is shared by all PPE engines and each engine only owns
one slice of it, so the aggregate debugfs views cannot tell how many entries
an engine actually bound. Expose one bind/summary pair per engine under
ppe/cdm<N>/ and label the register dump cdm1..cdmN.

DRAM entries do not belong to any engine, they remain visible in the
aggregate bind and summary files only.

Signed-off-by: liujixings <liujixings@outlook.com>
---
--- a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
@@ -7,6 +7,15 @@
 #include "airoha_regs.h"
 #include "airoha_eth.h"
 
+/* Per engine (CDM) debugfs view. The SRAM flow table is split evenly
+ * between the PPE engines, so engine N owns [start, end) of the hashes.
+ */
+struct airoha_ppe_debugfs_cdm {
+	struct airoha_ppe *ppe;
+	u32 start;
+	u32 end;
+};
+
 static void airoha_debugfs_ppe_print_tuple(struct seq_file *m,
 					   void *src_addr, void *dest_addr,
 					   u16 *src_port, u16 *dest_port,
@@ -35,8 +44,9 @@ static void airoha_debugfs_ppe_print_tuple(struct seq_file *m,
 		seq_printf(m, ":%d", *dest_port);
 }
 
-static int airoha_ppe_debugfs_foe_show(struct seq_file *m, void *private,
-				       bool bind)
+static int airoha_ppe_debugfs_foe_show(struct seq_file *m,
+				       struct airoha_ppe *ppe,
+				       u32 start, u32 end, bool bind)
 {
 	static const char *const ppe_type_str[] = {
 		[PPE_PKT_TYPE_IPV4_HNAPT] = "IPv4 5T",
@@ -53,14 +63,13 @@ static int airoha_ppe_debugfs_foe_show(struct seq_file *m, void *private,
 		[AIROHA_FOE_STATE_BIND] = "BND",
 		[AIROHA_FOE_STATE_FIN] = "FIN",
 	};
-	struct airoha_ppe *ppe = m->private;
-	u32 ppe_num_entries = airoha_ppe_get_total_num_entries(ppe);
-	int i;
+	u32 i;
 
-	for (i = 0; i < ppe_num_entries; i++) {
+	for (i = start; i < end; i++) {
 		const char *state_str, *type_str = "UNKNOWN";
 		void *src_addr = NULL, *dest_addr = NULL;
 		u16 *src_port = NULL, *dest_port = NULL;
+		struct airoha_foe_mac_info_common native_l2 = {};
 		struct airoha_foe_mac_info_common *l2;
 		unsigned char h_source[ETH_ALEN] = {};
 		struct airoha_foe_stats64 stats = {};
@@ -133,7 +142,18 @@ static int airoha_ppe_debugfs_foe_show(struct seq_file *m, void *private,
 			break;
 		}
 
-		if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
+		if (airoha_is_7581(ppe->eth) && type == PPE_PKT_TYPE_BRIDGE) {
+			data = hwe->l2b.data;
+			ib2 = hwe->l2b.ib2;
+			native_l2.dest_mac_hi = hwe->l2b.dest_mac_hi;
+			native_l2.dest_mac_lo = hwe->l2b.dest_mac_lo;
+			native_l2.src_mac_hi = hwe->l2b.src_mac_hi;
+			native_l2.vlan1 = hwe->l2b.vlan1;
+			native_l2.vlan2 = hwe->l2b.vlan2;
+			native_l2.etype = hwe->l2b.etype;
+			l2 = &native_l2;
+			*((__be16 *)&h_source[4]) = cpu_to_be16(hwe->l2b.src_mac_lo);
+		} else if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
 			data = hwe->ipv6.data;
 			ib2 = hwe->ipv6.ib2;
 			l2 = &hwe->ipv6.l2;
@@ -164,16 +184,33 @@ static int airoha_ppe_debugfs_foe_show(struct seq_file *m, void *private,
 
 static int airoha_ppe_debugfs_foe_all_show(struct seq_file *m, void *private)
 {
-	return airoha_ppe_debugfs_foe_show(m, private, false);
+	struct airoha_ppe *ppe = m->private;
+
+	return airoha_ppe_debugfs_foe_show(m, ppe, 0,
+					   airoha_ppe_get_total_num_entries(ppe),
+					   false);
 }
 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_foe_all);
 
 static int airoha_ppe_debugfs_foe_bind_show(struct seq_file *m, void *private)
 {
-	return airoha_ppe_debugfs_foe_show(m, private, true);
+	struct airoha_ppe *ppe = m->private;
+
+	return airoha_ppe_debugfs_foe_show(m, ppe, 0,
+					   airoha_ppe_get_total_num_entries(ppe),
+					   true);
 }
 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_foe_bind);
 
+static int airoha_ppe_debugfs_cdm_bind_show(struct seq_file *m, void *private)
+{
+	struct airoha_ppe_debugfs_cdm *cdm = m->private;
+
+	return airoha_ppe_debugfs_foe_show(m, cdm->ppe, cdm->start, cdm->end,
+					   true);
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_cdm_bind);
+
 static int airoha_ppe_debugfs_config_show(struct seq_file *m, void *private)
 {
 	struct airoha_ppe *ppe = m->private;
@@ -210,7 +247,9 @@ static int airoha_ppe_debugfs_config_show(struct seq_file *m, void *private)
 }
 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_config);
 
-static int airoha_ppe_debugfs_summary_show(struct seq_file *m, void *private)
+static void airoha_ppe_debugfs_summary_types(struct seq_file *m,
+					     struct airoha_ppe *ppe,
+					     u32 start, u32 end)
 {
 	static const char *const ppe_type_str[] = {
 		[PPE_PKT_TYPE_IPV4_HNAPT] = "IPv4 5T",
@@ -221,32 +260,16 @@ static int airoha_ppe_debugfs_summary_show(struct seq_file *m, void *private)
 		[PPE_PKT_TYPE_IPV6_ROUTE_5T] = "IPv6 5T",
 		[PPE_PKT_TYPE_IPV6_6RD] = "6RD",
 	};
-	static const char *const drop_str[__AIROHA_PPE_DROP_MAX] = {
-		[AIROHA_PPE_DROP_RULE_META] = "rule_meta",
-		[AIROHA_PPE_DROP_RULE_CONTROL] = "rule_control",
-		[AIROHA_PPE_DROP_RULE_BASIC] = "rule_basic",
-		[AIROHA_PPE_DROP_ADDR_TYPE] = "addr_type",
-		[AIROHA_PPE_DROP_ACTION] = "action",
-		[AIROHA_PPE_DROP_VLAN_ACTION] = "vlan_action",
-		[AIROHA_PPE_DROP_PPPOE_ACTION] = "pppoe_action",
-		[AIROHA_PPE_DROP_PORTS] = "ports",
-		[AIROHA_PPE_DROP_INVALID_MAC] = "invalid_mac",
-		[AIROHA_PPE_DROP_PON_MAPPING] = "pon_mapping",
-		[AIROHA_PPE_DROP_WDMA] = "wdma",
-	};
 	u64 entry_packets[ARRAY_SIZE(ppe_type_str)] = {};
 	u64 entry_bytes[ARRAY_SIZE(ppe_type_str)] = {};
 	u32 entry_total[ARRAY_SIZE(ppe_type_str)] = {};
 	u32 entry_bound[ARRAY_SIZE(ppe_type_str)] = {};
-	struct airoha_ppe *ppe = m->private;
-	struct airoha_eth *eth = ppe->eth;
-	u32 total, i;
+	u32 i;
 
 	/* Hardware counters only exist when the flow stats region is
 	 * enabled; without it every packets/bytes value stays zero.
 	 */
-	total = airoha_ppe_get_total_num_entries(ppe);
-	for (i = 0; i < total; i++) {
+	for (i = start; i < end; i++) {
 		struct airoha_foe_stats64 stats = {};
 		struct airoha_foe_entry *hwe;
 		u32 state, type;
@@ -282,15 +305,49 @@ static int airoha_ppe_debugfs_summary_show(struct seq_file *m, void *private)
 			   entry_total[i], entry_bound[i],
 			   entry_packets[i], entry_bytes[i]);
 	}
+}
 
-	for (i = 0; i < eth->soc->num_ppe; i++) {
-		seq_printf(m, "ppe%u bind_rate=%08x tb_cfg=%08x unbind_age=%08x bind_age0=%08x bind_age1=%08x\n",
-			   i, airoha_fe_rr(eth, REG_PPE_BIND_RATE(i)),
+/* idx < 0 dumps the registers of every engine, otherwise only engine idx. */
+static void airoha_ppe_debugfs_summary_hw(struct seq_file *m,
+					  struct airoha_ppe *ppe, int idx)
+{
+	struct airoha_eth *eth = ppe->eth;
+	int first = idx < 0 ? 0 : idx;
+	int last = idx < 0 ? eth->soc->num_ppe - 1 : idx;
+	int i;
+
+	for (i = first; i <= last; i++) {
+		seq_printf(m, "cdm%d bind_rate=%08x tb_cfg=%08x unbind_age=%08x bind_age0=%08x bind_age1=%08x\n",
+			   i + 1, airoha_fe_rr(eth, REG_PPE_BIND_RATE(i)),
 			   airoha_fe_rr(eth, REG_PPE_TB_CFG(i)),
 			   airoha_fe_rr(eth, REG_PPE_UNBIND_AGE(i)),
 			   airoha_fe_rr(eth, REG_PPE_BND_AGE0(i)),
 			   airoha_fe_rr(eth, REG_PPE_BND_AGE1(i)));
 	}
+}
+
+static int airoha_ppe_debugfs_summary_show(struct seq_file *m, void *private)
+{
+	static const char *const drop_str[__AIROHA_PPE_DROP_MAX] = {
+		[AIROHA_PPE_DROP_RULE_META] = "rule_meta",
+		[AIROHA_PPE_DROP_RULE_CONTROL] = "rule_control",
+		[AIROHA_PPE_DROP_RULE_BASIC] = "rule_basic",
+		[AIROHA_PPE_DROP_ADDR_TYPE] = "addr_type",
+		[AIROHA_PPE_DROP_ACTION] = "action",
+		[AIROHA_PPE_DROP_VLAN_ACTION] = "vlan_action",
+		[AIROHA_PPE_DROP_PPPOE_ACTION] = "pppoe_action",
+		[AIROHA_PPE_DROP_PORTS] = "ports",
+		[AIROHA_PPE_DROP_INVALID_MAC] = "invalid_mac",
+		[AIROHA_PPE_DROP_PON_MAPPING] = "pon_mapping",
+		[AIROHA_PPE_DROP_PPP_UPLINK] = "ppp_uplink",
+		[AIROHA_PPE_DROP_WDMA] = "wdma",
+	};
+	struct airoha_ppe *ppe = m->private;
+	u32 total, i;
+
+	total = airoha_ppe_get_total_num_entries(ppe);
+	airoha_ppe_debugfs_summary_types(m, ppe, 0, total);
+	airoha_ppe_debugfs_summary_hw(m, ppe, -1);
 
 	seq_puts(m, "offload drops:\n");
 	for (i = 0; i < ARRAY_SIZE(drop_str); i++)
@@ -301,6 +358,19 @@ static int airoha_ppe_debugfs_summary_show(struct seq_file *m, void *private)
 }
 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_summary);
 
+static int airoha_ppe_debugfs_summary_cdm_show(struct seq_file *m,
+					       void *private)
+{
+	struct airoha_ppe_debugfs_cdm *cdm = m->private;
+
+	airoha_ppe_debugfs_summary_types(m, cdm->ppe, cdm->start, cdm->end);
+	airoha_ppe_debugfs_summary_hw(m, cdm->ppe,
+				      cdm->start / PPE_SRAM_NUM_ENTRIES);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_summary_cdm);
+
 static int airoha_ppe_debugfs_multicast_show(struct seq_file *m, void *private)
 {
 	airoha_ppe_mc_dump(m);
@@ -311,6 +381,18 @@ DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_multicast);
 
 int airoha_ppe_debugfs_init(struct airoha_ppe *ppe)
 {
+	struct airoha_eth *eth = ppe->eth;
+	struct airoha_ppe_debugfs_cdm *cdm;
+	int i;
+
+	/* DRAM entries are not owned by a single engine and stay visible in
+	 * the aggregate 'bind'/'summary' files only.
+	 */
+	cdm = devm_kcalloc(eth->dev, eth->soc->num_ppe, sizeof(*cdm),
+			   GFP_KERNEL);
+	if (!cdm)
+		return -ENOMEM;
+
 	ppe->debugfs_dir = debugfs_create_dir("ppe", NULL);
 	debugfs_create_file("config", 0444, ppe->debugfs_dir, ppe,
 			    &airoha_ppe_debugfs_config_fops);
@@ -323,5 +405,21 @@ int airoha_ppe_debugfs_init(struct airoha_ppe *ppe)
 	debugfs_create_file("multicast", 0444, ppe->debugfs_dir, ppe,
 			    &airoha_ppe_debugfs_multicast_fops);
 
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		struct dentry *dir;
+		char name[8];
+
+		cdm[i].ppe = ppe;
+		cdm[i].start = i * PPE_SRAM_NUM_ENTRIES;
+		cdm[i].end = cdm[i].start + PPE_SRAM_NUM_ENTRIES;
+
+		snprintf(name, sizeof(name), "cdm%d", i + 1);
+		dir = debugfs_create_dir(name, ppe->debugfs_dir);
+		debugfs_create_file("bind", 0444, dir, &cdm[i],
+				    &airoha_ppe_debugfs_cdm_bind_fops);
+		debugfs_create_file("summary", 0444, dir, &cdm[i],
+				    &airoha_ppe_debugfs_summary_cdm_fops);
+	}
+
 	return 0;
 }
