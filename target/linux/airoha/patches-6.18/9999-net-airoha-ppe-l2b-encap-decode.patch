 					     false);
@@ -1140,6 +1141,14 @@
 				airoha_ppe_mc_learn_skb(&eth->ppe->dev,
 							q->skb, hash);
 			break;
+		case PPE_CPU_REASON_UN_HIT:
+		case PPE_CPU_REASON_NO_FLOW_IS_ASSIGNED:
+			/* Bridged non-IP frames (PPPoE passthrough, 802.1Q) are
