From: liujixings <liujixings@outlook.com>
Subject: [PATCH] net: airoha: enable hardware counters for native AN7581 L2B

Native AN7581 L2B entries use the same forwarding control layout as the
other entry types (data at 40, ib2 at 44) and store the accounting word
at offset 64, matching the vendor _l2_bridge32 layout. Extend the native
structure with that word and let the native layout go through the same
NPU flow-stats programming as IPv4/IPv6 entries instead of skipping it.

Multicast entries are left untouched: their ib2 PORT_AG field carries the
bridge MDB egress mask, so they must not be redirected to the accounting
PSE port.

Signed-off-by: liujixings <liujixings@outlook.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -407,6 +407,8 @@ struct airoha_foe_l2b {
 	u16 vlan2;
 	u16 reserved3;
 	u32 reserved4;
+	u32 meter;
+	u32 reserved5[3];
 };
 
 struct airoha_foe_ipv4_tuple {
@@ -501,6 +503,7 @@ struct airoha_foe_entry {
 static_assert(offsetof(struct airoha_foe_entry, l2b.data) == 40);
 static_assert(offsetof(struct airoha_foe_entry, l2b.ib2) == 44);
 static_assert(offsetof(struct airoha_foe_entry, l2b.vlan1) == 48);
+static_assert(offsetof(struct airoha_foe_entry, l2b.meter) == 64);
 static_assert(sizeof(struct airoha_foe_entry) == PPE_ENTRY_SIZE);
 
 struct airoha_foe_stats {
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -920,12 +920,10 @@ static void airoha_ppe_foe_flow_stats_update(struct airoha_ppe *ppe,
 	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
 	u32 index, pse_port, val, *data, *ib2, *meter;
 	int ppe_num_stats_entries;
+	bool native_l2b = airoha_is_7581(ppe->eth) &&
+			  type == PPE_PKT_TYPE_BRIDGE;
 	u8 nbq;
 
-	/* No verified NPU counter layout for native AN7581 L2B entries. */
-	if (airoha_is_7581(ppe->eth) && type == PPE_PKT_TYPE_BRIDGE)
-		return;
-
 	ppe_num_stats_entries = airoha_ppe_get_total_num_stats_entries(ppe);
 	if (ppe_num_stats_entries < 0)
 		return;
@@ -939,9 +937,23 @@ static void airoha_ppe_foe_flow_stats_update(struct airoha_ppe *ppe,
 		return;
 
 	if (type == PPE_PKT_TYPE_BRIDGE) {
-		data = &hwe->bridge.data;
-		ib2 = &hwe->bridge.ib2;
-		meter = &hwe->bridge.l2.meter;
+		if (native_l2b) {
+			/* The native L2B layout keeps the forwarding control at
+			 * the same offsets as the other entry types and stores
+			 * its accounting word at offset 64. Multicast entries
+			 * carry the bridge MDB egress mask in PORT_AG, so they
+			 * are not redirected to the accounting PSE port.
+			 */
+			data = &hwe->l2b.data;
+			ib2 = &hwe->l2b.ib2;
+			meter = &hwe->l2b.meter;
+			if (*ib2 & AIROHA_FOE_IB2_MULTICAST)
+				return;
+		} else {
+			data = &hwe->bridge.data;
+			ib2 = &hwe->bridge.ib2;
+			meter = &hwe->bridge.l2.meter;
+		}
 	} else if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
 		data = &hwe->ipv6.data;
 		ib2 = &hwe->ipv6.ib2;
@@ -2908,14 +2906,7 @@ void airoha_ppe_foe_entry_get_stats(struct airoha_ppe *ppe, u32 hash,
 	int ppe_num_stats_entries;
 	struct airoha_npu *npu;
-	struct airoha_foe_entry *hwe;
 	u32 index;
 
-	hwe = ppe->foe + hash * sizeof(*hwe);
-	if (airoha_is_7581(eth) &&
-	    FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, READ_ONCE(hwe->ib1)) ==
-	    PPE_PKT_TYPE_BRIDGE)
-		return;
-
 	ppe_num_stats_entries = airoha_ppe_get_total_num_stats_entries(ppe);
 	if (ppe_num_stats_entries < 0)
 		return;
