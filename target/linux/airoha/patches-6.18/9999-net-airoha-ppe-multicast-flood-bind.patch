From: liujixings <liujixings@outlook.com>
Subject: [PATCH] net: airoha: bind multicast L2B entries without an MDB

Bridges that keep IGMP snooping disabled (the OpenWrt default for br-lan)
never populate an MDB, so airoha_ppe_mc_learn_skb() finds no egress mask
and returns without binding the hardware-allocated multicast L2B entry.
The entry stays unbind and every packet keeps being punted to the CPU,
which is why the multicast counters show a large no_mdb value and ok=0.

Reproduce the bridge flooding semantics in hardware when no MDB entry
exists: send the frame to every other bridge member that is
administratively up. Like br_flood(), a member is not excluded just
because it lost carrier. Members that cannot be expressed by the L2B PORT_AG mask (native LAN GDM
or DSA conduit) keep the software path so nothing is silently dropped, with
one exception: PON side members (IPTV VLANs on pon0) have no LAN egress bit
at all, so they are skipped and the frame is bound for the remaining LAN
ports. This is what makes PON-to-LAN multicast end up in hardware instead of
being punted forever, and it matches what br_flood() can actually deliver.

Frames received on a DSA user port are still attached to the conduit in
the driver RX path, so resolve the real ingress port from the
METADATA_HW_PORT_MUX metadata that QDMA fills from the RX descriptor.
Without that the bridge of the ingress port cannot be determined and the
entry would never be bound.

Broadcast and link-local groups (224.0.0.x, ff02::/16) are skipped: the
local stack is a member of those and must keep receiving them through the
punt path. The bound entry still sets the multicast-to-CPU bit, so the
local stack keeps getting its copy for every other group.

Signed-off-by: liujixings <liujixings@outlook.com>
---
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -18,6 +18,7 @@
 #include <linux/platform_device.h>
 #include <linux/rhashtable.h>
 #include <net/ipv6.h>
+#include <net/dst_metadata.h>
 #include <linux/if_bridge.h>
 #include <net/pkt_cls.h>
 #include <net/route.h>
@@ -1730,6 +1731,166 @@
 	return NULL;
 }
 
+/* 把桥端口换算成 L2B PORT_AG 的 GDM 位（GDM1..GDM4 → bit 0..3）。
+ * WLAN、PON/WAN、VLAN-over-bridge 等形态无法用该掩码表达，返回 false。
+ */
+static bool airoha_ppe_mc_port_bit(struct net_device *netdev, u32 *bit)
+{
+	struct airoha_gdm_dev *dev;
+
+	if (airoha_ppe_netdev_is_wlan(netdev))
+		return false;
+
+	dev = airoha_netdev_to_gdm_dev(netdev);
+	if (!dev) {
+#if IS_ENABLED(CONFIG_NET_DSA)
+		struct dsa_port *dp;
+		struct net_device *conduit;
+
+		dp = dsa_port_from_netdev(netdev);
+		if (IS_ERR(dp))
+			return false;
+
+		conduit = dsa_port_to_conduit(dp);
+		if (!conduit)
+			return false;
+
+		dev = airoha_netdev_to_gdm_dev(conduit);
+#endif
+	}
+	if (!dev || !dev->port)
+		return false;
+
+	if (!airoha_is_lan_gdm_dev(dev) ||
+	    test_bit(AIROHA_DEV_F_PON, &dev->flags) ||
+	    dev->port->id < AIROHA_GDM1_IDX ||
+	    dev->port->id > AIROHA_GDM4_IDX)
+		return false;
+
+	*bit = BIT(dev->port->id - 1);
+	return true;
+}
+
+/* DSA 用户口的入向帧在驱动 RX 路径里仍挂在 conduit 上，真正的用户口记在
+ * skb 的 METADATA_HW_PORT_MUX 元数据中（QDMA 把 DSA source port 放在 RX
+ * 描述符里）。这里按 DSA 的解析方式换回用户口，否则无法判断入向端口和它
+ * 所属的桥。
+ */
+static struct net_device *airoha_ppe_mc_ingress_netdev(struct sk_buff *skb)
+{
+#if IS_ENABLED(CONFIG_NET_DSA)
+	struct metadata_dst *md_dst;
+	struct dsa_port *cpu_dp, *dp;
+	struct net_device *dev = skb->dev;
+
+	if (!dev || !netdev_uses_dsa(dev))
+		return dev;
+
+	md_dst = skb_metadata_dst(skb);
+	if (!md_dst || md_dst->type != METADATA_HW_PORT_MUX)
+		return NULL;
+
+	cpu_dp = dev->dsa_ptr;
+	if (!cpu_dp || !cpu_dp->dst)
+		return NULL;
+
+	list_for_each_entry(dp, &cpu_dp->dst->ports, list) {
+		if (dp->ds->index == 0 &&
+		    dp->index == md_dst->u.port_info.port_id &&
+		    dp->type == DSA_PORT_TYPE_USER)
+			return dp->user;
+	}
+
+	return NULL;
+#else
+	return skb->dev;
+#endif
+}
+
+/* 桥未开启 IGMP snooping 时 MDB 为空，硬件分配的组播 L2B 条目没有可用的
+ * 出向掩码，只能一直 punt 给 CPU。这里按内核桥的泛洪语义补齐掩码：发往
+ * 除入端口以外所有处于 up 的桥成员口（与内核 br_flood 一致，不因
+ * 载波丢失而排除）。
+ *
+ * PON 侧桥成员没有 GDM LAN 位，也永远不会出现在 LAN 出向掩码里，直接跳过；
+ * WLAN 等其它不可表达的成员则让整条组播保持软件路径，避免绑定后的硬件掩码
+ * 把它们静默漏掉。链路本地组（224.0.0.x / ff02::/16）与广播由本机协议栈
+ * 自己消费，不能绑定，否则会切断本地收包。
+ */
+static bool airoha_ppe_mc_is_pon_netdev(struct net_device *netdev)
+{
+	struct airoha_gdm_dev *dev;
+
+	if (is_vlan_dev(netdev))
+		netdev = vlan_dev_real_dev(netdev);
+
+	dev = airoha_netdev_to_gdm_dev(netdev);
+
+	return dev && test_bit(AIROHA_DEV_F_PON, &dev->flags);
+}
+
+static u32 airoha_ppe_mc_flood_mask(struct sk_buff *skb)
+{
+	struct net_device *ingress, *master, *lower;
+	struct list_head *iter;
+	u32 ingress_bit = 0, mask = 0;
+	bool exclude_ingress = false;
+
+	rcu_read_lock();
+	ingress = airoha_ppe_mc_ingress_netdev(skb);
+	if (!ingress) {
+		rcu_read_unlock();
+		return 0;
+	}
+
+	master = netdev_master_upper_dev_get_rcu(ingress);
+	if (!master || !netif_is_bridge_master(master)) {
+		rcu_read_unlock();
+		return 0;
+	}
+
+	/* PON 入向无法用 GDM LAN 位表达，但它本就不需要从出向掩码里排除；其它
+	 * 无法表达的入向设备（WLAN 等）无法排除自身，放弃绑定。
+	 */
+	if (airoha_ppe_mc_port_bit(ingress, &ingress_bit)) {
+		exclude_ingress = true;
+	} else if (!airoha_ppe_mc_is_pon_netdev(ingress)) {
+		rcu_read_unlock();
+		return 0;
+	}
+
+	netdev_for_each_lower_dev(master, lower, iter) {
+		u32 bit;
+
+		if (!netif_running(lower))
+			continue;
+
+		if (!airoha_ppe_mc_port_bit(lower, &bit)) {
+			/* PON 侧成员跳过，其余不可表达成员保守放弃。 */
+			if (airoha_ppe_mc_is_pon_netdev(lower))
+				continue;
+			mask = 0;
+			goto out;
+		}
+		mask |= bit;
+	}
+out:
+	rcu_read_unlock();
+
+	if (exclude_ingress)
+		mask &= ~ingress_bit;
+
+	return mask;
+}
+
+static bool airoha_ppe_mc_is_local_group(const u8 *mac)
+{
+	return (mac[0] == 0x01 && mac[1] == 0x00 && mac[2] == 0x5e &&
+		mac[3] == 0x00 && mac[4] == 0x00) ||
+	       (mac[0] == 0x33 && mac[1] == 0x33 &&
+		mac[2] == 0x00 && mac[3] == 0x00 && mac[4] == 0x00);
+}
+
 /* 把硬件已分配但未绑定的 L2B 组播条目绑定到桥 MDB 给出的出向端口掩码。
 *
 * 硬件在首个组播包上送 CPU 之前已经按硬件私有布局填好 ingress key
@@ -1772,8 +1933,14 @@
 	spin_unlock_bh(&airoha_ppe_mc_lock);
 
 	if (!mask) {
-		atomic64_inc(&airoha_ppe_mc_learn_nomdb_count);
-		return;
+		/* 无 MDB 时按桥泛洪语义直接绑定；本地组与广播除外。 */
+		if (!is_broadcast_ether_addr(eh->h_dest) &&
+		    !airoha_ppe_mc_is_local_group(eh->h_dest))
+			mask = airoha_ppe_mc_flood_mask(skb);
+		if (!mask) {
+			atomic64_inc(&airoha_ppe_mc_learn_nomdb_count);
+			return;
+		}
 	}
 
 	if (hash >= airoha_ppe_get_total_num_entries(ppe)) {
