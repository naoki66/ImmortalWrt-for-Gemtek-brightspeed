From: 1261685372 <1261685372@users.noreply.github.com>
Date: Thu, 25 Sep 2026 00:00:00 +0800
Subject: [PATCH] mtd: spinand: xtx: add XT26G01C and XT26G02C (C-series) support

XTX C-series SPI NANDs (JEDEC manufacturer 0x0B, device IDs 0x11/0x12)
share the 128-byte OOB layout and the bit[7:4] ECC status encoding with
the D-series, while keeping the QE bit from the A-series.

XT26G01C: 1 Gbit, 2048+128 page, 64 pages/block, 1024 blocks
XT26G02C: 2 Gbit, 2048+128 page, 64 pages/block, 2048 blocks

Signed-off-by: 1261685372 <1261685372@users.noreply.github.com>
---
diff --git a/drivers/mtd/nand/spi/xtx.c b/drivers/mtd/nand/spi/xtx.c
index 5915b37..d8c15eb 100644
--- a/drivers/mtd/nand/spi/xtx.c
+++ b/drivers/mtd/nand/spi/xtx.c
@@ -159,6 +159,26 @@ static const struct spinand_info xtx_spinand_table[] = {
 		     SPINAND_HAS_QE_BIT,
 		     SPINAND_ECCINFO(&xt26g0xa_ooblayout,
 				     xt26g0xa_ecc_get_status)),
+	SPINAND_INFO("XT26G01C",
+		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_ADDR, 0x11),
+		     NAND_MEMORG(1, 2048, 128, 64, 1024, 20, 1, 1, 1),
+		     NAND_ECCREQ(8, 512),
+		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants,
+				      &write_cache_variants,
+				      &update_cache_variants),
+		     SPINAND_HAS_QE_BIT,
+		     SPINAND_ECCINFO(&xt26xxxd_ooblayout,
+				     xt26xxxd_ecc_get_status)),
+	SPINAND_INFO("XT26G02C",
+		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_ADDR, 0x12),
+		     NAND_MEMORG(1, 2048, 128, 64, 2048, 40, 1, 1, 1),
+		     NAND_ECCREQ(8, 512),
+		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants,
+				      &write_cache_variants,
+				      &update_cache_variants),
+		     SPINAND_HAS_QE_BIT,
+		     SPINAND_ECCINFO(&xt26xxxd_ooblayout,
+				     xt26xxxd_ecc_get_status)),
 	SPINAND_INFO("XT26G04A",
 		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_ADDR, 0xE3),
 		     NAND_MEMORG(1, 2048, 64, 128, 2048, 40, 1, 1, 1),
