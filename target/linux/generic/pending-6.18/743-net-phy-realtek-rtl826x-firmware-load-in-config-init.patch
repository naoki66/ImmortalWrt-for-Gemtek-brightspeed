From: Gilly <gilroyscott1970@gmail.com>
Date: Sat, 25 Apr 2026 00:00:00 +1000
Subject: [PATCH] net: phy: realtek: move RTL826x firmware load to config_init

rtl826x_probe() calls rtl826x_patch_db_init() which uses
request_firmware_direct() and returns -EPROBE_DEFER when rtl8261n.bin /
rtl8264b.bin are not yet available (squashfs not mounted). The kernel
retries probe at ~1s intervals, delaying PHY attach by several seconds.

Move firmware loading from probe() to config_init(). By the time any
network interface is brought up squashfs is guaranteed to be mounted,
so the firmware is always available and -EPROBE_DEFER is never needed.

Adapted to match our repo's 742 patch structure (single rtl826x_probe,
rtl826x_patch_db_init wrapper, enable_pma_low_power priv field).

Signed-off-by: Gilly <gilroyscott1970@gmail.com>
---
 drivers/net/phy/realtek/phy_patch_rtl826x.c |    7 +-----
 drivers/net/phy/realtek/realtek_main.c      |   11 ++++++++---
 2 files changed, 9 insertions(+), 9 deletions(-)

--- a/drivers/net/phy/realtek/phy_patch_rtl826x.c
+++ b/drivers/net/phy/realtek/phy_patch_rtl826x.c
@@ -1141,13 +1141,8 @@ static int rtl826x_phy_patch_db_init(str
 	int ret;
 
 	ret = request_firmware_direct(&fw, fw_name, dev);
 	if (ret) {
-		if (ret == -ENOENT) {
-			phydev_dbg(phydev, "Failed to request %s: defer probing\n", fw_name);
-			return -EPROBE_DEFER;
-		} else {
-			phydev_err(phydev, "Failed to request %s: %d\n", fw_name, ret);
-			return ret;
-		}
+		phydev_err(phydev, "Failed to request %s: %d\n", fw_name, ret);
+		return ret;
 	}
 
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -255,9 +255,6 @@ static int rtl826x_probe(struct phy_devi
 	phy_disable_eee_mode(phydev, ETHTOOL_LINK_MODE_100baseT_Full_BIT);
 	phy_disable_eee_mode(phydev, ETHTOOL_LINK_MODE_1000baseT_Full_BIT);
 
-	ret = rtl826x_patch_db_init(phydev);
-	if (ret < 0)
-		return ret;
-
 	if (IS_ENABLED(CONFIG_REALTEK_PHY_HWMON))
 		return rtl822x_hwmon_init(phydev);
 
@@ -300,6 +297,7 @@ static int rtl826x_config_serdes_polarit
 static int rtl826x_config_init(struct phy_device *phydev)
 {
 	const unsigned int max_dereset_tries = 5;
+	struct rtl826x_priv *priv = phydev->priv;
 	unsigned int tries = 0;
 	int ret;
 
@@ -334,6 +332,15 @@ static int rtl826x_config_init(struct ph
 
 	msleep(30);
 
+	if (!priv->patch) {
+		ret = rtl826x_patch_db_init(phydev);
+		if (ret < 0) {
+			phydev_err(phydev, "firmware load failed: %d\n", ret);
+			return ret;
+		}
+	}
+
 	ret = rtlgen_phy_patch(phydev);
 	if (ret) {
 		phydev_err(phydev, "patch failed!! %d\n", ret);
